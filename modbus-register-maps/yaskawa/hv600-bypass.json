{
 "manufacturer": "Yaskawa",
 "manufacturer_slug": "yaskawa",
 "model": "HV600 Narrow and Enclosed Bypass (MEMOBUS/Modbus RTU)",
 "model_slug": "hv600-bypass",
 "short_model": "HV600 Bypass",
 "aliases": [
  "HV600 Bypass",
  "HV600 Enclosed Bypass",
  "HV600 Narrow Bypass"
 ],
 "equipment_type": "Variable frequency drive (HVAC bypass package)",
 "applies_to": "Yaskawa HV600 Narrow and Enclosed Bypass packages using the bypass board RS-485 port (TB3) with H5-08 = 0 (Modbus); Technical Reference SIEPYAIH6B01F, section 10.6.",
 "summary": "The HV600 Bypass wraps an HV600 HVAC drive with a bypass contactor board that carries its own RS-485 port. In Modbus mode it exposes the drive command and monitor registers plus bypass-only registers: a bypass command word (drive/bypass select, emergency override, Motor AND/OR), network control of the bypass digital inputs and outputs, and status bits for bypass run and bypass faults.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 31,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Register numbers are hex and are sent unchanged: the manual's read example asks for starting register 0020H as 00 20. Parameters use the hex number printed under each parameter (H5-01 = 0425H)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "HV600 Narrow & Enclosed Bypass Technical Reference",
  "doc_number": "SIEPYAIH6B01F",
  "revision_date": "2025-09",
  "url": "https://www.yaskawa.com/delegate/getAttachment?documentId=SIEPYAIH6B01&cmd=documents&documentName=SIEPYAIH6B01.pdf",
  "pages": "pp. 310-313 (H5 parameters), 752-781 (MEMOBUS/Modbus: specifications, function codes, examples, Tables 10.30-10.32)"
 },
 "notes": [
  "All registers are 16-bit; signed values are noted per register.",
  "Frequency registers 0002H, 0023H and 0024H use the units chosen in o1-03, so they are left unscaled.",
  "Left out: 0025H output voltage (unit switched by H5-10), 0026H/0027H output current and power (resolution or unit not fixed in the table), 00ABH/00FBH currents (unit depends on drive model), 003EH/003FH speed values, the fault-trace blocks from 0080H and the long fault/minor-fault description words from 00C0H.",
  "Date/time registers 3004H-3030H, emergency-override references 3A93H-3A96H and bypass clock monitors 8440H-8442H are not listed.",
  "Supported function codes are 03H, 08H, 10H, 5AH and 67H; there is no 06H, so use 10H even for one register. A 03H read returns at most 16 registers.",
  "H5-08 defaults to 3 (BACnet) on the bypass, so select Modbus (0) first.",
  "0001H bits 0 and 1 are printed with two meanings each (forward run / run, and reverse run / reverse direction) without saying which applies, so bit 1 is left out; bit 0 = 1 runs the motor either way."
 ],
