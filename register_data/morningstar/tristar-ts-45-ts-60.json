{
  "manufacturer": "Morningstar",
  "manufacturer_slug": "morningstar",
  "model": "TriStar TS-45 / TS-60 PWM charge, load and diversion controller (Modbus RTU)",
  "model_slug": "tristar-ts-45-ts-60",
  "short_model": "TriStar TS-45/60",
  "aliases": [
    "TS-45",
    "TS-60",
    "TriStar",
    "TriStar PWM"
  ],
  "equipment_type": "Solar charge controller (PWM charge / load / diversion)",
  "applies_to": "Morningstar TriStar TS-45 and TS-60 (non-MPPT) on the RS-232 port; Modbus specification V07 (31 Jan 2020).",
  "summary": "The TriStar TS-45/TS-60 is a PWM controller that runs as a solar charger, a load controller or a diversion regulator. Its RS-232 port speaks Modbus RTU: RAM registers carry battery, array/load voltage and currents, temperatures, Ah counters, control mode/state, alarm and fault bitfields and PWM duty; EEPROM registers hold setpoints, and coils trigger equalize, disconnect, resets and counter clears.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 9600,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 2,
    "tcp_port": null
  },
  "addressing": {
    "convention": "hex 0-based",
    "note": "Morningstar lists a hex PDU address (used on the wire unchanged) and a logical address one higher. The spec says all listed addresses are request-PDU addresses; its scaling example reads battery voltage at PDU 0x0008."
  },
  "default_word_order": "ABCD",
  "firmware": "Alarm_HI (0x001D) needs software newer than 1.04.02; data logger needs firmware v13+.",
  "source": {
    "title": "TriStar MODBUS Specification",
    "doc_number": "V07",
    "revision_date": "2020-01-31",
    "url": "https://www.morningstarcorp.com/wp-content/uploads/technical-doc-tristar-modbus-specification-en.pdf",
    "pages": "p. 3 (parameters), pp. 4-7 (RAM, EEPROM, coils), pp. 10-13 (definitions), pp. 23-26 (coils, example, alarm/fault bits)"
  },
  "notes": [
    "Scaling: formulas n x 96.667 x 2^-15 (battery voltages), n x 139.15 x 2^-15 (array/load voltage), n x 66.667 x 2^-15 (charging current) and n x 316.67 x 2^-15 (load current) are converted to single multipliers. Example from the spec: 0x1007 = 4103 x 96.667 / 32768 = 12.1 V.",
    "Word order: the RAM table names each pair HI word first (Ah_r_HI 0x0011, Ah_r_LO 0x0012), so these are ABCD. The EEPROM Ah copies are printed LO first (EAh_r_LO 0xE028), so they are CDAB.",
    "The alarm bitfield is split: bits 0-15 at 0x0017 and bits 16-23 at 0x001D, so it is listed as two 16-bit registers.",
    "Control state codes mean different things in charge/diversion and in load/lighting mode; both meanings are given in the values.",
    "Left out: EEPROM kWh 0xE02C (no scaling or unit printed), lighting-mode and diversion EEPROM settings, calibration values and the 0x8000-0x85DF data logger. Registers 0x0000-0x0007 are internal use.",
    "Both FC 0x03 and FC 0x04 are supported for reading; EEPROM is written with Write Single Register (0x06)."
  ],
  "integration": {
    "summary": "Connect to the RS-232 port at 9600 8N2, ID 1, and read 0x0008-0x001D in one request. Convert voltages with 96.667/32768 (battery) or 139.15/32768 (array/load). Check control mode 0x001A before interpreting control state 0x001B.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 8,
        "why": "Battery voltage"
      },
      {
        "table": "holding_register",
        "address": 10,
        "why": "Array or load voltage"
      },
      {
        "table": "holding_register",
        "address": 11,
        "why": "Charging current"
      },
      {
        "table": "holding_register",
        "address": 26,
        "why": "Control mode"
      },
      {
        "table": "holding_register",
        "address": 27,
        "why": "Control state"
      },
      {
        "table": "holding_register",
        "address": 24,
        "why": "Fault bitfield"
      },
      {
        "table": "coil",
        "address": 1,
        "why": "Remote disconnect"
      }
    ],
    "enable": "Modbus is available on the RS-232 port at the factory settings (address 1); no enable step is described.",
    "watchdog": null,
    "quirks": [
      "Each analog channel has its own scaling constant; check which applies before converting.",
      "EEPROM values that need updating are written once every 24 hours; use coil 0x0016 to force it.",
      "Clearing faults does not clear those that need a power cycle (e.g. DIP switch change)."
    ],
    "setup": [
      "Serial: 9600 baud, 8 data bits, no parity, 2 stop bits, no flow control, RS-232 only."
    ],
    "gotchas": [
      "The spec describes Modbus on the RS-232 port only; an RS-485 network needs a converter."
    ]
  },
