  "integration": {
    "summary": "Set 8-30 = Modbus RTU and the port settings, make sure 8-02 is FC port, then write the 16 control bits (coils 1-16) and the reference (coils 17-32) with function 15 and read status coils 33-48. Read readouts from the 16-xx registers at parameter number x 10, minus 1 on the wire.",
    "minimum_registers": [
      {
        "table": "coil",
        "address": 6,
        "why": "CTW bit 6: start / ramp stop"
      },
      {
        "table": "coil",
        "address": 10,
        "why": "CTW bit 10: data valid"
      },
      {
        "table": "coil",
        "address": 43,
        "why": "Running"
      },
      {
        "table": "coil",
        "address": 35,
        "why": "Alarm"
      },
      {
        "table": "holding_register",
        "address": 16129,
        "why": "16-13 Frequency"
      },
      {
        "table": "holding_register",
        "address": 16139,
        "why": "16-14 Motor current"
      },
      {
        "table": "holding_register",
        "address": 16899,
        "why": "16-90 Alarm word"
      }
    ],
    "enable": "8-30 Protocol = [2] Modbus RTU, 8-31 Address 1-247, 8-32 Baud Rate (2400-115200), 8-33 Parity/Stop Bits (default even, 1 stop bit). 8-02 Control Source must be [1] FC port and 8-01 Control Site decides whether digital inputs, the control word or both are used.",
    "watchdog": "8-03 Control Timeout Time (0.1-6000 s, default 1 s) and 8-04 Control Timeout Function (default Off; Freeze output, Stop, Jogging, Max. speed, Stop and trip) act when the control word stops being updated.",
    "quirks": [
      "Control word bit 10 (coil 11) must be 1 or the drive ignores the control word.",
      "Parameter writes go to RAM only unless coil 65 is 1."
    ],
    "setup": [
      "8-35 Minimum Response Delay can be raised for slow masters or converters.",
      "Array parameters need the index written to holding register 9 first."
    ],
    "gotchas": [
      "Register numbers in the manual are 1-based; subtract 1 in the request."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
