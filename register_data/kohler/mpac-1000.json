  "integration": {
    "summary": "Poll 40001-40015 in one FC 03 read for contactor position, source availability and both sources' voltages and frequencies. Use 41350 bit commands for remote tests, peak shave and exercise, and 41312-41319 for transfer statistics.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "Contactor position and source availability"
      },
      {
        "table": "holding_register",
        "address": 7,
        "why": "Source A L1-L2 voltage"
      },
      {
        "table": "holding_register",
        "address": 10,
        "why": "Source B L1-L2 voltage"
      },
      {
        "table": "holding_register",
        "address": 13,
        "why": "Source A frequency"
      },
      {
        "table": "holding_register",
        "address": 14,
        "why": "Source B frequency"
      },
      {
        "table": "holding_register",
        "address": 741,
        "why": "Accessory status (exercise, test, peak shave)"
      }
    ],
    "enable": "Set the Modbus address and baud rate (9600 or 19200) of the network interface port with the ATS Controller Setup Program on a PC; each device on the network needs a unique address.",
    "watchdog": null,
    "quirks": [
      "Counters in 41300-41311 are high word first, unlike the LSW-first LONG type used by Kohler generator controllers.",
      "Phase sequence in 40022 is two bits per source with 01 = ABC and 00 = CBA."
    ],
    "setup": [
      "Serial format is 8 data bits, no parity, 1 stop bit.",
      "Register 49999 returns 19 for the MPAC 1000."
    ],
    "gotchas": [
      "The general exception table caps reads at 50 registers and writes at 16.",
      "Bit 5 of 41350 forces the switch to OFF; use with care on a live load."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
