  "integration": {
    "summary": "Read input registers 0-4 (status bits, torque, position) with function 04 or 03. Command the valve by writing register 5 (0 stop, 1 close, 2 open, 3 ESD) or send a position in 0.1 % to register 6. The actuator selector must be in Remote.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "Status: limits, moving, remote/local, alarms"
      },
      {
        "table": "input_register",
        "address": 1,
        "why": "Status: interlocks, DIs, general alarm"
      },
      {
        "table": "input_register",
        "address": 3,
        "why": "Valve position, 0.1 %"
      },
      {
        "table": "input_register",
        "address": 2,
        "why": "Instantaneous torque, %"
      },
      {
        "table": "holding_register",
        "address": 5,
        "why": "Digital control command"
      },
      {
        "table": "holding_register",
        "address": 6,
        "why": "Position set-point, 0.1 %"
      },
      {
        "table": "holding_register",
        "address": 7,
        "why": "Action on loss of comms"
      }
    ],
    "enable": "Set the module address (register 22, default 247), baud (23) and parity (24) with a Modbus tool or the Rotork setting tool over IR/Bluetooth. Turn the actuator's local/remote selector to Remote. Keep register 80 at 0.",
    "watchdog": "If no network traffic is seen for the comms fault timer (register 21, default 10 s), the actuator does what register 7 says: nothing (default), open, close, stop, or move to the comms lost position in register 13.",
    "quirks": [
      "Addresses are already 0-based: holding register 5 is 40006 in 1-based host software.",
      "Writing 0 % or 100 % to the position register runs to the tight shut-off or full open limit unless limited-range positioning is set.",
      "Only register 5 values 0 (stop) and 3 (ESD), and coils 0 and 3, accept broadcast (address 0)."
    ],
    "setup": [
      "RS-485 two-wire half duplex, 300 to 115200 baud, 8 data bits, odd/even/none parity, 1 or 2 stop bits.",
      "Switch on module termination (register 25) only on the last device of a segment; use network biasing somewhere on the highway.",
      "Replies can take up to 190 ms; a segment takes up to 32 nodes, more with repeaters."
    ],
    "gotchas": [
      "Every new module ships at address 247, which the manual says should never stay in use on a live system; readdress each actuator before adding the next.",
      "Dual-channel modules share one baud/parity setting; leave an 11-byte idle gap on port 1 so port 2 messages are answered.",
      "Setting the deadband below the hysteresis forces the hysteresis to 0.1 %."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
