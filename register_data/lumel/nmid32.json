  "integration": {
    "summary": "Read input registers with function 04 from 0x00: per-phase volts, amps and powers, then system values at 0x2A-0x46 and import/export energy at 0x48-0x50. Each value is a float in two registers.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "Voltage L1"
      },
      {
        "table": "input_register",
        "address": 6,
        "why": "Current L1"
      },
      {
        "table": "input_register",
        "address": 52,
        "why": "Total active power"
      },
      {
        "table": "input_register",
        "address": 70,
        "why": "Frequency"
      },
      {
        "table": "input_register",
        "address": 72,
        "why": "Active energy import"
      },
      {
        "table": "input_register",
        "address": 74,
        "why": "Active energy export"
      }
    ],
    "enable": "Modbus is always on; set address and the RS-485 setup code (baud/parity/stop bits, table 4) from the front-panel menu.",
    "watchdog": null,
    "quirks": [
      "Never start a read in the middle of a float (exception 02).",
      "At most 20 parameters (40 registers) per request.",
      "Word order is switchable; a meter set to reversed order returns CDAB."
    ],
    "setup": [
      "RS-485 setup code (table 4) combines baud 4800-57600 with parity and stop bits in one value."
    ],
    "gotchas": [
      "Tables 1.2 and 1.3 (per-phase and tariff energies) are not in this map; their Modicon numbers and hex addresses do not always agree, so check both before using them."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
