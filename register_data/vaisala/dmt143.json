  "integration": {
    "summary": "Read holding registers 7-12 for dew/frost point values (CDAB floats). Write the line pressure (bar absolute) to 771 so the dew point converted to 1 atm is correct.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 6,
        "why": "Dew/frost point"
      },
      {
        "table": "holding_register",
        "address": 20,
        "why": "Water ppm"
      },
      {
        "table": "holding_register",
        "address": 512,
        "why": "Error status"
      },
      {
        "table": "holding_register",
        "address": 513,
        "why": "Online / frozen"
      },
      {
        "table": "holding_register",
        "address": 770,
        "why": "Live pressure compensation"
      }
    ],
    "enable": "Order the transmitter with the Modbus configuration option, or set the serial mode to MODBUS with the SMODE serial command (takes effect at the next reset or power-up).",
    "watchdog": null,
    "quirks": [
      "Floats are low word first (CDAB); pick \"word-swapped\" float in masters that default to high word first.",
      "Read or write each 32-bit value in one transaction."
    ],
    "setup": [
      "Defaults: address 240, 19200 baud, None parity, 8 data bits, 2 stop bits.",
      "Give each device on a shared bus a unique address (1-247); change serial settings with Insight or registers 1537-1540."
    ],
    "gotchas": [
      "Use the test registers (7937 on) to confirm float format and addressing before trusting readings."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
