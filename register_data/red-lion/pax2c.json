{
  "manufacturer": "Red Lion",
  "manufacturer_slug": "red-lion",
  "model": "PAX2C temperature/process PID controller (Modbus RTU/ASCII)",
  "model_slug": "pax2c",
  "short_model": "PAX2C",
  "aliases": [
    "PAX2CHZVR",
    "PAX2C00000",
    "PX2FCA0",
    "PX2FCA1"
  ],
  "equipment_type": "Thermostat / temperature and process PID controller",
  "applies_to": "PAX2C version 2.0 register table (LP0905F, 2017-02-27); the FlexCard (PX2FCA0/PX2FCA1) blocks of the same table are not included.",
  "summary": "The PAX2C is Red Lion's PID temperature and process controller. Its Modbus table starts with a block of frequently used registers (process value, setpoints, output power, tuning, alarms and status) followed by full configuration. This map covers that frequently used block, profile status and the serial settings.",
  "transport": [
    "RTU",
    "ASCII"
  ],
  "defaults": {
    "unit_id": 247,
    "baud": 38400,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": null,
    "tcp_port": null
  },
  "addressing": {
    "convention": "1-based",
    "note": "Registers are numbered from 1; the table's own example reads register 2 with start address 00 01, and its notes refer to 41701-41710 for registers 1701-1710. Request register N at wire address N-1."
  },
  "default_word_order": "ABCD",
  "firmware": "PAX2C Ver 2.0",
  "source": {
    "title": "PAX2C, PX2FCA0, and PX2FCA1 Modbus Register Tables",
    "doc_number": "LP0905F",
    "revision_date": "2017-02-27",
    "url": "https://cdn.logic-control.com/docs/red-lion/Datasheets/PAX2CHZVR%20Modbus%20Register%20Table.pdf",
    "unofficial": true,
    "pages": "p. 1 (example query, frequently used registers 1-31), p. 2 (32-73), p. 19 (serial settings 1701-1710)"
  },
  "notes": [
    "Red Lion's site hosts only the older Ver 1.5 table (PAX2C8H8V, marked reference only); this file uses the unaltered Ver 2.0 table (LP0905F) from a distributor's file host.",
    "Registers can be read as holding (4x) or input (3x) registers; they are listed as holding registers.",
    "Values marked 1 = 1 display unit are the displayed digits without the decimal point; apply the controller's decimal point setting yourself.",
    "The only 32-bit value listed (segment time remaining) is printed as a Hi word register followed by a Lo word register, so it is ABCD.",
    "Factory serial settings: Modbus ASCII (type 2), 38400 baud, 8 data bits, no parity, address 247. Stop bits are not given in the table.",
    "Serial setting changes (1701-1709) take effect only after writing 1 to register 1710, and the master must then switch to the new settings.",
    "Do not power the unit down while parameters are being written; the table warns this can corrupt non-volatile memory.",
    "Profile definitions (5001 and up), the A/B parameter lists, input/output configuration and FlexCard registers are documented in the table but left out."
  ],
