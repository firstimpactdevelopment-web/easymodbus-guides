  "integration": {
    "summary": "Read 0x0100-0x0114 for temperatures, state, fan speeds, alarms, CO2 and RH. Switch with 0x0300, pick the mode with 0x0307 and the manual speed with 0x0309; a BMS humidity or CO2 sensor can be fed through 0x030A/0x030B.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 256,
        "why": "T1 temperature"
      },
      {
        "table": "holding_register",
        "address": 261,
        "why": "Machine state and mode"
      },
      {
        "table": "holding_register",
        "address": 272,
        "why": "Alarms"
      },
      {
        "table": "holding_register",
        "address": 267,
