 "integration": {
  "summary": "Set P-12 = 3 (or 4 to write ramp times in register 4), keep digital input 1 closed as the hardware enable, then write register 1 = 1 to run and register 2 with the frequency x10. Poll 2001 for status, 2002-2004 for speed, current and power, and 2016 for the trip code.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Control word: run, reset, coast stop"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Frequency setpoint, 0.1 Hz"
   },
   {
    "table": "holding_register",
    "address": 2000,
    "why": "Status word 2"
   },
   {
    "table": "holding_register",
    "address": 2001,
    "why": "Motor output speed, 0.1 Hz"
   },
   {
    "table": "holding_register",
    "address": 2002,
    "why": "Motor output current, 0.1 A"
   },
   {
    "table": "holding_register",
    "address": 2003,
    "why": "Motor output power, 0.1 kW"
   },
   {
    "table": "holding_register",
    "address": 2015,
    "why": "Trip code"
   },
   {
    "table": "holding_register",
    "address": 139,
    "why": "P-12 command source"
   }
  ],
  "enable": "Set P-12 = 3 (Modbus with internal ramps) or 4 (ramps from register 4). Set the drive address, baud rate and watchdog in P-36 indexes 1-3 (factory address 1, 115.2 kbps). An enable signal on digital input 1 is still required in Modbus mode. P-14 must hold the access code (P-37, factory 101) to reach parameters above P-14.",
  "watchdog": "P-36 index 3 sets the communication-loss time: 0 disables it, or 30, 100, 1000 or 3000 ms (factory 3000 ms with trip). A 't' suffix trips the drive (fault 50, Modbus comms loss); the other suffix coast-stops without tripping. P-63 decides whether any valid telegram (0, standard) or only telegrams for this node (1, advanced) reset the timer.",
  "quirks": [
   "Register numbers are 1-based: subtract 1 for the wire address.",
   "Only 8-N-1 framing is listed; the factory baud rate is 115200.",
   "Parameter registers are 128 + parameter number, not the parameter number itself."
  ],
  "setup": [
   "Wire RS485- to RJ45 pin 7, RS485+ to pin 8 and 0 V common to pin 3; pins 4/5 are the PC/keypad port.",
   "Use twisted pair for RS485+/-, connect 0 V common across all devices, and terminate the shield at the controller only.",
   "The RJ45 port is not Ethernet: do not plug it into a network switch."
  ],
  "gotchas": [
   "With the factory P-63 = 0, telegrams for other nodes also keep the watchdog alive.",
   "After an over current or overload trip (codes 3, 4, 15) a reset is refused until the built-in delay has elapsed."
  ]
 },
