 "integration": {
  "summary": "Set the Modbus address on SW1, wire DB/DA/GND, set H0008 to External or Changeover, then write H0001-H0006 for setpoints, mode and on/off and poll I0020-I0078 for status.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 4,
    "why": "Space heating/cooling on/off"
   },
   {
    "table": "holding_register",
    "address": 3,
    "why": "Heating or cooling"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Heating leaving water setpoint"
   },
   {
    "table": "holding_register",
    "address": 8,
    "why": "Who may switch the unit"
   },
   {
    "table": "input_register",
    "address": 23,
    "why": "Leaving water temperature (x100)"
   },
   {
    "table": "input_register",
    "address": 21,
    "why": "Group error"
   },
   {
    "table": "input_register",
    "address": 22,
    "why": "Error code"
   },
   {
    "table": "input_register",
    "address": 20,
    "why": "Units found on P1/P2"
   }
  ],
  "enable": "H0008 = 1 (External) or 3 (Changeover, default) lets Modbus switch the unit; 2 (Local) ignores Modbus on/off.",
  "watchdog": "If P1/P2 communication is lost for one minute the RTD raises an alarm on the fault relay R2; an RS485 communication timeout is also shown on the LEDs.",
  "quirks": [
   "Temperatures in input registers are x100 and signed; setpoints in holding registers are whole °C.",
   "Read at most 10 registers per request."
  ],
  "setup": [
   "RS485 D-Bus: DB(+), DA(-) and common GND, daisy chain only, up to 500 m without repeaters.",
   "Factory serial settings 9600 baud, no parity, 1 stop bit.",
   "Power 15..24 V DC, e.g. from X9A on the A3P board."
  ],
  "gotchas": [
   "The RTD-W works as a SUB controller: a BRC21 must be configured as MAIN on the P1/P2 bus."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/realtime-controls/rtd-w",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
