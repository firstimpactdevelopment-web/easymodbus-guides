 "integration": {
  "summary": "Configure lines and units in Intesis MAPS, send the project, then poll each IU x 100 block. Write on/off, mode, fan, vane and setpoint (tenths) per unit, or use the occupancy and all-unit registers 0..24.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 100,
    "why": "On/off"
   },
   {
    "table": "holding_register",
    "address": 101,
    "why": "Mode"
   },
   {
    "table": "holding_register",
    "address": 102,
    "why": "Fan speed"
   },
   {
    "table": "holding_register",
    "address": 104,
    "why": "Setpoint (x10)"
   },
   {
    "table": "holding_register",
    "address": 105,
    "why": "Room temperature (x10)"
   },
   {
    "table": "holding_register",
    "address": 119,
    "why": "Error code"
   },
   {
    "table": "holding_register",
    "address": 122,
    "why": "Communication error"
   },
   {
    "table": "holding_register",
    "address": 7025,
    "why": "Outdoor unit communication error"
   }
  ],
  "enable": "Indoor and outdoor units must be configured in MAPS; P-Link goes to Port A (A3/A4, no polarity).",
  "watchdog": null,
  "quirks": [
   "Every register is a 16-bit signed integer; there are no 32-bit values (unless stated in this file).",
   "Read with FC03 or FC04; write with FC06 or FC16.",
   "Undefined addresses in the 0..20000 poll range read back 0; the manual also says invalid addresses return a Modbus exception code."
  ],
  "setup": [
   "All Modbus settings (RTU slave number, baud 1200..115200, parity, stop bits, RS-485 or RS-232, TCP port, IP) are set with the Intesis MAPS tool over the USB console port or Ethernet.",
   "Factory IP is 192.168.100.246 with DHCP enabled.",
   "Modbus RTU and Modbus TCP can be used at the same time on the 16 and 64 versions; on the 128 version Port B carries the second P-Link line, so Modbus RTU is not available.",
   "Port B carries Modbus RTU on B1, B2 and B3 (SGND). The manual prints the B1/B2 polarity both ways in two sections, so check the terminal label. A DIP switch enables 120 ohm termination and bias."
  ],
  "gotchas": [
   "The line number (1 or 2) moves the whole map by 10000."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/intesis/inmbspan016o000",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
