  "integration": {
    "summary": "Set 9802 = 1 (STD MODBUS), set 5302 and the line settings, then 5305 = 2 (ABB DRV FULL) and point 1001/1102/1103 at COMM. Write the control word and REF1 at 40001/40002, poll the status word 40004 and output frequency/current at 40103/40104.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "Control word: start/stop/reset"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Reference 1 (20000 = 1105 REF1 MAX)"
      },
      {
        "table": "holding_register",
        "address": 3,
        "why": "Status word"
      },
      {
        "table": "holding_register",
        "address": 102,
        "why": "0103 Output frequency, 0.1 Hz"
      },
      {
        "table": "holding_register",
        "address": 103,
        "why": "0104 Current, 0.1 A"
      },
      {
        "table": "holding_register",
        "address": 105,
        "why": "0106 Power, 0.1 kW"
      },
      {
        "table": "holding_register",
        "address": 400,
        "why": "0401 Last fault"
      },
      {
        "table": "holding_register",
        "address": 304,
        "why": "0305 Fault word 1"
      }
    ],
    "enable": "Set 9802 COMM PROT SEL = 1 (STD MODBUS); this loads Modbus defaults into group 53. Set 5302 station ID (a new address applies after a power cycle, or after setting 5302 to 0 and then the new value), 5303 baud and 5304 parity. For control set 1001 EXT1 COMMANDS = COMM, 1102 EXT1/EXT2 SEL and 1103 REF1 SELECT = COMM, and optionally 1601 RUN ENABLE and 1604 FAULT RESET SEL = COMM. Parameter writes are volatile until 1607 PARAM. SAVE = 1.",
    "watchdog": "3018 COMM FAULT FUNC (NOT SEL default / FAULT 28 SERIAL 1 ERR / CONST SP 7 / LAST SPEED with alarm 2005 I/O COMM) after 3019 COMM FAULT TIME (default 10.0 s).",
    "quirks": [
      "Zero-based addressing: 4xxxx is sent as xxxx - 1.",
      "Everything is 16-bit.",
      "With ABB DRV LIM (default) control word bits 4 and 10 are ignored; choose ABB DRV FULL for the full ABB Drives state machine.",
      "Alarm words 0308/0309 stay set until the whole word is written to zero."
    ],
    "setup": [
      "RS-485 on X1:28-32: A(-) and B(+), terminal 31 reference/AGND; the J2 switch sets the active termination/bias at the bus ends.",
      "Up to 31 ACH550 drives per RS-485 segment without repeaters (full-load transceiver)."
    ],
    "gotchas": [
      "5302 = 0 holds the RS-485 channel in reset and stops communication.",
      "If a protocol is missing from 9802, the drive does not have that protocol software loaded."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
