 "equipment_type": "Sensor (digital process controller)",
 "applies_to": "Fuji Electric PXH digital controllers on the RS-485 Modbus port; read-only monitoring registers from manual INP-TN514207c-E.",
 "summary": "The PXH is a Fuji Electric digital process controller. Every Modbus value is a 32-bit integer spread over two registers, low word first. This map covers the read-only monitoring block: control mode, PV, SV, deviation, MV, input error, alarm and relay states, ramp/soak position, extra inputs/outputs and DI/DO status.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 38400,
  "parity": "Odd",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Register numbers are printed Modicon-style (30259) with the relative wire address beside them (0102H = 30259 - 30001)."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "Digital Controller Communication Functions (MODBUS) Type PXH",
  "doc_number": "INP-TN514207c-E",
  "revision_date": null,
  "url": "https://americas.fujielectric.com/wp-content/uploads/2018/12/PXH-Digital-Controller-Communication-FunctionsMODBUS-TN514207c-E-.pdf",
  "pages": "Settings p. 7; 2-word order pp. 17-18 and 22; data format pp. 24-28; read-only map pp. 49-50"
 },
 "notes": [
  "All PXH data are two registers per value; the manual's read and write examples put the lower word first (CDAB). Read both registers in one request.",
  "Function 04 reads at most 15 registers per request; 03 reads up to 32.",
  "Holding-register parameters (40001-45001) are not included: their decimal-point table could not be tied to each register with certainty.",
  "Values carry no decimal point; PV-type values follow the input range decimal point setting.",
  "Heating/cooling MV (30625-30643), totalizer and timer monitors are omitted."
 ],
 "integration": {
  "summary": "Read input registers 30257-30269 with function 04 (control mode, PV, SV, DV, MV, input error) as 32-bit values with the low word first, two registers per value.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 258,
    "why": "PV1 (30259)"
   },
   {
    "table": "input_register",
    "address": 260,
    "why": "SV1 (30261)"
   },
   {
    "table": "input_register",
    "address": 264,
    "why": "MV1 (30265)"
   },
   {
    "table": "input_register",
    "address": 268,
    "why": "Input error (30269)"
   },
   {
    "table": "input_register",
    "address": 256,
    "why": "Control mode bits (30257)"
   },
   {
    "table": "input_register",
    "address": 832,
    "why": "Alarm 1 status (30833)"
   }
  ],
  "enable": "Set SPD4 (speed), BIT4 (parity) and STN4 (station 0-255; 0 stops communication) for the RS-485 channel on the front keys, then cycle power.",
  "watchdog": null,
  "quirks": [
   "32-bit values are low word first; a single-register write (06) only changes the lower word.",
   "The PC-loader port always uses station 1."
  ],
  "setup": [
   "Factory defaults (RS-485): 38400 bps, 8 data bits, 1 stop bit, odd parity, station 1.",
   "Turn power off and on after changing the communication settings."
  ],
  "gotchas": [
   "After changing the input range over the bus, a FIX command and a power cycle or reset are needed before the new range applies."
  ]
 },
