  "integration": {
    "summary": "Poll holding registers 0x0000-0x0034 with FC03 (up to 125 per read) for I/O, temperatures, setpoints, burner status and lockout code; temperatures are 0.1 °C. The Remote STAT register (0x002A) can create a heat demand.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 32,
        "why": "Burner control status"
      },
      {
        "table": "holding_register",
        "address": 34,
        "why": "Lockout code"
      },
      {
        "table": "holding_register",
        "address": 35,
        "why": "Alarm reason"
      },
      {
        "table": "holding_register",
        "address": 7,
        "why": "Outlet temperature"
      },
      {
        "table": "holding_register",
        "address": 16,
        "why": "Active CH setpoint"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Digital I/O"
      },
      {
        "table": "holding_register",
        "address": 42,
        "why": "Remote STAT demand"
      }
    ],
    "enable": "Use the MB1 or MB2 RS-485 port; the Falcon answers on a single Modbus address.",
    "watchdog": null,
    "quirks": [
      "Temperatures are always Celsius x10.",
      "0x8FFF = sensor not configured.",
      "Variable-length items must be read on their own."
    ],
    "setup": [
      "RTU 38400 8N1 per the manual.",
      "Writes: up to 20 registers; reads: up to 125."
    ],
    "gotchas": [
      "Reading 0x0000 clears it, so a second master will miss change flags."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
