{
  "manufacturer": "Intesis (HMS Networks)",
  "manufacturer_slug": "intesis",
  "model": "IN485DAI001A000 Daikin Altherma 3 air-to-water to Modbus RTU / BACnet MS/TP gateway",
  "model_slug": "in485dai001a000",
  "short_model": "IN485DAI001A000",
  "aliases": [
    "IN485DAI001A000",
    "Daikin Altherma 3 Modbus",
    "Intesis Altherma 3",
    "HMS Daikin Altherma gateway"
  ],
  "equipment_type": "Heat pump gateway (VRF / split AC gateway)",
  "applies_to": "Intesis (HMS Networks) IN485DAI001A000 gateway for Daikin Altherma 3 air-to-water heat pumps, set to Modbus RTU, per user manual version 1.0.2 (2025-07-18).",
  "summary": "This Intesis gateway connects a Daikin Altherma 3 air-to-water heat pump to an RS-485 bus as a Modbus RTU server (or BACnet MS/TP device, chosen by DIP switch). All points are single 16-bit registers: on/off, heat/cool mode, zone, room and DHW setpoints with limits, water and outdoor temperatures, compressor and pump status and hours, flow, error codes and gateway diagnostics.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": null,
    "baud": 2400,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 2,
    "tcp_port": null
  },
  "addressing": {
    "convention": "0-based",
    "note": "The manual lists every register with a 'Modbus address (base 0)' and a 'PLC address (base 1)'. This map uses the base-0 value on the wire; Zones on/off is address 140 (PLC 141)."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "IN485DAI001A000 User Manual - Daikin Altherma 3 Air-to-water Heat Pumps to BACnet MS/TP and Modbus RTU",
    "doc_number": "User Manual Version 1.0.2",
    "revision_date": "2025-07-18",
    "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-in485dai001a000.pdf",
    "pages": "DIP switches pp. 7-8; Modbus functions and physical layer p. 27; register tables pp. 28-35"
  },
  "notes": [
    "Temperatures follow DIP switch SW2: position 7 OFF = whole degrees (x1, default), ON = tenths (x10, 19.2 = 192); position 8 OFF = °C (default), ON = °F. Units and scale here are for the defaults; use scale 0.1 if you set x10.",
    "Every register starts at 0x8000 (-32768) until the gateway has data, so temperatures are typed signed 16-bit.",
    "An invalid write resets a temperature register to its initial value; other registers keep their old value.",
    "Room 1 unit-limit registers (205-208) are left out to keep the map short; they report the Altherma's absolute room setpoint limits.",
    "The manual's baud-rate table prints 38500 bps for value 5; the physical-layer section lists 38400, which is used here."
  ],
