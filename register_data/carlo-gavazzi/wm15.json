{
  "manufacturer": "Carlo Gavazzi",
  "manufacturer_slug": "carlo-gavazzi",
  "model": "WM15 power analyzer",
  "model_slug": "wm15",
  "short_model": "WM15",
  "aliases": [
    "WM15",
    "WM15-96",
    "WM1596AV53XOSX",
    "WM1596AV53XOSPFB",
    "WM1596AV53HOSX"
  ],
  "equipment_type": "Power meter (power analyzer)",
  "applies_to": "WM15-96 three-phase panel power analyzers with RS485 Modbus RTU (OS / OSPF / HOS versions), protocol version 1.2.",
  "summary": "The WM15 is a 96x96 mm panel power analyzer with an RS485 Modbus RTU port. Values are mostly 32-bit integers sent low word first with fixed weights; functions 03 and 04 are equivalent and up to 125 registers can be read at once. This map covers voltages, currents, powers, PF (both sign conventions), frequency, energy totals and partials, run hours, THD, demand and max values, output/alarm status, alarm and pulse-output setup, serial settings, resets and device state.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 9600,
    "parity": "None",
    "data_bits": null,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "Modicon",
    "note": "Registers are printed as a 6-digit Modicon number for function 04 (3xxxxx; use 4xxxxx for function 03) beside the hex physical address that goes in the frame; the hex address is authoritative. A few printed Modicon numbers do not match their hex address (1105h, 110Bh, 053Ah, 053Ch); the 'documented' field keeps them as printed and the wire address follows the hex."
  },
  "default_word_order": "CDAB",
  "firmware": "Rows apply to all firmware unless noted (OS/OX/OSPF/OXPF 1.0)",
  "source": {
    "title": "WM15 Communication Protocol",
    "doc_number": "Version 1.2",
    "revision_date": "2019-12-20",
    "url": "https://www.gavazziautomation.com/fileadmin/images/PIM/OTHERSTUFF/COMPRO/WM15_CP.pdf",
    "pages": "Data format p. 8; tables pp. 9-20"
  },
  "notes": [
    "Word order: the protocol states INT32/UINT32/UINT64 are LSW first with bytes MSB first, so 32-bit values are CDAB.",
    "PF is published twice: 002Eh-0031h signed by power direction, 0072h-0075h signed by lead/lag, with the L/C flag in 0076h-0079h.",
    "Functions 03, 04, 06 and 10h are supported; up to 125 registers per read.",
    "Left out: the INT64 energy block (0500h-0533h, Wh resolution) because the document states word order only for INT32, UINT32 and UINT64, not INT64; the duplicate by-phase table (00F6h-01B4h) and its copies of hour meters at 0534h-053Bh; input terminal mapping (1150h-1158h); display page filter settings (1600h-1629h); the factory-reset key sequence (4020h); serial-number and configurable-name ASCII registers; and the M-Bus secondary address.",
    "MID (PFB) versions: measuring system accepts only 0/1, CT ratio is read-only, and total-energy reset (4003h) is not available.",
    "On 1-phase and 2-phase systems, phase 2/3 registers read 0."
  ],
  "integration": {
    "summary": "Read input registers 0000h-0059h with function 04 (or 03) in one request; decode INT32 values low word first and apply the fixed weights (V and W x10, A and PF x1000, energy x10).",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "V L1-N"
      },
      {
        "table": "input_register",
        "address": 12,
        "why": "A L1"
      },
      {
        "table": "input_register",
        "address": 40,
        "why": "W system"
      },
      {
        "table": "input_register",
        "address": 49,
        "why": "PF system"
      },
      {
        "table": "input_register",
        "address": 51,
        "why": "Frequency"
      },
      {
        "table": "input_register",
        "address": 52,
        "why": "kWh(+) total"
      },
      {
        "table": "input_register",
        "address": 78,
        "why": "kWh(-) total"
      }
    ],
    "enable": "Modbus RTU is on the OS (RS485) versions; OX versions have no serial port. Address, baud rate, parity and stop bits are in registers 2000h-2003h.",
    "watchdog": null,
    "quirks": [
      "INT32 values are low word first (CDAB).",
      "Two PF sign conventions are exposed; pick the block that matches your SCADA.",
      "Some printed Modicon numbers are wrong; trust the hex physical address."
    ],
    "setup": [
      "Defaults: address 1, 9600 baud, no parity, 1 stop bit.",
      "Terminate the master end with 120 ohm; use a repeater above 1000 m or 160 devices."
    ],
    "gotchas": [
      "Device state 5012h reports a configuration error when the phase/terminal mapping is inconsistent."
    ]
  },
