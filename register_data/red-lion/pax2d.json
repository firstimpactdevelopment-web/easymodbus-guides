  "integration": {
    "summary": "Read 40001-40016 in one request for counts, rates and min/max, then apply the decimal point settings. Write setpoints as two registers, high word first; take manual control of outputs through the MMR and SOR.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "Counter A value"
      },
      {
        "table": "holding_register",
        "address": 6,
        "why": "Rate A value"
      },
      {
        "table": "holding_register",
        "address": 16,
        "why": "Setpoint 1"
      },
      {
        "table": "holding_register",
        "address": 36,
        "why": "Setpoint output states"
      },
      {
        "table": "holding_register",
        "address": 121,
        "why": "Counter A decimal point"
      }
    ],
    "enable": "Set the serial Type register (40482) to 1 for Modbus RTU or 2 for Modbus ASCII. The factory setting is 2 (Modbus ASCII), so change it for an RTU master. Port settings 40481-40487 only take effect after writing 1 to Load Serial Settings (40490).",
    "watchdog": null,
    "quirks": [
      "Values carry no decimal point; scale them with the decimal point registers.",
      "The Slave ID block (41001+) reports a maximum of 64 registers per read or write."
    ],
    "setup": [
      "Factory settings: Modbus ASCII, 38400 baud, 8 data bits, no parity, address 247 (Modbus range 1-247).",
      "Baud (40483), data bits (40484), parity (40485), address (40486) and transmit delay (40487, 1 = 1 ms) are registers; write 1 to 40490 to apply them, then switch the master to the new settings."
    ],
    "gotchas": [
      "Counter values are writable; a write overwrites the count.",
      "Out of the box the port speaks Modbus ASCII, not RTU."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
