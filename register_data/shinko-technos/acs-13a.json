{
  "manufacturer": "Shinko Technos",
  "manufacturer_slug": "shinko-technos",
  "model": "ACS-13A digital indicating controller (C5 option)",
  "model_slug": "acs-13a",
  "short_model": "ACS-13A",
  "aliases": [
    "ACS-13A-C5",
    "ACS-13A C5"
  ],
  "equipment_type": "Sensor (digital temperature controller)",
  "applies_to": "Shinko ACS-13A with the C5 serial communication option; communication manual No.ACS12CE5.",
  "summary": "The ACS-13A is a digital indicating PID temperature controller. With the C5 option it speaks Shinko protocol, Modbus ASCII or Modbus RTU on RS485, and every item is a signed 16-bit holding register. The map covers SV, PID, alarm, heater-burnout and display settings, auto/manual and output-off control, PV, MV, heater current and status flags.",
  "transport": [
    "RTU",
    "ASCII"
  ],
  "defaults": {
    "unit_id": 0,
    "baud": 9600,
    "parity": "Even",
    "data_bits": 7,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "hex 0-based",
    "note": "Registers are listed as hex data items (0001H) that go into the request unchanged. The manual adds that the matching Modicon holding-register number is the item in decimal plus 40001 (0001H = 40002)."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "Communication Instruction Manual ACS-13A (C5)",
    "doc_number": "No. ACS12CE5",
    "revision_date": "2019-08",
    "url": "https://shinko-technos.co.jp/e/manual/english/ACS12CE5.pdf",
    "pages": "Section 7 Communication Command Table, pp. 9-13"
  },
  "notes": [
    "All data are 16-bit; negatives are two's complement. Items marked 'decimal point ignored' are sent as whole numbers, so apply the decimal point place (001AH).",
    "Units of PID times, cycles, rates and MV are not printed in the command table; they match the keypad settings in the main instruction manual.",
    "Some writes are refused with exception 1: output-OFF (0037H) when the OUT/OFF key is set for auto/manual, auto/manual (0038H) when it is set for output OFF, manual MV (0039H) in automatic mode, and AT (0003H) under PI or ON/OFF control.",
    "Instrument number and communication speed can only be set from the keypad, not over Modbus."
  ],
  "integration": {
    "summary": "Select MODBUS RTU and an 8-bit data format on the keypad, set a non-zero instrument number, then poll PV 0080H, OUT1 MV 0081H and status 0085H with function 03. Write SV at 0001H with function 06.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 128,
        "why": "Process value"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Set value"
      },
      {
        "table": "holding_register",
        "address": 129,
        "why": "OUT1 manipulated value"
      },
      {
        "table": "holding_register",
        "address": 133,
        "why": "Output, alarm and error status"
      },
      {
        "table": "holding_register",
        "address": 55,
        "why": "Control output on/off"
      },
      {
        "table": "holding_register",
        "address": 26,
        "why": "Decimal point for scaling"
      }
    ],
    "enable": "Requires the C5 option. In the communication settings choose MODBUS RTU, an instrument number, speed, Data bit/Parity (use an 8-bit choice for RTU) and stop bit.",
    "watchdog": null,
    "quirks": [
      "Factory data format is 7 bits/Even, which suits Shinko protocol; RTU needs 8 bits.",
      "Instrument number 0 is the default but is the Modbus broadcast address; set 1-95.",
      "Writes over Modbus work even when the keypad set value lock is on."
    ],
    "setup": [
      "Factory defaults: Shinko protocol, instrument 0, 9600 bps, 7 bits/Even, 1 stop bit.",
      "Speeds 2400, 4800, 9600, 19200 bps."
    ],
    "gotchas": [
      "Non-volatile memory is rated about 1,000,000 writes; writing an unchanged value does not use a write.",
      "The manual suggests polling only PV, OUT1 MV and status, and re-reading settings when status bit 15 shows a keypad change."
    ]
  },
