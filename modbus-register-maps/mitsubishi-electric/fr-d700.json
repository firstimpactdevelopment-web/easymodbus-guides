{
 "manufacturer": "Mitsubishi Electric",
 "manufacturer_slug": "mitsubishi-electric",
 "model": "FR-D700 compact inverter (PU connector, Modbus RTU)",
 "model_slug": "fr-d700",
 "short_model": "FR-D700",
 "aliases": [
  "FR-D720",
  "FR-D740",
  "FR-D720S",
  "FR-D710W"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "FR-D700 series (FR-D720/D740/D720S/D710W) using the PU connector with Pr.549 = 1; Instruction Manual (Applied) revision H.",
 "summary": "Mitsubishi Electric's simple compact inverter. The PU connector can run Modbus RTU, giving system variables (control word, operation mode, frequency command) at 40002-40015, a real-time monitor block from 40201, fault history at 40501 and every parameter at 41000 + parameter number. This map covers control, status, monitors, fault codes and the communication parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "The manual prints Modicon-style register numbers (40002, 41004) and states: starting address = register number - 40001. Its example reads 41004 (Pr.4) with start address H03EB (1003)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "FR-D700 Instruction Manual (Applied)",
  "doc_number": "IB(NA)-0600366ENG-H",
  "revision_date": "2018-06",
  "url": "https://dl.mitsubishielectric.com/dl/fa/document/manual/inv/ib0600366eng/ib0600366engh.pdf",
  "pages": "Printed pp. 201-212 (4.19.6 MODBUS RTU communication specifications, example p. 205, MODBUS registers pp. 210-212); parameter list pp. 60 ff."
 },
 "notes": [
  "All registers are single 16-bit words.",
  "Modbus RTU runs on the PU connector (RJ45-type RS-485 port), configured with the PU communication parameters Pr.117-Pr.122, not on separate terminals.",
  "Frequency registers use 0.01 Hz; with Pr.37 (speed display) set they switch to 1 r/min. The 0.01 Hz unit for 40014/40015 is from the same manual's computer-link set-frequency description (H0000-HFFFF in 0.01 Hz increments).",
  "Fault history registers hold the fault code in the low byte; the values listed are the manual's fault code list.",
  "Parameters with a 9999 (function off) setting, such as the communication check interval, are listed with their normal increment; the manual does not say how the 9999 setting itself is encoded on the wire, so read the parameter back after setting it from the panel.",
  "Parameters 0-999 sit at 41000 + Pr. number; calibration parameters C2-C25 have their own registers and are not listed. Pr.7/Pr.8 are left out (increment depends on Pr.21 / capacity).",
  "Left out because the sign is not stated: PID deviation 40254.",
  "Several status bits and real-time monitors depend on the unit's manufacturing date (marked Ver.UP in the manual); older units may read 0 there."
 ],
