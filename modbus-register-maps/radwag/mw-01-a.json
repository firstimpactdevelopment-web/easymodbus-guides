 "integration": {
  "summary": "Read input registers (FC04) from offset 0: mass is a low-word-first float at offset 0 and the status bits at offset 5. Write bit 0 or 1 of the Command register (offset 256) to zero or tare, clearing it before repeating.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "Mass"
   },
   {
    "table": "input_register",
    "address": 5,
    "why": "Status (stable, zero, errors)"
   },
   {
    "table": "input_register",
    "address": 4,
    "why": "Displayed unit"
   },
   {
    "table": "input_register",
    "address": 32,
    "why": "Dosing status"
   },
   {
    "table": "holding_register",
    "address": 256,
    "why": "Zero / tare / dosing commands"
   }
  ],
  "enable": "Configure communication with the MwManager PC software under Parameters / Set Communication.",
  "watchdog": null,
  "quirks": [
   "Floats are CDAB (low word first).",
   "Commands act on a bit being set; write 0 first to repeat the same command."
  ],
  "setup": [
   "Use MwManager to set the RS-485 or Ethernet parameters."
  ],
  "gotchas": [
   "Do not reuse a PUE indicator template: the MW-01-A float word order and holding addresses differ."
  ]
