{
  "manufacturer": "Seneca",
  "manufacturer_slug": "seneca",
  "model": "R203 three-phase power analyzer (Ethernet + RS-485)",
  "model_slug": "r203",
  "short_model": "R203",
  "aliases": [
    "R203-1",
    "R203-2",
    "Seneca R203"
  ],
  "equipment_type": "Power meter (three-phase network analyzer)",
  "applies_to": "R203-1 and R203-2 as covered by user manual MI-00591-4-EN.",
  "summary": "The Seneca R203 is a DIN-rail three-phase network analyzer with harmonic analysis, digital I/O and a data logger. It serves Modbus TCP on Ethernet and Modbus RTU on RS-485 from one holding-register table. This map covers identity and status, instantaneous electrical values, THD, fundamentals, 64-bit energy counters, system values and the two pulse counters.",
  "transport": [
    "TCP",
    "RTU"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 38400,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": 502
  },
  "addressing": {
    "convention": "Modicon",
    "note": "Each table row prints the 4x number (40001) beside a 0-based ADDRESS OFFSET (0); the manual's addressing chapter says the offset is the 0-based address. Request the offset on the wire."
  },
  "default_word_order": "ABCD",
  "firmware": null,
  "source": {
    "title": "User Manual R203-1 / R203-2",
    "doc_number": "MI-00591-4-EN (rev 4)",
    "revision_date": "2023-02-16",
    "url": "https://www.seneca.it/media/6849393/mi00591-4-en.pdf",
    "pages": "Modbus conventions pp. 24-28; register table pp. 29-113 (instantaneous pp. 31-34, fundamentals p. 47, energies pp. 104-110, system values and counters pp. 112-113)"
  },
  "notes": [
    "Only function codes 03, 06 and 16 are supported; everything is a holding register.",
    "Every 32-bit row is marked MSW at the lower address and every 64-bit energy is marked MMSW first, so the map uses ABCD. The manual says the two words can be swapped when reading; this map follows the order printed in the tables.",
    "Energy totals are in Wh / VARh / VAh as unsigned or signed 64-bit integers as printed.",
    "Left out: the per-harmonic voltage and current tables, the averaged and min/max values from 41497 upward, and the L1 net active energy (41843), which is typed UNSIGNED64 while its L2/L3 siblings are SIGNED64.",
    "Left out: the per-phase apparent energy rows 41867-41878, whose register name says reactive energy while the description says apparent energy.",
    "Factory network settings: static IP 192.168.90.101, gateway 192.168.90.1, Modbus TCP port 502, TCP station address 1; RS-485 38400 baud 8N1.",
    "RW* registers live in flash and tolerate about 10,000 writes.",
    "Left out: the demand averaging time (45075), typed 32-bit but printed as a single row with no MSW/LSW marking."
  ],
