{
 "manufacturer": "Rishabh Instruments",
 "manufacturer_slug": "rishabh-instruments",
 "model": "RISH Delta Power NX multifunction power meter",
 "model_slug": "rish-delta-power-nx",
 "short_model": "Delta Power NX",
 "aliases": [
  "RISH Delta Power NX",
  "Delta Power NX",
  "RISH Delta Power"
 ],
 "equipment_type": "Power meter",
 "applies_to": "Rishabh RISH Delta Power NX programmable panel meters with RS-485 Modbus RTU, per operating manual AMAN-00IM-0117 Rev. E.",
 "summary": "The RISH Delta Power NX is a 96 x 96 mm multifunction meter that measures voltage, current, power, power factor, frequency and demand (no energy counters) on 1-phase and 3-phase networks, with an RS-485 Modbus RTU port. Every value is an IEEE 754 float in two registers: measurements are input registers (FC04) from 30001, mirrored as holding registers at 40001+, and setup parameters sit at 46003-46085. This map covers the measured values, demands, run/on hours and the setup block.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "The manual prints 3X/4X register numbers. Wire address = number - 30001 (FC04) or - 40001 (FC03/FC16): the Volts 3 example (30005) starts at 00 04 and the system-type example (46003) starts at 17 72 (6002)."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Operating Manual RISH Delta Power NX",
  "doc_number": "AMAN-00IM-0117 Rev. E",
  "revision_date": "2024-02",
  "url": "https://rishabh.co.in/uploads/product/rish-delta-power-nx-72/RISH_Delta_POWER_NX__Manual_REV_E.pdf",
  "pages": "pp. 25-29 (data format, examples, Table 3 3X registers), pp. 31-36 (4X examples, Table 4, explanations, RS485 set-up code)"
 },
 "notes": [
  "The data-format table states IEEE 754 floats, most significant byte first; the Volts 3 example returns 43 5B 41 21 (219.25 V), so ABCD is the default. 46049 can switch to reversed order.",
  "Every 3X value can also be read with FC03 at the number plus 10000; only the 3X copies are listed.",
  "The register table has no unit column, so units are left blank.",
  "Left out: the min/max history from 31301 and the user-assignable registers. Demand time (46015) is printed as seconds in Table 4 and minutes in the explanation, so no unit is given.",
  "Up to 40 parameters (80 registers) per read request."
 ],
