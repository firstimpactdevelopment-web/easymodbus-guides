 "integration": {
  "summary": "Fit the Modbus module, wire D0/D1/Common, and poll input registers with function 04 using low-word-first floats: energy 30103, volume 30303, power 30703, flow 30713 and temperatures 30723/30725/30733, plus their unit codes. Discrete inputs 10001-10016 report meter errors.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 100,
    "why": "Energy unit code"
   },
   {
    "table": "input_register",
    "address": 102,
    "why": "Energy totalizer (float)"
   },
   {
    "table": "input_register",
    "address": 302,
    "why": "Volume (float)"
   },
   {
    "table": "input_register",
    "address": 702,
    "why": "Power (float)"
   },
   {
    "table": "input_register",
    "address": 712,
    "why": "Flow (float)"
   },
   {
    "table": "input_register",
    "address": 722,
    "why": "High temperature"
   },
   {
    "table": "input_register",
    "address": 724,
    "why": "Low temperature"
   },
   {
    "table": "discrete_input",
    "address": 2,
    "why": "Flow error flag"
   }
  ],
  "enable": "The integrator detects the module automatically once it is plugged into a module slot; no setting is needed. Baud rate is set with DIP switch S2 (default 19200), bias and termination with DIP switch S1.",
  "watchdog": null,
  "quirks": [
   "32-bit values are low word first (CDAB) even though the tables say '(h-l)'.",
   "Each float block has a unit register two registers before the value; read it once to know whether energy is kWh, MWh or GJ."
  ],
  "setup": [
   "Defaults: address 1, RTU, 19200 baud, 8 data bits, even parity, 1 stop bit.",
   "Address, parity, stop bits and RTU/ASCII can be changed over Modbus by writing 40017 (password) through the wanted register in one telegram; the module then reboots and is silent for 30-60 s. Do not power it down for 90-120 s.",
   "If settings are changed with Prog531/449 over the optical port, the module must be power-cycled (wait 15 s, power off at least 10 s) before they take effect.",
   "In ASCII mode with no parity the module uses 2 stop bits automatically."
  ],
  "gotchas": [
   "The module needs integrator firmware 3.7 or later.",
   "The module is powered from the integrator's mains supply board or an external 12 VDC / 150 mA supply; without that supply it will not answer."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/sontex/supercal-531-modbus-module",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
