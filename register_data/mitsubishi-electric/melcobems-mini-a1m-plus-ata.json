  "integration": {
    "summary": "Set DIP 7 on for Modbus RTU, pick the slave address on DIP 1-5 and DIP 6 on for 9600 / no parity, then use holding registers 0-3 and 7 for mode, setpoint, fan, vane and on/off, and poll 8-9 for room temperature and fault.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 7,
        "why": "On/off"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Mode"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Setpoint (x10)"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Fan speed"
      },
      {
        "table": "holding_register",
        "address": 8,
        "why": "Room temperature (x10)"
      },
      {
        "table": "holding_register",
        "address": 9,
        "why": "Fault code (0x8000 = none)"
      },
      {
        "table": "holding_register",
        "address": 13,
        "why": "Confirms an air-to-air unit was detected"
      }
    ],
    "enable": "DIP switch 7 on selects Modbus RTU on RS-485 (off = BACnet MS/TP and BACnet IP). Modbus TCP on the Ethernet port came with firmware 4.1.0; the manual says the Ethernet protocol follows the DIP switch setting and needs application mode (DIP switches not all off).",
    "watchdog": null,
    "quirks": [
      "Fault code 0x8000 (decimal register: 8000) means no fault; 0x6999 / 6999 means the gateway cannot talk to the indoor unit.",
      "Fan speed codes skip 1 and 4: 0 Auto, 2 Quiet, 3 Weak, 5 Strong, 6 Very strong.",
      "The i-see mode codes 9-11 are read-only."
    ],
    "setup": [
      "RS-485 A, B and GND must all be connected; shielded cable, daisy chain only.",
      "Factory IP 192.168.92.114, Modbus TCP port 502.",
      "Node address 1..30 on DIP 1-5 (binary); all off = 1."
    ],
    "gotchas": [
      "The gateway detects ATA vs ATW by itself; check register 13 reads 0 before trusting the ATA map."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
