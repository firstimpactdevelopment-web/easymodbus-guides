{
 "manufacturer": "Fronius",
 "manufacturer_slug": "fronius",
 "model": "Fronius Smart Meter via GEN24 / Tauro inverter (SunSpec meter model int+SF)",
 "model_slug": "smart-meter-gen24-sunspec-int-sf",
 "short_model": "Fronius Smart Meter GEN24 int+SF",
 "aliases": [
  "Fronius Smart Meter 63A",
  "Fronius Smart Meter 50kA",
  "Fronius Smart Meter TS",
  "SunSpec meter model 201/202/203"
 ],
 "equipment_type": "Energy meter",
 "applies_to": "A Fronius Smart Meter wired to a GEN24 or Tauro inverter over Modbus RTU and republished by the inverter over Modbus TCP, with SunSpec Model Type set to int+SF (meter model 201/202/203).",
 "summary": "When a Fronius Smart Meter is connected to a GEN24 or Tauro inverter over Modbus RTU, the inverter republishes its readings over Modbus TCP as a SunSpec device at a configurable unit ID (meter address 1 = 200 by default, up to 204). With the int+SF data type the meter appears as SunSpec model 201, 202 or 203 after the common block. This map covers the common block, the 16-bit current, voltage, frequency, power and power-factor values with their scale factors, and the end block.",
 "transport": [
  "TCP",
  "RTU"
 ],
 "defaults": {
  "unit_id": 200,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "1-based",
  "note": "Fronius numbers registers from 1 (SunSpec base register 40001) and tells you to request the register number minus one, so register 40072 is read at wire address 40071. The manual's RTU example reads register 40005 with address bytes 9C 44 (40004)."
 },
 "default_word_order": null,
 "firmware": "Register map archive 1.2.7-2 (Smart_Meter_Register_Map_Int&SF.xlsx); manual 42,0410,2649 rev. 034-28092026.",
 "source": {
  "title": "Fronius GEN24 Modbus TCP & RTU (operating instructions) + Smart_Meter_Register_Map_Int&SF.xlsx",
  "doc_number": "42,0410,2649 (034-28092026)",
  "revision_date": "2026-09",
  "url": "https://www.fronius.com/en/~/downloads/Solar%20Energy/Operating%20Instructions/42,0410,2649.pdf",
  "pages": "PDF English part: printed pp. 68-69 (unit IDs 200-204 for meters, response times), printed pp. 76-77 (Meter address offset), printed p. 112 (Meter Model, meter-location sign table); register table = XLSX 'Complete Map' sheet in https://www.fronius.com/en/~/downloads/Solar%20Energy/Operating%20Instructions/gen24-modbus-api-external-docs.zip"
 },
 "notes": [
  "Register table comes from Fronius' official 'Smart_Meter_Register_Map_Int&SF.xlsx' in gen24-modbus-api-external-docs.zip; behaviour and device IDs come from the GEN24 manual.",
  "Addresses assume SunSpec Model Type = int+SF. With the default float setting the meter shows model 211/212/213 and the register layout is different.",
  "Word order: neither the manual nor the XLSX states the order of 32-bit values, so the 32-bit SID (40001-40002), every acc32 energy counter (TotWhExp/Imp 40108-40123, TotVAhExp/Imp 40125-40140 and the unsupported VArh counters) and the 32-bit event field (40175, documented as hard-coded zero) are left out, together with the energy scale factors.",
  "Phase B/C values are only meaningful on a three-phase meter (model 203).",
  "The sign of W and the meaning of the import/export energy counters depend on the meter location set in the inverter (0 grid, 1 load, 3 external generator, 256-511 sub-load); see the location table in the PDF.",
  "The A, W, VA and VAR scale factors are auto-scaled: read each value block together with its _SF register. Phase B/C power-factor values depend on the grid connection and meter type."
 ],
