 "equipment_type": "Energy meter (DC)",
 "applies_to": "DCT1 300 A and 600 A / 1000 V DC meters, with and without signed data (S1/S2/S3), protocol version 1.1.",
 "summary": "The DCT1 is a DC energy meter with an internal shunt, built for EV charging and DC distribution, with an RS485 Modbus RTU port. Readings are 32-bit integers sent low word first with fixed weights. This map covers voltage, current, power, imported and exported energy and Ah, run-hour counters, shunt temperatures, cable-loss value, serial settings, resets and the device state word.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": null,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Each row gives a 6-digit Modicon number (3xxxxx) and the hex physical address; the hex value goes in the frame. 300001 / 0000h is read at wire address 0. Functions 03 and 04 both read the measurement tables."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "DCT1 Modbus Communication Protocol - Public version",
  "doc_number": "Version 1.1",
  "revision_date": "2024-02-13",
  "url": "https://www.gavazziautomation.com/fileadmin/images/PIM/OTHERSTUFF/COMPRO/DCT1_CPP_%20V1.1_05042024.pdf",
  "pages": "Data format p. 9 (PDF p. 10); tables pp. 10-23 (PDF pp. 11-27)"
 },
 "notes": [
  "Word order: the protocol says INT32, UINT32 and UINT64 are sent least significant word first, bytes MSB first, so 32-bit values here are CDAB.",
  "Left out: the FLOAT block at 0200h (word order for IEEE 754 values is not stated), the INT64 high-resolution energy blocks at 0500h and 0600h (word order is stated only for UINT64, not INT64), the mirror INT32 block at 0100h-0124h, the signed OBIS data maps at 0700h and 0800h, public key, signatures, device tag and serial-number ASCII words, maintenance mode and the cable-loss datalogger.",
  "The ID code (000Bh) and firmware word (0302h) may only be read one word at a time.",
  "Reading an address not in the tables returns an illegal data address exception.",
  "The factory-reset sequence at 4020h (write 0x0A0A then 0xC1A0 within 5 s) is not listed as a register.",
  "Start-up current of run hour counter is printed as Modicon 304360 next to hex 110Bh; the hex address (wire 4363) is used."
 ],
