{
 "manufacturer": "Machine Saver",
 "manufacturer_slug": "machine-saver",
 "model": "TriVibe vibration and temperature sensor (Modbus RTU)",
 "model_slug": "trivibe",
 "short_model": "TriVibe",
 "aliases": [
  "TriVibe",
  "Machine Saver TriVibe"
 ],
 "equipment_type": "Sensor (vibration / temperature)",
 "applies_to": "Machine Saver TriVibe triaxial vibration sensors on RS-485 Modbus RTU, per the 'Modbus Registers Map' page of the Machine Saver online library (revision #12).",
 "summary": "TriVibe is a triaxial vibration and temperature sensor that talks Modbus RTU on RS-485 at 115200 baud. Overall acceleration, velocity and displacement per axis are 32-bit floats, high word first. This map covers system status, run time, temperature, overall vibration values from the external and internal accelerometers, alarm states and the four configurable alarm channels.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": 115200,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "The page states the listed registers are 0-indexed; use the number unchanged on the wire."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "TriVibe - Modbus Registers Map (Machine Saver Knowledge Base)",
  "doc_number": "Revision #12",
  "revision_date": null,
  "url": "https://library.machinesaver.com/books/trivibe/page/modbus-registers",
  "pages": "single web page (register table)"
 },
 "notes": [
  "32-bit values are listed as a HIGH_ register followed by a LOW_ register, and the page says the sensor is big-endian, so the high word is at the lower address (ABCD).",
  "The default slave ID is the last two digits of the sensor's serial number (white label on the side).",
  "Left out: the dynamic data clip registers (49-171), DDR/capture engine controls, detonation and impact alert counters, unique ID words and sensitivity calibration registers - they are for waveform capture or factory use.",
  "TEMPERATURE (31) is divided by 10; the page does not give the unit.",
  "Units for alarm levels follow the alarm type (velocity, acceleration, displacement or temperature) chosen in ALARMn_TYPE.",
  "Alarm configuration writes need the alarm registers unlocked (SYSTEM_CONTROL = 42074) and saved afterwards (42075)."
 ],
