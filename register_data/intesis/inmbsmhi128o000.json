  "integration": {
    "summary": "Enable the indoor units in LinkBoxMB, set the SLK selector (New = Superlink-II, Old = Superlink-I), then poll each unit's 20-register block. Write single registers (FC06) for on/off, mode, setpoint and fan.",
    "minimum_registers": [
