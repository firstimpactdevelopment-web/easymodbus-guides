  "integration": {
    "summary": "Fit the RS-422/485 option, set H5-01..H5-03 and power-cycle, set b1-01 = 2 and b1-02 = 2, then write 0001H/0002H with function 10H and poll 0020H-002DH.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1,
        "why": "Run/stop and reset"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Frequency reference"
      },
      {
        "table": "holding_register",
        "address": 32,
        "why": "Drive status 1"
      },
      {
        "table": "holding_register",
        "address": 33,
        "why": "Fault contents"
      },
      {
        "table": "holding_register",
        "address": 36,
        "why": "Output frequency"
      },
      {
        "table": "holding_register",
        "address": 44,
        "why": "Drive status 2 incl. comm timeout"
      },
      {
        "table": "holding_register",
        "address": 66,
        "why": "Output current (% rated)"
      },
      {
        "table": "holding_register",
        "address": 128,
        "why": "Current fault code"
      }
    ],
    "enable": "H5-01 address (default 1Fh), H5-02 speed (default 3 = 9600), H5-03 parity (default none); cycle power. b1-01 = 2 and b1-02 = 2 hand reference and run to Modbus; H5-12 picks FWD/REV vs RUN/DIR bit meaning and H5-13 the frequency unit.",
    "watchdog": "H5-05 = 1 (default) raises CE when no data arrives for 2 s; H5-04 sets the reaction: 0 ramp, 1 coast, 2 fast-stop, 3 alarm only (default). 002CH bit F flags the timeout.",
    "quirks": [
      "Registers are hex and 0-based.",
      "No 06H function: use 10H for single writes.",
      "Parameter changes take effect in RAM immediately; write 0 to 0900H to keep them over power loss. 0900H is write-only.",
      "Wait at least 10 ms between commands, 50 ms after a parameter write and 3-5 s after Enter."
    ],
    "setup": [
      "MEMOBUS/Modbus needs the optional RS-422/485 interface for the J1000.",
      "Speeds 1200-38400 bps; parity none/even/odd; power-cycle after H5-01..H5-03 changes.",
      "H5-07 = 1 (RTS switched) for RS-485."
    ],
    "gotchas": [
      "With H5-01 = 0 the drive sends no Modbus responses."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
