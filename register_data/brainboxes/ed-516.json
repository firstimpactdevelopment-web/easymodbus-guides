  "integration": {
    "summary": "Switch the module to Modbus TCP on its web page, then read the packed input or output register for a whole-module snapshot, or use the per-channel coils and discrete inputs. All values are single 16-bit registers or bits, so there is no word-order question.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 32,
        "why": "All digital input states in one read"
      },
      {
        "table": "discrete_input",
        "address": 0,
        "why": "First digital input"
      },
      {
        "table": "input_register",
        "address": 0,
        "why": "First input's pulse counter"
      },
      {
        "table": "coil",
        "address": 512,
        "why": "Clear the first counter"
      }
    ],
    "enable": "Open the module's web page (http://<ip>/#/protocol) and change Current Protocol from ASCII to Modbus TCP. The factory IP is 192.168.127.254 unless DHCP assigned one.",
    "watchdog": null,
    "quirks": [
      "Inputs appear three ways (coils from 0x0020, discrete inputs from 0x0000, packed input register 0x0020); they carry the same states.",
      "Counters can be read as input registers or holding registers at the same addresses."
    ],
    "setup": [
      "TCP port defaults to 502, idle timeout 0 (never drop), up to 8 simultaneous connections; all set on the protocol web page."
    ],
    "gotchas": [
      "The module answers ASCII, not Modbus, until the protocol is changed on the web page.",
      "An idle timeout other than 0 closes quiet connections; poll faster than the timeout or leave it at 0."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
