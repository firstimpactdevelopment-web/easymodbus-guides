 "integration": {
  "summary": "Read holding registers (function 03) from 19000: the 122-register block gives volts, amps, power, CosPhi, frequency, energy and THD as big-endian floats. For all-tariff energy totals read 9851 (consumed) and 9863 (delivered).",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 19000,
    "why": "Voltage L1-N"
   },
   {
    "table": "holding_register",
    "address": 19012,
    "why": "Current L1"
   },
   {
    "table": "holding_register",
    "address": 19026,
    "why": "Total real power"
   },
   {
    "table": "holding_register",
    "address": 19034,
    "why": "Total apparent power"
   },
   {
    "table": "holding_register",
    "address": 19050,
    "why": "Frequency"
   },
   {
    "table": "holding_register",
    "address": 9851,
    "why": "Consumed real energy, all tariffs"
   },
   {
    "table": "holding_register",
    "address": 9863,
    "why": "Delivered real energy, all tariffs"
   }
  ],
  "enable": "The list holds the RS-485 Modbus device address at 10180 (read/write). It gives no menu path or other enable step.",
  "watchdog": null,
  "quirks": [
   "Addresses are used as printed (0-based).",
   "Floats are ABCD; add 32768 to an address to get the same value little-endian.",
   "Energy is in Wh and varh, not kWh.",
   "Rotation field (19052) is a float: 1, 0 or -1."
  ],
  "setup": [
   "Use 8 data bits and no parity; the device transmits 2 stop bits (the master may use 1 or 2).",
   "Set the CT/VT ratios at the device so the float values read in primary units.",
   "Write 1 to 9997 / 9998 to clear the real / reactive energy counters."
  ],
  "gotchas": [
   "19068 is tariff 1 only; use 9851 for the consumed total.",
   "Short-format copies elsewhere in the list ignore the CT/VT ratio."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/janitza/umg-104",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
