  "integration": {
    "summary": "With DIP SW1-1 ON (communication), write coil 00001 for on/off and holding registers 40001, 40003 and 40004 for mode and discharge targets; read 30011/30013 for air temperatures and 10001-10026 for unit and outdoor-unit status.",
    "minimum_registers": [
      {
        "table": "coil",
        "address": 0,
        "why": "On/off"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Operation mode"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Cooling discharge target"
      },
      {
        "table": "holding_register",
        "address": 3,
        "why": "Heating discharge target"
      },
      {
        "table": "input_register",
        "address": 12,
        "why": "Supply air temperature"
      },
      {
        "table": "input_register",
        "address": 0,
        "why": "Error code"
      },
      {
        "table": "discrete_input",
        "address": 0,
        "why": "Error status"
      },
      {
        "table": "discrete_input",
        "address": 2,
        "why": "Defrost status"
      }
    ],
    "enable": "DIP SW1-1 ON = controlled by DDC through Modbus or an LG central controller (OFF = contact signal, where Modbus control functions are unavailable). SW1-4 ON selects LG central communication over Modbus.",
    "watchdog": null,
    "quirks": [
      "Operation mode uses 0 = cooling, 2 = fan, 4 = heating.",
      "The error code is a decimal number whose second digit is the module number."
    ],
    "setup": [
      "DDC central communication on RS485 CH4, 2-core 18-16 AWG, up to 1640 ft.",
      "The main module address (1-247, needed with an LG central controller) is set with the Set/ESC buttons and the 7-segment display; the manual does not say whether it is also the Modbus slave ID for a DDC."
    ],
    "gotchas": [
      "Control functions are not available when contact-signal control is selected (SW1-1 OFF)."
    ]
  },
