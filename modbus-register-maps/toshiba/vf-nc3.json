 "integration": {
  "summary": "Set f829 = 1 (Modbus RTU) and f802 to a non-zero address, then power-cycle. Write FA00 = C400H (command and frequency priority + run forward) and the speed in FA01 (0.01 Hz), and poll FD00/FD01/FC90 for speed, status and trip.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 64000,
    "why": "Run/stop and comms priority bits"
   },
   {
    "table": "holding_register",
    "address": 64001,
    "why": "Speed reference, 0.01 Hz"
   },
   {
    "table": "holding_register",
    "address": 64768,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 64769,
    "why": "Running / tripped / alarm status"
   },
   {
    "table": "holding_register",
    "address": 64771,
    "why": "Output current, % of rating"
   },
   {
    "table": "holding_register",
    "address": 64656,
    "why": "Present trip code"
   },
   {
    "table": "holding_register",
    "address": 64657,
    "why": "Pre-alarm bits"
   }
  ],
  "enable": "Set f829 (communication protocol) to 1 = MODBUS-RTU; the factory setting is 0 (Toshiba protocol). Baud f800, parity f801 and the protocol take effect only after a reset or power cycle. Comms run/frequency control is taken by setting FA00 bits 15 and 14, independent of cmod/fmod.",
  "watchdog": "f803 sets a communication time-out (0.0 = off, 0.1-100.0 s); f804 picks alarm only, trip with coast stop or trip with slowdown stop (trip shows err5); f808 sets when it is checked (always, during comms mode, or comms mode and running).",
  "quirks": [
   "The inverter number factory value is 0, which Modbus treats as broadcast with no reply; set 1-247 first.",
   "FA00 bit 13 (fault reset) gets no reply from the drive.",
   "Missing communication numbers inside a multi-word read come back as 8000H.",
   "An input terminal set to function 48/49 (forced local) overrides comms commands and frequency.",
   "Function 03 reads at most 8 consecutive words in one request (direct block read); a plain read is one word."
  ],
  "setup": [
   "f800 baud: 3 = 9600, 4 = 19200 (default), 5 = 38400.",
   "f801 parity: 0 none, 1 even (default), 2 odd.",
   "f802 address 1-247.",
   "f805 adds reply delay for slow RS-485 converters (CPU1 v108 and later).",
   "Power-cycle after changing f800, f801 or f829."
  ],
  "gotchas": [
   "Do not write EEPROM-backed parameters cyclically; the manual rates the EEPROM at about 10,000 writes.",
   "Comms do not answer for about one second after power-up.",
   "f700 = 2 blocks parameter writes over RS-485 (error code 04)."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/toshiba/vf-nc3",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
