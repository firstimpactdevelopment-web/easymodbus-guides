  "integration": {
    "summary": "Read registers 257-260 (wire 256-259) for probe A humidity and temperature as low-word-first floats, add 277 for CO2 if a CO2 probe is fitted, and watch the transmitter status code at 49153.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 256,
        "why": "Probe A relative humidity"
      },
      {
        "table": "holding_register",
        "address": 258,
        "why": "Probe A temperature"
      },
      {
        "table": "holding_register",
        "address": 260,
        "why": "Dew point"
      },
      {
        "table": "holding_register",
        "address": 276,
        "why": "CO2 ppm (CO2 probe)"
      },
      {
        "table": "holding_register",
        "address": 48,
        "why": "Probe A status"
      },
      {
        "table": "holding_register",
        "address": 49152,
        "why": "Transmitter error/warning bits"
      }
    ],
    "enable": "Order Origo10A with the Modbus RTU output option. Serial settings and the Modbus address can be changed in Vaisala Insight PC software over the USB-C service port or through registers 51202-51205.",
    "watchdog": null,
    "quirks": [
      "Floats are low word first (CDAB); choose a word-swapped float format in masters that default to high word first.",
      "Read or write each 32-bit value in one transaction.",
      "Register blocks are per subdevice: add 4096 for probe B and 8192/12288/16384 for modules 1-3."
    ],
    "setup": [
      "Defaults: address 240, 19200 baud, no parity, 8 data bits, 1 stop bit, response delay 20 ms.",
      "Up to 24 transmitters on one RS-485 line, each with a unique address.",
      "Use the RS-485 termination jumper on the component board at the line ends."
    ],
