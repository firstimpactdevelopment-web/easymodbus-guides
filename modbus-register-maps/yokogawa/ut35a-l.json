 "applies_to": "Yokogawa UT35A-L limit controllers with RS-485 (Modbus RTU/ASCII); process monitoring D registers from IM 05P07A01-01EN chapter 12.",
 "summary": "The UT35A-L is a high/low limit controller in Yokogawa's UTAdvanced family that trips an output relay when the PV passes its limit setpoint. Its D registers map one-to-one onto Modbus holding registers. This map covers the process monitoring block: PV, limit setpoint, exceed and relay status, alarms, latches, exceed duration time and PV peak value.",
 "transport": [
  "RTU",
  "ASCII"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "1-based",
  "note": "The manual lists D register numbers; the Modbus reference is the D number with D replaced by 4 (D2003 = 42003) and the wire address is that minus 40001, as printed in the H No. column (07D2H)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "UTAdvanced Series Communication Interface (RS-485, Ethernet) User's Manual",
  "doc_number": "IM 05P07A01-01EN 13th Edition",
  "revision_date": "2026-03",
  "url": "https://web-material3.yokogawa.com/IM05P07A01-01EN.pdf",
  "pages": "D register addressing p. 3-4; serial settings p. 2-1; UT35A-L process data pp. 12-4 to 12-9"
 },
 "notes": [
  "All registers are 16-bit and read-only in this block (D2001-D2100).",
  "PV is sent without its decimal point; the position follows the input's decimal point setting.",
  "Alarm setpoints and setup parameters (D2501 onward) are not included in this map.",
  "Current SP group registers (D2101-D2200) are not included."
 ],
 "integration": {
  "summary": "Use the factory Modbus RTU setting, then read D2001-D2008 for errors, PV, limit setpoint and the exceed/relay status bits.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 2002,
    "why": "PV (D2003)"
   },
   {
    "table": "holding_register",
    "address": 2001,
    "why": "PV input error flags (D2002)"
   },
   {
    "table": "holding_register",
    "address": 2003,
    "why": "Limit setpoint (D2004)"
   },
   {
    "table": "holding_register",
    "address": 2007,
    "why": "Exceeded / output relay (D2008)"
   },
   {
    "table": "holding_register",
    "address": 2010,
    "why": "Alarm status (D2011)"
   },
   {
    "table": "holding_register",
    "address": 2036,
    "why": "Alarm output status (D2037)"
   }
  ],
  "enable": "Set the communication setup parameters PSL, BPS, PRI, STP, DLN and ADR on the keypad (factory protocol is Modbus RTU).",
  "watchdog": null,
  "quirks": [
   "Wire address = D number - 1 (D2003 = 07D2H)."
  ],
  "setup": [
   "Factory defaults: Modbus RTU, 19200 bps, even parity, 1 stop bit, 8 data bits, address 1."
  ],
  "gotchas": [
   "Reading undefined (blank) D registers is not allowed and can upset the unit."
  ]
 },
