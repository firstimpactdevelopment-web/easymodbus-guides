{
 "manufacturer": "E+E Elektronik",
 "manufacturer_slug": "e-e-elektronik",
 "model": "EE260 humidity and temperature probe for meteorology (RS-485 Modbus RTU)",
 "model_slug": "ee260",
 "short_model": "EE260",
 "aliases": [
  "EE260",
  "E+E EE260",
  "EE 260"
 ],
 "equipment_type": "Sensor (humidity / temperature probe)",
 "applies_to": "EE260 meteorological RH/T probe with RS-485 Modbus RTU, per Quick Guide QG_EE260 v1.3 (10-2025).",
 "summary": "The EE260 is an M12-connected humidity and temperature probe for weather stations, with two analogue outputs and an RS-485 Modbus RTU port. It publishes every measured and calculated humidity quantity twice: as 32-bit floats and as scaled 16-bit integers, in metric and US units. This map lists both blocks.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 235,
  "baud": 9600,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "1-based",
  "note": "The quick guide prints a decimal register number that starts at 1 and a hex register address that starts at 0 (1003 = 0x3EA). Send the hex address on the wire: register number minus 1."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "Quick Guide EE260 - Humidity and Temperature Probe for Meteorological Applications",
  "doc_number": "QG_EE260 v1.3 (194928)",
  "revision_date": "2025-10",
  "url": "https://downloads.epluse.com/fileadmin/data/product/ee260/QG_EE260.pdf",
  "pages": "Modbus setup p. 1; register map p. 2 (float and integer tables, footnotes 1-3)"
 },
 "notes": [
  "Float word order comes from E+E application note AN0103 Rev. 1.4 (11/2020), section 7.2, which the quick guide points to: the two byte pairs of a float are swapped (bytes 3-4 first, then 1-2), i.e. low word first (CDAB). The note's write example (1013.25 mbar sent as 49 9A 44 7D) also puts the high word 44 7D second. AN0103: https://downloads.epluse.com/fileadmin/data/product/ee071/AN0103.pdf",
  "Integer scaling: the quick guide's scale column is a divisor (scale 100: a reading of 2550 = 25.5; scale 50: 2550 = 51). The scale field here is the matching multiplier, so the ppm row with divisor 0.1 becomes x10.",
  "Measured values can be read with function 03 or 04 (both are listed); they are filed here as holding registers.",
  "Left out: the slave-address register (0x00) and communication-settings register (0x01). AN0103 says they are write-only and does not fully define the settings byte coding.",
  "Read each float with one request for both registers, so both halves come from the same measurement (AN0103 advice)."
 ],
