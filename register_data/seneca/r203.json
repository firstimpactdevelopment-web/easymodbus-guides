  "integration": {
    "summary": "Read the instantaneous float block 100-187 in one or two requests, and the three-phase 64-bit energy totals at 1878-1905. Status at 17 flags reversed CTs and wiring errors during commissioning.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 100,
        "why": "Line voltage L1-L2"
      },
      {
        "table": "holding_register",
        "address": 106,
        "why": "Current L1"
      },
      {
        "table": "holding_register",
        "address": 168,
        "why": "Total active power"
      },
      {
        "table": "holding_register",
        "address": 174,
        "why": "Total power factor"
      },
      {
        "table": "holding_register",
        "address": 144,
        "why": "Frequency"
      },
      {
        "table": "holding_register",
        "address": 1878,
        "why": "Imported active energy total"
      },
      {
        "table": "holding_register",
        "address": 1882,
        "why": "Exported active energy total"
      },
      {
        "table": "holding_register",
        "address": 17,
        "why": "Status and wiring error flags"
      }
    ],
    "enable": "The Modbus TCP server and RTU slave are active by default. Network and serial parameters are set with the Easy Setup 2 software or the web server.",
    "watchdog": "The manual documents a Modbus TCP connection timeout (default 60 s) that closes idle client connections; no output watchdog is described.",
    "quirks": [
      "Table offsets are the wire addresses; 4x numbers are offset + 40001.",
      "32-bit floats are MSW first and 64-bit energies MMSW first as printed in the tables."
    ],
    "setup": [
      "Factory IP is 192.168.90.101: change it before putting a second unit on the same network.",
      "RS-485 defaults to 38400 baud, 8 data bits, no parity, 1 stop bit; the manual does not print a default RTU station address."
    ],
    "gotchas": [
      "Check status bits 7-12 after wiring: reversed CTs and voltage/current mismatches are flagged there.",
      "Power sign follows the quadrant convention: negative active power means generation."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
