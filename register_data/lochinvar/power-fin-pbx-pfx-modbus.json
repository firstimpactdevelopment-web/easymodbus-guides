  "model": "Power-fin PBX / PFX boilers and water heaters 502-1302, 1501-2001 (Modbus communication board)",
  "model_slug": "power-fin-pbx-pfx-modbus",
  "short_model": "Power-fin PBX/PFX",
  "aliases": [
    "Power-fin",
    "Power-Fin",
