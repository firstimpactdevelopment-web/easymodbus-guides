      "values": null,
      "bits": {
        "0": "OFF1 CONTROL: 1 = ready to operate, 0 = ramp stop",
        "1": "OFF2 CONTROL: 0 = emergency off, coast to stop",
        "2": "OFF3 CONTROL: 0 = emergency stop (2208)",
        "3": "INHIBIT OPERATION: 1 = operation enabled (needs run enable, 1601)",
        "4": "RAMP_OUT_ZERO (ABB DRV FULL only): 0 = force ramp output to zero",
        "5": "RAMP_HOLD: 0 = halt ramping",
        "6": "RAMP_IN_ZERO: 0 = force ramp input to zero",
        "7": "RESET: 0->1 = fault reset (1604 = COMM)",
        "8": "Unused",
        "9": "Unused",
        "10": "REMOTE_CMD (ABB DRV FULL only): 1 = fieldbus control enabled",
        "11": "EXT CTRL LOC: 1 = EXT2, 0 = EXT1 (1102 = COMM)",
        "12": "Unused",
        "13": "Unused",
        "14": "Unused",
