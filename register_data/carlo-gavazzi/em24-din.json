    "EM24DINAV23XISX",
    "EM24 DIN AV9",
    "EM24 DIN AV5"
  ],
  "equipment_type": "Energy meter (energy analyzer)",
  "applies_to": "EM24-DIN three-phase energy analyzers, PFA/PFB (MID) and X models with the RS485 Modbus RTU port (IS option), protocol version 4 revision 0.",
  "summary": "The EM24-DIN is Carlo Gavazzi's three-phase DIN-rail energy analyzer. Models with the IS (RS485) port speak Modbus RTU; measurements are 32-bit integers sent low word first with fixed weights (V x10, A x1000, W x10). This map covers voltages, currents, powers, demand, power factor, frequency, total/partial/phase/tariff energy, hour meter, input and tariff status, identification and the setup, serial and reset registers.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": null,
    "baud": null,
    "parity": "None",
    "data_bits": null,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "Modicon",
    "note": "Each register is printed twice: a 6-digit Modicon number for function 04 (3xxxxx; the same data is readable with function 03 by changing the leading 3 to 4) and the hex 'physical address' that goes in the frame. Wire address = physical address, e.g. 300001 / 0000h is address 0. Configuration rows are also printed as 3xxxxx but are written with function 06, so they are listed here as holding registers."
  },
  "default_word_order": "CDAB",
  "firmware": null,
  "source": {
    "title": "EM24-DIN PFA, PFB & X models Communication Protocol",
    "doc_number": "Version 4 Revision 0",
    "revision_date": "2012-12-03",
    "url": "https://www.gavazziautomation.com/fileadmin/images/PIM/OTHERSTUFF/COMPRO/EM24_IS_CP.pdf",
    "pages": "Tables pp. 8-13 (data format p. 7)"
  },
  "notes": [
    "Word order: the protocol states that within a word bytes are MSB first and that INT32/UINT32/UINT64 values are sent LSW first, so all 32-bit values here are CDAB.",
    "Functions 03 and 04 return the same data; only 11 registers can be read per request.",
    "A register's 'value weight' means raw = value x weight, so V*10 becomes scale 0.1, A*1000 becomes 0.001.",
    "Left out: counters 1-3 (0062h-0066h), whose weight depends on the digital-input format setting (x10, x100 or x1000); display page selectors, user ID codes, input prescaler/format, M-Bus secondary address and the ASCII serial-number letters (1300h-1306h).",
    "The identification code is printed at 300012 / 000Bh, which is also the second word of V L3-L1 (000Ah-000Bh). Read it as a single register; it is listed exactly as the protocol prints it.",
    "Application types: A, B, C, G exist on PFA only; E, F, H on PFB only; all on X models. PFA/PFB support only the 3Pn measuring system.",
    "Reset 3001h clears the total meters (kWh/kvarh import and export totals, phase kWh and all tariff registers); 3002h clears the partial kWh/kvarh.",
    "SFA/SFB 'IS' models documented separately (EM24-IS SFA/SFB protocol) expose a reduced map; see the em24-is-sfa-sfb file."
  ],
  "integration": {
    "summary": "Poll input registers (function 04, or 03) in blocks of at most 11 registers; decode INT32 values low word first and apply the fixed weights. Energy is kWh x10 in 2 registers.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "V L1-N"
      },
      {
        "table": "input_register",
        "address": 12,
        "why": "A L1"
      },
      {
        "table": "input_register",
        "address": 40,
        "why": "W system"
      },
      {
        "table": "input_register",
        "address": 53,
        "why": "PF system"
      },
      {
        "table": "input_register",
        "address": 55,
        "why": "Frequency"
      },
      {
        "table": "input_register",
        "address": 62,
        "why": "kWh(+) total"
      },
      {
        "table": "input_register",
        "address": 92,
        "why": "kWh(-) total"
      }
    ],
    "enable": "Modbus RTU is on the IS (RS485) versions. Set the address and baud rate in the serial port menu or via registers 110Ah/110Bh.",
    "watchdog": null,
    "quirks": [
      "INT32 values are low word first (CDAB).",
      "Max 11 registers per read request.",
      "Parity is fixed to none and stop bits to 1.",
      "Writes use function 06 only (single register); broadcast write to address 0 is allowed."
    ],
    "setup": [
      "Address 1-247, baud 4800 or 9600.",
      "Terminate both bus ends with 120 ohm; above 1000 m or 160 devices use a repeater.",
      "Typical answer time 40 ms, maximum 500 ms; repeat a query 2-3 times before declaring the meter offline."
    ],
    "gotchas": [
      "The display shows EEEE when the value's top word is 7FFFh (overrange).",
      "PFA/PFB models accept only the 3Pn measuring system."
    ]
  },
