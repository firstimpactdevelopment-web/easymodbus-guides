  "applies_to": "One Midea commercial / VRF indoor unit on the XYE bus, user manual v1.11.",
  "summary": "Modbus RTU server that talks to one Midea indoor unit over the XYE bus. Holding registers cover on/off, mode, fan, vane, setpoint, external temperature input, window contact, alarm and error code, return-air temperature, machine mode and the Midea indoor-unit address the gateway controls.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 9600,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 2,
    "tcp_port": null
  },
  "addressing": {
    "convention": "0-based",
    "note": "Tables give a 'protocol address' (base 0) and a 'PLC address' (base 1); the protocol address is the wire address and is used for 'documented'."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "Intesis INMBSMID001I000 User Manual",
    "doc_number": "User Manual v1.11 EN",
