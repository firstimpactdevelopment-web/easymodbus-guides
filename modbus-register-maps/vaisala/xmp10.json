 "equipment_type": "Sensor (humidity and temperature probe)",
 "applies_to": "XMP10 probes ordered with (or switched to) Modbus RTU output, user guide M213279EN-A.",
 "summary": "XMP10 is a small Vaisala HUMICAP humidity and temperature probe that works stand-alone or as the sensing part of a transmitter such as Origo10. With the Modbus option it talks Modbus RTU on RS-485 and can be daisy-chained. This map covers humidity, temperature and the calculated humidity values as floats and scaled integers, error and status registers, filtering, serial settings and the test registers.",
 "transport": [
  "RTU"
 ],
