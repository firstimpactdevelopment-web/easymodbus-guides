{
 "manufacturer": "Mitsubishi Electric",
 "manufacturer_slug": "mitsubishi-electric",
 "model": "Procon MelcoRETAIL MINI controller for Air-To-Air split units",
 "model_slug": "melcoretail-mini",
 "short_model": "MelcoRETAIL MINI",
 "aliases": [
  "MelcoRETAIL MINI",
  "Procon MelcoRETAIL MINI"
 ],
 "equipment_type": "VRF / split AC gateway (retail controller)",
 "applies_to": "Procon MelcoRETAIL MINI on the CN105/CN92 connector of Mitsubishi Electric M, S and P series Air-To-Air indoor units, installation manual v1.0.6, firmware 1.0.3.",
 "summary": "Small Procon controller that plugs into one Mitsubishi Electric split indoor unit and adds retail-style local I/O (status relays, force/lock inputs, analogue mode, fan, setpoint and occupancy inputs) plus a Modbus RTU slave on RS-485. Over Modbus it exposes mode, setpoint, fan, vane, on/off, room temperature and fault code, occupancy-based setpoints, setpoint limits, deadband settings and relay overrides.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Every table prints a 0-based 'Address' next to the Modicon address (40001 = holding 0, 30001 = input 0, 10001 = discrete input 0, 00001 = coil 0). The 0-based address is the wire address."
 },
 "default_word_order": "CDAB",
 "firmware": "1.0.3",
 "source": {
  "title": "Procon MelcoRETAIL MINI Installation Manual",
  "doc_number": "Manual version 1.0.6",
  "revision_date": "2018-02-08",
  "url": "https://library.mitsubishielectric.co.uk/pdf/download_full/3632",
  "pages": "pp. 8-10 (DIP switches), pp. 35-41 (Modbus register tables)"
 },
 "notes": [
  "Input and coil values are mirrored as holding registers (marked read only) for BMSs that only read holding registers.",
  "The four analogue input readings (inputs 11-18) are 32-bit values split over two registers; the manual labels the lower address 'least significant register' and the higher 'most significant register', so they are listed as UINT32 low word first (CDAB). Signedness is not stated; the values are mV (0-10 V inputs) or ohm, so they never reach the sign bit.",
  "Rows that the manual describes as 'temperature value in °C multiplied by 10' use scale 0.1; rows described as 'temperature in °C' (virtual setpoint, deadband, limits, occupancy setpoints, relay offsets) are whole degrees.",
  "Holding 44/45 repeat the names of 18/19 (deadband cooling / heating setpoint) with the same defaults; both are listed as printed.",
  "Discrete input 9 is printed with Modicon number 10000; it sits between 10009 and 10011, so it is listed at address 9.",
  "Holding 20-31 and 47-50 are not printed. Inputs 2, 4, 6 and 7 are not printed; input 9 is printed as 'Unused' and left out.",
  "Fault codes other than 8000 / 0x8000 and 6999 / 0x6999 are the indoor unit's own codes.",
  "Discrete input 8 (DIP 1-6): the register table gives 0 = fixed 9600 / no parity and 1 = software settings, the opposite of the DIP switch section (OFF = software, ON = 9600). Only the switch position (0 = OFF, 1 = ON) is listed."
 ],
