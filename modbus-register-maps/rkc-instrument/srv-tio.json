{
 "manufacturer": "RKC Instrument",
 "manufacturer_slug": "rkc-instrument",
 "model": "SRV module type controller, TIO temperature control module (Modbus RTU)",
 "model_slug": "srv-tio",
 "short_model": "SRV TIO",
 "aliases": [
  "SRV",
  "SRV TIO module",
  "RKC SRV"
 ],
 "equipment_type": "Sensor (modular temperature controller)",
 "applies_to": "RKC SRV two-channel temperature control (TIO) modules, basic and extension type, with Modbus selected.",
 "summary": "The SRV is a DIN-rail modular controller whose TIO modules each run two heat or heat/cool PID loops; extension modules share the bus of a basic module. With DIP switch 6 set to Modbus, each module answers Modbus RTU on RS-485 with channel 1 data at 0000H and channel 2 data at 1000H. This map covers measured values, events, setpoints, PID, manual output, module DI/DO and the key input setup items.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 38400,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "The data map prints each register in hex and decimal; the value is the address sent on the wire. The manual's read example asks for 0000H-0002H, so 0000H is a real register (CH1 measured value)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "SRV Communication Instruction Manual (Module Type Controller)",
  "doc_number": "IMS01P01-E7",
  "revision_date": null,
  "url": "https://flw.com/rkc/pdf/ims01p01e7.pdf",
  "pages": "Settings pp. 14-15; Modbus frames pp. 45-48; decimal handling pp. 49-51; data map pp. 52-62",
  "unofficial": true
 },
 "notes": [
  "RKC's own download center does not offer this manual publicly; the linked copy is the unaltered RKC manual hosted by a US distributor (a distributor stamp on the cover only).",
  "All registers are 16-bit; FFFFH is -1. Values are sent without a decimal point: PV/SV-type items follow the input range (temperature ranges with or without one decimal, or the 0873H setting for voltage/current inputs); other items have the fixed decimals shown (scale).",
  "Items marked (module) exist once per module (channel 1 address only); all others repeat for channel 2 at +1000H.",
  "DI/DO function settings, input error actions, AT bias, differential gaps and event action bits are left out.",
  "Initial-setting items (0870H onward) can only be written in initial setting mode (0860H = 1), which needs control stopped (0030H = 0)."
 ],
 "integration": {
  "summary": "Set DIP switch 6 ON (Modbus) and the rotary address, then read 0000H-0006H for CH1 PV, event state, outputs and SV monitor (1000H onward for CH2). Write the setpoint to 0010H/1010H and start control with 0030H = 1.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "CH1 measured value"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "CH1 event state"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "CH1 heat-side output"
   },
   {
    "table": "holding_register",
    "address": 16,
    "why": "CH1 set value"
   },
   {
    "table": "holding_register",
    "address": 48,
    "why": "Control RUN/STOP"
   },
   {
    "table": "holding_register",
    "address": 4096,
    "why": "CH2 measured value"
   },
   {
    "table": "holding_register",
    "address": 4112,
    "why": "CH2 set value"
   }
  ],
  "enable": "The protocol is set when ordering but can be changed with DIP switch 6 (ON = Modbus). Speed is set by DIP switches 1-2, data/parity by 3-5; changes apply after power-up or a RUN/STOP change.",
  "watchdog": null,
  "quirks": [
   "The Modbus slave address is the rotary switch setting plus 1 (switch 00 = slave 1).",
   "Each module (slave address) carries at most two channels.",
   "With a data error part-way through a multi-write, the values before the error still take effect."
  ],
  "setup": [
   "Factory DIP settings for Modbus: 38400 bps, 8 data bits, no parity, 1 stop bit (fixed). Speeds 2400-38400 bps.",
   "Give the basic TIO module the lowest address when extension modules share its bus. DIP switches 7 and 8 stay OFF."
  ],
  "gotchas": [
   "Wait 30 bit times after a response before the next request.",
   "Do not write to addresses not in the data map; items for functions that are not fitted return no error response."
  ]
 },
