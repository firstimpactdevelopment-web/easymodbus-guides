 ],
 "equipment_type": "Energy meter (DC)",
 "applies_to": "DCM1 300 A / 600 A, 1000 V DC meters (MID, Eichrecht and LNE variants) with RS485 and Ethernet, protocol version 1.11.",
 "summary": "The DCM1 is a two-part DC meter (DCM-D display/meter plus DCM-T transducer) for DC fast chargers, with RS485 Modbus RTU and Modbus TCP. Readings are 32-bit integers sent low word first with fixed weights. This map covers voltage, current, power, energy and Ah counters, run hours, shunt temperatures, serial and Ethernet settings, resets, the device state word and the main OCMF charging-session registers.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": null,
  "stop_bits": 1,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Rows give a 6-digit Modicon number (3xxxxx for function 04, 4xxxxx for function 03) and the hex physical address that goes in the frame. 300001 / 0000h is wire address 0. Functions 03 and 04 return the same data."
 },
 "default_word_order": "CDAB",
 "firmware": "OCMF display/string registers need firmware 1.5.3 onward",
 "source": {
  "title": "DCM1 Modbus Communication Protocol - Public version",
  "doc_number": "Version 1.11",
  "revision_date": "2025-07-30",
  "url": "https://www.gavazziautomation.com/fileadmin/images/PIM/OTHERSTUFF/COMPRO/DCM1_CPP.pdf",
  "pages": "Data format p. 12; tables pp. 14-45 (PDF pp. 15-46); charging-session procedure PDF pp. 35-36"
 },
 "notes": [
  "Word order: the protocol says INT32, UINT32 and UINT64 are sent least significant word first with bytes MSB first, so those values are CDAB here.",
  "Left out: the FLOAT block at 0200h (no word order stated for IEEE 754), INT64 energy blocks at 0500h/0600h and the INT64 UTC timestamp at 7032h (word order stated only for unsigned 64-bit), the mirror block at 0100h, the signed OBIS maps at 0700h/0800h, public keys, signatures, display page filters, MAC address, OCMF identification fields, custom display strings, the OCMF file buffer, maintenance mode and the cable-loss datalogger.",
  "When the DCM-T transducer is unplugged, its values read 0x7FFF or 0x7FFFFFFF and the device state flags it.",
  "The part-number table gives code 1832 for both ULB variants, with hex 0x0728 and 0x0729; check the code on the unit.",
  "The charging-session procedure (sync clock at 7031h/7032h, write 'B' to 7040h, read 7A00h-7A08h, write 'E', read and acknowledge the OCMF file at 7100h-7110h) is described in the source."
 ],
