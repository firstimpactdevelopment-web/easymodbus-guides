 "integration": {
  "summary": "Read holding registers 0x0022-0x0027 for intensity and accumulation as low-word-first floats, 0x002A for precipitation type, and check the status words at 0x0200 and 0x0218.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 34,
    "why": "Precipitation intensity"
   },
   {
    "table": "holding_register",
    "address": 36,
    "why": "Precipitation accumulation"
   },
   {
    "table": "holding_register",
    "address": 42,
    "why": "Precipitation type (SYNOP)"
   },
   {
    "table": "holding_register",
    "address": 512,
    "why": "Device status"
   },
   {
    "table": "holding_register",
    "address": 536,
    "why": "Measurement status"
   }
  ],
  "enable": "Order communication option 1 (Modbus RTU), or set Interface mode to Modbus RTU in Insight PC software (Configure device > Communication), save, and power-cycle the sensor.",
  "watchdog": null,
  "quirks": [
   "Floats and int32 are low word first (CDAB).",
   "Reading a differential accumulation register resets it."
  ],
  "setup": [
   "Option 1 default: RS-485 Modbus RTU, 19200 baud, 8 data bits, even parity, 1 stop bit, address 240.",
   "After changing settings in Insight, the guide has you power-cycle the sensor (cable off for 5 s) before connecting the Modbus client."
  ],
  "gotchas": [
   "Read the test registers at 0x1F00-0x1F06 first to confirm addressing and word order."
  ]
 },
