 "integration": {
  "summary": "Set address, baud and parity on the board DIP switches, set the control mode in the installer menu (code 5309, CONTROL MODES), then write 40001 and the commands: enable only = 40001 0x0001 + 40002 0x0001; enable + rate = 40001 0x0005 + 40002 0x0001 + 40003; rate only = 40001 0x0004 + 40003. Monitor 30009-30016.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Configuration bits"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Enable command"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Rate (%) or setpoint command"
   },
   {
    "table": "input_register",
    "address": 8,
    "why": "Outlet temperature"
   },
   {
    "table": "input_register",
    "address": 11,
    "why": "Modulation rate"
   },
   {
    "table": "input_register",
    "address": 13,
    "why": "Status code"
   },
   {
    "table": "input_register",
    "address": 14,
    "why": "Blocking code"
   },
   {
    "table": "input_register",
    "address": 15,
    "why": "Lockout code"
   }
  ],
  "enable": "Installer menu (hold LEFT SELECT [MENU] 5 s, code 5309) > CONTROL MODES: set BMS to ACTIVE for rate/setpoint control or BMS TSTAT to ACTIVE for remote DHW, and choose BMS TYPE (POWER or SETPOINT). Re-send 40001 before each command.",
  "watchdog": "MODBUS T/O in CONTROL MODES, 5-120 s (default 10 s): BAS-supplied temperatures/0-10 V values must be refreshed within it. Other commands must be refreshed at least every 4 minutes or the boiler reverts to its own inputs.",
  "quirks": [
   "Modicon addressing: 30009 is input register 8 on the wire.",
   "Temperatures are degrees C x 10 with DIP switch 8 OFF.",
   "A setpoint sent through 40003 is the 0-10 V equivalent percentage interpolated from the BMS low/high setpoint parameters, not degrees.",
   "Read the lockout code only when the status code is 40."
  ],
  "setup": [
   "DIP switches 1-7: Modbus address (maximum 127).",
   "DIP switch 8: OFF = Celsius, ON = Fahrenheit.",
   "DIP switch 9: 0 = 9600 baud, 1 = 19200 baud.",
   "DIP switch 10: 0 = no parity with 2 stop bits, 1 = even parity with 1 stop bit.",
   "RTU only; check 120 ohm termination."
  ],
  "gotchas": [
   "Board LED D7: 1 s bright / 1 s dim = normal; 1.5 s on / 0.5 s off = no Modbus traffic; 0.5 s on / 1.5 s off = no burner-control communication."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/lochinvar/lectrus-keb-modbus",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
