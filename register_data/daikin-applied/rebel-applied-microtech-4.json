 "integration": {
  "summary": "Set address/baud/parity on the controller HMI (BMS Communication / Modbus Set-Up), apply and cycle power, then read holding registers with function 03. Check register 261 first to know if values are English or Metric, and use 251/252 for occupancy, 249 for application mode and 138-141 for setpoints.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Discharge air temperature"
   },
   {
    "table": "holding_register",
    "address": 137,
    "why": "Occupied cooling setpoint"
   },
   {
    "table": "holding_register",
    "address": 139,
    "why": "Occupied heating setpoint"
   },
   {
    "table": "holding_register",
    "address": 244,
    "why": "Unit status"
   },
   {
    "table": "holding_register",
    "address": 248,
    "why": "Application mode"
   },
   {
    "table": "holding_register",
    "address": 250,
    "why": "Network occupancy mode"
   },
   {
    "table": "holding_register",
    "address": 157,
    "why": "Highest active alarm"
   },
   {
    "table": "holding_register",
    "address": 263,
    "why": "Local/network control"
   },
   {
    "table": "holding_register",
    "address": 260,
    "why": "English/Metric units flag"
   }
  ],
  "enable": "A Modbus RTU communication module must be fitted. Network address and baud are set only from the HMI (password 2526, BMS Communication / Modbus Set-Up), then 'Apply Changes' and cycle power. Application mode has no effect unless the HMI Control Mode is Auto. Register 264 (Unit Local/Network Control) must read Network (0), set at the HMI, for most network writes to apply.",
  "watchdog": "The module's Com LED Timeout (0-3600 s, default 3 s) only turns the bus LED red when the client stops polling; no control fallback on comms loss is documented. Network temperature/RH inputs fall back to local sensors when the network value is unreliable.",
  "quirks": [
   "Printed register numbers are 1-based without the 4xxxx prefix: subtract 1 for the wire address.",
   "All values follow the English/Metric setting (register 261); the multiplier stays the same.",
   "Writable registers are shown as 'W' in the document but are readable too.",
   "Enable registers 162/164/166 use -1 as 'not network-controlled'."
  ],
  "setup": [
   "Address 1-247 (default 1), baud 4800/9600/19200/38400 (default 38400), parity Even/Odd/None (default None), two stop bits Yes/No (default Yes).",
   "Load resistor (termination) is a software setting on the module (default No); set Yes at the ends of the segment.",
   "Response delay default 5 ms; increase only for slow clients.",
   "Network parameters revert to defaults after a controller software field upgrade."
  ],
  "gotchas": [
   "Writing Emergency Override (register 255) = Off stops the unit until it is written back to Normal.",
   "Current State (252) only acts when Occupancy Mode (251) is Auto.",
   "Many points exist only with options (power monitoring, refrigerant monitoring, energy recovery, expansion module)."
  ]
 },
