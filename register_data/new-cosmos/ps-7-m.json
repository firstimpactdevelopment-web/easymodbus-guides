  "integration": {
    "summary": "Read 41039-41040 for concentration and full-scale code and 40516 for alarms and faults; check 40011 once for the unit. Write AL set values and modes at 40051-40055 when needed.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1038,
        "why": "Gas concentration"
      },
      {
        "table": "holding_register",
        "address": 1039,
        "why": "Full-scale code"
      },
      {
        "table": "holding_register",
        "address": 515,
        "why": "Status: alarms, faults, sign"
      },
      {
        "table": "holding_register",
        "address": 10,
        "why": "Measurement unit code"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Pump flow rate"
      }
    ],
    "enable": "Turn the base unit power switch OFF, select RS485 or ETHERNET with the mode DIP switch and set the unit ID on the address DIP switches (binary, 1-254), then switch the power back on.",
    "watchdog": null,
    "quirks": [
      "Concentration has no sign in the register itself; read status bit 15.",
      "Use relative (0-based) addresses on the wire: 41039 -> 1038."
    ],
    "setup": [
      "RS-485: up to 32 devices, 1.2 km at 9600 baud, built-in 120 ohm terminator switchable.",
      "Modbus TCP: fixed port 502."
    ],
    "gotchas": [
      "Reading or writing at 41321 and above returns an illegal address error."
    ]
  },
