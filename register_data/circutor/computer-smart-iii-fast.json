  "integration": {
    "summary": "Read the measurement block from 0x0000 with function 04, keeping each frame at or under 80 bytes (at most 37 registers per read). Values are 32-bit integers, high word first; currents are in mA.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 80,
        "why": "Three-phase current"
      },
      {
        "table": "input_register",
        "address": 90,
        "why": "Three-phase apparent power"
      },
      {
        "table": "input_register",
        "address": 92,
        "why": "Three-phase reactive power consumed"
      },
      {
        "table": "input_register",
        "address": 104,
        "why": "Frequency (Hz x10)"
      },
      {
        "table": "input_register",
        "address": 136,
        "why": "Active energy consumed (kWh)"
      },
      {
        "table": "input_register",
        "address": 1536,
        "why": "Which capacitor stages are switched in"
      },
      {
        "table": "input_register",
        "address": 114,
        "why": "Leakage current"
      }
    ],
    "enable": "Set the peripheral number, speed, parity and stop bits in the RS-485 communications setup screen or with registers 0x1071-0x1075.",
    "watchdog": null,
    "quirks": [
      "Frames longer than 80 bytes in either direction are rejected, so split large reads.",
      "Energies are a whole-unit register plus a remainder register; combine both.",
      "Digital output bits in the output status word read 1 when the output is OFF."
    ],
    "setup": [
      "Defaults: peripheral 1, 19200 baud, no parity, 8 data bits, 1 stop bit.",
      "Only 9600 and 19200 baud are offered on the RS-485 Modbus port."
    ],
    "gotchas": [
      "Writing the stage status registers (0x1110-0x111B) forces capacitor stages on or off; return them to Auto (0) afterwards."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
