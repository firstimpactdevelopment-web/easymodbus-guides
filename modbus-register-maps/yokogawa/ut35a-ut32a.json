{
 "manufacturer": "Yokogawa",
 "manufacturer_slug": "yokogawa",
 "model": "UTAdvanced UT35A / UT32A digital indicating controller",
 "model_slug": "ut35a-ut32a",
 "short_model": "UT35A/UT32A",
 "aliases": [
  "UT35A",
  "UT32A",
  "UT35A/MDL",
  "UT32A/MDL"
 ],
 "equipment_type": "Sensor (digital indicating temperature controller)",
 "applies_to": "Yokogawa UT35A and UT32A single-loop controllers with RS-485 or Ethernet communication; D-register map from IM 05P07A01-01EN chapter 8 (UT32A-D loop 2 and UP35A/UP32A program items excluded).",
 "summary": "The UT35A and UT32A are single-loop PID controllers in Yokogawa's UTAdvanced family. Their data live in D registers that map one-to-one onto Modbus holding registers, reachable over RS-485 (Modbus RTU/ASCII) or, on Ethernet models, Modbus/TCP. This map covers the process data block (PV, setpoint, outputs, status words), the current SP/PID group and the operation-mode switches.",
 "transport": [
  "RTU",
  "ASCII",
  "TCP"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "1-based",
  "note": "The manual lists D register numbers (D2003). The Modbus reference number replaces the D with 4 (42003) and the wire address is that minus 40001, printed in the table's H No. column (D2003 = 07D2H)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "UTAdvanced Series Communication Interface (RS-485, Ethernet) User's Manual",
  "doc_number": "IM 05P07A01-01EN 13th Edition",
  "revision_date": "2026-03",
  "url": "https://web-material3.yokogawa.com/IM05P07A01-01EN.pdf",
  "pages": "D register addressing p. 3-4; serial settings section 2.1 (p. 2-1); D register tables pp. 8-6 to 8-21"
 },
 "notes": [
  "All registers are 16-bit. Values are sent without their decimal point: PV/SP-type values follow the input's decimal point setting, percentages carry one decimal (scale 0.1).",
  "D2001-D2100 are read-only; registers marked as group items (D2101-D2135) act on the SP/PID group currently in use.",
  "UT32A-D loop-2, UP35A/UP32A program-pattern and GREEN-series compatible (D0001-D2000) registers are not included.",
  "Only part of the D-register space is listed; setup and operation parameter areas (D2501 onward) are left out.",
  "Up to 100 registers per read and 50 per multi-register write; blank (undefined) addresses must not be read or written.",
  "Modbus/TCP applies only to UT35A units with the Ethernet option; the UT32A is serial only."
 ],
 "integration": {
  "summary": "Set protocol MBRTU (factory default) and an address, then read D2001-D2012 in one block for status, PV, SP and output, write the target setpoint to D2101 and switch AUTO/MAN and RUN/STOP with D2301 and D2304.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 2002,
    "why": "PV (D2003)"
   },
   {
    "table": "holding_register",
    "address": 2003,
    "why": "Control setpoint (D2004)"
   },
   {
    "table": "holding_register",
    "address": 2004,
    "why": "Control output (D2005)"
   },
   {
    "table": "holding_register",
    "address": 2007,
    "why": "Operation mode status (D2008)"
   },
   {
    "table": "holding_register",
    "address": 2010,
    "why": "Alarm status (D2011)"
   },
   {
    "table": "holding_register",
    "address": 2100,
    "why": "Target setpoint (D2101)"
   },
   {
    "table": "holding_register",
    "address": 2300,
    "why": "AUTO/MAN (D2301)"
   },
   {
    "table": "holding_register",
    "address": 2303,
    "why": "RUN/STOP (D2304)"
   }
  ],
  "enable": "Set the communication setup parameters PSL (protocol, MBRTU or MBASC), BPS, PRI, STP, DLN and ADR on the keypad. Ethernet models use Modbus/TCP on port 502 by default.",
  "watchdog": null,
  "quirks": [
   "Address D register n at wire address n-1 (D2101 = 0834H).",
   "Writing values with a decimal point: send the integer without it (50.0 with one decimal place = 500)."
  ],
  "setup": [
   "Factory defaults: Modbus RTU, 19200 bps, even parity, 1 stop bit, 8 data bits, address 1. Speeds 600-38400 bps (38400 only on suffix types that allow it)."
  ],
  "gotchas": [
   "Available registers depend on the suffix code and parameter settings; check the model before writing."
  ]
 },
