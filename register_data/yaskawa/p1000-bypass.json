  "integration": {
    "summary": "Set Z3-01 = 0 (Modbus), Z3-02 address, Z3-03/Z3-04 line settings and restart. Set Z1-07 = 2 and Z1-08 = 2 to take speed and run from the bypass serial port, then write 8401H (frequency) and 8400H (run bit 0, AUTO select bit 10, BYPASS select bit 12); poll 0020H, 0021H, 0024H and UB-09 (8788H).",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 33792,
        "why": "Bypass command 8400H"
      },
      {
        "table": "holding_register",
        "address": 33793,
        "why": "Bypass frequency reference 8401H"
      },
      {
        "table": "holding_register",
        "address": 32,
        "why": "Drive status 1"
      },
      {
        "table": "holding_register",
        "address": 33,
        "why": "Fault contents 1"
      },
      {
        "table": "holding_register",
        "address": 36,
        "why": "Output frequency"
      },
      {
        "table": "holding_register",
        "address": 34696,
        "why": "Bypass current fault UB-09"
      },
      {
        "table": "holding_register",
        "address": 49,
        "why": "DC bus voltage"
      }
    ],
    "enable": "Set Z3-01 = 0, then Z1-07 = 2 [Bypass Serial] for the speed reference and Z1-08 = 2 [Bypass Serial] for the AUTO run command. Set Z3-12 = 1 if the bypass digital inputs are to be driven from 8402H.",
    "watchdog": "Z3-11 enables comm-fault detection and Z3-06 sets the timeout (default 2.0 s); Z3-05 sets the action (see notes).",
    "quirks": [
      "8400H bits are OR-ed with the physical bypass inputs; clear them to release a command.",
      "There is no function 06H; write single registers with 10H."
    ],
    "setup": [
