  "integration": {
    "summary": "Read holding registers 1-4 for RH and temperature (CDAB floats), plus any calculated parameter you need from 7-66. Write the process pressure to 769 for correct calculated values.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "Relative humidity"
      },
      {
        "table": "holding_register",
        "address": 2,
