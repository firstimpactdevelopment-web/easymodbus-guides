 "integration": {
  "summary": "Read holding registers 1-4 (wire 0-3) for RH and temperature as low-word-first floats, or 257-258 as integers divided by 10. Check register 513 and the error code at 516 for faults.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Relative humidity"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Temperature"
   },
   {
    "table": "holding_register",
    "address": 8,
    "why": "Dew/frost point"
   },
   {
    "table": "holding_register",
    "address": 26,
    "why": "Enthalpy"
   },
   {
    "table": "holding_register",
    "address": 512,
    "why": "Error status"
   },
   {
    "table": "holding_register",
    "address": 515,
    "why": "Error code"
   }
  ],
  "enable": "Order the probe with Modbus RTU output (output code M), or from the serial command interface give smode modbus and then reset or power cycle the probe. Serial setting changes also need a power cycle before they apply.",
  "watchdog": null,
  "quirks": [
   "Floats are low word first (CDAB); choose a word-swapped float format in masters that default to high word first.",
   "Read or write each 32-bit value in one transaction."
  ],
  "setup": [
   "Defaults: address 240, 19200 baud, no parity, 8 data bits, 2 stop bits, response delay 0.",
   "Up to 32 probes per RS-485 line at 19200 bps or lower; give each a unique address with Insight.",
   "Terminate the last device when the line is over 100 m.",
   "Allow up to 2 s after power-up before the first request."
  ],
  "gotchas": [
   "Read the test registers 7937-7939 first to confirm addressing and float format; a wrong float setting can still give plausible-looking numbers."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/vaisala/xmp10",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
