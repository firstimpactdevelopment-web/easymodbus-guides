 "aliases": [
  "HMM170",
  "HUMICAP HMM170"
 ],
 "equipment_type": "Sensor (humidity and temperature module)",
 "applies_to": "HMM170 OEM humidity and temperature module with the Modbus RTU interface (user guide M212259EN-D).",
 "summary": "The HMM170 is a Vaisala HUMICAP OEM humidity module for integration into environmental chambers and other harsh conditions. It is a Modbus RTU slave on RS-485. This map covers humidity, temperature and all calculated parameters, status registers, compensation, purge, filtering, serial settings and test registers.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 240,
  "baud": 19200,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 2,
  "tcp_port": null
 },
 "addressing": {
  "convention": "1-based",
  "note": "The guide numbers registers in decimal starting at 1 and also prints the 0-based hex address used in the request; register number 1 is address 0x0000 on the wire."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "HMM170 User Guide",
  "doc_number": "M212259EN-D",
  "revision_date": "2021-06",
  "url": "https://docs.vaisala.com/r/M212259EN-D/en-US",
  "pages": "Appendix A Modbus reference, pp. 32-45"
 },
 "notes": [
  "All registers are holding registers: read with function 03, write with function 16.",
  "32-bit floats and 32-bit integers put the least significant word at the listed register (CDAB). The guide's data-encoding section covers both formats and its worked read example confirms the order.",
  "Unavailable data reads as quiet NaN (float) or 0x8000 (16-bit integer) rather than an exception.",
  "Left out: the integer water activity register 271, because the guide gives no scale for it.",
  "Left out: probe heating on/off (1289) and the 24-byte user information text (2561 onward).",
  "Register 513 reads 0 when an error is active and 1 when there is none, as printed in the guide.",
  "The T and Td/f measurement status registers (521, 522) share a table cell with the RH status bit list in the guide, so their bits are not repeated here."
 ],
