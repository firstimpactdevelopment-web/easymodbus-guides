{
  "manufacturer": "ASCO",
  "manufacturer_slug": "asco",
  "model": "7000 Series Group 5 transfer switch controller (Modbus RTU)",
  "model_slug": "7000-series-group-5",
  "short_model": "ASCO Group 5",
  "aliases": [
    "ASCO 7000 Group 5",
    "Group 5 Controller",
    "381339-221"
  ],
  "equipment_type": "Transfer switch controller",
  "applies_to": "ASCO 7000 Series Group 5 controller, firmware 607540-023 (some bits 607540-033); document 381339-221 revision I. Power Manager Xp registers in the same document are not included.",
  "summary": "The Group 5 controller runs ASCO 7000 Series automatic transfer switches. Through its Modbus RTU interface it reports normal and emergency source voltages and frequencies, switch position, source availability, phase rotation, alarms, the transfer-sequence state with its timer value, active features and the event log.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": null,
    "baud": null,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "Modicon",
    "note": "The map says the address sent is the map address minus 40001, and the supported-address list (11-54, 100) matches the map's defined block 40012-40055 and 40101. The read example sends start address 0x0010 and gets the three normal voltages, which the map lists from 40017. The example prose names registers one lower (40016), but its hex addresses follow the map rule."
  },
  "default_word_order": null,
  "firmware": "607540-023 (bits marked 607540-033 need that version)",
  "source": {
    "title": "Connectivity to the ASCO Power Manager Xp & 7000 Series Group 5 Controller via Modbus",
    "doc_number": "381339-221 I",
    "revision_date": null,
    "url": "https://ccontrols.com/support/dp/Asco%207000%20Group%205.pdf",
    "unofficial": true,
    "pages": "p. 1 (format), pp. 10-11 (Group 5 function codes), pp. 18-22 (Group 5 register map and lookup tables)"
  },
  "notes": [
    "Host: copy hosted by Contemporary Controls. Schneider Electric lists a newer revision (381339-221Q, document ASC-TS-UM-7000-PWRMNMDBS) on se.com, but the download is behind a bot check and was not opened; differences from revision I are unknown.",
    "Readable addresses (decimal, wire): 11-54, 100, 105-173; at most 12 registers per FC03 read. Writable with FC06: 44 and 101-173 (time delays and settings, not listed here because their table is not in this revision's map).",
    "All values are 16-bit. Voltages are whole volts, frequencies Hz x 100, phase shift degrees x 10 (signed).",
    "The Power Manager Xp section of the same document (meter registers, LO/HO kWh words) is a separate device and is not part of this map."
  ],
  "integration": {
    "summary": "Read 40015 (switch position and source availability), 40017-40024 (normal and emergency voltages), 40013/40014 (frequencies), 40040 (alarms) and 40041/40042 (transfer state and timer) with FC03, max 12 registers per read.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 14,
        "why": "Switch position and source availability"
      },
      {
        "table": "holding_register",
        "address": 16,
        "why": "Normal voltage A-B"
      },
      {
        "table": "holding_register",
        "address": 20,
        "why": "Emergency voltage A-B"
      },
      {
        "table": "holding_register",
        "address": 12,
        "why": "Normal frequency"
      },
      {
        "table": "holding_register",
        "address": 39,
        "why": "Alarm / lockout / engine running"
      },
      {
        "table": "holding_register",
        "address": 40,
        "why": "Transfer sequence state"
      }
    ],
    "enable": "Address and baud rate are set on the Group 5 controller; this document does not describe how (it refers to the Group 5 Controller User's Guide 381333-126).",
    "watchdog": null,
    "quirks": [
      "Maximum 12 registers per read; larger reads return an exception.",
      "RTU only, 8 data bits, no parity, 1 stop bit; replies within 50 ms."
    ],
    "setup": [
      "Maximum 64 bytes per packet."
    ],
    "gotchas": [
      "Wire addresses 0-10 and 55-99 (40001-40011, 40056-40100) are undefined; avoid reads that span them."
    ]
  },
