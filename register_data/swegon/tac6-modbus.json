  "integration": {
    "summary": "Connect over Modbus TCP (port 502, unit ID 1). Set 40200 = 1 and write 0-3 to 40201 for stop/I/II/III, or set 40200 = 3 and write supply/exhaust flows to 40204/40205. Read 40052/40053 for mode and speed, 40155-40162 for temperatures and 40300-40304 for alarms; write 1 to 40250 to reset alarms.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 199,
        "why": "Control master"
      },
      {
        "table": "holding_register",
        "address": 200,
        "why": "Speed via Modbus"
      },
      {
        "table": "holding_register",
        "address": 51,
        "why": "Current working mode"
      },
      {
        "table": "holding_register",
        "address": 52,
        "why": "Current speed"
      },
      {
        "table": "holding_register",
        "address": 154,
        "why": "Temperature T1"
      },
      {
        "table": "holding_register",
        "address": 158,
        "why": "Temperature T5"
      },
      {
        "table": "holding_register",
        "address": 299,
        "why": "Alarm bitmap 1"
      },
      {
        "table": "holding_register",
        "address": 249,
        "why": "Alarm reset"
      }
    ],
    "enable": "Fit the TAC6 Modbus satellite (SAT WIFI-ETHERNET for Modbus TCP) and set 40200 to give Modbus control of the speed or airflows.",
    "watchdog": null,
    "quirks": [
      "Only holding registers are used (FC 03, 06, 16).",
      "All registers are signed 16-bit.",
      "32-bit values are low word first (CDAB)."
    ],
    "setup": [
      "Use unit ID 1 in Modbus TCP requests; the SAT WIFI-ETHERNET accepts only that address because it is not a gateway to RTU.",
      "Default satellite IP is 192.168.1.1/255.255.255.0; set DHCP or a fixed IP from the TACtouch advanced menu or TACsimulator, then reset the control board.",
      "At most 3 TCP clients can connect at once."
    ],
    "gotchas": [
      "Writing EEPROM-backed setup values often wears out the memory."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
