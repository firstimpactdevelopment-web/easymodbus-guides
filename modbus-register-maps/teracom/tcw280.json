  "data_bits": null,
  "stop_bits": null,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "0-based",
  "note": "The address table prints PDU (wire) addresses in decimal. The manual's example frames use them directly (coil 100 = 0x0064, holding register 500 = 0x01F4), so no offset is applied."
 },
