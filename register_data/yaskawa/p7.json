  "integration": {
    "summary": "Set H5-01..H5-03 at the keypad and power-cycle, set b1-01 = 2 and b1-02 = 2, then write 0001H and 0002H with function 10H and poll 0020H-002DH for status and faults.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1,
        "why": "Run/stop and fault reset"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Frequency reference"
      },
      {
        "table": "holding_register",
        "address": 32,
        "why": "Drive status"
      },
      {
        "table": "holding_register",
        "address": 33,
        "why": "Fault details"
      },
      {
        "table": "holding_register",
        "address": 36,
        "why": "Output frequency"
      },
      {
        "table": "holding_register",
        "address": 44,
        "why": "Drive status 2 incl. comm timeout"
      },
      {
        "table": "holding_register",
        "address": 56,
        "why": "PI feedback level"
      }
    ],
    "enable": "Set H5-01 address (default 1F hex), H5-02 baud (default 3 = 9600) and H5-03 parity (default none), then cycle power. b1-01 = 2 and b1-02 = 2 hand the reference and run command to Modbus. Status reads, parameter access, fault reset and multi-function inputs work regardless of b1-01/b1-02.",
    "watchdog": "H5-05 = 1 (default) enables CE detection after H5-09 seconds (default 2.0 s) without messages; H5-04 sets the reaction: 0 ramp, 1 coast, 2 fast-stop, 3 alarm only (default). 002CH bit F shows a comm time-out.",
    "quirks": [
      "Registers are hex and 0-based.",
      "Function codes 03H, 06H, 08H and 10H; 1 to 16 registers per message.",
      "Parameter writes need 0 written to 0900H (EEPROM + RAM) or 0910H (RAM only); EEPROM write life is 100,000 cycles.",
      "Network multi-function inputs are ORed with terminals S3-S7.",
      "Write 0 to unused bits and never write reserved registers."
    ],
    "setup": [
      "Terminals S+, S-, R+, R-; for RS-485 jumper S+ to R+ and S- to R-. Up to 31 drives.",
      "Termination: S1-1 ON only at the end of the line.",
      "8 data bits, 1 stop bit; 1200-19200 baud; parity none/even/odd.",
      "Power-cycle after changing H5-01..H5-03."
    ],
    "gotchas": [
      "Parameters cannot be written while running (error 22H) or during undervoltage (23H)."
    ]
  },
