  "integration": {
    "summary": "Read temperatures CH1-CH8 at registers 1-8 (signed, x0.01 °C) and check the validity bits at register 9 before trusting a value.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1,
        "why": "Temperature CH1"
      },
      {
        "table": "holding_register",
