{
  "manufacturer": "ASCO",
  "manufacturer_slug": "asco",
  "model": "Power Manager Xp power meter for transfer switches (Modbus RTU)",
  "model_slug": "power-manager-xp",
  "short_model": "Power Manager Xp",
  "aliases": [
    "ASCO Power Manager Xp",
    "Power Manager Xp",
    "381339-221"
  ],
  "equipment_type": "Power meter (transfer switch metering)",
  "applies_to": "ASCO Power Manager Xp, firmware FS611842-006 (some registers AS629262-004); document 381339-221 revision I.",
  "summary": "The Power Manager Xp is ASCO's metering module for 7000 Series transfer switches. Over Modbus RTU it reports per-phase voltage, current, kW, kvar, kVA and power factor, frequency, demand, separate energy totals for the normal and emergency sources, digital I/O and switch position, all as holding registers.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": null,
    "baud": null,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "Modicon",
    "note": "ASCO says the address sent is the map address minus 40001. The read example asks for IA-IAVE at 40021 with start address 0x0014 (20)."
  },
  "default_word_order": "CDAB",
  "firmware": "FS611842-006; AS629262-004 for the nominal-rating and later registers",
  "source": {
    "title": "Connectivity to the ASCO Power Manager Xp & 7000 Series Group 5 Controller via Modbus",
    "doc_number": "381339-221 I",
    "revision_date": null,
    "url": "https://ccontrols.com/support/dp/Asco%207000%20Group%205.pdf",
    "unofficial": true,
    "pages": "pp. 4-9 (Power Manager Xp function codes and configuration registers), pp. 12-17 (register map)"
  },
  "notes": [
    "Host: copy hosted by Contemporary Controls. Schneider Electric lists a newer revision (381339-221Q) on se.com behind a bot check; it was not opened.",
    "Energy registers are 32-bit pairs printed as 'LO word' then 'HO word' with a signed range (-1,999,999,999 to +1,999,999,999), so they are INT32, low word first (CDAB).",
    "Power factor is published as (value) x 100; frequency as Hz x 100.",
    "Readable addresses (wire, decimal): 11-26, 31-48, 51-64, 71-84, 87-94, 96-125, 127-128, 130-137, 149-159.",
    "Duplicate copies of total kW/kvar/kVA/PF/frequency at 40087-40101 and 40130-40132 and the configuration block 40200-40215 (system type, PT/CT ratios, port settings) are mostly not listed; their coding is described on pp. 6-8 of the document.",
    "Switch position register 40096 is printed as '0:norm & 1:emer.' for main and auxiliary; the bit layout is not stated."
  ],
  "integration": {
    "summary": "Read 40011-40026 for voltage and current, 40031-40046 for power and power factor, and the LO/HO energy pairs from 40051 (normal source) and 40071 (emergency source).",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 17,
        "why": "VL AVE average L-L voltage"
      },
      {
        "table": "holding_register",
        "address": 23,
        "why": "Average current"
      },
      {
        "table": "holding_register",
        "address": 33,
        "why": "Total kW"
      },
      {
        "table": "holding_register",
        "address": 41,
        "why": "Total power factor"
      },
      {
        "table": "holding_register",
        "address": 50,
        "why": "Normal kWh import"
      },
      {
        "table": "holding_register",
        "address": 92,
        "why": "Frequency"
      }
    ],
    "enable": "The 485 port (J1) protocol, baud rate and address are configuration registers 40208-40210 (writable with FC06).",
    "watchdog": null,
    "quirks": [
      "RTU only, 8 data bits, no parity, 1 stop bit; maximum 64 bytes per packet.",
      "Energy pairs are low word first."
    ],
    "setup": [
      "Device address 1-247; 0 is broadcast."
    ],
    "gotchas": [
      "Only the listed address ranges are supported; keep block reads inside them (e.g. skip undefined 40027-40030)."
    ]
  },
