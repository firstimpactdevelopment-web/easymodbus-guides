{
 "manufacturer": "Airzone",
 "manufacturer_slug": "airzone",
 "model": "Aidoo Pro Modbus control for direct-expansion (split / VRF) air conditioners",
 "model_slug": "aidoo-pro-modbus-dx",
 "short_model": "Aidoo Pro Modbus DX",
 "aliases": [
  "Aidoo Pro",
  "Aidoo Pro Modbus",
  "Airzone Aidoo Modbus"
 ],
 "equipment_type": "VRF / split AC gateway",
 "applies_to": "Airzone Aidoo Pro units configured for Modbus output and connected to a direct-expansion AC unit; register table 'Registers for Direct Expansion units' of the Aidoo - Modbus integration manual (v. 201). The air-to-water table in the same manual is not covered.",
 "summary": "Aidoo Pro is a small Airzone interface for an air-conditioning unit that can serve Modbus RTU on RS-485 to a BMS. The direct-expansion map gives on/off, mode, setpoint, fan, louvres, room and refrigerant-circuit temperatures, pressures, current, error codes and 32-bit energy counters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "Registers are numbered from 0 (unit on/off is register 0) and the command description puts this number in the 'register address' field, so the printed number is the wire address."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "Integration Manual Aidoo - Modbus",
  "doc_number": "v. 201",
  "revision_date": null,
  "url": "https://thermosilesia.pl/assets/default/system_object_files/4bc5a150b45a2a7401add97664eff2aa.pdf",
  "pages": "pp. 4-13 (serial settings, function codes, frames, direct-expansion registers)",
  "unofficial": true
 },
 "notes": [
  "Distributor copy: airzonecontrol.com answers automated requests with a bot check (not bypassed) and no other Airzone-hosted copy was found; this multilingual PDF carries Airzone's own layout and address.",
  "32-bit energy counters span two registers with the low word first: the manual's worked example reads (1) 0x1215 and (2) 0x0001 as 0x00011215 = 70165 kWh, so CDAB.",
  "The manual does not state signed or unsigned for 16-bit values; the remaining registers are listed as UINT16 because their normal values are not negative.",
  "The Modbus slave address is set in the Airzone Cloud app (Airtools > Integration > Modbus) or via register 56.",
  "Function codes 03, 04, 06 and 16 are supported.",
  "External (outdoor) temperature (35) and outdoor heat exchanger temperature (39) are left out: these routinely go below 0 °C and the manual gives no sign convention for 16-bit values."
 ],
