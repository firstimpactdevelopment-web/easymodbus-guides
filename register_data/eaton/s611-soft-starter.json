  "integration": {
    "summary": "Poll 300 for run/bypass/fault, 301-305 for current, 306-309 for voltage and 324 for trip bits. Start the motor by setting 400 bit 2 (permissive) and bit 0 (run); bit 3 resets a fault. Set 443-445 so the starter stops or faults when the network drops.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 299,
        "why": "Motor status bits"
      },
      {
        "table": "holding_register",
        "address": 304,
        "why": "Average current (scale by 301)"
      },
      {
        "table": "holding_register",
        "address": 300,
        "why": "Current scale factor"
      },
      {
        "table": "holding_register",
        "address": 308,
        "why": "Average voltage"
      },
      {
        "table": "holding_register",
        "address": 313,
        "why": "Thermal memory"
      },
      {
        "table": "holding_register",
        "address": 323,
        "why": "Trip reason bits"
      },
      {
        "table": "holding_register",
        "address": 399,
        "why": "Run / permissive / reset"
      }
    ],
    "enable": "Modbus TCP is served by the C441 Ethernet module; the IP is set by DHCP, NV memory or the DIP switches (register 143 shows the method; 192.168.1.254 is the restore address). Remote motor control also depends on the comm idle/loss settings 251-254.",
    "watchdog": "Register 110 (Modbus TCP) and 159 (serial) set a com timeout in ms (0 = off); 251-254 choose whether the motor stops or holds on comm idle or loss, and 111-114 set the adapter relays' fault and idle states.",
    "quirks": [
      "Register numbers are 1-based; subtract 1 on the wire.",
      "Coil numbers in the manual are bit views of registers (coil = 16 x (register - 1) + bit + 1), not separate data."
    ],
    "setup": [
      "Serial port settings live in 160-163 (mode, baud, address, parity/stop) where the table lists them.",
      "On a C441R/C441T the RS-485 port is an extra Modbus RTU/ASCII monitoring port that serves the same register map."
    ],
    "gotchas": [
      "Several values change scale with hardware or a scale register; check the notes before trusting raw numbers."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
