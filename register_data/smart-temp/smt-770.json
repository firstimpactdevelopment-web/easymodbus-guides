  "integration": {
    "summary": "Read 40354 for the room temperature shown on the display and 40318 for the active setpoint; write mode (40002), fan (40003) and setpoints (40005/40006 or 40015 depending on DIP mode).",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 353,
        "why": "Room temperature (0.1 °C)"
      },
      {
        "table": "holding_register",
        "address": 317,
        "why": "Active setpoint"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Thermostat mode"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Fan mode"
      },
      {
        "table": "holding_register",
        "address": 14,
        "why": "Single setpoint (manual mode)"
      },
      {
        "table": "coil",
        "address": 0,
        "why": "G1 fan relay"
      }
    ],
    "enable": "Set the thermostat address in the installer menu (item AD, default 7); 9600 8N1 by default. A paired EC-02 copies address and baud from the thermostat.",
    "watchdog": "Coil override (40062) falls back to thermostat control after about 5 minutes without Modbus or after a power loss; refresh it at least every 4 minutes.",
    "quirks": [
      "Celsius setpoints are (raw - 20) / 2.",
      "Registers 40350/40354 are (raw - 400) / 10."
    ],
    "setup": [
      "Only the last device on the bus gets the EOL resistor; with a paired EC-02, terminate at the EC-02, not the thermostat.",
      "Up to 32 thermostats per segment."
    ],
    "gotchas": [
      "Writes that conflict with the DIP-switch mode are silently ignored.",
      "Changing baud (40060) or parity (40068) over Modbus drops the device off the current network."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
