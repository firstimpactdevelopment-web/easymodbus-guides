  "integration": {
    "summary": "Read with function 04 from 0x00 in two-register steps (maximum 20 variables / 40 registers per frame). Values are 32-bit integers, high word first.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "L1 phase-neutral voltage (V x10)"
      },
      {
        "table": "input_register",
        "address": 2,
        "why": "L1 current (mA)"
      },
      {
        "table": "input_register",
        "address": 66,
        "why": "Three-phase apparent power"
      },
      {
        "table": "input_register",
        "address": 40,
        "why": "Frequency (Hz x10)"
      },
      {
        "table": "input_register",
        "address": 60,
        "why": "Active energy tariff 1"
      },
      {
        "table": "input_register",
        "address": 108,
        "why": "Active energy tariff 2"
