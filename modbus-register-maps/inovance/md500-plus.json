 "integration": {
  "summary": "Fit the MD38TX1 card, set F0-02 = 2 and F0-03 = 9, then write a signed percentage of F0-10 to 1000H (10000 = 100.00 %) and a run code to 2000H. Poll 3000H for run state, 8000H for faults and 7000H-7006H for frequency, voltage, current, power and torque.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 8192,
    "why": "Run / stop / reset command"
   },
   {
    "table": "holding_register",
    "address": 4096,
    "why": "Speed reference as % of max frequency"
   },
   {
    "table": "holding_register",
    "address": 12288,
    "why": "Forward / reverse / stopped"
   },
   {
    "table": "holding_register",
    "address": 32768,
    "why": "Fault code"
   },
   {
    "table": "holding_register",
    "address": 28672,
    "why": "Running frequency"
   },
   {
    "table": "holding_register",
    "address": 28676,
    "why": "Output current"
   },
   {
    "table": "holding_register",
    "address": 28674,
    "why": "DC bus voltage"
   }
  ],
  "enable": "RS-485 needs the MD38TX1 extension card. F0-02 = 2 accepts run commands over communication; F0-03 = 9 makes 1000H the main frequency. FD-00..FD-02 set baud, data format and address.",
  "watchdog": "FD-04 sets a Modbus timeout (0.0 s = off); when messages stop for longer the drive reports a communication fault (Err16).",
  "quirks": [
   "1000H is a percentage, not Hz: 10000 = +100.00 % of F0-10, negative values reverse.",
   "Default serial format is 8-N-2 (FD-01 = 0).",
   "To change F-group parameters without wearing the EEPROM, replace the leading F with 0 (F3-12 -> 030CH); A-group uses 4x. Those RAM addresses are write-only."
  ],
  "setup": [
   "FD-02 address (default 1), FD-00 baud (default 5 = 9600 bit/s), FD-01 data format (default 0 = 8-N-2).",
   "Restore defaults over Modbus by writing the user password to 1F00H, then 1 to 1F01H within 30 s."
  ],
  "gotchas": [
   "Reads longer than 12 registers, or reads that cross the end of a parameter group, return an error.",
   "No reply is sent for a frame with a CRC error."
  ]
 },
