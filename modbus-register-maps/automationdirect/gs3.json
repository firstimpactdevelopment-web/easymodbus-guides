 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "The manual lists each register in hex and as a Modicon number: hex 0000h = 40001, 2100h = 48449. The hex value is the wire address. CLICK PLCs need a six-digit form (402331 instead of 42331)."
 },
