 "integration": {
  "summary": "Set P1-01 = 1, close both STO inputs, write the speed to register 2 and then write register 1 = 1 (up/forward) or 2 (reverse). Poll register 6 for status, 7-10 for speed, current, torque and power, and 18 for the fault code.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Control word: run forward/reverse, reset"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Speed reference"
   },
