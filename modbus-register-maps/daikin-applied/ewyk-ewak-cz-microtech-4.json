 ],
 "equipment_type": "Heat pump",
 "applies_to": "Daikin Applied Europe EWAK-CZ / EWYK-CZ units with MicroTech 4 controller, ICARO software and POL902 Modbus module, per D-EIGOC00204-26_00EN.",
 "summary": "Daikin Applied EWAK-CZ / EWYK-CZ chiller and heat pump range on a MicroTech 4 controller. With a POL902 module the unit is a Modbus RTU slave and every point is a 16-bit holding register: enable, mode, cool/heat setpoints, capacity and current limits, water temperatures, DHW and collective-housing functions, VFD pump data, master/slave status and packed unit and circuit alarm words.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 19200,
  "parity": "None",
  "data_bits": null,
  "stop_bits": 2,
  "tcp_port": null
 },
 "addressing": {
  "convention": "1-based",
  "note": "The guide says all variables are holding registers 'addressed 4xxxx' with the number in its Address column (1 = 40001), the same rule as Daikin Applied's other MicroTech 4 Modbus guides. Wire address = column value - 1."
 },
 "default_word_order": null,
 "firmware": "ICARO control software (version not stated)",
 "source": {
  "title": "BAS integration guide - Modbus protocol, EWAK-CZ/EWYK-CZ (ICARO)",
  "doc_number": "D-EIGOC00204-26_00EN",
  "revision_date": null,
  "url": "https://www.daikinapplied.uk/hubfs/portale-documentale/D_EIGOC00204_26_00EN_EWA_Y_K_CZ.pdf",
  "pages": "p. 7 (POL902 defaults), pp. 8-13 (Modbus integration list), pp. 14-19 (Annex A alarm words)"
 },
 "notes": [
  "The integration list's 'Offset' column holds 1 for enums and 0,1 for temperatures, percentages and the current limit; it is a multiplier (0,1 = tenths), so it is used as scale here.",
  "Temperatures are shown in °C; register 47 switches the unit system between Metric and Imperial.",
  "The W access letter is taken as read/write.",
  "Left out: the three 'UNSIGNED DOUBLE WORD' run-hour counters (102 evaporator pump 1, 323 and 423 compressor run hours) because the guide does not say which word is high.",
  "Left out: DHW Standby Mode (95), whose type and offset columns are not filled in properly (MV_red / DHWStandbyMode), and the Reserved registers 279, 290, 291.",
  "Alarm words are single 16-bit registers (the printed 0...4294967295 range is not meaningful for one word). Only bits with a named alarm are listed; the annex marks which bits apply to the SIC, SPLIT, R454C and R290 variants.",
  "Compressor starts registers are single words although the printed range is 0-9,999,999.",
  "Bit numbering in the alarm words is confirmed by the guide's worked example: Unit Alarm Word #1 = 17,408 (0100 0100 0000 0000) means bits 10 and 14 are active."
 ],
