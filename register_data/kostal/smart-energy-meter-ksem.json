{
  "manufacturer": "KOSTAL",
  "manufacturer_slug": "kostal",
  "model": "KOSTAL Smart Energy Meter (KSEM G1 / G2)",
  "model_slug": "smart-energy-meter-ksem",
  "short_model": "KSEM",
  "aliases": [
    "KSEM",
    "KSEM G1",
    "KSEM G2",
    "KOSTAL Smart Energy Meter"
  ],
  "equipment_type": "Energy meter",
  "applies_to": "KOSTAL Smart Energy Meter generation 1 and 2, firmware 2.6.0 (interface description dated 13.03.2025); OBIS-coded internal registers only.",
  "summary": "The KSEM is a three-phase energy meter and energy manager. As a Modbus RTU slave (RS485 A/B) or Modbus TCP slave (port 502, TLS on 802) it exposes OBIS-coded power and energy registers, a plug-and-play identification block and a SunSpec meter block. This map covers the internal instantaneous values (0-145), the 64-bit energy counters (512-791) and the identification block (8192-8249).",
  "transport": [
    "RTU",
    "TCP"
  ],
  "defaults": {
    "unit_id": null,
    "baud": null,
    "parity": null,
    "data_bits": null,
    "stop_bits": null,
    "tcp_port": 502
  },
  "addressing": {
    "convention": "0-based",
    "note": "The register tables give decimal and hex addresses that are used directly on the wire: the manual's own example reads active power+ from holding registers 0 and 1 and energy from registers 512-515."
  },
  "default_word_order": "ABCD",
  "firmware": "KSEM software 2.6.0",
  "source": {
    "title": "KSEM G1/G2 KOSTAL Smart Energy Meter - Interface Description MODBUS",
    "doc_number": "DOC02348405-0007",
    "revision_date": "2025-03-13",
    "url": "https://www.kostal-solar-electric.com/fileadmin/downloadcenter/kse/BA_KOSTAL_Interface_KSEM_EN.pdf",
    "pages": "PDF pp. 9-10 (register layout and word order example), pp. 13-16 (sections 3.1-3.4 tables)"
  },
  "notes": [
    "Word order is stated in section 2.2: in a multi-register value the lower address holds the most significant bits, and the worked examples combine register 0 x 2^16 + register 1 and registers 512-515 most significant first.",
    "Each import/export quantity is split into a '+' and a '-' register, both unsigned; net power = (+) minus (-).",
    "The SunSpec block at 40000-40177, the static/dynamic E-mobility and energy-flow areas, group registers and sensor registers are not included in this file.",
    "Register 146 ('Minimum active power+ * 3', no OBIS code) and the MAC address at 8250-8252 (outside the stated PnP range) are left out.",
    "Reading an address not listed in the tables returns exception 0x02 (illegal data address); request each multi-register value in a single read."
  ],
