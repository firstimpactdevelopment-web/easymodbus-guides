{
 "manufacturer": "Fuji Electric",
 "manufacturer_slug": "fuji-electric",
 "model": "PXR micro controller X (RS-485 Modbus option)",
 "model_slug": "pxr",
 "short_model": "PXR",
 "aliases": [
  "PXR3",
  "PXR4",
  "PXR5",
  "PXR9"
 ],
 "equipment_type": "Sensor (digital temperature controller)",
 "applies_to": "Fuji Electric PXR series controllers with the RS-485 Modbus communication option; manual INP-TN512642d-E.",
 "summary": "The PXR is a Fuji Electric PID temperature controller. With the RS-485 option it is a Modbus RTU slave whose data appear twice: once as internal percentage values (3xxxx/4xxxx) and once in engineering units at the same numbers plus 1000. This map uses the engineering-unit block: PV, SV, MV and status in the input registers, control, alarm and ramp/soak settings in the holding registers, plus alarm bits.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "Odd",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Register numbers are printed Modicon-style with the relative (wire) address beside them; the manual says the wire address is the lower four digits minus 1 (41001 = 03E8H)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Micro Controller X Communication Functions (RS-485 MODBUS) Type PXR",
  "doc_number": "INP-TN512642d-E",
  "revision_date": null,
  "url": "https://americas.fujielectric.com/files/prod_selector_v/Micro%20Controller%20X%20Communication%20Functions%20%28MODBUS%29%20Model%20PXR%20%28TN512642d-E%29.pdf",
  "pages": "Settings p. 5; data format pp. 28-30; engineering-unit map pp. 37-42; bit details pp. 43-44"
 },
 "notes": [
  "Only the engineering-unit block (31001+, 41001+) is listed. The internal-value block at 30001/40001 holds the same items as 0.00-100.00 % of the input range for range-dependent data.",
  "Values carry no decimal point. PV/SV-type values use the P-dP decimal point (41020); P, D, filter and heater current have one decimal; MV, output limits, dead band and output convergence have two.",
  "On over/under-range or open input the PV reads 105 % or -5 % of the range; check 31008.",
  "Reserved/'do not use' registers and the display-mask items (41101-41113) are omitted; DI and alarm option codes are not reproduced.",
  "Writes are accepted beyond the setting range without error; keep values in range."
 ],
 "integration": {
  "summary": "Set CoM parity and a station number on the keypad, then read input registers 31001-31010 (PV, current SV, DV, MV, status) in one request and write the setpoint to 41003.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 1000,
    "why": "PV (31001)"
   },
   {
    "table": "input_register",
    "address": 1001,
    "why": "Current SV (31002)"
   },
   {
    "table": "input_register",
    "address": 1003,
    "why": "Output 1 MV (31004)"
   },
   {
    "table": "input_register",
    "address": 1006,
    "why": "Alarm status (31007)"
   },
   {
    "table": "input_register",
    "address": 1007,
    "why": "Input error status (31008)"
   },
   {
    "table": "holding_register",
    "address": 1002,
    "why": "Face panel SV (41003)"
   },
   {
    "table": "holding_register",
    "address": 1003,
    "why": "RUN/standby (41004)"
   },
   {
    "table": "holding_register",
    "address": 1019,
    "why": "Decimal point (41020)"
   }
  ],
  "enable": "Order the RS-485 option. On the keypad set STno (1-255; 0 stops communication), CoM (parity) and PCoL = 1 (Modbus) where shown.",
  "watchdog": null,
  "quirks": [
   "Speed is fixed at 9600 bps with 8 data bits and 1 stop bit; only parity is selectable (0 odd, 1 even, 2 none).",
   "Monitor SV at 31002, not 41003: the face-panel SV differs while SV-1 or ramp/soak is active.",
   "When changing the decimal point over the bus, rewrite the input scale limits as well."
  ],
  "setup": [
   "Factory defaults: station 1, odd parity, 9600 bps, 8 data bits, 1 stop bit."
  ],
  "gotchas": [
   "Every write is saved to EEPROM automatically (about 100,000 writes); avoid cyclic writes and wait a few seconds after writing before removing power."
  ]
 },
