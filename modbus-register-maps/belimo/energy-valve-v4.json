{
 "manufacturer": "Belimo",
 "manufacturer_slug": "belimo",
 "model": "Energy Valve DN 15-50 (Version 4) Modbus RTU / TCP",
 "model_slug": "energy-valve-v4",
 "short_model": "Belimo Energy Valve V4",
 "aliases": [
  "EV..R2+BAC",
  "EV..R2+KBAC",
  "EV..R2+MID",
  "EV..R3+BAC",
  "Energy Valve 4"
 ],
 "equipment_type": "Actuator / valve (pressure-independent control valve with energy metering)",
 "applies_to": "Belimo Energy Valve Version 4, DN 15-50 (EV..R2+(K)BAC, EV..R2+MID, EV..R3+BAC), per Energy Valve Modbus interface description en-gb 2023-08.",
 "summary": "Belimo's Energy Valve combines a pressure-independent control valve, a flow sensor and two temperature sensors, so it reports flow, delta T, heating/cooling power and energy totals. Version 4 offers Modbus RTU on RS-485 and Modbus TCP on its Ethernet port. Most values are given three times - in SI, imperial and a user-selected unit - and large values use two registers, low word first.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 38400,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 2,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "1-based",
  "note": "Belimo prints each register twice: 'No.' counts from 1 and 'Address' from 0, and the documented value here is the No. column. Register No. 1 (setpoint) is wire address 0. Every value sits in one flat table, so holding-register reads (FC 3) and writes (FC 6/16) reach everything; FC 4 input-register reads of the same addresses also work."
 },
 "default_word_order": "CDAB",
 "firmware": "Version 4 devices (firmware example in the document: 400 = 4.00)",
 "source": {
  "title": "Energy Valve Modbus Interface Description - Energy Valve DN 15...50 (Version 4)",
  "doc_number": "en-gb 2023-08 (general notes dated 15.01.2022)",
  "revision_date": "2023-08",
  "url": "https://www.belimo.com/mam/general-documents/system_integration/Modbus/belimo_Modbus-Register_Energy-Valve_V4_1_en-gb.pdf",
  "pages": "General notes p. 2; register overview pp. 3-5; register descriptions pp. 6-10"
 },
 "notes": [
  "32-bit values occupy two registers with the low word first (Belimo's worked example: No. 10 = 14551, No. 11 = 19 gives 19 x 65536 + 14551 = 1,259,735), so they are UINT32 with CDAB word order. Write a 32-bit pair with one FC 16 request covering only those two registers.",
  "Values are unsigned unless Belimo marks them signed (**): the sensor-1 and Temperature 1/2 registers (No. 14, 15, 20-23) are signed two's complement and typed INT16 here.",
  "Unsupported registers read 65535. Writable registers from No. 101 up are persistent; don't write them cyclically.",
  "The description table prints Sensor 1 °C/°F (No. 123/124) with addresses 124/125, which does not match the No.-minus-1 rule used everywhere else, so those two are left out. No. 13 (raw sensor value, scale depends on sensor type) is also left out.",
  "No. 136/137 (Vmax in selected unit) is left out: its scaling is printed as '0.001-' and is unclear. No. 201-204 (sensor serial number / production order and sequence numbers) are left out because the document does not say whether each pair is one 32-bit value.",
  "No. 9 (flow gpm) has no access letter in the description table; it is read-only like its neighbours. No. 151 has no access letter either and is listed as read-only to be safe, although the other unit selections are R/W.",
  "Belimo lists Communication watchdog (No. 110) as 'not functional, reserved for future' in this edition, so don't rely on it."
 ],
