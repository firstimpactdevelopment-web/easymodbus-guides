 "integration": {
  "summary": "Set the Aidoo output to Modbus and the slave ID in the Airzone Cloud app, connect RS-485 at 19200 8E1, then use registers 0, 3, 9, 11 and 12 for on/off, mode, DHW and setpoints, and poll 46-48 and 7-8 for water temperatures and errors.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "On/off"
   },
   {
    "table": "holding_register",
    "address": 3,
    "why": "Mode"
   },
   {
    "table": "holding_register",
    "address": 11,
    "why": "Water setpoint circuit 1 (x10)"
   },
   {
    "table": "holding_register",
    "address": 9,
    "why": "DHW on/off"
   },
   {
    "table": "holding_register",
    "address": 12,
    "why": "DHW setpoint (x10)"
   },
   {
    "table": "holding_register",
    "address": 46,
    "why": "Water out temperature (x10)"
   },
   {
    "table": "holding_register",
    "address": 48,
    "why": "DHW tank temperature (x10)"
   },
   {
    "table": "holding_register",
    "address": 7,
    "why": "Error code (ASCII)"
   }
  ],
  "enable": "In the Airzone Cloud app: Airtools > advanced configuration via Bluetooth > Integration > output Modbus, set the Modbus ID.",
  "watchdog": null,
  "quirks": [
   "Mode codes start at 1 (1 Auto, 2 Cool, 3 Heat, 4 Fan, 5 Dry).",
   "Energy counters are low word first (CDAB)."
  ],
  "setup": [
   "Factory serial settings 19200 baud, 8 data bits, even parity, 1 stop bit.",
   "Slave address default 1."
  ],
  "gotchas": [
   "Register 13 bit 0 tells whether a DHW tank is configured."
  ]
 },
