{
 "manufacturer": "INVT",
 "manufacturer_slug": "invt",
 "model": "Goodrive270 (GD270) fan and pump VFD",
 "model_slug": "goodrive270-gd270",
 "short_model": "GD270",
 "aliases": [
  "GD270",
  "Goodrive270",
  "GD270 fan and pump drive",
  "GD270 HVAC drive"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "INVT Goodrive270 fan and pump drives using the built-in RS-485 Modbus RTU port, per the GD270 manual V1.4 (chapter 9).",
 "summary": "INVT's variable frequency drive built for fans, pumps and HVAC duty, with sleep/wake, frost and dry-pump protection. The built-in RS-485 port speaks Modbus RTU (Modbus TCP and BACnet MS/TP need option cards). Commands and setpoints go to the 2000H block, status and fault words sit at 2100H-2103H, monitors at 3000H onwards, and every function parameter has its own hex address. This map covers that block plus the run-source, P14 serial and fault parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Addresses are printed in hex and go on the wire unchanged. Parameter P00.00 sits at 0000H and the manual's example frames carry the address bytes directly (setting P01.20 is sent as 01 06 01 14 00 32, and the multi-register write example starts at 20 00)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Goodrive270 Series VFD for Fan and Pump Operation Manual",
  "doc_number": "V1.4",
  "revision_date": "2025-07",
  "url": "https://www.invt.com/uploads/file1/20250804/GD270%20Manual_V1.4.pdf",
  "pages": "pp. 178 (P00.06), pp. 226-228 (P07.27 fault list), pp. 267-269 (P14 group), pp. 361-366 (9.4.4-9.4.7)"
 },
 "notes": [
  "Every register is a single 16-bit word; there are no 32-bit values in this map.",
  "Any function parameter can be read or written at (group << 8) | index; only the parameters an integrator needs most are listed here.",
  "3016H (identification code) and 5000H (fault code) are printed without range or unit, so they are left out; 2102H and 2103H carry the same information.",
  "The fault list prints codes 77 and 78 twice (AI2/AI3 disconnection and water pipe breaking / power underload), so those two codes are left out of the value lists.",
  "3011H, 300FH and 3010H (pulse input) are reserved or printed with a mixed kHz/0.01 Hz unit and are left out.",
  "300DH/300EH (AI2/AI3) are left out: the address table prints AI2 as 0.00-10.00 V and AI3 as -10.00-10.00 V, but P17.20 prints AI2 as -10.00-10.00 V and AI3 is a 0-10 V option-card input, so signedness is unclear."
 ],
