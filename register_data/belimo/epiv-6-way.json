  "integration": {
    "summary": "Set the address (factory 10) and frame with the Belimo Assistant app, write Setpoint source No. 119 = 1 (Bus), then write No. 1: 0-33 % runs sequence 1, 67-100 % sequence 2, 34-66 % closes. Poll No. 17 (active sequence), No. 7/10 (flow) and No. 105 (faults).",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 118,
        "why": "Setpoint source = Bus (default Analog)"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Setpoint across both sequences"
      },
      {
        "table": "holding_register",
        "address": 16,
        "why": "Active sequence"
      },
      {
        "table": "holding_register",
        "address": 9,
        "why": "Flow l/h"
      },
      {
        "table": "holding_register",
        "address": 4,
        "why": "Relative position"
      },
      {
        "table": "holding_register",
        "address": 104,
        "why": "Fault flags"
      }
    ],
    "enable": "Configure address and frame with the Belimo Assistant app, then write No. 119 = 1 so the valve follows the bus setpoint (factory setting is Analog).",
    "watchdog": null,
    "quirks": [
      "Register No. is 1-based; subtract 1 for the wire address.",
      "Factory slave address is 10.",
      "One setpoint drives both sequences; 33 % and 67 % are both zero flow."
    ],
    "setup": [
      "Default frame 1-8-N-2 at 38400 baud.",
      "No built-in terminator: fit an external 120 ohm resistor at the bus ends."
    ],
    "gotchas": [
      "While air bubbles are detected the valve stays in position control whatever Control mode says (bit 5 of No. 105)."
    ]
  },
  "verified": {
    "date": "2026-10-28",
    "method": "independent re-check of every register against the source PDF"
  }
