{
 "manufacturer": "SATEC",
 "manufacturer_slug": "satec",
 "model": "EM133-R residential multifunction meter",
 "model_slug": "em133-r",
 "short_model": "EM133-R",
 "aliases": [
  "EM133",
  "EM133-R",
  "EM133-XM",
  "SATEC EM133"
 ],
 "equipment_type": "Energy meter (multifunction)",
 "applies_to": "SATEC EM133-R (and EM133-XM) multifunction meters, per Modbus reference guide BG0520 Rev. A6 (Oct 2018).",
 "summary": "The EM133 is a SATEC DIN-rail multifunction energy meter with RS-485 and optional Ethernet, WiFi, Profibus or CANopen modules. Its 32-bit register set carries 1-second phase and total values, demands and energy counters as integers, low word first. This map covers volts, amps, power, PF, frequency, unbalance, present demands, energy totals, digital I/O, basic wiring/CT/PT setup, resolution and energy decimal settings, COM1 settings, password and clear commands.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "The guide says to add 40001 (or 400001 above 9999) to a register address for Modicon holding-register numbers, so printed addresses go straight into the frame: 13952 is requested as 13952 (Modicon 413953)."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "EM133-R Residential Multifunction Meter - Modbus Communications Protocol Reference Guide",
  "doc_number": "BG0520 Rev. A6",
  "revision_date": "2018-10",
  "url": "https://www.satec-global.com/wp-content/uploads/2022/11/EM133-R-Modbus.pdf",
  "pages": "Addressing p. 11, data formats p. 12; 32-bit registers pp. 33-37; control/status p. 53; setup pp. 56-57; data units p. 75; F26 wiring codes p. 81"
 },
 "notes": [
  "Addressing: the guide says to add 40001 to a register address to get the Modicon holding-register number (400001 above 9999), so printed addresses are 0-based wire addresses.",
  "Word order: 32-bit values are sent with the low-order word in the first (even) register and the high-order word in the second, so they are CDAB here.",
  "Function 04 can be used the same way as function 03.",
  "Units depend on the device resolution option (2390). Scales here are for the default low resolution: U1 = 1 V, U2 = 1 A, U3 = 1 kW/kvar/kVA. With high resolution they become 0.1 V and 0.001 kW at PT ratio 1 (1 V and 1 kW above PT 1) and 0.01 A.",
  "Energy registers use U4, set by energy decimal places (2391, 0-4, default 4). The scale here (0.0001) is for the default.",
  "Phase rotation sits at 11904 on this model (not 11906 as on some other SATEC meters).",
  "Left out: 16-bit scaled registers, harmonics, min/max logs, billing/TOU, data logs, the total PF lag/lead rows (printed UINT16 in a two-register slot), and COM2/COM3 settings."
 ],
