{
 "manufacturer": "Lumel",
 "manufacturer_slug": "lumel",
 "model": "NR30 DIN-rail power network meter",
 "model_slug": "nr30",
 "short_model": "NR30",
 "aliases": [
  "NR30"
 ],
 "equipment_type": "Power meter (DIN-rail network meter)",
 "applies_to": "Lumel NR30 rail-mounted 3-phase meter (RS-485 Modbus RTU; Ethernet versions also offer Modbus TCP), per manual NR30-09E_R1.",
 "summary": "The NR30 is a DIN-rail 3-phase power network meter with RS-485 Modbus RTU and, in Ethernet versions, Modbus TCP. Its fixed measurement list is offered as floats in several areas; this map uses the 8000 area (two registers per value, high word first), plus comms settings, the status word and 32-bit energy counters.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 2,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "0-based",
  "note": "Addresses are used as printed: the example frames read 7000 as 0x1B58 and 6000 as 0x1770. Float registers show the table's 6xxx/8xxx pair in 'documented'; this map uses the 8xxx address."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "NR30 Rail mounted power network meter - User's manual",
  "doc_number": "NR30-09E_R1",
  "revision_date": null,
  "url": "https://www.lumel.com.pl/resources/Pliki%20do%20pobrania/NR30/NR30_service_manual.pdf",
  "pages": "Example frames around PDF p. 31; register area table PDF p. 34; configuration and status/energy tables PDF pp. 41-52; Table 21 floats PDF pp. 55-60"
 },
 "notes": [
  "Byte order: the area table gives 8000-8970 as bytes 3-2-1-0 and 6000-6970 as 1-0-3-2; example 2 returns 41 20 00 00 (10.0) for a 3-2-1-0 area and example 3 returns 00 00 41 20 for the 6000 area, so the 8000 area is high word first (ABCD).",
  "The 7000/7200/7400 areas are a user-programmable group (set in 4200-4259) and are not listed.",
  "Energy counters 4426-4435 follow the manual's formula (high x 65536 + low) / 100.",
  "Left out: 4101 transmission mode (its row could not be read cleanly), time/date and status floats 8110-8128, the min/max area from 8136, and the alarm, MQTT and display setup registers.",
  "Frequency (8072) is printed with unit 'f'; it is listed in Hz."
 ],
