{
 "manufacturer": "Condair",
 "manufacturer_slug": "condair",
 "model": "RS II resistive steam humidifier (Integrated Controller, Modbus RTU/TCP)",
 "model_slug": "rs-ii",
 "short_model": "RS II",
 "aliases": [
  "Condair RS",
  "Condair RS II",
  "RS"
 ],
 "equipment_type": "Air handler humidifier (resistive steam)",
 "applies_to": "Condair RS with the Integrated Controller (cylinders A and B), per addendum 2603326-G.",
 "summary": "The Condair RS is a resistive-heating steam humidifier with one or two cylinders. Its Integrated Controller is a Modbus RTU slave on RS-485 or a Modbus TCP server. This map covers per-cylinder status, safety chain, heating, valves and levels, capacities, demand, operating hours and service counters, plus two-channel setpoint and control registers.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": 10,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Tables print the 5-digit register (32001 = input register, 43001 = holding register) and the 0-based address beside it (2000 / 3000). The address column is what goes on the wire; the manual's own example: register 43004 = address 3003."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Modbus addendum manual for DL II, ME II, RS II, RO-E and Vita (Integrated Controller)",
  "doc_number": "2603326-G EN 2607",
  "revision_date": null,
  "url": "https://www.condair.com/m/0/2603326-e-modbus-for-dl-series-addendum.pdf",
  "pages": "RS tables pp. 25-28; settings pp. 10-17"
 },
 "notes": [
  "Input registers are read with function 04; holding registers with 03 and written with 06 or 16.",
  "Floats use 'Register Sequence': MSR first (high register first, ABCD) is the factory setting; LSR first (CDAB) is the option. The map assumes the factory setting.",
  "Factory serial settings: Modbus RTU, address 10, 19200 baud, even parity, 8 data bits, 1 stop bit. Modbus TCP uses port 502 and unit ID 255 (per the TCP technical data).",
  "Units marked metric/imperial follow the controller's Metric/Imperial setting; the listed unit is the metric one."
 ],
