 "integration": {
  "summary": "Read the sensor block at 40 (12 registers per sensor, up to 48 in one request) and divide the current value by the divisor register. Alarm and relay states are bit fields in the same block.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 40,
    "why": "Gas type of sensor 1"
   },
   {
    "table": "holding_register",
    "address": 42,
    "why": "Divisor needed to scale sensor 1 values"
   },
   {
    "table": "holding_register",
    "address": 43,
    "why": "Sensor 1 current gas value"
   },
   {
    "table": "holding_register",
    "address": 45,
    "why": "Sensor 1 error word"
   },
   {
    "table": "holding_register",
    "address": 46,
    "why": "Sensor 1 alarm 1-4 bits"
   },
   {
    "table": "holding_register",
    "address": 47,
    "why": "Relay and digital input states"
   }
  ],
  "enable": "The RS-485 Modbus port (Bus A / Bus B terminals) is always a slave at 19200 baud, 8 data bits, even parity, 1 stop bit. The slave address can be changed by writing the new address to register 333 with function 16.",
  "watchdog": null,
  "quirks": [
   "Only function 03 reads are supported; nothing can be written with function 06, and function 16 is accepted only for the address-change register 333.",
   "The compact block (not listed here) must be read as exactly 10 words starting at address 0."
  ],
  "setup": [
   "Poll each unit no faster than every 100 ms; with poll intervals under 550 ms, add at least one pause longer than 550 ms per polling cycle."
  ],
  "gotchas": [
   "Changing the address with register 333 readdresses every device sharing the old address, so only one device with that address may be on the bus."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/danfoss/gas-detection-unit-gd",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
