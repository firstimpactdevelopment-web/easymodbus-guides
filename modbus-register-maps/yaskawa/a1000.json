 "integration": {
  "summary": "Set H5-01..H5-03 at the keypad and power-cycle, set b1-01 = 2 and b1-02 = 2 so the frequency reference and Run command come from Modbus, then write 0001H (run bits) and 0002H (frequency reference) together with function 10H and poll 0020H-002CH for status, faults and alarms.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 1,
    "why": "Run/stop, direction, fault reset"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Frequency reference (o1-03 units)"
   },
   {
    "table": "holding_register",
    "address": 32,
    "why": "Drive Status 1: run/ready/fault"
   },
   {
    "table": "holding_register",
    "address": 33,
    "why": "Fault Contents 1"
   },
   {
    "table": "holding_register",
    "address": 36,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 44,
    "why": "Drive Status 2 incl. comm timeout bit"
   },
   {
    "table": "holding_register",
    "address": 49,
    "why": "DC bus voltage"
   },
   {
    "table": "holding_register",
    "address": 128,
    "why": "U2-01 current fault code"
   }
  ],
  "enable": "Set H5-01 slave address (default 1F hex = 31, range 0-FF hex), H5-02 speed (default 3 = 9600 bps) and H5-03 parity (default 0 = none), then cycle power. For control set b1-01 = 2 and b1-02 = 2 (b1-15/b1-16 for external reference 2). H5-12 decides whether 0001H bits 0/1 mean FWD/REV run or Run + direction. Network inputs are ORed with terminals S1-S8.",
  "watchdog": "H5-05 = 1 (default) enables CE detection, H5-09 CE Detection Time (0.0-10.0 s, default 2.0 s) sets the timeout, and H5-04 selects the reaction: 0 ramp to stop, 1 coast, 2 fast stop, 3 alarm only and keep running (default). Drive Status 2 (002CH) bit F shows a communication timeout.",
  "quirks": [
   "Registers are hex and 0-based: 0020H is sent as 00 20.",
   "Only function codes 03H, 08H and 10H are supported; there is no 06H single-register write, so use 10H even for one register.",
   "Reads and writes are limited to 16 registers per message.",
   "H5-11 defaults to 0 on A1000: parameter writes only apply after writing 0 to 0900H (RAM + EEPROM) or 0910H (RAM only). Registers 0000H-001FH never need Enter. 0900H/0910H are write-only; reading them returns error 02H.",
   "Minimum gap before the next message: 5 ms after commands/reads, 50 or 200 ms after a parameter write, 200 ms-2 s after an Enter command, and 5 s for an Enter that saves to EEPROM after initialization."
  ],
  "setup": [
   "Terminal block TB5 (R+, R-, S+, S-, IG); for 2-wire RS-485 jumper S+ to R+ and S- to R-. Up to 31 drives on RS-485.",
   "Set DIP switch S2 ON (termination) only on the drive at the end of the line.",
   "H5-07 = 1 (RTS switched, default) for RS-485 or multi-drop RS-422; 0 for point-to-point RS-422.",
   "Data is 8 bits, 1 stop bit, RTU only; speeds 1.2-115.2 kbps; parity none/even/odd.",
   "H5-06 Drive Transmit Wait Time (default 5 ms) delays the reply if the master overruns; H5-06 and H5-07 also need a power cycle."
  ],
  "gotchas": [
   "H5-01 = 0 stops the drive from answering at all.",
   "H5-01..H5-03 changes need a power cycle before they apply.",
   "The Enter command to EEPROM (0900H) wears the EEPROM (about 100,000 writes); use 0910H for frequent changes.",
   "Error code 25H means an EEPROM write was refused; H5-17 = 1 makes such writes go to RAM only.",
   "With a communication option card fitted, the option takes priority for ComRef/ComCtrl.",
   "Self-test: set H1-06 = 67, jumper R+ to S+, R- to S- and S6 to SN (SC-SP jumper in place) and power up; the keypad shows PASS when the port is healthy, CE when not."
  ]
 },
