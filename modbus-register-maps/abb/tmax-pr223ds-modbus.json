 ],
 "equipment_type": "Power meter (circuit breaker trip unit)",
 "applies_to": "ABB SACE PR223DS electronic trip unit (Tmax moulded-case breakers), software version 02.02, per 1SDH000658R0001.",
 "summary": "The PR223DS trip unit on Tmax moulded-case breakers has a built-in Modbus RTU interface. Measurements, status, alarms and trip data are input registers; open, close and reset commands are single holding registers set to 1. 32-bit power and energy values are sent low word first.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 247,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Each register row gives the absolute address (30001/40001 style) and a 'Relative Address - 1 (HEX)' column that goes in the Modbus message (30101 = 0064h, 40001 = 0000h). This applies with the default 'Standard' addressing type."
 },
 "default_word_order": "CDAB",
 "firmware": "SW 02.02",
 "source": {
  "title": "PR223DS Modbus System Interface - Instruction manual",
  "doc_number": "1SDH000658R0001",
  "revision_date": null,
  "url": "https://library.e.abb.com/public/dfe9aa822695b773c125780800716f6c/1SDH000658R0001.pdf",
  "pages": "Addressing p. 12; default comms p. 17; data organization p. 27; registers pp. 28-40; commands pp. 48-51; serial parameters p. 8; operating mode p. 19; command conditions pp. 22-24"
 },
 "notes": [
  "The manual says double words are little-endian by word (least significant word first) and big-endian within each word, so 32-bit registers here are CDAB.",
  "Default communication parameters (address 247, 19200 baud, even parity, Standard addressing) apply until set with the Test Unit; they can only be changed locally.",
  "Currents read in amps once the nominal current is set; if 'Nominal current unknown' (status bit 13) is set they read as a percentage of In (150 = 1.5 In).",
  "Voltages, power, energy and frequency need the VM210 voltage module; without it they read 0.",
  "Commands run only in remote operating mode and one at a time. The remote signalling contact commands are left out because their hex addresses (0029h, 002Ah) do not match the absolute addresses 40041/40043.",
  "Read the currents as a 5-register block, not one at a time, as the manual asks."
 ],
