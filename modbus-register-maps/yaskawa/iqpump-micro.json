 "integration": {
  "summary": "Set H5-01..H5-03 and power-cycle, then b1-01 = 2 and b1-02 = 2 so the frequency reference and Run come from Modbus. Write 0001H (run bits) and 0002H (frequency reference) with function 10H and poll 0020H, 0021H, 002AH and 002CH.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 1,
    "why": "Run/stop, direction, fault reset"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Frequency reference (o1-03 units)"
