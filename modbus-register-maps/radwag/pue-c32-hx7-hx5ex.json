 "addressing": {
  "convention": "Modicon",
  "note": "Each table gives both a 0-based Offset and a Modbus address (30001/40001 style); the offset is what goes on the wire, e.g. platform 1 mass is offset 0 = 30001 and Command is offset 500 = 40501. The 'documented' field holds the Modbus address column."
 },
 "default_word_order": "ABCD",
