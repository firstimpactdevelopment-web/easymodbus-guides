  "integration": {
    "summary": "Turn on the Modbus TCP slave in the KSEM web UI and poll the listed blocks of holding registers 0-145 for live values and 512-791 for 64-bit energy counters, high word first, splitting reads at the gaps. Net grid power is Active power+ minus Active power-.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "Active power import (0.1 W)"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Active power export (0.1 W)"
      },
      {
        "table": "holding_register",
        "address": 26,
        "why": "Grid frequency"
      },
      {
        "table": "holding_register",
        "address": 62,
        "why": "Voltage L1"
      },
      {
        "table": "holding_register",
        "address": 60,
        "why": "Current L1"
      },
      {
        "table": "holding_register",
        "address": 512,
        "why": "Imported active energy (0.1 Wh)"
      },
      {
        "table": "holding_register",
        "address": 516,
        "why": "Exported active energy (0.1 Wh)"
      },
      {
        "table": "holding_register",
        "address": 8228,
        "why": "Serial number for identification"
      }
    ],
    "enable": "In the KSEM web interface open the Modbus settings and activate the TCP slave (and optionally TLS), or set RS485 A or B to Modbus RTU slave; save the settings before polling.",
    "watchdog": null,
    "quirks": [
      "Values are unsigned with separate + and - registers instead of one signed value, except power factor (int32).",
      "With TLS enabled the slave only answers on port 802, not 502.",
      "64-bit energy counters must be read as all four registers in one request."
    ],
    "setup": [
      "Default TCP port 502; encrypted Modbus on port 802.",
      "A self-signed TLS client certificate must be accepted in the KSEM certificate list before reads are allowed."
    ],
    "gotchas": [
      "Reading across a gap between listed registers returns exception 0x02, so split polls at the gaps (e.g. 0-7, 16-27, 40-47)."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
