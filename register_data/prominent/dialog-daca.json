  "integration": {
    "summary": "Read holding registers (function 03) from PDU 99: each channel block gives the measured value and setpoint as floats followed by status, warnings and the 32-bit error words. Check the endian test value at PDU 197 first. Writes use function 06 for single registers and 16 for floats.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 99,
        "why": "Channel 1 measured value"
      },
      {
        "table": "holding_register",
        "address": 103,
        "why": "Channel 1 setpoint"
      },
      {
        "table": "holding_register",
        "address": 106,
        "why": "Channel 1 status"
      },
      {
        "table": "holding_register",
        "address": 108,
        "why": "Channel 1 existing errors"
      },
      {
        "table": "holding_register",
        "address": 112,
        "why": "Channel 2 measured value"
      },
      {
        "table": "holding_register",
        "address": 197,
        "why": "Endian test (0xAABBCCDD)"
      },
      {
        "table": "holding_register",
        "address": 199,
        "why": "Channel 1 stop command"
      }
    ],
    "enable": "Set the slave address, baud rate, serial format, interface mode and termination in SETUP > BUS configuration (access code needed). Bus control parameters are used when bit 15 of the channel configuration word is set.",
    "watchdog": null,
    "quirks": [
      "Register numbers are 1-based; subtract 1 for the PDU address.",
      "32-bit values are high word first (ABCD).",
      "Byte-sized parameters use only the low 8 bits of the register; write the top 8 bits as 0.",
      "If one register in a multi-register write raises an exception, the rest of that write is ignored."
    ],
    "setup": [
      "Factory settings: RS-485, slave address 1, 19200 baud, 8 data bits, odd parity, 1 stop bit; termination off.",
      "Turn on active termination in the menu when the controller is the last device on the RS-485 line.",
      "With no parity, 2 stop bits are required."
    ],
    "gotchas": [
      "Keep responses short at low baud rates: the manual warns that replies over about 100 bytes at 9600 baud (200 at 19200) may be corrupted.",
      "Read-only registers answer only to function 03."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
