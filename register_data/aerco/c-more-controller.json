 "integration": {
  "summary": "Give the C-More a Comm Address (1-127) in its Setup menu, set Boiler Mode to Remote Setpoint or Direct Drive and Remote Signal to Network, then write holding register 0 (setpoint counts) or 1 (fire rate %) at least every 10 seconds. Read input registers 1-16 for status, temperatures, fire rate and run hours.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Network setpoint (Remote Setpoint mode)"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Network fire rate (Direct Drive mode)"
   },
   {
    "table": "holding_register",
    "address": 12,
    "why": "Boiler mode"
   },
   {
    "table": "input_register",
    "address": 1,
    "why": "Unit status"
   },
   {
    "table": "input_register",
    "address": 2,
    "why": "Outlet temperature"
   },
   {
    "table": "input_register",
    "address": 8,
    "why": "Fire rate out"
   },
   {
    "table": "input_register",
    "address": 15,
    "why": "Flame strength"
   },
   {
    "table": "input_register",
    "address": 0,
    "why": "Status / fault message code"
   }
  ],
  "enable": "Setup menu: Comm Address 1-127 (0, the default, disables Modbus). Configuration menu: Boiler Mode = Direct Drive or Remote Setpoint and Remote Signal = Network. Changing settings needs the right password level; register 2 holds the Modbus-port password and writes to protected registers fail with exception 02 until it matches.",
  "watchdog": "Fixed 10 s heartbeat: each received Net Direct Drive or Net Remote Setpoint write resets it. If it expires the controller shows MODBUS COMM FAULT and falls back to the Failsafe Mode in holding register 24 (Shutdown or Constant Setpoint).",
  "quirks": [
   "Temperatures are 0-1000 counts that need AERCO's conversion equations; they are not tenths of a degree.",
   "Function code 16 (write multiple registers) is not supported and returns Illegal Function; write one register at a time with function 06.",
   "A multi-register read (FC03/FC04) that includes any register the current password level cannot access fails as a whole with Illegal Data Address.",
   "32-bit counters are low word first."
  ],
  "setup": [
   "RS-485 2-wire with shield, RTU only, fixed 9600 baud on the C-More; up to 127 slaves (32 when driven by a BMS/ACS).",
   "Terminate and bias only the last C-More on the bus: TERM, BIAS1 and BIAS2 DIP switches on the PMC board behind the front panel; that unit must stay powered for bias.",
   "Address 0 is broadcast; a broadcast Net Direct Drive or Net Remote Setpoint sets all enabled slaves at once."
  ],
  "gotchas": [
   "Do not write to registers marked Reserved.",
   "Front-panel, RS-232 and Modbus changes are not interlocked; the last write wins.",
   "AERCO recommends enabling Set Point Limiting and choosing the Failsafe Mode before handing control to Modbus."
  ]
 },
