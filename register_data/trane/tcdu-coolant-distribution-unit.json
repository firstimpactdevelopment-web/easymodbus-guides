  "integration": {
    "summary": "Connect to the TCDU's Telemetry Control RJ45 with Modbus TCP on port 503 (not 502) and read holding registers 40001-40096. Setpoints sit in 40046-40062 and the control word in 40092.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1,
        "why": "Common fault summary"
      },
      {
        "table": "holding_register",
        "address": 31,
        "why": "TCS supply temperature"
      },
      {
        "table": "holding_register",
        "address": 32,
        "why": "TCS return temperature"
      },
      {
        "table": "holding_register",
        "address": 29,
        "why": "TCS flow rate"
      },
      {
        "table": "holding_register",
        "address": 36,
        "why": "TCS cooling kW"
      },
      {
        "table": "holding_register",
        "address": 12,
        "why": "FWS supply temperature"
      },
      {
        "table": "holding_register",
        "address": 48,
        "why": "TCS supply temperature setpoint"
      },
      {
        "table": "holding_register",
        "address": 90,
        "why": "System status bits"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Heartbeat counter"
      }
    ],
    "enable": "Modbus TCP is served on the RJ45 port labelled Telemetry Control (also used for data-log download and the REST API). The port takes a DHCP address by default; a fixed IP is set by logging into the internal IOT2050 module over SSH, editing the connection with nmtui and rebooting it.",
    "watchdog": null,
    "quirks": [
      "TCP port is 503, not the usual 502.",
      "All values are signed 16-bit with fixed decimal multipliers; there are no 32-bit registers, so each pump's energy is split into a kWh register and an MWh register."
    ],
    "setup": [
      "Find the unit's IP on the DHCP server, or set a fixed IP on the IOT2050 module (service port P1-X1, default 192.168.2.40; credentials are supplied separately by Trane).",
      "Point the client at port 503; the manual does not state a unit ID."
    ],
    "gotchas": [
      "Several status bits are active-low (E-stop, safety relay, leak detection, inverter state): 1 means normal.",
      "Register 40001 counts 1-255 continuously; use it to confirm the link is alive."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
