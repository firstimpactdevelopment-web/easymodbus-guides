    "parity": "None",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "0-based",
    "note": "The register list's ID column is the wire address. The manual's example frame reads the '2nd register' with register ID bytes 0x00 0x02, and the list starts at ID 0 (program version), so use the ID unchanged in the request."
  },
