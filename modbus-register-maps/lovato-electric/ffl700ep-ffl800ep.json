{
 "manufacturer": "Lovato Electric",
 "manufacturer_slug": "lovato-electric",
 "model": "FFL700EP / FFL800EP electric fire pump controllers",
 "model_slug": "ffl700ep-ffl800ep",
 "short_model": "FFL...EP",
 "aliases": [
  "FFL700EP",
  "FFL800EP",
  "FFL 700 EP",
  "FFL 800 EP"
 ],
 "equipment_type": "Pump (electric fire pump controller)",
 "applies_to": "FFL700EP and FFL800EP electric fire pump controllers (built-in RS-485, optical port, EXP1012T/EXP1013T modules on FFL800EP), per protocol document I589 GB I 08 22.",
 "summary": "The FFL700EP and FFL800EP are Lovato controllers for electric fire pumps built to EN 12845. They speak Modbus RTU, ASCII or TCP on the optical port, the built-in RS-485 and, on FFL800EP, EXP1012T/EXP1013T modules. This map covers the supply voltages, currents, active powers and power factors, frequency and asymmetry, working hours, the alarm words, I/O states, the global status word and the save/reset/command registers.",
 "transport": [
  "RTU",
  "ASCII",
  "TCP"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": 1001
 },
 "addressing": {
  "convention": "1-based",
  "note": "The document states that the address in a request is the table address decreased by one (Modbus standard). Addresses here are the table value minus one."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "FFL700EP - FFL800EP electric fire pump controllers (EN12845) - Modbus protocol",
  "doc_number": "I589 GB I 08 22",
  "revision_date": "2022-08-26",
  "url": "https://datasheet.lovatoelectric.com/DOWNLOAD/Technical/TechInstructions/33.%20CONTROLLORI%20ANTINCENDIO/I589IGB08_22.pdf",
  "pages": "pp. 1-3 (settings, functions, example), pp. 7-10 (Tables 2-5)"
 },
 "notes": [
  "Measures and status words are read with function 03 or 04 (same data) and are listed as input registers. Commands use function 06.",
  "Word order: the example answer 00 00 09 EC decodes to 2540 = 25.40 °C, so 32-bit values are high word first (ABCD).",
  "The example says it reads water temperature with start address 0F 09 (table 0F0Ah), but Table 2 lists water temperature at 0F0Eh. Because of that mismatch the water temperature register is left out; the minus-one rule itself is stated in the text.",
  "Scales are the divisors printed in the unit column (V/100, A/10000, W/10, var/10, VA/10, PF/10000, Hz/1000). Phase-to-phase asymmetry is printed %/10 while the other asymmetries are %/100.",
  "Left out: L1-L3 reactive and apparent powers (same pattern at 001Ah-0024h), max/min equivalent phase-to-phase voltage, LIM1-8 words, CNT1-8 counters, analog inputs/outputs (no units printed) and the key simulation at 2F0Ah."
 ],
