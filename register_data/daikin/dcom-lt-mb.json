  "integration": {
    "summary": "Wire P1P2 to the Altherma user interface and RS-485 to the master, set the slave address on DIP switches SW1.3-SW1.8, wait for the green status LED, then poll input registers 21-50 with function 04 and write setpoints with function 06 or 16.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 4,
        "why": "Space heating/cooling on/off"
      },
      {
        "table": "holding_register",
        "address": 3,
        "why": "Operation mode"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Heating leaving water setpoint"
      },
      {
        "table": "holding_register",
        "address": 10,
        "why": "DHW setpoint"
      },
      {
        "table": "input_register",
        "address": 21,
        "why": "Unit error"
      },
      {
        "table": "input_register",
        "address": 22,
        "why": "Error code"
      },
      {
        "table": "input_register",
        "address": 42,
        "why": "Return water temperature"
      },
      {
        "table": "input_register",
        "address": 43,
        "why": "DHW temperature"
      },
      {
        "table": "input_register",
        "address": 44,
        "why": "Outside temperature"
      }
    ],
    "enable": "No software enable. Choose the operating mode on SW1.1-SW1.2 and the address on SW1.3-SW1.8; the DCOM answers as a Modbus slave once it has synchronised with the Altherma master.",
    "watchdog": "If P1P2 communication with the Altherma master fails for 60 seconds the DCOM falls back to waiting for the master; after 3 more minutes it reports Timeout (unit error 1, error code U8). No Modbus-side watchdog is documented.",
    "quirks": [
      "Reads are limited to 64 registers; function 06 for single writes, function 16 for up to 64.",
      "Setpoint writes outside the configured range are clamped to the nearest limit; other out-of-range writes are ignored.",
      "Sensor temperatures are signed and divided by 100; setpoints are whole degrees."
    ],
    "setup": [
      "Power: regulated 15-24 VDC, at least 80 mA (polarity independent).",
      "RS-485 is fixed at 9600 baud, 8 data bits, no parity, 1 stop bit.",
      "Connect the RS-485 common terminal C to the other devices' common; termination is not needed at 9600 baud, and if you add it you must add failsafe bias too.",
      "Up to 32 devices per segment, bus topology, under 1000 m."
    ],
    "gotchas": [
      "With Altherma 2 and EKRUCBL / EKRUHML user interfaces the DCOM works only if no LAN adapter is connected.",
      "Values read 32765 until synchronisation finishes; do not treat that as a temperature."
    ]
  },
