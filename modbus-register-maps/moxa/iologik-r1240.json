 ],
 "equipment_type": "Sensor (remote I/O module)",
 "applies_to": "ioLogik R1240 per the ioLogik R1200 Series User's Manual, Edition 3.4 (April 2021).",
 "summary": "The ioLogik R1240 is a Moxa RS-485 Modbus RTU remote I/O module with 8 analog inputs (0-10 V, 0-20 mA, 4-20 mA). It supports a repeater or dual RS-485 mode and a Modbus host-connection watchdog. This map covers the shared system registers (model, watchdog, serial settings) and the analog input raw values, min/max, status and range.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Each row prints the hex protocol address and a 1-based reference number (0x0000 = 00001/10001/30001/40001). The hex address is sent on the wire; the table (coil, discrete input, input or holding) is set by the function code column."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "ioLogik R1200 Series User's Manual",
  "doc_number": "Edition 3.4",
  "revision_date": "2021-04",
  "url": "https://cdn11.bigcommerce.com/s-hltjsp5jm3/content/pdfs/moxa-iologik-r1200-series-manual.pdf",
  "pages": "pp. 2-4 to 2-5 (device ID, serial settings, Initial/Run and Dual/Repeater switches), Appendix A pp. A-2 to A-37 (Modbus mapping), Appendix B (factory defaults)",
  "unofficial": true
 },
 "notes": [
  "Moxa does not appear to offer this manual on a public URL found in this pass; the link is an unaltered copy of the Moxa user's manual on a reseller's file host.",
  "Each table row gives the hex wire address, the 1-based decimal reference (e.g. 0x0000 = 40001; system registers use six digits, 0x7530 = 330001), access, size and function code.",
  "Left out: system strings and multi-word values whose format is not described (firmware version and release date, serial number, server name/location, password, vendor name).",
  "Left out: the 32-bit engineering values (current, min, max) and burnout values at 0x0320-0x03AF and 0x02E0-0x02EF (holding), because the table does not say whether they are integers or floats or how they are scaled. Raw values are listed with no scaling."
 ],
