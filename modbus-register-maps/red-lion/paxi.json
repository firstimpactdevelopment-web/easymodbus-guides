 "integration": {
  "summary": "Read 40001-40012 in one request for counts, rate and min/max (high word first). Change setpoints or count loads by writing both words of 40019-40032; take direct control of outputs by setting MMR bits and then writing the SOR.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Counter A value"
   },
   {
    "table": "holding_register",
    "address": 6,
    "why": "Rate value"
   },
   {
    "table": "holding_register",
    "address": 24,
    "why": "Setpoint 1"
   },
   {
    "table": "holding_register",
    "address": 37,
    "why": "Setpoint output states"
   },
   {
    "table": "holding_register",
    "address": 102,
    "why": "Counter A decimal point"
   },
   {
    "table": "holding_register",
    "address": 163,
    "why": "Rate decimal point"
   }
  ],
  "enable": "Set Serial Protocol (40301) to 1 for Modbus RTU or 2 for Modbus ASCII (factory setting is RTU). Serial settings 40301-40306 only take effect after writing 1 to Load Serial Settings (40309).",
  "watchdog": null,
  "quirks": [
   "Values carry no decimal point; read the decimal point registers to scale them.",
   "The Slave ID block (41001+) reports a maximum of 64 registers per read or write."
  ],
  "setup": [
   "Factory settings: Modbus RTU, 38400 baud, 8 data bits, no parity, address 247 (Modbus range 1-247).",
   "Baud (40302), data bits (40303), parity (40304), address (40305) and transmit delay (40306, 1 = 1 ms) are registers in this table; write 1 to 40309 to apply them, then switch the master to the new settings."
  ],
  "gotchas": [
   "Counter values are read/write: a write overwrites the count."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/red-lion/paxi",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
