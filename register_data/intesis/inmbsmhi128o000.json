    "unit_id": null,
    "baud": null,
    "parity": null,
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": 502
  },
  "addressing": {
    "convention": "1-based",
    "note": "The tables say 'base addr is 1': printed register 1 is wire address 0. Indoor unit with Superlink address n (0..127) uses printed n x 20 + 1 .. n x 20 + 14, so wire n x 20 + 0..13. This file lists unit address 0 (printed 1..14, wire 0..13) and the all-unit block (printed 2995..3000)."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "Intesis Modbus Server - Mitsubishi Heavy Industries AC User's Manual",
    "doc_number": "User's Manual r1.0 eng",
    "revision_date": "2012-05",
    "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-inmbsmhixxxo000.pdf",
    "pages": "pp. 8-10 (Modbus interface and address map), p. 26 (error codes)"
  },
  "notes": [
    "Only indoor unit address 0 is listed. For unit address n add n x 20 to each wire address (unit 127 on/off: printed 2542, wire 2541).",
    "The manual says registers are 2-byte big-endian values but does not say signed or unsigned; all listed values are non-negative, so UINT16 is used.",
    "Temperatures are whole °C (no x10).",
    "Writes must use function 06 (single register). Reads use 03 or 04. A poll range containing an invalid address returns an exception.",
    "Error code numbers match MHI remote-controller E codes (value 40 = E40 high pressure); full table on p. 26 of the manual.",
    "INMBSMHI048O000 serves unit addresses 00..47 only."
  ],
