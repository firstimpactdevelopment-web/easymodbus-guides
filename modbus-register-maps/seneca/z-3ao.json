 "integration": {
  "summary": "Write normalized values to 40005-40007 (wire 4-6): 0-10000 maps to the electrical start/end scale of each output.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 4,
    "why": "OUT1 setpoint"
   },
   {
    "table": "holding_register",
    "address": 5,
    "why": "OUT2 setpoint"
   },
   {
    "table": "holding_register",
    "address": 6,
    "why": "OUT3 setpoint"
   },
   {
    "table": "holding_register",
    "address": 7,
    "why": "Error bits"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Bus timeout"
   }
  ],
  "enable": "Set the baud rate with DIP switches 1-2 and the address with switches 3-8, or set switches 3-8 OFF to use the EEPROM values in 40002/40004.",
  "watchdog": "With 40004 bit 7 set, if no bus traffic arrives for the time in 40003 (0.1 s units, default 20 s) the module sets 40008 bit 2 and copies 40069-40071 to the outputs.",
  "quirks": [
   "40002 packs baud code and address into one register.",
   "Output type follows the per-channel DIP switch."
  ],
  "setup": [
   "Write 0xBAB0 to 40009 to store settings in EEPROM."
  ],
  "gotchas": [
   "Bit 12 of 40004 selects old or new Z-3AO behaviour."
  ]
 },
