{
 "manufacturer": "Lumel",
 "manufacturer_slug": "lumel",
 "model": "NMID11 / NMID12 / NMID13 single-phase energy meter",
 "model_slug": "nmid12",
 "short_model": "NMID12",
 "aliases": [
  "NMID11",
  "NMID12",
  "NMID13"
 ],
 "equipment_type": "Energy meter (DIN-rail, single-phase, MID)",
 "applies_to": "Modbus RTU versions of the NMID11, NMID12 and NMID13 meters (NMID11/NMID13 are the CT-connected models); the LITE and MBUS versions have no Modbus port.",
 "summary": "Single-phase MID energy meters with an RS-485 Modbus RTU port. Values are IEEE-754 floats in two registers, high word first, readable as input registers (3X) and mirrored as holding registers (4X). This map covers the 3X measurement table: instantaneous values, demands, total, tariff and partial energies with overflow counters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "The measurement table prints Modicon numbers (30001) next to the hex start address (00 00). The hex column is the wire address, so 30001 is register 0 and power factor 30031 is 0x1E."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "NMID11, NMID12, NMID13 DIN rail mount single phase energy meter - User Manual",
  "doc_number": null,
  "revision_date": null,
  "url": "https://www.lumel.com.pl/resources/Pliki%20do%20pobrania/liczniki%20energii/NMID11_NMID12_NMID13_user_manual.pdf",
  "pages": "RS-485 section and example frames pp. 15-17; Table 4 3X/4X measured parameters pp. 17-21 (printed page numbers)"
 },
 "notes": [
  "Format is stated as 4 bytes per parameter, IEEE-754 float, most significant byte first; the example frames return 43 66 00 00 for 230 V and 40 A0 00 00 for 5 A, which settles high word first.",
  "The same values sit in the 4X (holding register) area at the same addresses; this map lists the 3X copy only.",
  "Left out: 0x54 (labelled the same as 0x56), 0xD8 (Partial Active Import Energy, printed with unit 'Wh' unlike its neighbours) and 0xF4 (Partial Total Reactive Energy, unit printed 'kArh'); the long-energy table 5 because its format is not spelled out; the 4X setup table and the assignable area.",
  "Energy registers count up to 99999.999 and the matching overflow register counts the roll-overs.",
  "Table 4 uses the label 'Total Apparent Energy' twice (0x7A/0x7C and 0x8A/0x8C), and likewise for the T1, T2 and partial groups; both copies are listed as printed."
 ],
