  "integration": {
    "summary": "Set DIP switch 9 on for Modbus, choose the address with SW3-SW5 (or 231 default), and poll 1992-2021 with function 03 at 19200 8E1. Read alarm_code/warning_code (2010/2011) when supervise_mode_status is not zero, and write a non-zero value to RESET_ALARM (2033) to clear a pending alarm.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1994,
        "why": "Stator temperature (PT100)"
      },
      {
        "table": "holding_register",
        "address": 1998,
        "why": "Water in oil"
      },
      {
        "table": "holding_register",
        "address": 2009,
        "why": "Normal / warning / alarm state"
      },
      {
        "table": "holding_register",
        "address": 2010,
        "why": "Alarm code"
      },
      {
        "table": "holding_register",
        "address": 2011,
        "why": "Warning code"
      },
      {
        "table": "holding_register",
        "address": 2012,
        "why": "Alarm bits"
      },
      {
        "table": "holding_register",
        "address": 2022,
        "why": "Running hours (minutes)"
      },
      {
        "table": "holding_register",
        "address": 2033,
        "why": "Reset alarm command"
      }
    ],
    "enable": "DIP switch 9 = on selects Modbus instead of GENIbus. Commands such as START, STOP, RESET_ALARM and RESET_HIST are executed by writing a non-zero value to their register.",
    "watchdog": null,
    "quirks": [
      "Register numbers are the wire addresses; do not subtract 1.",
      "Older PC Tool WU versions (before TC06.00.06) show unit numbers offset by 31 from the real address.",
      "FACT_BOOT and USER_BOOT only take effect after a RESET command or a power cycle; every other setting applies at once."
    ],
    "setup": [
      "Fixed format 19200 baud, 8 data bits, even parity, 1 stop bit.",
      "Address range 32-231 (factory 231). SW3-SW5 select 40-45; with them all off the address comes from unit_addr (2050)."
    ],
    "gotchas": [
      "Keep request and reply under 80 bytes, so read at most about 37 registers per request.",
      "Write no more than two configuration parameters per telegram."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
