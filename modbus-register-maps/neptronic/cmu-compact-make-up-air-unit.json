 "equipment_type": "Air handler (compact make-up air unit)",
 "applies_to": "Neptronic CMU compact make-up air units with the Modbus communication module, guide CMU-Modbus Guide-211125.",
 "summary": "The Neptronic CMU is a compact make-up air unit with an ECM fan, electric heater, damper, sensor inputs and an exhaust-fan output. Its Modbus RTU module exposes holding registers only: input voltages and temperatures, room temperature, RH, CO2, VOC and light from the TDF room sensor, supply and outdoor air readings, static pressure and airflow, set points and loop tuning, input/output configuration, occupancy and alarm flags.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "The guide prints the protocol-base (0-based) address and the holding register (base 40001) side by side, e.g. 23 / 40024. The protocol-base number is the wire address."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Compact Make-up Air Unit - Modbus Communication Module User Guide",
  "doc_number": "CMU-Modbus Guide-211125",
  "revision_date": "2021-11-25",
  "url": "https://www.neptronic.com/Heaters/pdf/20211206/CMU-Modbus%20Guide-211125.pdf",
  "pages": "p. 1 (requirements), pp. 2-8 (Modbus registers table)"
 },
 "notes": [
  "Only function codes 03, 06 and 16 are supported; every point is a 16-bit holding register.",
  "'Scale N' with 'Value x N' means raw = engineering value x N; this map stores the multiplier 1/N. Units follow the °C/°F setting.",
  "Left out: register 0 (product type / address; the byte description is garbled); network / TDF / anti-freeze temperature set points 32-34 and set point min/max 44-45 (Scale 100 but 'Value x 1'); static pressure offset 58 (Scale 10 but example 2 Pa = 200); System alarm host 105 (bits up to B31 printed for a 16-bit register).",
  "Alarm status (104) is printed with 'B8 to B31 = Reserved'; only bits 0-7 carry meanings and are listed.",
  "Both 22 and 23 rows read 'Binary output 1 state' in the guide; 23 is presumably binary output 2 but is copied as printed.",
  "Serial framing defaults are not given; the guide lists 9600-76800 baud with auto-baud detection as the default."
 ],
