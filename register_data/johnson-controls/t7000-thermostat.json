      {
        "table": "input_register",
        "address": 1,
        "why": "Room temperature x10"
      },
      {
        "table": "holding_register",
        "address": 4,
        "why": "Power on/off"
      },
      {
        "table": "holding_register",
        "address": 5,
        "why": "Mode"
      },
      {
        "table": "holding_register",
        "address": 6,
        "why": "Setpoint x10"
      },
      {
