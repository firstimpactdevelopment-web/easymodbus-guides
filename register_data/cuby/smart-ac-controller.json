    "parity": "None",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "0-based",
    "note": "The sheet prints both the protocol address (0-based, e.g. 4 for the setpoint) and the PLC address (1-based, 5). The protocol address goes on the wire. The sheet does not name function codes; the registers are listed here as holding registers because the writable rows can only be holding registers and all rows share one address list."
  },
