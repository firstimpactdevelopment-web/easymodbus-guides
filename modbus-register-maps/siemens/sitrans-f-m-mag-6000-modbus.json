 "integration": {
  "enable": "Fit the USM II Modbus RTU add-on module in the transmitter. The module adds a 'MODBUS RTU module' menu (between Reset mode and Service mode) for address, baud, parity/framing, timeouts and TAG; the same settings are writable at addresses 528-530.",
  "watchdog": null,
  "setup": [
   "Factory settings: address 1, 19200 baud, even parity, 1 stop bit; response delay 0, interframe space 3.5 characters.",
   "Baud 1200-115200; framing 8E1, 8O1, 8N2 or 8N1.",
   "RS-485 2-wire on screw terminals; up to 31 devices per segment without repeaters.",
   "Modbus settings live in the module; after swapping the module they must be written again from the master."
  ],
  "summary": "Read holding registers (FC 03) from address 3002 for volume flow and 3014/3018 for the double totalizers; values are big-endian IEEE, high word first. Use coils 9-12 to reset or hold the totalizers.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 3002,
    "why": "Volume flow"
   },
   {
    "table": "holding_register",
    "address": 3014,
    "why": "Totalizer 1 (double)"
   },
   {
    "table": "holding_register",
    "address": 3018,
    "why": "Totalizer 2 / batch (double)"
   },
   {
    "table": "holding_register",
    "address": 3200,
    "why": "System status bits"
   },
   {
    "table": "holding_register",
    "address": 3201,
    "why": "First pending error"
   },
   {
    "table": "holding_register",
    "address": 2906,
    "why": "Volume flow unit ID"
   }
  ],
  "quirks": [
   "Use the address column (0-based); 4:03003 is address 3002.",
   "Max 26 registers per read and 25 per write.",
   "No input registers or discrete inputs: everything is holding registers and coils."
  ],
  "gotchas": [
   "The module does not react to broadcasts that need an answer; broadcast writes get no reply.",
   "If the reply is not ready within the response timeout the module returns exception 6 (busy); repeat the request."
  ]
 },
