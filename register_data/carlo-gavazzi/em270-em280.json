  "integration": {
    "summary": "Over RS485 read input registers (function 04, or 03) in short blocks: 0000h-000Ah for voltages, 010Ch-0120h for load 1 (TCDA1) and 020Ch-0220h for load 2 (TCDA2). All values are INT32 low word first with fixed scaling.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "V L1-N (x0.1 V)"
      },
      {
        "table": "input_register",
        "address": 268,
        "why": "TCDA1 current L1 (x0.001 A)"
      },
      {
        "table": "input_register",
        "address": 280,
        "why": "TCDA1 total power (x0.1 W)"
      },
      {
        "table": "input_register",
        "address": 286,
        "why": "TCDA1 kWh(+) (x0.1 kWh)"
      },
      {
        "table": "input_register",
        "address": 536,
        "why": "TCDA2 total power"
      },
      {
        "table": "input_register",
        "address": 542,
        "why": "TCDA2 kWh(+)"
      },
      {
        "table": "input_register",
        "address": 11,
        "why": "Model ID"
      }
    ],
    "enable": "Modbus RTU runs on the built-in RS485 port. Address, baud and parity are set from the meter's configuration or written at 2000h-2002h.",
    "watchdog": null,
    "quirks": [
      "32-bit values are low word first (CDAB).",
      "Keep reads to 16 registers or fewer (the request table caps the count at 10h); ID and version words are read one at a time.",
      "Totals at 000Ch-0024h are only available with the SUM/Virtual function on.",
      "Out-of-range markers: the high word (second register) reads 7FFFh on overflow, 7FFDh when the variable is not part of the selected measuring system and 7FFEh when a needed TCD is missing; the low word is then FFFFh."
    ],
    "setup": [
      "Baud options: 9600, 19200, 38400; parity none or even.",
      "Choose the measuring system (1002h) to match how the two TCD inputs are wired."
    ],
    "gotchas": [
      "A value is valid only if the meter also shows it on the display for the selected system.",
      "Maximum answer time is 500 ms; keep the master timeout above that."
    ]
  },
