 "equipment_type": "Sensor (Ethernet analog / digital output module)",
 "applies_to": "TCW280 per the Teracom TCW280 user manual TCW280_R1.8.",
 "summary": "The TCW280 is a Teracom Ethernet module with 2 isolated analog outputs (0-5/0-10 V or 0-20/4-20/0-24 mA), 4 open-drain digital outputs with ON/OFF or PWM mode and 2 relays. Over Modbus TCP the relays and digital outputs are coils, and modes, ranges, setpoints and alarms are holding registers.",
 "transport": [
  "TCP"
 ],
