  },
  "addressing": {
    "convention": "1-based",
    "note": "The table numbers points from 1. The demo frames settle it: reading room temperature (address 2) sends start address 00 01, and powering on (address 5) writes to 00 04, so wire address = listed address - 1."
  },
  "default_word_order": null,
