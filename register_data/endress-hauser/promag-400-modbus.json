  "integration": {
    "summary": "Set bus address, baud rate and parity on the device, then read volume flow (register 3874, wire 3873) and totalizer 1 (register 2610, wire 2609) with function 03 or 04 as CDAB floats. Reset totalizers by writing to the totalizer control registers.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 3873,
        "why": "Volume flow"
      },
      {
        "table": "holding_register",
        "address": 3875,
        "why": "Mass flow"
      },
      {
        "table": "holding_register",
        "address": 2609,
        "why": "Totalizer 1 value"
      },
      {
        "table": "holding_register",
        "address": 2102,
        "why": "Volume flow unit code"
      },
      {
        "table": "holding_register",
        "address": 2731,
        "why": "Active diagnostic"
      },
      {
        "table": "holding_register",
        "address": 2607,
        "why": "Totalizer 1 control (reset/hold)"
      }
    ],
    "enable": "Modbus settings are under Expert > Communication > Modbus configuration. Writing over the bus can be limited with the Fieldbus writing access parameter (Read + write or Read only).",
    "watchdog": null,
    "quirks": [
      "Floats default to CDAB because of the 1-0-3-2 byte order; the order is selectable on the device.",
      "Failure mode (register 4920) chooses whether measured values go to NaN or hold the last valid value during a fault."
    ],
    "setup": [
      "Factory settings: address 247, 19200 baud, Even parity, RTU.",
      "Telegram delay (default 6 ms) can be raised for slow masters."
    ],
    "gotchas": [
      "Writing parameters cyclically wears out the EEPROM.",
      "Flow and totalizer values are sent in the units set in the unit registers, so changing a unit on the device changes what the numbers mean."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
