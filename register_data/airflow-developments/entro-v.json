  "integration": {
    "summary": "Wire RS-485 to the MODBUS connector on the control board, poll address 1 at 9600 8N1 with FC03, and use FC06 to write. Start/stop with ID 1, set fan stages with IDs 101/102 and the set point with ID 128; watch ID 2 for faults.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1,
        "why": "Unit on/off"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Alarm code"
      },
      {
        "table": "holding_register",
        "address": 101,
        "why": "Fresh air fan speed stage"
      },
      {
        "table": "holding_register",
        "address": 102,
        "why": "Exhaust air fan speed stage"
      },
      {
        "table": "holding_register",
        "address": 22,
        "why": "Supply air temperature"
      },
      {
        "table": "holding_register",
        "address": 20,
        "why": "Outdoor air temperature"
      },
      {
        "table": "holding_register",
        "address": 21,
        "why": "Return air temperature"
      },
      {
        "table": "holding_register",
        "address": 128,
        "why": "Set temperature"
      }
    ],
    "enable": "Modbus is built into the control board. Slave address (ID 153), link speed (ID 154, 0 = 9600) and frame type (ID 155, 0 = N81 RTU) are service-level parameters in the full list.",
    "watchdog": null,
    "quirks": [
      "Only FC03 and FC06 are supported: no FC04, no FC16 multi-register writes.",
      "IDs are 0-based wire addresses.",
      "Fan speed stage values run 0 = Low, 1 = Mid, 2 = High, 3 = Stop."
    ],
    "setup": [
      "Defaults: address 1, 9600 baud, no parity, 8 data bits, 1 stop bit.",
      "Fit a 120 ohm terminating resistor at each end of a long RS-485 line, as the manual advises.",
      "Avoid duplicate addresses when several units share the bus."
    ],
    "gotchas": [
      "The link to the digital controller panel uses its own Modbus address parameters (IDs 235/236), separate from the BMS slave address (ID 153)."
    ]
  },
  "verified": {
