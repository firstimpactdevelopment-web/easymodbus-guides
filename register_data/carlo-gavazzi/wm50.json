  "integration": {
    "summary": "Read input registers (function 04, or 03) from 0050h as low-word-first floats for main-feeder values and 0500h-051Fh as UINT64 Wh/varh counters (least significant word first). Branch circuits start at C200h, 14 registers per channel.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 80,
        "why": "V L1-N (float)"
      },
      {
        "table": "input_register",
        "address": 96,
        "why": "A L1 (float)"
      },
      {
        "table": "input_register",
        "address": 110,
        "why": "W system (float)"
      },
      {
        "table": "input_register",
        "address": 134,
        "why": "PF system"
      },
      {
        "table": "input_register",
        "address": 136,
        "why": "Frequency"
      },
      {
        "table": "input_register",
        "address": 1280,
        "why": "Total kWh+ in Wh"
      },
      {
        "table": "input_register",
        "address": 11,
        "why": "Model ID (99 = WM50)"
      },
      {
        "table": "input_register",
        "address": 49666,
        "why": "Branch channel 1 active power"
      }
    ],
    "enable": "Fit a communication module (the status word at 4002h shows MC485232 or MCETH as present) and set its communication parameters on the instrument as described in the WM50 instruction manual; this document does not list them.",
    "watchdog": null,
    "quirks": [
      "Floats are low word first (CDAB).",
      "64-bit energy counters are least significant word first and in Wh/varh.",
      "Functions 03 and 04 are equivalent; up to 125 registers per read.",
      "Input port status bits are inverted: 0 = closed."
    ],
    "setup": [
      "Terminate the last instrument and the host on RS485; above 1000 m use a line amplifier.",
      "Assign each TCD channel to a phase; register C100h + (channel - 1) shows the assignment."
    ],
    "gotchas": [
      "Wait at least 1 s after a function 10h reset before the next query.",
      "Check register 4007h after installation: any bit set means a wiring error to correct."
    ]
  },
  "verified": {
    "date": "2026-10-29",
    "method": "independent re-check of every register against the source PDF"
  }
