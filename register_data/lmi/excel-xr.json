  ],
  "equipment_type": "Pump (chemical metering pump)",
  "applies_to": "LMI Excel XR electronic metering pumps fitted with the Modbus RTU interface (manual 55312 rev 04).",
  "summary": "The Excel XR is a stepper-driven chemical metering pump from LMI (Milton Roy). Its Modbus RTU version exposes coils for on/off, prime and mode selection, holding registers for flow setpoints and I/O configuration, input registers for live flow, analog I/O and totalizers, and discrete inputs for status and alarms. This map covers the control, live-value and alarm points plus the main mode settings.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": null,
    "baud": null,
    "parity": null,
    "data_bits": null,
    "stop_bits": null,
    "tcp_port": null
  },
  "addressing": {
    "convention": "1-based",
    "note": "Every table says PLC addressing (base 1) is used and lists each point as decimal and hex (holding register 1 = 0x0001). Request address n-1 on the wire: manual flow rate (1) is wire address 0."
  },
  "default_word_order": "ABCD",
  "firmware": null,
  "source": {
    "title": "Excel XR Series Electronic Metering Pump Modbus RTU Manual",
    "doc_number": "55312 Rev 04",
    "revision_date": "2020-03",
    "url": "https://www.pumpworld.com/assets/lmi-excel-xr-chemical-pump-modbus-manual.pdf",
    "pages": "Settings p. 7; functions p. 8; coils p. 9; holding registers pp. 10-15; input registers pp. 16-17; discrete inputs pp. 17-19",
    "unofficial": true
  },
  "notes": [
    "LMI does not host this manual publicly as far as we could find; the linked copy is the unaltered LMI manual hosted by a distributor (Pumpworld).",
    "Multi-register values: the manual states the first register holds the high-order value, so 32- and 64-bit counters are high word first (ABCD).",
    "Pulse mode volume (13-14) and batch mode volume (17-18) are left out: the manual gives a decimal range for a two-register integer but no scale.",
    "Timed event, RTC, password and stay-prime registers are left out; stay-prime remaining time and weekly event time have no stated units or length conflicts.",
    "Flow values are in GPH or L/h and volumes in gallons or litres depending on the units setting (coil 13 / discrete input 14)."
  ],
  "integration": {
    "summary": "Set slave address, bit rate, parity and stop bits on the pump's Communication Settings screen. Read input register 3 for live flow and discrete inputs 1 and 101 for running and global alarm; set the flow with holding register 1 and start/stop with coil 1.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 2,
        "why": "Current flow rate"
      },
      {
        "table": "input_register",
        "address": 3,
        "why": "Flow percentage"
      },
      {
        "table": "discrete_input",
        "address": 0,
        "why": "Running status"
      },
      {
        "table": "discrete_input",
        "address": 100,
        "why": "Global alarm"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Manual mode flow setpoint"
      },
      {
        "table": "coil",
        "address": 0,
        "why": "On/off toggle"
      },
      {
        "table": "coil",
        "address": 5,
        "why": "Select manual mode"
      }
    ],
    "enable": "Modbus settings are on the pump display under Settings > Communication Settings: slave address 1-125, bit rate 9600/19200/38400/115200 or Auto, parity none/even/odd, 1 or 2 stop bits, internal line termination on/off.",
    "watchdog": null,
    "quirks": [
      "Coil 1 toggles on/off rather than setting a state; read discrete input 1 to know the result.",
      "Flow values are four-digit integers with two implied decimals (1234 = 12.34)."
    ],
    "setup": [
      "With Auto bit rate the pump hunts for the speed, so the first messages may fail; set the rate explicitly when known.",
      "Enable internal termination on the last device on the bus. Connection is an M12 5-pin B-coded connector (pin 2 D0, pin 4 D1, pin 3 DGND)."
    ],
    "gotchas": [
      "Function code 07 (read exception status) and 17 (report server ID) are also supported."
    ]
  },
