 "integration": {
  "summary": "Set H5-01..H5-03 at the keypad and power-cycle, set b1-01 = 2 and b1-02 = 2, then write 0001h and 0002h with function 10h and poll 0020h-002Dh and 0040h-0046h.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 1,
    "why": "Run/stop, direction, reset"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Frequency reference"
   },
   {
    "table": "holding_register",
    "address": 32,
    "why": "Run/fault status"
   },
   {
    "table": "holding_register",
    "address": 33,
    "why": "Fault summary"
   },
   {
    "table": "holding_register",
    "address": 44,
    "why": "Status incl. comm timeout"
   },
   {
    "table": "holding_register",
    "address": 65,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 66,
    "why": "Output current"
   },
   {
    "table": "holding_register",
    "address": 128,
    "why": "Current fault code"
   }
  ],
  "enable": "H5-01 node address (default 1Fh, 0h-20h), H5-02 baud (default 3 = 9600), H5-03 parity (default none); cycle power. b1-01 = 2 and b1-02 = 2 select Modbus for reference and run (or set 0001h bits 4/5).",
  "watchdog": "H5-05 = 1 (default) enables CE detection; H5-04 selects the response: 0 ramp, 1 coast, 2 fast-stop, 3 alarm only (default). 002Ch bit F shows a comm timeout.",
  "quirks": [
   "Registers and the node address are hex.",
   "Read 1-8 registers per 03h message.",
   "Command registers (0000h-00FFh) act immediately; parameter writes (0100h-07FFh) wait in an off-line area until 0 is written to 0910h (ACCEPT) or 0900h (ENTER, about 100,000 writes). Unconfirmed writes cause 'Busy Write Protected' on the keypad.",
   "Network digital inputs are ORed with the physical terminals."
  ],
  "setup": [
   "RS-422/485 on control terminals R+, R-, S+, S- (see the G7 user manual for 2-wire wiring).",
   "Node address 1-20h; 0 is broadcast and is not valid for reads.",
   "8 data bits, 1 stop bit; 1200-19200 baud."
  ],
  "gotchas": [
   "Two output-current registers use different resolutions (0026h 0.01 A, 0042h 0.1 A)."
  ]
 },
