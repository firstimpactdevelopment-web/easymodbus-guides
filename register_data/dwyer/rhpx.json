  "integration": {
    "summary": "Set the address with DIP switches 1-8 and switch 9 to Modbus, power up and let the transmitter auto-detect the line settings from the master's traffic, then read input registers 0-17 as big-endian floats.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "Relative humidity"
      },
