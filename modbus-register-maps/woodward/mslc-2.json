 "integration": {
  "summary": "Block-read up to 128 holding registers from wire address 50000 for frequencies, phase angle, modes, flags and alarms, and from 50100 for 32-bit system A power, voltages and currents. Release functions to the interface in 7645, switch them in 7644, and write setpoints to 7640-7642 and 7780.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 50010,
    "why": "System A (utility) frequency"
   },
   {
    "table": "holding_register",
    "address": 50023,
    "why": "System B (bus) frequency"
   },
   {
    "table": "holding_register",
    "address": 50032,
    "why": "Phase angle A / B"
   },
   {
    "table": "holding_register",
    "address": 50056,
    "why": "Synchronizer state"
   },
   {
    "table": "holding_register",
    "address": 50057,
    "why": "Load control mode"
   },
   {
    "table": "holding_register",
    "address": 50075,
    "why": "Alarms 1"
   },
   {
    "table": "holding_register",
    "address": 50100,
    "why": "Total system A power (32-bit)"
   },
   {
    "table": "holding_register",
    "address": 50156,
    "why": "P sum"
   }
  ],
  "enable": "RS-485 (serial interface 2): Modbus slave ID 3188 (default 1; 0 disables Modbus), baud 3170 (default 19.2 kBd), parity 3171 (default none), stop bits 3172 (default one). Network A/B Modbus/TCP slave IDs are 5351/5451 (default 255).",
  "watchdog": "No timeout parameter is given. After an interface connection loss the discrete-input states stay as they were; energising DI 22 'Modbus reset' hands all functions back to hardware control and clears the control bits.",
  "quirks": [
   "Some PLCs need the address shifted by one; the manual notes 450001 may become bus address 50000.",
   "32-bit parameters such as 7642 and 7780 are written as two registers in one request, high word first."
  ],
  "setup": [
   "Network A default IP 192.168.0.33 and network B default 192.168.1.33 (parameters 5330-5333 / 5430-5433); Woodward recommends the MSLC-2 device number (33-48) as the last octet.",
   "RS-485 reply delay is parameter 3189 (0.00-2.55 s)."
  ],
  "gotchas": [
   "Releasing Run/Permissive to the interface lets the PLC close the utility tie breaker through synchronisation; test carefully.",
   "CB Aux and Modbus reset stay hardware controlled even when released in 7645."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/woodward/mslc-2",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
