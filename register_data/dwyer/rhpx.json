        "why": "Dew point °C"
      },
      {
        "table": "input_register",
        "address": 18,
        "why": "Error flags"
      }
    ],
    "enable": "DIP switch 9 ON selects Modbus (OFF = BACnet); switches 1-8 set the address bits (128...1), switch 10 enables the 120 ohm terminator. Modbus addresses must be 1-247.",
    "watchdog": null,
    "quirks": [
      "Register address = register number - 1.",
      "Pick the byte order by address range (+2000/+4000/+6000) instead of configuring the master.",
      "The red LED blinks until the transmitter has locked onto the bus settings; if the bus settings change, power-cycle it."
    ],
    "setup": [
      "Terminate the RS-485 line at both ends with 120 ohm (switch 10 on an end device).",
      "If the transmitter is set up offline, send read requests to it so it can detect the baud rate."
    ],
    "gotchas": [
      "The factory DIP setting is address 127; change it before putting several units on one bus."
    ]
  },
