  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Register numbers are hex and are sent unchanged: the 03H example reads starting address 00 20 (drive status) and the 10H example writes from 00 01."
 },
