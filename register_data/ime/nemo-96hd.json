  "integration": {
    "summary": "Read holding registers (function 03) from 0x1000 for voltages and currents in mV/mA, power factor, frequency and THD. Double words are high word first.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 4096,
        "why": "Phase 1 voltage"
      },
      {
        "table": "holding_register",
        "address": 4102,
        "why": "Phase 1 current"
      },
      {
        "table": "holding_register",
        "address": 4134,
        "why": "Frequency"
      },
      {
        "table": "holding_register",
        "address": 4132,
        "why": "3-phase power factor"
      }
    ],
    "enable": "Set the address, baud rate and parity on the meter (both are programmable). Only functions 03 and 0x10 are used. Setup writes need the unlock key 0x5AA5 written to 0x2700 first.",
    "watchdog": null,
    "quirks": [
      "Only functions 03 and 0x10 are supported (no function 04).",
      "A single request may ask for at most 240 bytes of data (100 bytes on software older than 1.09).",
      "Voltages and currents are in mV and mA."
    ],
    "setup": [
      "Baud rate and parity are programmable on the device; 8 data bits and 1 stop bit."
    ],
    "gotchas": [
      "Power and energy values are not in this map because their scale depends on the CT/VT ratio; see the protocol footnotes before using them."
    ]
  },
  "model": "Nemo 96HD multifunction meter (MF96001 / MF96021)",
