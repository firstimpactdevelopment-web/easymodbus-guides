 "integration": {
  "summary": "Poll 300 for running/faulted/bypass state, 304/305 for fault and warning bits, 340 for average line current (0.1 A) and 361 for kW. Control the motor with register 500 (permissive bit 2 plus run bit 0) or 501 in two-wire mode, and set 684 for comm-loss behaviour.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 299,
    "why": "Status word"
   },
   {
    "table": "holding_register",
    "address": 303,
    "why": "Fault bits"
   },
   {
    "table": "holding_register",
    "address": 304,
    "why": "Warning bits"
   },
   {
    "table": "holding_register",
    "address": 339,
    "why": "Average line current"
   },
   {
    "table": "holding_register",
    "address": 360,
    "why": "Real power"
   },
   {
    "table": "holding_register",
    "address": 306,
    "why": "Thermal pile"
   },
   {
    "table": "holding_register",
    "address": 499,
    "why": "Network control word"
   }
  ],
  "enable": "Network control needs 623 = 0 (local-only off); 687 selects three-wire (500, which also needs permissive bit 2 set) or two-wire (501) control. Modbus TCP is served by the C441 module (IP via DHCP, NV memory or DIP switches).",
  "watchdog": "684 sets the motor's comm-loss action (auto stop, run, hold or all-stop fault); 686 is the comm idle timeout that raises a device-missing fault; 110/159 set adapter-level Modbus timeouts.",
  "quirks": [
   "Register numbers are 1-based; subtract 1 on the wire.",
   "Run1 in register 500 is edge-sensitive, but in 501 it is level-sensitive."
  ],
  "setup": [
   "S811+ Modbus settings 503 (baud) and 505 (parity) take effect only after a power cycle; the node address 504 is read from the DIP switches at power-up."
  ],
  "gotchas": [
   "Writing 101 (adapter relay outputs) can change the relay states."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/eaton/s811-plus-soft-starter",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
