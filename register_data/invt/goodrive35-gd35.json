{
  "manufacturer": "INVT",
  "manufacturer_slug": "invt",
  "model": "Goodrive35 (GD35) closed-loop vector VFD",
  "model_slug": "goodrive35-gd35",
  "short_model": "GD35",
  "aliases": [
    "GD35",
    "Goodrive35",
    "GD35 vector VFD"
  ],
  "equipment_type": "Variable frequency drive",
  "applies_to": "INVT Goodrive35 closed-loop vector drives using the built-in RS-485 Modbus RTU port, per the GD35 VFD manual V4.0 (communication protocol chapter).",
  "summary": "INVT's closed-loop vector drive for high-performance machinery, with encoder feedback support. The built-in RS-485 port speaks Modbus RTU. Commands and setpoints go to the 2000H block, status and fault words sit at 2100H-2103H, monitors at 3000H onwards, and each function parameter has its own hex address. This map covers that block plus the run-source, P14 serial and fault parameters.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 19200,
    "parity": "Even",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "hex 0-based",
    "note": "Addresses are printed in hex and go on the wire unchanged. Parameter P00.00 sits at 0000H and the manual's example frames carry the address bytes directly (setting P01.20 is sent as 01 06 01 14 00 32, and the multi-register write starts at 20 00)."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "Goodrive35 Series Closed-loop Vector Control VFD Operation Manual",
    "doc_number": "V4.0",
    "revision_date": "2022-05",
    "url": "https://www.invt.com/uploads/file1/20220622/GD35-Series-VFD-Manual_V4.0.pdf",
    "pages": "P00 group, P07.27 fault list, P14 group, pp. 232-236 (other function addresses, fieldbus scale)"
  },
  "notes": [
    "Every register is a single 16-bit word; there are no 32-bit values in this map.",
    "Any function parameter can be read or written at (group << 8) | index; only the parameters an integrator needs most are listed here.",
    "3016H (identification code) and 5000H (fault code) are printed without range or unit, so they are left out; 2102H and 2103H carry the same information.",
    "300FH, 3010H (pulse input printed with a mixed kHz/0.01 Hz unit) and 3011H are left out.",
    "P00.02 values other than 0 select option cards; only 0 (Modbus) is listed."
  ],
