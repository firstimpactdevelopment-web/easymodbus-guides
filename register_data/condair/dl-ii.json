  "manufacturer": "Condair",
  "manufacturer_slug": "condair",
  "model": "DL II hybrid humidifier (Integrated Controller, Modbus RTU/TCP)",
  "model_slug": "dl-ii",
  "short_model": "DL II",
  "aliases": [
    "Condair DL",
