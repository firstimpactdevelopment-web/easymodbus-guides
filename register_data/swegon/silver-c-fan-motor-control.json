  "model": "SILVER C fan motor control (RX/PX/CX/SD, generation E/F)",
  "model_slug": "silver-c-fan-motor-control",
  "short_model": "SILVER C fan control",
  "aliases": [
    "SILVER C RX",
    "SILVER C PX",
    "SILVER C CX",
    "SILVER C SD",
    "SILVER C generation E",
    "SILVER C generation F"
  ],
  "equipment_type": "Air handler fan motor control",
  "applies_to": "The EC/FC fan motor controllers inside Swegon SILVER C air handling units, generation E/F, document SILVERCModbus.210809.",
  "summary": "Each supply or extract fan in a SILVER C air handler has its own motor controller with a Modbus RTU slave port. Over it a master can start and stop the fan, give a speed setpoint in percent, reset alarms and read speed, current, power, temperatures, run time and an energy log. Configuration values such as ramp times, I/O module functions and the serial settings are holding registers.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": 54,
    "baud": 38400,
    "parity": "None",
    "data_bits": null,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "1-based",
    "note": "Every table prints the reference (0x0001, 1x0001, 3x0001, 4x0001) and the protocol address next to it; the address column is the reference number minus 1 (4x0001 = address 0). The address column is used here."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "Modbus RTU SILVER RX, PX, CX, SD, generation E/F",
    "doc_number": "SILVERCModbus.210809",
    "revision_date": null,
    "url": "https://www.swegon.com/globalassets/digizuite/12063-en-silverc_modbus_other_en.pdf",
    "pages": "p. 3 comm settings (table 2), p. 4 coils (table 3), p. 5 discrete inputs (table 4), pp. 6-7 input registers (tables 5-6), pp. 8-10 holding registers (table 7)"
  },
  "notes": [
    "Scales and units are for the EC configuration. In the FC configuration speed values (3x0005, 4x0002, 4x0003) are in 0.01 Hz instead of rpm; this is said in the description of those registers.",
    "Discrete inputs 26 and 27 are printed with a 0x prefix (0x0027, 0x0028) inside the discrete-input table; they are kept as discrete inputs at the printed addresses.",
    "Left out: 3x0014 config file variant (two ASCII characters), 3x0019 AOC SW variant (no range or unit), the product name characters 3x2004-3x2012 (the address column switches between decimal and hex there), 4x0033/4x0034 relay configuration and 4x0037 analog input 2 (option tables mostly TBD / N/A).",
    "Run time is split into minutes (0-1439) and days; energy is split into Wh, kWh and MWh parts. Add the parts yourself."
  ],
