  "integration": {
    "summary": "Read holding registers (FC03 or FC04) from 7000: 3 x 7 per-phase floats then 3-phase totals and frequency, high word first. Energy totals are the float pairs at 7096-7110 or the 32-bit counters at 4038-4045 (divide by 10).",
    "minimum_registers": [
      {
        "table": "holding_register",
