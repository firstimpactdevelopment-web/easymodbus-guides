{
 "manufacturer": "Walchem",
 "manufacturer_slug": "walchem",
 "model": "WebMaster WIND series Modbus TCP/IP option (s825)",
 "model_slug": "webmaster-wind",
 "short_model": "WebMaster WIND",
 "aliases": [
  "WIND",
  "WebMaster WIND",
  "s825"
 ],
 "equipment_type": "Water treatment controller (Sensor / controller)",
 "applies_to": "Walchem WebMaster WIND-series controllers with the Modbus TCP/IP option, software s825v008 and higher, per manual 180413 Rev A1.",
 "summary": "The WIND-series WebMaster is an older Walchem water treatment controller. Its Modbus TCP/IP option serves holding registers on port 502. This map covers the live dynamic values: direct sensor readings and temperatures, 4-20 mA analog inputs and totals, analog outputs and the calculated RSI/LSI indices, all as word-swapped 32-bit floats.",
 "transport": [
  "TCP"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "1-based",
  "note": "Section 4.5.1 says the published addresses are 1-based and the packet is 0-based; subtract 1 on the wire (sensor 1 current reading 3001 / 43001 is wire address 3000)."
 },
 "default_word_order": "CDAB",
 "firmware": "s825v008 and higher",
 "source": {
  "title": "WebMaster Modbus TCP/IP Option Instruction Manual (WIND series)",
  "doc_number": "180413 Rev A1",
  "revision_date": null,
  "url": "https://walchem.com/literature/Controllers/WM/180413_WIND%20Modbus%20Manual_V08-10.pdf",
  "pages": "pp. 4-6 (encoding, addressing), pp. 26-27 (dynamic data)"
 },
 "notes": [
  "Floats use the 'float inverse' format: the manual shows 0x12345678 transmitted as 0x56 0x78 0x12 0x34, i.e. low word first (CDAB).",
  "Left out: digital input states, which the manual describes both as single bits and as 0 = open / 256 = closed, so the encoding is unclear; also relay interlock and volume values on pp. 28-31, whose table layout could not be read reliably.",
  "Left out: status, alarm and header/custom-name registers, and all set point writes (pp. 32-80). The write addresses depend on how each input is configured.",
  "This is the older WIND-series manual; WebMaster ONE / WM1 uses manual 180422 and has a different analog output layout (3681 = % output there)."
 ],
