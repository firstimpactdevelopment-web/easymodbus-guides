  "integration": {
    "summary": "License GLT with the supplied USB dongle, then poll input registers 0-59 and discrete inputs 0-7 over Modbus TCP and write holding registers 0-23 for outdoor temperature, setpoints and modes.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 37,
        "why": "Plant status"
      },
      {
        "table": "input_register",
        "address": 0,
        "why": "Mean outdoor temperature"
      },
      {
        "table": "input_register",
        "address": 1,
        "why": "Flow temperature"
      },
      {
        "table": "input_register",
        "address": 2,
        "why": "Return temperature"
      },
      {
        "table": "input_register",
        "address": 4,
        "why": "Hot water temperature"
      },
      {
        "table": "input_register",
        "address": 46,
        "why": "Active fault"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Return temperature setpoint"
      },
      {
        "table": "holding_register",
        "address": 7,
        "why": "Heating mode"
      },
      {
        "table": "holding_register",
        "address": 14,
        "why": "Smart grid state"
      },
      {
        "table": "coil",
        "address": 0,
        "why": "Fault reset"
      }
    ],
    "enable": "Configure GLT with the Novelan GLT Tool, then insert the supplied USB dongle in the controller's USB port to unlock GLT permanently (otherwise only a test phase runs). Check Service > Informationen > GLT on the controller.",
    "watchdog": null,
    "quirks": [
      "To stop forcing a value, write a value outside its limits (holding registers) or 0 (coils); otherwise the written value stays in force.",
      "Only the currently active fault is shown in input register 46."
    ],
    "setup": [
      "Modbus TCP uses the controller's IP address and port 502; set the IP under Service > Systemsteuerung (DHCP server, DHCP client or fixed IP)."
    ],
    "gotchas": [
      "Controllers with software older than the Modbus TCP versions listed can only use BACnet/IP."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
