{
 "manufacturer": "Yaskawa",
 "manufacturer_slug": "yaskawa",
 "model": "GA800 AC drive (MEMOBUS/Modbus RTU)",
 "model_slug": "ga800",
 "short_model": "GA800",
 "aliases": [
  "CIPR-GA80",
  "GA800 Industrial AC Microdrive"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "Yaskawa GA800 drives using the built-in RS-485 MEMOBUS/Modbus port, per technical reference SIEPC71061737 revision G.",
 "summary": "Yaskawa's general-purpose industrial variable frequency drive with a built-in RS-485 MEMOBUS/Modbus RTU port. Commands go to hex registers 0001H-000FH, status, faults and monitors are read from 0020H onwards, and each parameter has its own hex register. This map covers the command block, status and fault words, the key monitors with fixed units and the b1/H5 communication parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 31,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Register numbers are hex and are sent unchanged: the manual's read example asks for starting register 0020H as 00 20. Parameters use the hex number printed under each parameter (H5-01 = 0425H)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "GA800 Drive Technical Reference",
  "doc_number": "SIEPC71061737G",
  "revision_date": "2026-03",
  "url": "https://www.yaskawa.com/delegate/getAttachment?documentId=SIEPC71061737&cmd=documents&documentName=SIEPC71061737.pdf",
  "pages": "Section 6.3: communication specs p. 348, function codes and examples pp. 349-356, Enter command p. 358, Table 6.15 command data pp. 360-363, Table 6.16 monitor data pp. 364-367; b1-01/b1-02 and H5 parameter details in chapter 12"
 },
 "notes": [
  "Frequency registers 0002H, 0023H and 0024H use the units chosen in o1-03, so they are left unscaled.",
  "Left out: 0025H output voltage (unit switched by H5-10), 0026H output current (0.1 A in Table 6.16, but U1-03 resolution can depend on drive capacity), 0027H output power and 0028H/0032H torque reference (units/sign not fixed in the table), 002FH frequency reference bias, 0034H/0035H product codes, and the long fault-history and U-monitor blocks from 0040H.",
  "b1-02 option 1 is Digital Input in the parameter list; the detailed parameter section misprints it as Analog Input. It means the control circuit terminals.",
  "Supported function codes are 03H, 08H, 10H, 5AH and 67H (non-consecutive read/write); there is no 06H, so use 10H even for a single register. A 03H read returns at most 16 registers.",
  "With H5-11 = 0 parameter writes only take effect after writing 0 to 0900H (EEPROM) or 0910H (RAM). Command registers 0001H-000FH never need Enter. Reading 0900H/0910H returns error 02H."
 ],
