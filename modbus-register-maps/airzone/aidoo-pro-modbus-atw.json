{
 "manufacturer": "Airzone",
 "manufacturer_slug": "airzone",
 "model": "Aidoo Pro Modbus control for air-to-water heat pumps",
 "model_slug": "aidoo-pro-modbus-atw",
 "short_model": "Aidoo Pro Modbus ATW",
 "aliases": [
  "Aidoo Pro",
  "Aidoo Pro Modbus air-to-water",
  "Airzone Aidoo Modbus aerothermal"
 ],
 "equipment_type": "Heat pump Modbus interface",
 "applies_to": "Airzone Aidoo Pro units configured for Modbus output and connected to an air-to-water heat pump; register table 'Registers for Air-to-Water HP units' of the Aidoo - Modbus integration manual (v. 201).",
 "summary": "Modbus RTU map that an Airzone Aidoo Pro serves when it is connected to an air-to-water heat pump: on/off and mode, water, air and DHW setpoints for one or two circuits, setpoint limits, water and refrigerant temperatures, flow, pressure, error codes and 32-bit energy counters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "Registers are numbered from 0 (unit on/off is register 0) and the command description puts this number in the 'register address' field, so the printed number is the wire address."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "Integration Manual Aidoo - Modbus",
  "doc_number": "v. 201",
  "revision_date": null,
  "url": "https://thermosilesia.pl/assets/default/system_object_files/4bc5a150b45a2a7401add97664eff2aa.pdf",
  "pages": "pp. 4-8 (serial settings, frames), pp. 14-19 (air-to-water registers)",
  "unofficial": true
 },
 "notes": [
  "Distributor copy: airzonecontrol.com answers automated requests with a bot check (not bypassed) and no other Airzone-hosted copy was found; this multilingual PDF carries Airzone's own layout and address.",
  "32-bit energy counters are low word first: the manual's example (1) 0x1215, (2) 0x0001 = 0x00011215 = 70165 kWh, so CDAB.",
  "ACS in the manual means domestic hot water (DHW). C1 / C2 are water circuits 1 and 2.",
  "The manual does not state signed or unsigned for 16-bit values; the remaining registers are listed as UINT16 because their normal values are not negative.",
  "External (outdoor) temperature (35) and outdoor heat exchanger temperature (39) are left out: these routinely go below 0 °C and the manual gives no sign convention for 16-bit values."
 ],
