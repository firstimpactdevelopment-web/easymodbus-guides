 "integration": {
  "summary": "Block-read up to 128 holding registers from wire address 50000. Start or stop by writing 0 and then bit 0 (start) or bit 1 (stop) to parameter 503; acknowledge with two rising edges of bit 4.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 50002,
    "why": "Control mode AUTO/STOP/MANUAL"
   },
   {
    "table": "holding_register",
    "address": 50018,
    "why": "Operating state"
   },
   {
    "table": "holding_register",
    "address": 50045,
    "why": "Latched alarm classes"
   },
   {
    "table": "holding_register",
    "address": 50006,
    "why": "Generator frequency"
   },
   {
    "table": "holding_register",
    "address": 50052,
    "why": "Generator voltage L1-L2"
   },
   {
    "table": "holding_register",
    "address": 50034,
    "why": "Generator current 1"
   },
   {
    "table": "holding_register",
    "address": 50021,
    "why": "Battery voltage"
   },
   {
    "table": "holding_register",
    "address": 503,
    "why": "Remote start / stop / acknowledge"
   }
  ],
  "enable": "Enable Modbus on the serial interface and set its slave ID and baud in the controller's interface parameters. Include 04.13 Remote request in the LogicsManager start condition for remote starts.",
  "watchdog": null,
  "quirks": [
   "Commands act on rising edges: write 0, then the bit.",
   "32-bit parameters (507, 510) are written as two registers in one request, high word first; 507 overlaps 508 and 510 overlaps 511, so never block-write across them."
  ],
  "setup": [
   "Block reads of 1-128 registers are allowed in the visualization range."
  ],
  "gotchas": [
   "Writing parameter 503 can start or stop the engine; coordinate with site staff."
  ]
 },
