{
 "manufacturer": "Seneca",
 "manufacturer_slug": "seneca",
 "model": "Z-8AI 8-channel analog input module",
 "model_slug": "z-8ai",
 "short_model": "Z-8AI",
 "aliases": [
  "Z-8AI"
 ],
 "equipment_type": "Sensor (I/O module, 8 analog inputs)",
 "applies_to": "Seneca Z-8AI DIN-rail module with 8 voltage/current inputs and RS-485 Modbus RTU, per user manual MI00259-3-EN.",
 "summary": "The Z-8AI reads eight ±10 V / ±20 mA analog inputs and reports each as a normalized 16-bit value over RS-485 Modbus RTU. All data are single 16-bit holding registers; each channel has electrical and normalized start/end scale settings and a flag word.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 38400,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "The register table prints 4xxxx numbers (40001 = first holding register), so 40003 is wire address 2."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Z-8AI User Manual",
  "doc_number": "MI00259-3-EN",
  "revision_date": null,
  "url": "https://www.seneca.it/media/6849154/mi00259-3-en.pdf",
  "pages": "DIP-switch tables p. 5; RS485 register table pp. 6-9"
 },
 "notes": [
  "Every register is a single 16-bit word; there are no 32-bit values in this map.",
  "Address 1, 38400 baud and no parity are the EEPROM defaults; they apply only when the address DIP switches select 'from memory'. Otherwise the DIP switches set address and baud.",
  "The table has no registers 40011, 40018, 40024, 40030, 40036, 40042, 40048, 40054 or 40060; they are not listed.",
  "Scale units for the electrical start/end registers are mV for a voltage input and µA for a current input, set by the channel flag and DIP switches."
 ],
