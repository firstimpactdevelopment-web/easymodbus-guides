  "integration": {
    "summary": "Read two-register floats with function 04: voltage at 0x0000, current 0x0006, active power 0x000C, import/export kWh at 0x0048/0x004A. Write settings with function 16 after unlocking with the password in the KPPA register.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
