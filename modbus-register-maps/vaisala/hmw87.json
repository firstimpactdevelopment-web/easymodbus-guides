 "integration": {
  "summary": "Read holding registers 1-4 for RH and temperature (CDAB floats), or the integer copies 257-258 (raw x 0.1) if your controller lacks float support.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Relative humidity"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Temperature"
   },
   {
    "table": "holding_register",
    "address": 8,
    "why": "Dew point"
   },
   {
    "table": "holding_register",
    "address": 512,
    "why": "Error status"
   },
   {
    "table": "holding_register",
    "address": 515,
    "why": "Status code"
   }
  ],
  "enable": "HMW87 and HMW87D ship as Modbus RTU transmitters on RS-485; change the serial settings with Vaisala Insight PC software, the Indigo80 indicator or registers 1537-1540.",
  "watchdog": null,
  "quirks": [
   "Floats are low word first (CDAB); pick \"word-swapped\" float in masters that default to high word first.",
   "Read or write each 32-bit value in one transaction."
  ],
  "setup": [
   "Defaults: address 240, 19200 baud, no parity, 8 data bits, 2 stop bits, response delay 0.",
   "Bit rate and parity changes take effect after a restart (register 1542)."
  ],
  "gotchas": [
   "Use the test registers (7937 on) to confirm float format and addressing before trusting readings.",
   "Writing address 0 to register 1537 takes the transmitter offline: it stops answering Modbus requests."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/vaisala/hmw87",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
