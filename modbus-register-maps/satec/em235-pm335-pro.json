 "integration": {
  "summary": "Read 13952 onward (phase values) and 14336 onward (totals) with function 03; decode 32-bit integers low word first. Energy totals start at 14720; check the energy decimal places setting (46258) before scaling.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 13952,
    "why": "V1 voltage"
   },
   {
    "table": "holding_register",
    "address": 13958,
    "why": "I1 current"
   },
   {
    "table": "holding_register",
    "address": 14336,
    "why": "Total kW"
   },
   {
    "table": "holding_register",
    "address": 14342,
    "why": "Total PF"
   },
   {
    "table": "holding_register",
    "address": 14468,
    "why": "Frequency"
   },
   {
    "table": "holding_register",
    "address": 14720,
    "why": "kWh import"
   },
   {
    "table": "holding_register",
    "address": 14722,
    "why": "kWh export"
   }
  ],
  "enable": "Set the port protocol, address and baud for COM1 at 46448-46452 (or from the front panel/PAS); Modbus/TCP runs on the Ethernet port.",
  "watchdog": null,
  "quirks": [
   "32-bit values are low word first (CDAB).",
   "Voltage and power units change from 0.1 V / 1 W to 1 V / 1 kW when a PT ratio above 1 is set.",
   "Energy resolution depends on 46258."
  ],
  "setup": [
   "Set wiring mode, PT ratio and CT primary at 46208-46213 first.",
   "Write the 8-digit password to 44378 if protection is on."
  ],
  "gotchas": [
   "Changing the PT ratio from 1 changes the meaning of every voltage and power register."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/satec/em235-pm335-pro",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
