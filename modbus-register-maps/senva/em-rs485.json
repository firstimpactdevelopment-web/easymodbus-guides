{
 "manufacturer": "Senva",
 "manufacturer_slug": "senva",
 "model": "EM-RS485 networked energy meter (Modbus RTU/ASCII)",
 "model_slug": "em-rs485",
 "short_model": "EM-RS485",
 "aliases": [
  "EM-RS485",
  "Senva EM-RS485",
  "Senva protocol energy meter"
 ],
 "equipment_type": "Energy meter",
 "applies_to": "Senva EM-RS485 three-phase energy meters with Senva CVT sensors, firmware v1.1.2, Modbus Protocol Guide 154-0023-0B (2017-04-10).",
 "summary": "The Senva EM-RS485 is a compact three-phase energy meter that reads Senva current/voltage transducers (CVTs) and talks Modbus RTU, Modbus ASCII or BACnet MS/TP on RS-485 with auto-detected line settings. Measurements are IEEE floats in holding registers: system and per-phase voltage, current, power factor, real/reactive/apparent power, energy, demand, plus condition flags. This map covers the main reading and setup registers.",
 "transport": [
  "RTU",
  "ASCII"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "The guide prints raw protocol addresses with an R prefix (R420 = wire address 420; Modicon 40421). R420/21 marks a two-register value starting at 420. S phase registers are R phase + 1000, T phase + 2000."
 },
 "default_word_order": "ABCD",
 "firmware": "v1.1.2",
 "source": {
  "title": "EM-RS485 Modbus Protocol Guide",
  "doc_number": "154-0023-0B",
  "revision_date": "2017-04-10",
  "url": "https://senvainc.com/catalog/documents/downloadcenter/EM-RS485%20Modbus%20Protocol%20Guide.pdf",
  "pages": "pp. 6-8 (configuration), 8-38 (registers), 39 (data types and UINT32 byte example)"
 },
 "notes": [
  "Word order: the data-types section says UINT32 and FLOAT use two registers in network byte order and gives byte examples (0xAABBCCDD sent as AA BB CC DD across registers r and r+1), so the high word comes first (ABCD).",
  "Units are settable: power follows R163 (default kW), energy R173 (default kWh), temperature R133 (default °F), angles R153 (default degrees). The units listed here are the defaults.",
  "Energy registers (R700-R765, R1700-R1765) read as floats by default; with R170 = 1 they read as unsigned integers 0-999999 that wrap. They are listed as FLOAT32 here (the default).",
  "Most analog measurements also have Instantaneous, Minimum, Maximum and Average copies in the next registers (for example R422 instantaneous, R424 min, R426 max, R428 average for R420); those copies are not listed. Writing 0 resets a statistic.",
  "Default slave address is 100 plus the last two digits of the serial number. Baud (9600-115200), parity, data bits and protocol are auto-detected out of the box.",
  "Strings (CVT serial/model, location) and the remaining PowerPrint, pulse-input and multiplier settings are left out for length."
 ],
