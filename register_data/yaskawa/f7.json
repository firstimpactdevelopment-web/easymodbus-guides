  "integration": {
    "summary": "Set H5-01..H5-03 at the keypad and power-cycle, set b1-01 = 2 and b1-02 = 2, then write 0001H and 0002H with function 10H and poll 0020H-002DH for status and faults.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1,
        "why": "Run/stop and reset"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Frequency reference"
      },
      {
        "table": "holding_register",
        "address": 32,
        "why": "Drive status"
      },
      {
        "table": "holding_register",
        "address": 33,
        "why": "Fault details"
      },
      {
        "table": "holding_register",
        "address": 36,
        "why": "Output frequency"
      },
      {
