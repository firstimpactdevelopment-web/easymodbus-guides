 "integration": {
  "summary": "Set A001 = 03 and A002 = 03, write the frequency to registers 0001h-0002h (wire 0-1, 0.01 Hz) and run with coil 0001h (wire 0). Read output frequency at 1001h-1002h and current at 1003h.",
  "minimum_registers": [
   {
    "table": "coil",
    "address": 0,
    "why": "Run/stop command"
   },
   {
    "table": "coil",
    "address": 1,
    "why": "Direction command"
   },
   {
    "table": "holding_register",
    "address": 0,
    "why": "Frequency command (F001)"
   },
   {
    "table": "holding_register",
    "address": 4096,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 4098,
    "why": "Output current"
   },
   {
    "table": "holding_register",
    "address": 3,
    "why": "Inverter status B (run/trip)"
   }
  ],
  "enable": "Set C079 (communication mode) to Modbus-RTU, C071 speed, C072 node address, C074 parity, C075 stop bits and C078 wait time on the keypad; set A001 = 03 and A002 = 03 to take frequency and run commands over the network.",
  "watchdog": "C077 sets the reception timeout (0.00-99.99 s) and C076 picks the action after a timeout (trip, decelerate and trip, ignore, free-run stop, or decelerate and stop); the NDc output (coil 0033h) signals the disconnection.",
  "quirks": [
   "Requests use the printed number minus 1.",
   "32-bit values are high word first."
  ],
  "setup": [
   "RS485 on terminal block TM2 (SP, SN); use RP-SN to enable the terminating resistor.",
   "2400-19200 bps, 8 data bits in Modbus-RTU mode, up to 32 inverters."
  ],
  "gotchas": [
   "The physical intelligent input terminals override the input coils.",
   "Register writes are lost at power-off unless 1 is written to 0900h to store them in EEPROM."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/hitachi/sj700-2",
