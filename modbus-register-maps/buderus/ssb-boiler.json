 "integration": {
  "summary": "Wire Modbus + and - to the MOD BUS terminals of the boiler's terminal strip, set the master to 9600 8-N-2 and read holding registers 100-142 with function 03. To change a setpoint, first write register 99 = 1 (Write Enable), then write the value x10 within 4 seconds.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 101,
    "why": "Boiler status"
   },
   {
    "table": "holding_register",
    "address": 102,
    "why": "Error code"
   },
   {
    "table": "holding_register",
    "address": 120,
    "why": "Supply temperature"
   },
   {
    "table": "holding_register",
    "address": 121,
    "why": "Return temperature"
   },
   {
    "table": "holding_register",
    "address": 140,
    "why": "Firing rate"
   },
   {
    "table": "holding_register",
    "address": 502,
    "why": "CH setpoint"
   },
   {
    "table": "holding_register",
    "address": 503,
    "why": "DHW setpoint"
   },
   {
    "table": "holding_register",
    "address": 99,
    "why": "Write enable / lockout reset"
   }
  ],
  "enable": "Writes are refused unless register 99 bit 0 (Write Enable) is set. The bit clears itself after each write sequence or after 4 seconds, so set it again before every write.",
  "watchdog": "If no Modbus read or write arrives for more than 4 seconds the control register 99 is cleared. No other comm-loss behaviour is documented.",
  "quirks": [
   "Only functions 03, 06 and 16 are supported - no input registers or coils.",
   "Setting any undefined bit in register 99 clears the whole register.",
   "Lockout reset (99 bit 14) works only while the boiler is in lockout."
  ],
  "setup": [
   "Slave address (default 1) and stop bits (1 or 2, default 2) are set with the 894PB tool or LabVision software.",
   "Baud is fixed at 9600, 8 data bits, no parity.",
   "RS-485 two-wire, ground optional: Modbus + and - go to the MOD BUS pair on the boiler terminal strip (terminals 3-4)."
  ],
  "gotchas": [
   "Do not leave Write Enable set when you are not writing; the document warns that registers can be corrupted.",
   "Changing register 98 changes the units of every temperature you read and write."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/buderus/ssb-boiler",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
