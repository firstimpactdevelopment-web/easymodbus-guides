  "integration": {
    "summary": "Address the indoor units 0..63 in the AC system, write each unit's address into its slot (1000 + 20n + 9), then read and write the 20-register slot blocks.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1009,
        "why": "Map slot 0 to an indoor unit address"
      },
      {
        "table": "holding_register",
        "address": 1000,
        "why": "On/off"
      },
      {
        "table": "holding_register",
        "address": 1001,
        "why": "Mode"
