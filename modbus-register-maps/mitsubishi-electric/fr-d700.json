 "integration": {
  "summary": "Set Pr.549 = 1, Pr.117 to 1-247 and Pr.122 to 9999 (or a real interval), reset, then switch to NET mode by writing H0014 to 40010. Write the frequency to 40014 (0.01 Hz) and run bits to 40009; poll 40009, 40201, 40202 and 40501.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 8,
    "why": "Run/stop command and inverter status"
   },
   {
    "table": "holding_register",
    "address": 9,
    "why": "Operation mode (write H0014 for NET)"
   },
   {
    "table": "holding_register",
    "address": 13,
    "why": "Frequency command (RAM)"
   },
   {
    "table": "holding_register",
    "address": 200,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 201,
    "why": "Output current"
   },
   {
    "table": "holding_register",
    "address": 500,
    "why": "Latest fault code"
   }
  ],
  "enable": "Pr.549 = 1 selects Modbus RTU on the PU connector; set Pr.117 (station), Pr.118 (speed) and Pr.120 (parity) and reset. Operation and frequency commands need NET mode (write H0014 to 40010; allowed depending on Pr.79/Pr.340).",
  "watchdog": "Pr.122 is the communication check interval (0.1-999.8 s) with Pr.502 choosing coast or decelerate on E.PUE. Initial value 0 trips E.PUE as soon as the drive enters NET mode, so set 9999 or an interval before switching.",
  "quirks": [
   "Request address = register - 40001.",
   "Station 0 is broadcast and never replies; the initial Pr.117 is 0.",
   "40009 means control input when written and inverter status when read."
  ],
  "setup": [
   "Pr.118 initial 192 = 19200 bps; Pr.120 initial 2 = even parity, 1 stop bit.",
   "With Pr.549 = 1 and Pr.118 = 384, the FR-PU04/FR-PU07 parameter unit stops working; use the built-in panel.",
   "Modbus RTU cannot be used in PU operation mode."
  ],
  "gotchas": [
   "Pr.122 = 0 (initial) makes the drive trip E.PUE the moment it goes to NET mode."
  ]
 },
