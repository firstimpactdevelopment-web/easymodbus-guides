{
  "manufacturer": "APC (Schneider Electric)",
  "manufacturer_slug": "apc",
  "model": "InRow ACSC 100 Series self-contained DX cooling unit",
  "model_slug": "inrow-acsc100",
  "short_model": "InRow ACSC100",
  "aliases": [
    "ACSC100",
    "InRow SC",
    "InRow ACSC"
  ],
  "equipment_type": "Air handler (in-row self-contained DX cooling unit)",
  "applies_to": "APC by Schneider Electric InRow SC (ACSC 100 series) self-contained cooling units, per register map part number 990-3027D.",
  "summary": "The InRow SC (ACSC 100 series) is a self-contained DX in-row cooling unit. It answers Modbus RTU and Modbus TCP with all data in holding registers, readable with function 03 or 04. This map covers unit start/stop, setpoints, air and refrigerant temperatures and pressures, fan speeds, run hours, group settings and the one-register fault flags.",
  "transport": [
    "RTU",
    "TCP"
  ],
  "defaults": {
    "unit_id": null,
    "baud": null,
    "parity": null,
    "data_bits": null,
    "stop_bits": null,
    "tcp_port": null
  },
  "addressing": {
    "convention": "0-based",
    "note": "The table gives absolute addresses in hex and decimal. Note 11 says absolute address 0 equals Modicon register 40001 and is address zero on the wire, so the decimal column is the wire address as printed."
  },
  "default_word_order": "ABCD",
  "firmware": null,
  "source": {
    "title": "Modbus Register Map: InRow ACSC 100 Series",
    "doc_number": "990-3027D",
    "revision_date": null,
    "url": "https://download.se.com/files?p_Doc_Ref=Modbus_Register_Map_InRow_ACS",
    "pages": "Notes p. 1; unit data pp. 1-2, group data pp. 2-3, faults pp. 3-4"
  },
  "notes": [
    "Word order: note 2 says 32-bit values keep the most significant word at n+0 (ABCD). The table labels them LONG; they are listed here as signed 32-bit, since note 5 says signed values are two's complement and temperatures can go below zero.",
    "Scale comes from the units column: '(Tenths)' is 0.1 and '(Hundredths)' is 0.01. Temperatures are in tenths of a degree Fahrenheit.",
    "Function codes 3 and 4 read the same registers; writes use function 16, or function 6 for one-register items.",
    "Left out: the rows at 132 and 134, which repeat the name CONDENSER_FAN_RUNHOUR of the row at 130 so their meaning is not stated; the reserved blocks; and the APC serial diagnostic counters at 0xFFEE-0xFFFE.",
    "The source prints the bias enum as '3 = Slightly Neg4 = Negative'; it is split here into 3 = Slightly Negative and 4 = Negative.",
    "Data points that a unit does not support read as 0 rather than raising an error."
  ],
