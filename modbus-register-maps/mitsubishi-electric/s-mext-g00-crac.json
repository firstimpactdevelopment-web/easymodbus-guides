 "model": "s-MEXT-G00 computer room air conditioner (ME28 relC)",
 "model_slug": "s-mext-g00-crac",
 "short_model": "s-MEXT-G00",
 "aliases": [
  "s-MEXT",
  "s-MEXT-G00 006-044",
  "s-MEXT G00",
