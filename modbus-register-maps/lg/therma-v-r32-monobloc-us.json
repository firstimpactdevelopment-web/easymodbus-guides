 "integration": {
  "summary": "Wire RS-485 to terminals 26 (A) and 27 (B), set the unit's Modbus address, then read discrete inputs 10001-10017 and input registers 30001-30012 for status and write coils 00001/00002 plus holding registers 40001-40010 for control.",
  "minimum_registers": [
   {
    "table": "coil",
    "address": 0,
    "why": "Space heating/cooling on/off"
   },
   {
    "table": "coil",
    "address": 1,
    "why": "Hot water on/off"
   },
   {
    "table": "holding_register",
    "address": 0,
    "why": "Operation mode"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Circuit 1 water setpoint"
   },
   {
    "table": "holding_register",
    "address": 8,
    "why": "DHW setpoint"
   },
   {
    "table": "discrete_input",
    "address": 3,
    "why": "Compressor running"
   },
   {
    "table": "discrete_input",
    "address": 13,
    "why": "Error flag"
   },
   {
    "table": "input_register",
    "address": 0,
    "why": "Error code"
   }
  ],
  "enable": "Turn DIP switch No.1 of option switch 1 ON (Modbus function as slave for a 3rd-party controller), then set the Modbus address under Installer setting > Modbus Address on the LG controller.",
  "watchdog": null,
  "quirks": [
   "Operation mode codes are 0 = cooling, 3 = auto, 4 = heating (not 0/1/2).",
   "Product group and product info sit at the top of the input-register range (39998/39999 = wire 9997/9998)."
  ],
  "setup": [
   "Serial settings are 9600 bps, no parity, 1 stop bit.",
   "The bus connects to terminal block 3 (26 = A, 27 = B); check the CN_MODBUS harness is fully seated in CN_COM on the indoor PCB. The LG meter interface uses the same terminals."
  ],
  "gotchas": [
   "While a 3rd-party Modbus controller is in use, the LG controller cannot run the unit at the same time."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/lg/therma-v-r32-monobloc-us",
