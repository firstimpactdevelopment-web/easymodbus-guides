  "integration": {
    "summary": "Read holding registers 0x0000-0x0015 in one request for speed, direction, gust, lull and sonic temperature as low-word-first floats, and check the status words at 0x0200-0x0209.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 4,
        "why": "Instant wind speed"
      },
      {
        "table": "holding_register",
        "address": 6,
        "why": "Instant wind direction"
      },
      {
        "table": "holding_register",
        "address": 8,
        "why": "Average wind speed"
      },
      {
        "table": "holding_register",
        "address": 14,
        "why": "Gust"
      },
      {
        "table": "holding_register",
        "address": 512,
        "why": "Device status"
      },
      {
        "table": "holding_register",
        "address": 521,
        "why": "Wind measurement status"
      }
    ],
    "enable": "Order the sensor with the Modbus RTU communication profile (option C), or in Vaisala Insight PC software select Communication, set Interface mode to Modbus RTU, save, then power-cycle the sensor. Interface mode is also register 0x0605.",
    "watchdog": null,
    "quirks": [
      "Floats and int32 are low word first (CDAB).",
      "Default framing is 8 data bits, no parity, 2 stop bits."
    ],
    "setup": [
      "Defaults: address 240, 19200 baud, N82.",
      "Serial defaults in the register table apply unless the ordered configuration specifies otherwise; check the configuration code with Insight if unsure.",
      "If the Modbus client runs on the same PC as Insight, close Insight first; restart the sensor after changing settings."
    ],
    "gotchas": [
      "Read the test registers 0x1F00-0x1F02 first to confirm addressing and word order."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
