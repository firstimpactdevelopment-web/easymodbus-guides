    "enable": "Set node address and communication settings at the keypad and select communication as run and frequency source (parameter numbers are in the drive manual, not this addendum). Bit 15 of 2501H with 2503H gives torque control by communication.",
    "watchdog": null,
    "quirks": [
      "Registers are hex: 2520H is sent as 25 20.",
      "Functions 03H, 06H, 08H and 10H; maximum frame 80 bytes.",
      "Node addresses 01H-FEH; 00H is broadcast.",
      "Write 0 to unused bits and never write reserved registers."
    ],
    "setup": [
      "RS-485 on CON2 (RJ45): pin 1 or 3 = S+, pin 2 or 6 = S-.",
      "120 ohm, 1/4 W terminators at both ends of the line."
    ],
    "gotchas": [
      "Exception codes: 01 function, 02 register number, 03 number, 04 data setting, 05 write mode error.",
      "Inverter response time is about 10 ms."
    ]
  },
