 "integration": {
  "summary": "Block-read up to 128 holding registers from wire address 50000 (Modicon 450001) for measurements, status and alarms. To start or stop the set, write 0 and then the start (bit 0) or stop (bit 1) bit to parameter 503; acknowledge with two rising edges of bit 4.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 50000,
    "why": "Protocol number (4003) to confirm the map"
   },
   {
    "table": "holding_register",
    "address": 50001,
    "why": "Generator voltage L1-L2"
   },
   {
    "table": "holding_register",
    "address": 50003,
    "why": "Generator frequency"
   },
   {
    "table": "holding_register",
    "address": 50037,
    "why": "Generator current L1"
   },
   {
    "table": "holding_register",
    "address": 50033,
    "why": "Operating mode STOP/MANUAL/AUTO"
   },
   {
    "table": "holding_register",
    "address": 50057,
    "why": "System state"
   },
   {
    "table": "holding_register",
    "address": 50036,
    "why": "Active alarm classes"
   },
   {
    "table": "holding_register",
    "address": 503,
    "why": "Remote start / stop / acknowledge"
   }
  ],
  "enable": "Select the Modbus protocol on the serial interface and set the Modbus slave ID (0-255) and reply delay (0-1000 ms) in the controller. For remote start/stop the LogicsManager must use command variable 04.13; see application manual 37394. Parameter writes need the code level 2 password for that interface (parameter 10401 for serial interface 1).",
  "watchdog": "Interface watchdogs exist but are disabled by default; they are described in the device manual, not in this document.",
  "quirks": [
   "Start, stop and acknowledge react only to a rising edge: write 0 first, then the bit.",
   "Acknowledge must be sent twice: the first edge silences the horn, the second clears faults that are gone.",
   "Some PLCs and tools offset addresses by one; the manual notes 450001 may become bus address 50000."
  ],
  "setup": [
   "RS-485 half or full duplex is supported. Set the baud rate, parity and stop bits in the controller's serial interface menu to match the master."
  ],
  "gotchas": [
   "Writing control word 1 can start or stop the engine; make sure the site is safe first.",
   "Bits 2 and 3 of control word 1 must always be 0."
  ]
 },
