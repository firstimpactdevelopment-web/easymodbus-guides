  "Intesis Modbus Server Panasonic VRF"
 ],
 "equipment_type": "VRF / split AC gateway",
 "applies_to": "Intesis Modbus Server - Panasonic, order codes INMBSPAN016O000 / 064O000 / 128O000 (legacy PA-AC-MBS-16 / -64 / -128), user manual r1.1 (11/2020); Panasonic P-Link systems.",
 "summary": "Modbus server for Panasonic VRF systems on P-Link. Each configured indoor unit gets a 100-register block with control, temperatures, limits, error, occupancy and energy values; outdoor units get pressure and demand-limit registers; low addresses carry occupancy setpoints and all-unit commands. Up to two P-Link lines.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "0-based",
  "note": "The manual states formula results are link-layer addresses with the first register at 0. Indoor unit IU (1..64) on line L (1 or 2) uses IU x 100 + (L-1) x 10000 + offset; outdoor unit OU (1..30) uses OU x 25 + (L-1) x 10000 + 7000 + offset. This file lists line 1, IU 1 (100..132) and OU 1 (7025..7028)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Intesis Modbus Server - Panasonic User Manual",
  "doc_number": "User Manual r1.1 EN",
  "revision_date": "2020-11",
  "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-inmbspanxxxo000.pdf",
  "pages": "pp. 8-11 (Modbus interface and address map)"
 },
 "notes": [
  "Only line 1, indoor unit 1 and outdoor unit 1 are listed. Indoor unit IU: add (IU-1) x 100; outdoor unit OU: add (OU-1) x 25; line 2: add 10000.",
  "Compressor 1..3 operation time (OU block +4..+6) are left out: the manual gives a 0..16777215 h range, which does not fit the single 16-bit register it lists.",
  "Consumption registers (+30..+32) are printed in kWh with no scale factor; listed at scale 1.",
  "The manual says Modbus RTU and TCP work at the same time on the 16 and 64 versions; the 128 version has different connections (manual section 3.2).",
  "Temperatures are tenths of °C or °F per the MAPS temperature setting; °C shown."
 ],
