      "bits": {
        "0": "Write: stop command / Read: RUN (inverter running)",
        "1": "Write: forward rotation / Read: forward rotation",
        "2": "Write: reverse rotation / Read: reverse rotation",
        "3": "Write: RH (high speed) / Read: SU (up to frequency)",
        "4": "Write: RM (middle speed) / Read: OL (overload)",
        "5": "Write: RL (low speed) / Read: IPF (instantaneous power failure)",
        "6": "Write: JOG / Read: FU (frequency detection)",
        "7": "Write: RT (second function) / Read: ABC1 (fault)",
        "8": "Write: AU (current input selection) / Read: ABC2",
