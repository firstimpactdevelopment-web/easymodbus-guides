  "integration": {
    "summary": "Write the frequency reference (wire 0x2502) and set bit 0 of the command word (wire 0x2501) to run; a single function 16 write of two registers at 0x2501 does both. Read status, fault code and output values from the block starting at wire 0x2520.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 9473,
        "why": "Command word (run/stop, reset)"
      },
      {
        "table": "holding_register",
        "address": 9474,
        "why": "Frequency reference"
      },
      {
        "table": "holding_register",
        "address": 9504,
        "why": "Drive status"
      },
      {
        "table": "holding_register",
        "address": 9505,
        "why": "Fault code"
      },
      {
        "table": "holding_register",
        "address": 9508,
        "why": "Output frequency"
      },
      {
        "table": "holding_register",
        "address": 9511,
        "why": "Output current"
      }
    ],
    "enable": "Wire the drive's RS-485 port and select Modbus RTU or ASCII, the slave address and the run/frequency command source on the drive keypad; those parameter numbers are in the VT1 instruction manual, not in this protocol document.",
    "watchdog": "A lost connection shows Err6 on the drive; the reaction to an external abnormality written via command bit 2 follows parameter 07-09.",
    "quirks": [
      "Table addresses are one above the wire address.",
      "Exception codes are 51h-55h, not the usual 01h-04h.",
      "Reads and block writes may not cross register groups."
    ],
    "setup": [
      "Set slave address, baud rate and data format on the drive before connecting; the protocol document does not list defaults.",
      "Maximum frame length is 80 bytes.",
      "Terminate each end of the RS-485 line with a 120 ohm resistor."
    ],
    "gotchas": [
      "Do not write to the reserved word at table 2501H (wire 0x2500)."
    ]
  },
