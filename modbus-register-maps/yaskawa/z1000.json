{
 "manufacturer": "Yaskawa",
 "manufacturer_slug": "yaskawa",
 "model": "Z1000 HVAC fan/pump drive (MEMOBUS/Modbus RTU)",
 "model_slug": "z1000",
 "short_model": "Z1000",
 "aliases": [
  "CIMR-ZU",
  "Z1000 AC Drive for HVAC Fan and Pump"
 ],
 "equipment_type": "Variable frequency drive (HVAC fan / pump)",
 "applies_to": "Yaskawa Z1000 HVAC drives (CIMR-ZU) using the built-in RS-485 terminals with H5-08 = 0, per Programming Manual SIEP YAIZ1U 03C (the copy covers the 600 V class models 5A0007-5A0242).",
 "summary": "The Z1000 is Yaskawa's HVAC fan and pump drive; its built-in RS-485 port speaks MEMOBUS/Modbus RTU, BACnet, Metasys N2 or APOGEE FLN. Commands are written to hex registers 0001H-000FH, status, fault and alarm words are read from 0020H upward, U monitors from 0040H, and parameters have their own hex addresses. This map covers the command block, status/fault/alarm words, main monitors, fault codes and the b1/H5 setup parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 31,
  "baud": 9600,
  "parity": "None",
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Register numbers are hex and sent unchanged: the 03H example reads start address 00 20 (drive status). The parameter list gives each parameter's hex address in brackets (b1-01 = (180), H5-01 = (425), U1-06 = (45))."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "YASKAWA AC Drive Z1000 AC Drive for HVAC Fan and Pump Programming Manual",
  "doc_number": "SIEP YAIZ1U 03C",
  "revision_date": null,
  "url": "https://www.yaskawa.com/delegate/getAttachment?documentId=SIEPYAIZ1U03&cmd=documents&documentName=SIEPYAIZ1U03.pdf",
  "pages": "Appendix E: message examples, Enter command (Table E.5), data table pp. 316-327 (fault codes Table E.3 p. 325, alarm codes Table E.4 p. 327); parameter list pp. 180-250 (b1, H5 pp. 249-250, U monitors p. 232)"
 },
 "notes": [
  "This manual edition lists only 600 V class models; the register layout is the Z1000 one but check your model's manual for other voltage classes.",
  "0002H/0023H/0024H frequency values follow o1-03 and are left unscaled.",
  "0026H output current is printed as 0.1 A units in the data table; U1-03 (0042H) is not included because its unit footnote is model-dependent (00ABH rated current: 0.01 A for 5A0007-5A0017, 0.1 A for 5A0022-5A0242).",
  "Left out: 0025H output voltage (unit switched by H5-10; 0045H is included), 0027H/0047H output power (unit not printed in the data table), 0007H/0008H analog outputs (sign not stated), 003EH/003FH and 00ACH-00B8H speed/frequency in r/min or 0.01 % (sign not stated), and the RTC registers 3000H-3030H.",
  "Fault codes (Table E.3) are converted from hex to decimal (e.g. 0021H CE = 33); the oFA1x/oFA3x option codes are omitted from the value list. Alarm codes for 007FH (Table E.4) are not decoded.",
  "Only function codes 03H, 08H and 10H are supported; up to 16 registers per message."
 ],
