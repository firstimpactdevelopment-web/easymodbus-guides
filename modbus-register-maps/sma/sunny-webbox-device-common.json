 "integration": {
  "summary": "Look up the device's unit ID in the WebBox gateway table, then read 30775 (AC power), 30529/30513 (energy) and 30769-30773 (DC input) on that unit ID.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 30775,
    "why": "AC power"
   },
   {
    "table": "input_register",
    "address": 30513,
    "why": "Total energy"
   },
   {
    "table": "input_register",
    "address": 30517,
    "why": "Day energy"
   },
   {
    "table": "input_register",
    "address": 30773,
    "why": "DC power"
   },
   {
    "table": "input_register",
    "address": 30803,
    "why": "Grid frequency"
   },
   {
    "table": "input_register",
    "address": 30197,
    "why": "Active event number"
   }
  ],
  "enable": "Enable Modbus on the WebBox (Settings > Network > Use Modbus = Yes) and make sure the device has a unit ID other than 255.",
  "watchdog": null,
  "quirks": [
   "Read 64-bit counters as one 4-register block.",
   "NaN values (0x80000000 / 0xFFFFFFFF) mean the device does not supply that value."
  ],
  "setup": [
   "Modbus TCP to the WebBox IP, port 502, unit ID = the device's assigned ID."
  ],
  "gotchas": [
   "Sunny Central families typically take 8-10 s for a value change to show at the WebBox Modbus interface; polling faster gains nothing."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/sma/sunny-webbox-device-common",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
