{
 "manufacturer": "Toshiba",
 "manufacturer_slug": "toshiba",
 "model": "TOSVERT VF-nC3 compact inverter (Modbus RTU)",
 "model_slug": "vf-nc3",
 "short_model": "VF-nC3",
 "aliases": [
  "VF-nC3",
  "VF-nC3M",
  "TOSVERT VF-nC3",
  "VFNC3"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "Toshiba TOSVERT VF-nC3 series inverters using the built-in RS-485 port with f829 = 1 (Modbus RTU), per manual E6581657.",
 "summary": "The VF-nC3 is a small Toshiba inverter whose RS-485 port speaks either Toshiba's own protocol or a subset of Modbus RTU. Every value has a hex communication number that is used directly as the Modbus register address. This map covers the comms command words (FA..), the monitor block (FC../FD../FE..) and the communication setup parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 0,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Communication numbers are hex and go on the wire unchanged: the manual's read example sends 01 03 FD 00 00 01 for output frequency FD00, and the direct block-read example sends 01 03 01 30 for parameter f130 (communication number 0130). Parameters f### use communication number 0###."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "TOSVERT VF-nC3 Series RS485 Communication Function Instruction Manual",
  "doc_number": "E6581657",
  "revision_date": null,
  "url": "https://www.toshiba.com/tic/datafiles/manuals/NC3_RS485_Communication_Manual.pdf",
  "pages": "pp. 23-38 (Modbus RTU), p. 40 (comm parameters), pp. 44-54 (commands, status, alarms, trip codes), pp. 60-61 (command and monitor tables)"
 },
 "notes": [
  "Every register here is a single 16-bit word; the manual has no 32-bit values.",
  "FD.. registers give live values; the matching FE.. numbers (FE00-FE49) hold the same item frozen at the last trip. Only the live set is listed, plus the FE-only items.",
  "Left out: torque (FD18) and torque current (FD20), because the manual does not say whether these words are signed; FB05 capacity code (needs the Appendix 3 lookup); LED/keypad registers FA10/FA11/FA65-FA80; block-communication parameters f870-f879.",
  "Output current, output voltage and DC voltage are percentages of the drive rating, not amps or volts.",
  "Section 7.2 names the VI monitor FE35, while the block-read list calls it FE36; the monitor table on p. 61 says FE35, which is used here.",
  "The frequency command FA01 and command words FA00/FA20 are RAM only and reset at power-off, fault reset or factory reset.",
  "Other drive parameters follow the same rule (f### = communication number 0###); scale = the minimum setting unit in the drive's parameter list."
 ],
