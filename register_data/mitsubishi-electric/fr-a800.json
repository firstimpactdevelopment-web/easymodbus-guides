{
  "manufacturer": "Mitsubishi Electric",
  "manufacturer_slug": "mitsubishi-electric",
  "model": "FR-A800 inverter (RS-485 terminals, Modbus RTU)",
  "model_slug": "fr-a800",
  "short_model": "FR-A800",
  "aliases": [
    "FR-A820",
