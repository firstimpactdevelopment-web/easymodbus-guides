  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "The guide prints each register as a hex address with its decimal value (sent on the wire as-is) plus a 'register number' that is the address + 1. The test registers start at 0x1F00, which the guide reads directly."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "RM60 User Guide",
  "doc_number": "M213218EN-B",
  "revision_date": "2026-08",
