 "integration": {
  "summary": "Read input registers 0000h-0043h in one request (function 04 or 03). Decode INT32 low word first; V/W/VA/var x10, A x1000, energy x10, hours x100; PF and Hz are INT16 x1000 and x10.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "Voltage"
   },
   {
    "table": "input_register",
    "address": 2,
    "why": "Current"
   },
   {
    "table": "input_register",
    "address": 4,
    "why": "Active power"
   },
   {
    "table": "input_register",
    "address": 14,
    "why": "Power factor"
   },
   {
    "table": "input_register",
    "address": 15,
    "why": "Frequency"
   },
   {
    "table": "input_register",
    "address": 16,
    "why": "Imported kWh total"
   },
   {
    "table": "input_register",
    "address": 32,
    "why": "Exported kWh total"
   }
  ],
  "enable": "Modbus RTU on RS485 is always active; serial settings are at 2000h-2004h.",
  "watchdog": null,
  "quirks": [
   "32-bit values are CDAB.",
   "Stop-bit register uses 0 = 1 stop bit, 1 = 2 stop bits (unlike other Gavazzi meters).",
   "Two PF conventions are published: 000Eh (IEC sign) and 0070h (L/C sign)."
  ],
  "setup": [
   "Defaults: address 1, 9600 baud, no parity, 1 stop bit.",
   "Max answer time 500 ms."
  ],
  "gotchas": [
   "Total reset (4003h) is not available on MID versions.",
   "Tariff selection by Modbus needs 1101h on and the digital input not set to tariff mode."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/carlo-gavazzi/em511",
