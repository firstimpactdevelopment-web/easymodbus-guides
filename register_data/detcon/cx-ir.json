    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "0-based",
    "note": "Registers are printed with a leading 4 starting at 40000 (device type), so 40002 is wire address 2 and 48204 is wire address 8204."
  },
