  "integration": {
    "summary": "Set H5-01..H5-03, then b1-01 = 2 and b1-02 = 2 so the frequency reference and Run come from Modbus. Write 0001H (run bits) and 0002H (frequency reference) with function 10H and poll 0020H-0021H and 002CH.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1,
        "why": "Run/stop, direction, fault reset"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Frequency reference (o1-03 units)"
      },
      {
        "table": "holding_register",
        "address": 32,
        "why": "Drive status 1"
      },
      {
        "table": "holding_register",
        "address": 33,
        "why": "Fault description 1"
      },
      {
        "table": "holding_register",
        "address": 36,
        "why": "U1-02 output frequency"
      },
      {
        "table": "holding_register",
        "address": 44,
        "why": "Drive status 2 incl. comm timeout"
      },
      {
        "table": "holding_register",
        "address": 49,
        "why": "U1-07 DC bus voltage"
      }
    ],
    "enable": "Keep H5-08 = 0 (Modbus), set H5-01 node address (default 1FH), H5-02 speed (default 3 = 9600 bps), H5-03 parity (default 0 = none), then power-cycle or set H5-20 = 1. For control set b1-01 = 2 and b1-02 = 2. H5-12 decides whether 0001H bits 0/1 are FWD/REV run or Run plus direction.",
    "watchdog": "H5-05 = 1 (default) enables CE detection; H5-09 sets the timeout (0.0-10.0 s, default 2.0 s) and H5-04 the reaction (0 ramp, 1 coast, 2 fast stop, 3 alarm only - default, 4 run at the H5-34 go-to frequency). Drive status 2 (002CH) bit F shows a timeout.",
    "quirks": [
      "Registers are hex and 0-based: 0020H is sent as 00 20.",
      "No function 06H; use 10H.",
      "Parameter writes need the Enter command unless H5-11 = 1."
    ],
    "setup": [
      "RS-485 on the control terminal block; 8 data bits and 1 stop bit are fixed.",
      "Set DIP switch S2 ON only at the last drive on the line to enable its termination resistor."
    ],
    "gotchas": [
      "The EEPROM Enter command (0900H) is limited to about 100,000 writes; use 0910H for frequent changes.",
      "Network inputs in 0001H are ORed with the physical terminals."
    ]
  },
