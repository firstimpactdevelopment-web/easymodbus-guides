 "integration": {
  "summary": "Poll at 115200 8N1 using the slave ID from the serial number label. Read FC03 block 172-189 for overall vibration and 226-229 for alarm states; write with FC16 only.",
  "minimum_registers": [
   {
    "table": "holding_register",
