 "integration": {
  "summary": "Set H5-08 = 0 and H5-01..H5-03, power-cycle, set b1-01 = 2 and b1-02 = 2, then write 0001H/0002H with function 10H and poll 0020H-002DH.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 1,
    "why": "Run/stop and reset"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Frequency reference"
   },
   {
    "table": "holding_register",
    "address": 32,
    "why": "Drive status 1"
   },
   {
    "table": "holding_register",
    "address": 33,
    "why": "Fault contents 1"
   },
   {
    "table": "holding_register",
    "address": 36,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 38,
    "why": "Output current"
   },
   {
    "table": "holding_register",
    "address": 44,
    "why": "Status 2 incl. comm timeout"
   },
   {
    "table": "holding_register",
    "address": 128,
    "why": "Current fault code"
   }
  ],
  "enable": "H5-08 = 0 selects MEMOBUS/Modbus (1 N2, 2 P1, 3 BACnet). H5-01 address (default 1Fh), H5-02 speed (default 3 = 9600), H5-03 parity (default none); cycle power. b1-01 = 2 and b1-02 = 2 (AUTO mode sources) hand reference and run to serial communications.",
  "watchdog": "H5-05 = 1 (default) enables CE detection after H5-09 (default 2.0 s); H5-04 sets the reaction: 0 ramp, 1 coast, 2 fast stop, 3 alarm only (default), 4 run at d1-04. 002CH bit F flags the timeout.",
  "quirks": [
   "Registers are hex and 0-based.",
   "No 06H function: use 10H even for one register.",
   "H5-11 = 0 (default) means parameter writes need an Enter command (0 to 0900H for EEPROM or 0910H for RAM); registers 0000H-001FH never need Enter.",
   "Enter registers are write-only; reading them returns error 02H."
  ],
  "setup": [
   "RS-485 on terminals R+, R-, S+, S-; speeds 1200-115200 bps.",
   "Power-cycle after H5-01..H5-03 changes."
  ],
  "gotchas": [
   "b1-01/b1-02 are the reference and run sources for AUTO mode on the HOA keypad.",
   "H5-01 = 0 disables Modbus responses."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/yaskawa/z1000",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
