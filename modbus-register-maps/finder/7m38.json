 "integration": {
  "summary": "Read input registers with function 04 and decode the IEEE 754 float block, high word first: subtract 30000 from the printed number (Pt at 32490 is wire 2490). Energy comes as floats in Wh/varh at 32752 onward.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 2500,
    "why": "U1 voltage (float, V)"
   },
   {
    "table": "input_register",
    "address": 2516,
    "why": "I1 current (float, A)"
   },
   {
    "table": "input_register",
    "address": 2490,
    "why": "Total active power (float, W)"
   },
   {
    "table": "input_register",
    "address": 2496,
    "why": "Total power factor"
   },
   {
    "table": "input_register",
    "address": 2498,
    "why": "Frequency"
   },
   {
    "table": "input_register",
    "address": 2752,
    "why": "Energy counter n1 (float, Wh)"
   },
   {
    "table": "input_register",
    "address": 2756,
    "why": "Energy counter n3 (float, Wh)"
   }
  ],
  "enable": "Modbus RTU runs on the RS485 serial versions (7M.38.8.400.XXXX). Port 1 address, baud, stop bits and parity sit in registers 40202-40205; writing settings needs the access level raised first by writing the user password to 40001 (function 16), then save with operator command 40012 = 1.",
  "watchdog": null,
  "quirks": [
   "The memory reference is 30000/40000, not 30001/40001: printed 30107 is wire address 107.",
   "Floats and 32-bit integers are high word first (ABCD).",
   "The integer measurement registers use a packed exponent format; use the float block for SCADA."
  ],
  "setup": [
   "Modbus address 1-247; baud code range 1-7 (2400 to 115200 - code 0, 1200 baud, is listed but outside the allowed min/max); parity none/odd/even; 1 or 2 stop bits; 8 data bits only.",
   "The operator command register 40012 saves (1) or aborts (2) pending setting changes and can restart the instrument (3)."
  ],
  "gotchas": [
   "Which energy counter is import and which is export depends on the counter configuration registers; verify against the display before billing.",
   "Read 30099 for the maximum number of registers the meter accepts per request."
  ]
 },
