 "integration": {
  "summary": "Read holding registers (function 03) from 19000: 19000-19121 gives volts, amps, power, CosPhi, frequency, energy and THD as big-endian floats. For all-rate consumed/delivered energy use the energy-table totals.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 19000,
    "why": "Voltage L1-N"
   },
   {
    "table": "holding_register",
    "address": 19012,
    "why": "Current L1"
   },
   {
    "table": "holding_register",
    "address": 19026,
    "why": "Total real power"
   },
   {
    "table": "holding_register",
    "address": 19034,
    "why": "Total apparent power"
   },
   {
    "table": "holding_register",
    "address": 19050,
    "why": "Frequency"
   },
   {
    "table": "holding_register",
    "address": 6508,
    "why": "Real energy L1..L3, consumed (all rates)"
   },
   {
    "table": "holding_register",
    "address": 6520,
    "why": "Real energy L1..L3, delivered (all rates)"
   }
  ],
  "enable": "Set the RS485 port to Modbus slave operation with the device address and baud rate in the device configuration; the address list does not give the menu path.",
  "watchdog": null,
  "quirks": [
   "Addresses are used as printed (0-based).",
   "Floats are ABCD; add 32768 to an address for little-endian.",
   "Energy is in Wh/varh/VAh.",
   "Rotation field (19052) is a float: 1, 0 or -1."
  ],
  "setup": [
   "8 data bits, no parity; the device sends 2 stop bits.",
   "Baud rates 9.6, 19.2, 38.4, 57.6, 115.2 or 921.6 kbps."
  ],
  "gotchas": [
   "19068 is rate 1 only, not the consumed total.",
   "Short-format copies ignore the CT/VT ratio."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/janitza/umg-605",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
