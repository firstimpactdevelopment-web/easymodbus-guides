 "aliases": [
  "UTY-VMSX"
 ],
 "equipment_type": "VRF / split AC gateway",
 "applies_to": "Fujitsu General UTY-VMSX Modbus RTU converter, one per indoor unit, per interface specification part no. 9708438047-05.",
 "summary": "The UTY-VMSX connects a single Fujitsu indoor unit to an RS-485 Modbus RTU network as a slave. Input registers report mode, on/off, setpoint, room temperature, fan, louvres, errors and lockouts; holding registers send commands, where 0 always means 'no change'. All values are single 16-bit registers.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": 8,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "The specification states the rule: the frame address is the remainder of the register number divided by 10000, minus 1. Its example sends 35555 as 5554. So 30054 is input register 53 and 40002 is holding register 1."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Interface specification - Modbus convertor UTY-VMSX",
  "doc_number": "9708438047-05",
  "revision_date": null,
  "url": "https://www.fujitsu-general.com/datafiles/W9708438047-0501_IF_En_UTY-VMSX.pdf",
  "pages": "Communication spec and function list p. 6; object composition pp. 7-12 (printed page numbers)"
 },
 "notes": [
  "Function codes: 03 and 04 read, 06 and 16 write. If the indoor unit lacks a function or cannot report a value, an FC04 read returns 0.",
  "Serial settings per the spec: 9600 or 19200 bps, 8 data bits, parity even/odd/none, 2 stop bits with no parity or 1 with parity. No factory default address or speed is printed; they are set on the converter.",
  "Temperatures in input registers are x4 (0.25 °C steps). Temperature commands use bit 0 as a 'change' flag and bits 1-8 as the value x4, so 20 °C is written as 161; the spec prints a table for 18-30 °C.",
  "The setpoint limit registers 30066-30068 pack two values (upper in bits 0-7, lower in bits 8-15) so they are listed raw.",
  "Write all six limit registers 40012-40017 together with FC16 when switching between 'no limit' and 'limit', and keep each lower limit below its upper limit.",
  "Model name (30003) and software version (30007) are packed character codes; the spec does not give a character table, so they are listed raw.",
  "Not listed: holding registers 40018-40022 (external thermo-off and human-detection settings), whose rows are hard to align reliably in the printed table."
 ],
