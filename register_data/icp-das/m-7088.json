{
  "manufacturer": "ICP DAS",
  "manufacturer_slug": "icp-das",
  "model": "M-7088 8-channel PWM output / counter input module (Modbus RTU)",
  "model_slug": "m-7088",
  "short_model": "M-7088",
  "aliases": [
    "M-7088",
    "M7088"
  ],
  "equipment_type": "Sensor (PWM output and counter input module)",
  "applies_to": "ICP DAS M-7088 eight-channel PWM output module with eight digital inputs and counters, Modbus RTU firmware.",
  "summary": "The M-7088 is an RS-485 remote I/O module with eight PWM outputs and eight digital inputs that also count pulses. Over Modbus RTU the PWM duty cycle, frequency and burst settings are holding registers, PWM start/stop and modes are coils, and the 32-bit input counts are input registers stored low word first.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 9600,
    "parity": "None",
    "data_bits": null,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "Modicon",
    "note": "The table is titled 'M-7000 Address Mapping (Base 1)': 00001 coils, 10001 discrete inputs, 30001 input registers, 40001 holding registers. Subtract the table base for the wire address (40001 = holding register 0)."
  },
  "default_word_order": "CDAB",
  "firmware": null,
  "source": {
    "title": "M-7000 Series Address Mapping Table",
    "doc_number": "V1.18",
    "revision_date": "2025-09",
    "url": "https://www.icpdas.com/en/download/file.php?num=19906",
    "pages": "pp. 78-80"
  },
  "notes": [
    "The table states low word then high word for the DI counts, maximum counts and PWM frequency, so these are CDAB.",
    "Preset values (40097-40112) are left out: the table's example pairs 40097 with 40104, which contradicts the low/high pattern.",
    "Defaults come from the table: address 1 (40485) and baud/parity code 6 = 9600 bps, no parity, 1 stop bit (40486).",
    "PWM trigger, synchronisation, burst count readback, LED and EEPROM-save items are left out."
  ],
  "integration": {
    "summary": "Set a channel's frequency (40737+, 32-bit low word first) and duty cycle (40705+, 0.1 % steps), then start it with its PWM status coil (00001+). Read input registers 0-15 for the eight 32-bit pulse counts.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 704,
        "why": "PWM duty channel 0"
      },
      {
        "table": "holding_register",
        "address": 736,
        "why": "PWM frequency channel 0"
      },
      {
        "table": "coil",
        "address": 0,
        "why": "PWM start/stop channel 0"
      },
      {
        "table": "coil",
        "address": 864,
        "why": "PWM burst/continuous channel 0"
      },
      {
        "table": "input_register",
        "address": 0,
        "why": "DI count channel 0"
      },
      {
        "table": "discrete_input",
        "address": 32,
        "why": "DI status channel 0"
      }
    ],
    "enable": "The module must run the Modbus RTU protocol (coil 00257 = 1, factory default 1).",
    "watchdog": "Host watchdog: enable with coil 00261, timeout in 40489 (0.1 s steps, factory 25.5 s); coil 00270 shows and clears a timeout.",
    "quirks": [
      "32-bit values are low word first (CDAB).",
      "Duty cycle is in 0.1 % steps (500 = 50.0 %)."
    ],
    "setup": [
      "Module address in 40485 (1-247); baud and parity code in 40486."
    ],
    "gotchas": [
      "Coil 00260 picks the host watchdog mode: in the new mode an AO or DO command also clears the watchdog timeout status."
    ]
  },
