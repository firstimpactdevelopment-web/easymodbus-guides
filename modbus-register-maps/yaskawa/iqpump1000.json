{
 "manufacturer": "Yaskawa",
 "manufacturer_slug": "yaskawa",
 "model": "iQpump1000 intelligent pump drive (MEMOBUS/Modbus RTU)",
 "model_slug": "iqpump1000",
 "short_model": "iQpump1000",
 "aliases": [
  "CIMR-PW",
  "CIMR-PWA",
  "iQpump1000 AC Drive"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "Yaskawa iQpump1000 drives (CIMR-PW) using the built-in RS-485/422 MEMOBUS/Modbus terminals, per user manual TOEPYAIP1W01G.",
 "summary": "Yaskawa's pump drive with built-in pump-control functions and an RS-485/422 MEMOBUS/Modbus RTU port. Command registers (run bits, frequency reference, PID target, outputs) start at 0001H, status and monitor registers at 0020H, and parameters are reachable at their hex numbers. This map covers the command and status words, key monitors, fault/alarm bits and the b1/H5 setup parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 31,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Register numbers are hex and sent unchanged: the manual's read example asks slave 2 for starting register 0020H as Starting No. 00H 20H. Parameters use the hex numbers in the parameter list (H5-01 = 0425H)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "YASKAWA AC Drive iQpump1000 User Manual",
  "doc_number": "TOEPYAIP1W01G",
  "revision_date": null,
  "url": "https://www.yaskawa.com/delegate/getAttachment?documentId=TOEPYAIP1W01&cmd=documents&documentName=TOEPYAIP1W01.pdf",
  "pages": "Appendix C: C.4 H5 setup parameters pp. 455-458, function codes p. 461, read example p. 463, C.9 MEMOBUS/Modbus data table pp. 465-470 (command data p. 465-466, monitor data pp. 467-470), Enter command p. 483; parameter list hex numbers (b1 p. 214-217, H5 pp. 455-457)."
 },
 "notes": [
  "Frequency registers 0002H, 0023H and 0024H use the units chosen in o1-03, so they are left unscaled.",
  "Left out: 0007H/0008H analog output settings, 000DH PI2 setpoint (no unit printed), 0025H output voltage (unit switched by H5-10), 0026H output current and 0027H output power (left out like the other Yaskawa files because the unit is not fixed across models), 002FH frequency reference bias, 003EH/003FH output frequency in r/min or 0.01 % (sign not stated), the U-monitor/fault-trace blocks from 0040H and the real-time-clock registers 3004H-3030H.",
  "Only function codes 03H (read, max. 16 registers), 08H (loopback) and 10H (write multiple) are supported; use 10H for single writes.",
  "With H5-11 = 0 (default), parameter writes take effect only after the Enter command (0900H or 0910H). Command registers do not need Enter.",
  "H5 hex numbers come from the H5 parameter list table (p. 386-387): H5-01 0425H ... H5-12 043DH.",
  "Data length 8 bits and 1 stop bit are fixed (spec table C.1)."
 ],
