  "integration": {
    "summary": "Read holding registers (function 03) from 19000: 60 registers give volts, amps, power, CosPhi, frequency and per-phase energy as big-endian floats, and 19060-19077 adds total, consumed and delivered real energy in Wh. Over Ethernet use Modbus TCP; on RS-485 use RTU at the device address (parameter 0).",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 19000,
        "why": "Voltage L1-N"
      },
