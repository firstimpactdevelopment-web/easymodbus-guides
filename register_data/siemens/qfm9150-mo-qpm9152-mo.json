    "unit_id": 1,
    "baud": null,
    "parity": "Even",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "1-based",
    "note": "The register table prints register numbers and states that numbering starts at 1, so register 1 (temperature) is wire address 0 and register 764 (Modbus address) is wire address 763."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "Duct sensors QFM9150/MO, QPM9152/MO Basic Documentation",
    "doc_number": "A6V13841469_en--_a",
    "revision_date": "2022-12",
    "url": "https://sid.siemens.com/r/A6V13841469",
    "pages": "section Modbus registers; Modbus configuration parameters; DIP switch configuration"
  },
  "notes": [
    "All registers are single 16-bit holding registers; no 32-bit values are published.",
    "CO2, IAQ and VOC registers (5-8, 15-16, 212, 225-227) only carry data on the QPM9152/MO.",
    "Baud rate default is 0 = Auto (the sensor takes the master baud rate). Default format 1-8-E-1.",
    "Registers 764-768 cannot be written by the master while DIP2 switch 7 is ON (DIP-switch configuration mode). Address 246 cannot be set from the master.",
    "Temperature and offset registers are treated as signed because the published ranges go below zero.",
    "Software version example from the source: [2.01.33] = 0x02010021 (major byte, minor byte, then a 16-bit build).",
    "Register 767 is marked reserve and is left out."
  ],
