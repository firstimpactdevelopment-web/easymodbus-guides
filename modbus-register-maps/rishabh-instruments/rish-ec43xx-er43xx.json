{
 "manufacturer": "Rishabh Instruments",
 "manufacturer_slug": "rishabh-instruments",
 "model": "RISH EC43xx / ER43xx DIN-rail energy meters",
 "model_slug": "rish-ec43xx-er43xx",
 "short_model": "EC43xx / ER43xx",
 "aliases": [
  "EC4311",
  "EC4321",
  "ER4311",
  "ER4321",
  "RISH EC43X1",
  "EC43XX",
  "ER43XX"
 ],
 "equipment_type": "Energy meter",
 "applies_to": "Rishabh RISH EC43xx and ER43xx DIN-rail digital energy meters with RS-485 Modbus, per interface definition DMAN-00IM-09xx Rev. F (11/25).",
 "summary": "The RISH EC43xx / ER43xx is a DIN-rail digital energy meter that measures voltage, current, power, power factor, frequency, THD and energy on 3-phase 4-wire, 3-phase 3-wire or single-phase networks. Its RS-485 port speaks Modbus RTU and every reading is a 32-bit IEEE float in two registers. This map covers per-phase and system measurements, demands, THD, run/on hours and the float energy registers including per-phase and tariff energies, plus the read-only system type and CT/PT ratio registers.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": null,
  "parity": null,
  "data_bits": 8,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "The manual prints 30001/40001-style addresses next to the hex start address actually sent (30001 = 0x0000). Wire address = printed number - 30001 (input registers) or - 40001 (holding registers); every value here was cross-checked against the printed hex address."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "EC43XX / ER43XX Interface Definition",
  "doc_number": "DMAN-00IM-09xx Rev. F",
  "revision_date": "2025-11",
  "url": "https://rishabh.co.in/uploads/product/rish-ec43x1-260/RISH_EC43XX_ER43XX_INTERFACE_DEFINITION_REV_F.pdf",
  "pages": "pp. 7-8 (protocol, example frames), pp. 9-14 (Table 1.1-1.3), p. 19 (Table 3), p. 21 (word order)"
 },
 "notes": [
  "Measured values are IEEE-754 32-bit floats in two registers. The manual's example responses (e.g. data bytes 43 5B 41 06 for a voltage reading) put the most significant register first, so ABCD is the default order.",
  "Every measured value is also readable as a holding register (FC03) at the 4X address printed next to it in the manual; this map lists the 3X (input register, FC04) copies only.",
  "Rows whose printed hex address does not match the decimal 3X/4X address in the manual were left out rather than guessed.",
  "Left out: the 32-bit integer energy tables (their integer word order is not demonstrated in the manual), user-assignable registers and data-log blocks.",
  "Units come from the manual's Units column. One obvious slip was corrected: 30079 VArh export is printed as kVAh and is given here as kvarh. 30051 Watt Avg is left out because its unit cell is misprinted.",
  "The Word Order register (46055) is left out because its printed hex address (0x1790) does not match; the manual says writing 2141.0 to it makes the meter adopt the float register order used for that write.",
  "Only the setup rows whose printed hex matches the decimal address are included (Table 3's hex column is shifted for 46019-46105)."
 ],
 "integration": {
  "summary": "Read measured values with FC04 (or FC03 at the 4X copies) in pairs of registers and decode them as ABCD floats. Settings are floats too and are written with FC16.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "Voltage L1"
   },
   {
    "table": "input_register",
    "address": 6,
    "why": "Current L1"
   },
   {
    "table": "input_register",
    "address": 52,
    "why": "Total active power (Watt Sum)"
   },
   {
    "table": "input_register",
    "address": 70,
    "why": "Frequency"
   },
   {
    "table": "input_register",
    "address": 72,
    "why": "Active energy import"
   },
   {
    "table": "input_register",
    "address": 62,
    "why": "Average power factor"
   }
  ],
  "enable": "Modbus RTU on RS-485 is built in; set the slave address, baud rate and parity from the meter's setup menu or the RS-485 setup register.",
  "watchdog": null,
  "quirks": [
   "Each parameter is two registers; reading or writing only half of a float returns an Illegal Data Address exception.",
   "Addresses are Modicon-style: subtract 30001 or 40001 for the wire address."
  ],
  "setup": [
   "Slave address range 1-247; broadcast (address 0) is not supported.",
   "Allow about 300 ms for the meter to answer before retrying."
  ],
  "gotchas": [
   "If a password lock is set, write the valid password to the Password register before changing any 4X setting; a wrong password returns exception code 2."
  ]
 },
