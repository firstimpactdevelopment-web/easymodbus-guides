  "integration": {
    "summary": "Read holding registers in CDAB 32-bit pairs at address 100 (default). Read EnerPowDivider (16045) first and scale power and energy with raw x divider x 0.001.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 11000,
        "why": "Voltage L1-N"
      },
      {
        "table": "holding_register",
        "address": 11024,
        "why": "Current 1"
      },
      {
        "table": "holding_register",
        "address": 11054,
        "why": "Total active power (raw)"
      },
      {
        "table": "holding_register",
        "address": 14006,
        "why": "Total nett active energy (raw)"
      },
      {
        "table": "holding_register",
        "address": 16044,
        "why": "EnerPowDivider"
      }
    ],
    "enable": "Modbus is built in (RS-485 RTU or Ethernet TCP depending on model). Communication parameters and address are normally set with Measurlogic's DTSConfig software.",
    "watchdog": null,
    "quirks": [
      "Every value is 32-bit signed, low word first (CDAB).",
      "Published addresses are 1-based.",
      "Power/energy resolution depends on EnerPowDivider."
    ],
    "setup": [
      "Default slave address 100.",
      "RS-485 baud rate 9600 or 19200; change it with DTSConfig rather than by writing registers.",
      "Do not change the RS-485 registers on Ethernet models."
    ],
    "gotchas": [
      "Writing wrong values to 16119-16123 can make the meter unreachable.",
      "Not every register is used on every model or wiring; only connected channels and the Total/Average registers carry valid data."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
