  "integration": {
    "watchdog": "When the demand or humidity signal comes from Modbus, it must be rewritten within 'Signal Timeout' (1-300 s, default 300 s); otherwise warning W35 is raised and the unit stops humidifying.",
    "quirks": [
      "The address column is the wire address; 32001 is address 2000.",
      "Floats are two registers, MSR first by default."
    ],
    "summary": "Read input registers 2000-2019 (UInt16 states) and 2025-2050 (floats). To control over Modbus, write the demand or humidity value to holding 3004 at least once per signal timeout and enable via 3005.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 2001,
        "why": "Device status"
      },
      {
        "table": "input_register",
        "address": 2002,
        "why": "Maintenance and error status"
      },
      {
        "table": "input_register",
        "address": 2003,
        "why": "Error/warning code"
      },
      {
        "table": "input_register",
        "address": 2027,
        "why": "Actual capacity"
      },
      {
        "table": "input_register",
        "address": 2029,
        "why": "Actual humidity or demand"
      },
      {
        "table": "holding_register",
        "address": 3004,
        "why": "Demand/humidity via Modbus"
      },
      {
        "table": "holding_register",
        "address": 3005,
        "why": "Remote enable"
      }
    ],
    "enable": "Controls > Signal Settings: set Source = Modbus (and Remote Enable = Modbus to use register 43006). The demand register 43005 only works when Source is not Analog.",
    "setup": [
      "Menu > password 8808 > Network > Modbus Settings: set protocol (Modbus/RTU or Modbus/TCP), address, parity, baud rate and register sequence; the controller restarts after a protocol change.",
      "For Modbus TCP set the IP parameters under Network > IP Settings (factory setting DHCP)."
    ],
    "gotchas": [
      "With Modbus as signal source, do not also wire a hard demand signal to the driver board.",
      "Remote enable via 43006 needs software 1.4.0 or later."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
