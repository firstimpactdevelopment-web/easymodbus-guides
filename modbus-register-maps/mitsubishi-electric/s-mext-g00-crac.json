 ],
 "equipment_type": "Air handler (computer room air conditioner)",
 "applies_to": "Mitsubishi Electric (Hydronics & IT Cooling) s-MEXT-G00 006-044 close-control units with ME28-relC software and the Modbus serial board.",
 "summary": "The s-MEXT-G00 is a Mitsubishi Electric direct-expansion close-control unit for computer rooms (6-44 kW). With the Modbus serial board fitted, its controller exposes Boolean variables as coils and analogue/integer variables as holding registers over RS-485 Modbus RTU. This map covers unit status and on/off, setpoints, room/delivery/outside temperatures, humidity, pressures, fan and damper positions, operating mode, run hours and the electrical readings.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": null,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 2,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "The interface database prints coils as 001-184 and registers as 40001-40257 and states the start address is 1, not 0. So coil 002 is wire address 1 and register 40002 is wire address 1. Integer ('whole') variables start at 40129 (software address + 128)."
 },
 "default_word_order": null,
 "firmware": "ME28-relC",
 "source": {
  "title": "Computer room air conditioner model s-MEXT-G00 006-044 Interface Manual",
  "doc_number": "SM_s-MEXT_ME28relC_00_12_19_EN",
  "revision_date": "2019-12",
  "url": "https://library.mitsubishielectric.co.uk/pdf/download_full/3957",
  "pages": "pp. 8-13 (3 Interfacing with the Modbus system: setup p. 8-9, characteristics p. 10, address tables p. 11, database pp. 12-13)"
 },
 "notes": [
  "Scale: the manual's conversion factors are 'Value x10' for writes and 'Value/10' for reads, so those registers hold tenths (scale 0.1); 'Value x1' registers are unscaled.",
  "Analogue (type A) variables are listed as INT16 because the manual documents negative sentinel values (-999 probe alarm, -888 not configured); integer (type I) variables are listed as UINT16 since none carry negative ranges. The manual does not state signedness explicitly.",
  "Flow OUT = read only, IN = written by the BMS; rows listing both are read-write. Coil 038 is IN only (write).",
  "Run hours are split into a 'thousands' and a 'units' register.",
  "Serial settings per the manual: 8 data bits, 2 stop bits, no parity (fixed); baud selectable 1200-19200 in the user menu (P30.04); unit ID 001-200.",
  "Addresses not listed in the database must not be used, per the manual."
 ],
