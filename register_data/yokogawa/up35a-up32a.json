{
  "manufacturer": "Yokogawa",
  "manufacturer_slug": "yokogawa",
  "model": "UTAdvanced UP35A / UP32A program controller",
  "model_slug": "up35a-up32a",
  "short_model": "UP35A/UP32A",
  "aliases": [
    "UP35A",
    "UP32A"
  ],
  "equipment_type": "Sensor (program temperature controller)",
  "applies_to": "Yokogawa UP35A and UP32A single-loop program controllers with RS-485 or Ethernet communication; D-register map from IM 05P07A01-01EN chapter 8 (UP35A/UP32A columns).",
  "summary": "The UP35A and UP32A are compact UTAdvanced program (ramp/soak) controllers with up to 2 patterns (4 with option /AP) and one loop. Its D registers map one-to-one onto Modbus holding registers over RS-485 (Modbus RTU/ASCII) or Modbus/TCP on Ethernet models. This map covers process data, program status and events, local-mode settings and the program operation commands.",
  "transport": [
    "RTU",
    "ASCII",
    "TCP"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 19200,
    "parity": "Even",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": 502
  },
  "addressing": {
    "convention": "1-based",
    "note": "The manual lists D register numbers (D2003). The Modbus reference number replaces the D with 4 (42003) and the wire address is that minus 40001, printed in the table's H No. column (D2003 = 07D2H)."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "UTAdvanced Series Communication Interface (RS-485, Ethernet) User's Manual",
    "doc_number": "IM 05P07A01-01EN 13th Edition",
    "revision_date": "2026-03",
    "url": "https://web-material3.yokogawa.com/IM05P07A01-01EN.pdf",
    "pages": "D register addressing p. 3-4; tables and descriptions pp. 8-6 to 8-25 (UP35A/UP32A columns)"
  },
  "notes": [
    "All registers are 16-bit. Values are sent without their decimal point: PV/SP-type values follow the input's decimal point setting, percentages carry one decimal (scale 0.1).",
    "Only registers whose UP35A/UP32A columns show R or R/W are listed. D2001-D2100 are read-only.",
    "The current PID group registers (D2114 onward) are left out: in the source table the access mark for those rows cannot be placed reliably under the UP35A or UP32A column.",
    "D2045-D2047 (pattern repeat counters) are left out because the source gives two of them the same description.",
    "Which of D2061-D2064 (heater break, valve) are present depends on the model suffix and options.",
    "Program pattern data (D8001-D9000), the GREEN-series compatible area (D0001-D2000) and setup parameters (D2501 onward) are not included."
  ],
