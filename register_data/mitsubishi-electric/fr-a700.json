  "integration": {
    "summary": "Set Pr.549 = 1 and Pr.331 to 1-247 (initial 0 is broadcast) and reset, then switch to NET mode by writing H0014 to 40010. Write the frequency to 40014 (0.01 Hz) and the run bits to 40009, and poll 40009, 40201, 40224 and 40501.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 8,
        "why": "Run/stop command and inverter status"
      },
      {
        "table": "holding_register",
        "address": 9,
        "why": "Operation mode (write H0014 for NET)"
      },
      {
        "table": "holding_register",
        "address": 13,
        "why": "Frequency command (RAM)"
      },
      {
        "table": "holding_register",
        "address": 200,
        "why": "Output frequency"
      },
      {
        "table": "holding_register",
        "address": 223,
        "why": "Motor load factor"
      },
      {
        "table": "holding_register",
        "address": 500,
        "why": "Latest fault code"
      }
    ],
    "enable": "Pr.549 = 1 selects Modbus-RTU (RS-485 terminals only); set Pr.331, Pr.332 and Pr.334 and reset. Run/frequency commands need NET operation mode (write H0014 to 40010; allowed depending on Pr.79/Pr.340). With a communication option fitted and Pr.550 = 9999, RS-485 terminal commands are ignored.",
    "watchdog": "Pr.539 Modbus-RTU communication check time interval (0.1-999.8 s, same behaviour as Pr.122); 9999 (initial) = no check; 0 lets Modbus run but the drive trips in NET mode.",
    "quirks": [
      "Request address = register - 40001.",
      "Station 0 is broadcast and never replies.",
      "40009 means control input when written and inverter status when read."
    ],
    "setup": [
      "Pr.332 initial 96 = 9600 bps; Pr.334 initial 2 = even parity, 1 stop bit; data length fixed at 8 bits.",
      "Modbus-RTU cannot be used in PU operation mode."
    ],
    "gotchas": [
      "Current and power monitors change resolution at 75K, so check the drive size before scaling them."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
