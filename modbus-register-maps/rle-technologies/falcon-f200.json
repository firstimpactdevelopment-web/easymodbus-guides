{
 "manufacturer": "RLE Technologies",
 "manufacturer_slug": "rle-technologies",
 "model": "Falcon F200 environment and leak monitoring appliance (Modbus TCP)",
 "model_slug": "falcon-f200",
 "short_model": "Falcon F200",
 "aliases": [
  "F200",
  "Falcon F200"
 ],
 "equipment_type": "Sensor (environmental / leak monitor)",
 "applies_to": "RLE Falcon F200 with firmware 4100.1 or later; register guide v06.21.",
 "summary": "The Falcon F200 is a small monitoring appliance for data rooms: up to four external temperature/humidity sensors, a leak-detection cable input and eight digital inputs. It is a Modbus TCP server only. All values are 16-bit holding registers: temperatures in hundredths of a degree (C and F copies), humidity in %RH, leak and cable status flags and digital input states and alarms.",
 "transport": [
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "RLE prints every register in 4xxxx form ('Read Output Registers', read with FC3). Under the Modicon convention 40010 is wire address 9. The guide has no example frame that confirms the offset."
 },
 "default_word_order": null,
 "firmware": "4100.1 and above",
 "source": {
  "title": "F200 - Modbus Communications",
  "doc_number": "v06.21",
  "revision_date": "2021-06",
  "url": "https://WWW.RLETECH.COM/wp-content/uploads/2021/06/F200_Modbus_Registers-06.21.pdf",
  "pages": "pp. 1-2 (all register tables)"
 },
 "notes": [
  "Temperature registers are 'Celsius x 100' or 'Fahrenheit x 100' with range 0-65535 (unsigned as published), so 2150 = 21.50 °C. The guide does not say how sub-zero temperatures are reported.",
  "Humidity is published as '% Relative Humidity' with no multiplier; scale 1 is used.",
  "Only 16-bit registers exist; no word-order question arises.",
  "The guide gives no unit ID or TCP port."
 ],
 "integration": {
  "summary": "Poll the F200 over Modbus TCP with FC3. Read 40071-40073 for leak, missing cable and cable break, 40010/40013 for sensor 1 temperature and humidity, and 40004/40005 for digital input alarm and state bitfields.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 70,
    "why": "Leak detected"
   },
   {
    "table": "holding_register",
    "address": 72,
    "why": "Cable break"
   },
   {
    "table": "holding_register",
    "address": 71,
    "why": "No sensing cable connected"
   },
   {
    "table": "holding_register",
    "address": 9,
    "why": "Sensor 1 temperature (°C x 100)"
   },
   {
    "table": "holding_register",
    "address": 12,
    "why": "Sensor 1 humidity"
   },
   {
    "table": "holding_register",
    "address": 3,
    "why": "Digital input alarm bitfield"
   }
  ],
  "enable": "The guide only says the F200 acts as a Modbus TCP server; it does not describe enabling or configuring Modbus.",
  "watchdog": null,
  "quirks": [
   "Digital input alarm registers 40090-40097 stay 0 unless the input's notification option in the web interface is set to something other than Disabled."
  ],
  "setup": [],
  "gotchas": [
   "Each external sensor has its own fixed block of registers; 40006 reports whether sensors are connected."
  ]
 },
