  "integration": {
    "summary": "Set C096 to Modbus-RTU and the C07x serial settings, then set A001 = 03 and A002 = 03 so the frequency and run command come from Modbus. Write the frequency to 0001h/0002h, start and stop with coil 0001h, and poll 0003h-0005h plus the d-group monitors from 1001h.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "Frequency command F001"
      },
      {
        "table": "coil",
        "address": 0,
        "why": "Run/stop"
      },
      {
        "table": "coil",
        "address": 3,
        "why": "Fault reset"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Inverter state A"
      },
      {
        "table": "holding_register",
        "address": 4096,
        "why": "Output frequency"
      },
      {
        "table": "holding_register",
        "address": 4098,
        "why": "Output current"
      },
      {
        "table": "holding_register",
        "address": 17,
        "why": "Latest trip code"
      },
      {
        "table": "holding_register",
        "address": 4133,
        "why": "DC bus voltage"
      }
    ],
    "enable": "Set RS485 communication mode [C096] to Modbus-RTU, then A001 = 03 (frequency from Modbus) and A002 = 03 (run command from Modbus). Coils 0001h/0002h only act when A002 = 03.",
    "watchdog": "C077 sets a communication timeout (0.00 = off, up to 99.99 s); C076 selects the action on a comm error: trip, trip after deceleration, ignore (default), free run or deceleration stop.",
    "quirks": [
      "Wire address is the printed hex number minus 1.",
      "F001 is a two-register value (0001h high, 0002h low). Reading or writing only the low word 0002h is allowed; accessing only the high word is rejected with exception 27h.",
      "Byte order of the data field follows [P400]; keep it at 00 Big endian unless the master needs otherwise.",
      "Parameter writes over Modbus are not stored in EEPROM unless 0900h is written with 1 (or the EEPROM write mode is set)."
    ],
    "setup": [
      "C071 baud (default 05 = 9600), C072 node address 1-247 (default 1), C074 parity (default none), C075 stop bits (default 1).",
      "Turn on the built-in 120 ohm termination switch on the inverter at the end of the line.",
      "Connect SP/SN for the RS485 pair and L as signal ground."
    ],
    "gotchas": [
      "The intelligent input coils are OR-ed with the physical terminals; the [d005] monitor shows only the physical terminals, not the Modbus-driven state.",
      "Communication error coils (004Ah-004Eh) latch until an error reset."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
