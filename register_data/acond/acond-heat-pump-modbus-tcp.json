  "integration": {
    "summary": "Have Acond service enable ModbusTCP, tick ModbusTCP on the heat pump's web page, then poll input registers 30001-30024 with function 4 and write targets and TC_set at 40001-40014 regularly so the heat pump keeps using the master's values.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 6,
        "why": "Status bits (on, running, alarm, defrost)"
      },
      {
        "table": "input_register",
        "address": 13,
        "why": "Operating mode"
      },
      {
        "table": "input_register",
        "address": 9,
        "why": "Outdoor temperature"
      },
      {
        "table": "input_register",
        "address": 8,
        "why": "Return water temperature"
      },
      {
        "table": "input_register",
        "address": 20,
        "why": "Fault code"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Room setpoint circuit 1"
      },
      {
        "table": "holding_register",
        "address": 4,
        "why": "Hot water setpoint"
      },
      {
        "table": "holding_register",
        "address": 5,
        "why": "Mode / fault reset bits"
      }
    ],
    "enable": "ModbusTCP is activated by an Acond service technician. Afterwards a ModbusTCP link appears on the heat pump's main web page; tick the ModbusTCP box in the dark blue bar to start communication.",
    "watchdog": "If no data is exchanged within MaxCommDataRefresh, the status shows 'ModbusTCP false' and values received from the master are replaced by the heat pump's own sensor readings until communication returns.",
    "quirks": [
      "Only one Modbus master may talk to the heat pump at a time.",
      "Unit ID 2 is reserved for the heat pump cascade; the slave answers as ID 1.",
      "A temperature written outside its range makes the heat pump use its own sensor value; an out-of-range setpoint is ignored."
    ],
    "setup": [
      "Modbus TCP on port 502; supported functions 3 and 4 for reading, 6 and 16 for writing."
    ],
    "gotchas": [
      "The last communication error stays on the status page only until the next successful exchange."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
