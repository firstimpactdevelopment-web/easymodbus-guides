 "model": "LCG series DC inverter air conditioners (built-in Modbus)",
 "model_slug": "lcg-series",
 "short_model": "Aermec LCG",
 "aliases": [
  "LCG"
 ],
 "equipment_type": "Split AC unit (VRF / split AC gateway built in)",
 "applies_to": "Aermec LCG series DC inverter units whose indoor-unit controller has the built-in Modbus RTU interface; Modbus Protocol user manual LCG 5385758_02 (24.01).",
 "summary": "The indoor-unit controller of Aermec LCG units answers Modbus RTU directly, so no extra gateway is needed. Holding registers carry on/off, mode, fan speed, setpoint, louvre position and temperatures; coils carry feature flags (turbo, silent, locks, energy saving) and a long list of indoor, outdoor and inverter-drive fault bits. Up to 255 units can share a BMS line.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "The protocol says registers are words numbered from 0 and coils are bits numbered from 0 (Byte0.0 = bit 0). Word n is wire address n and Bit n is coil n; the example frames agree (read starting at word 1 sends 0x0001, coil 5 sends 0x0005)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Modbus Protocol User manual LCG",
  "doc_number": "5385758_02",
  "revision_date": "2024-01",
  "url": "https://www.aermec.com/download?id=14523",
  "pages": "p. 7 serial settings, pp. 8-12 addressing and frames, pp. 13-14 precautions, pp. 19-27 registers (words), pp. 28-43 coils (bits)"
 },
 "notes": [
  "Only named points are listed; reserved words and bits are left out.",
  "Left out because the table row is incomplete in the source: bit 18 (no name), bits 125, 155, 196 and 216-247 (blank names), plus bits 3, 48, 67, 94, 124, 189, 197, 200, 206 and 209 which fall on page breaks where the address and text do not line up reliably.",
  "Some fault bits are printed with the legend '1: yes 0: on'; the 0 state is read here as 'no fault'.",
  "Word 2 uses 0xAA for on and 0x55 for off, not 1/0.",
  "The point list matches Aermec's LPG series protocol; the LCG table lists DRED values 1-3 only (no value 0)."
 ],
