 "equipment_type": "Energy meter",
 "applies_to": "Rishabh RISH EM 3490 SS three-phase energy meters with the optional RS-485 Modbus output, per the 3-phase manual Rev E.",
 "summary": "The RISH EM 3490 SS is a three-phase panel energy meter with an optional RS-485 Modbus RTU port. Every measured value and every setting is an IEEE 32-bit float spread over two registers: readings are input registers (FC04) from 30001, settings are holding registers (FC03 read, FC16 write) from 40005. This map covers the full measured-value table, the setup registers and the word-order switch.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "The manual prints 30001/40001-style register numbers next to the hex start address that goes on the wire (30001 = 00 00, 40011 = 00 0A). Wire address = printed number - 30001 or - 40001; every row was checked against the printed hex."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "EM 3490 SS Three Phase Energy Meter Installation & Operating Instructions",
  "doc_number": "15000250 Rev. E",
  "revision_date": "2013-05",
  "url": "https://rishabh.co.in/uploads/product/rish-em3490ss-single-source-energy-meter-154/Energy_Meter_-_3490SS_-_Manual_Rev_E_3P.pdf",
  "pages": "printed pp. 7-10 (data format, function codes, examples, Table 4 3X registers, Table 5 4X registers, Table 6 RS485 set-up code, user-assignable registers)"
 },
 "notes": [
  "All registers are 32-bit floats in two consecutive registers. The read example for Volts 3 returns 43 5B 41 21 (219.25 V), most significant word first, so ABCD is the default; 40041 can switch the meter to reversed order.",
  "The register table has no unit column, so units are left blank. The manual notes active energy reads in Wh and apparent energy in VAh, while 40005 lets you change the energy unit to kWh or MWh.",
  "Rows marked '3-phase 4-wire only' are not available on a meter set to 3-phase 3-wire.",
  "Up to 20 parameters (40 registers) per read; larger requests return an exception.",
  "Left out: the 20 user-assignable registers (30513-30551, mapped through 40513-40534), which mirror any 3X value; see the manual's Tables 9 and 10.",
  "Serial defaults are not printed in the manual; read 40019 or the meter's setup menu."
 ],
