{
  "manufacturer": "Riello UPS",
  "manufacturer_slug": "riello-ups",
  "model": "NetMan 204 network card (UPS Modbus TCP map)",
  "model_slug": "netman-204",
  "short_model": "NetMan 204",
  "aliases": [
    "NetMan 204",
    "Riello UPS Modbus TCP"
  ],
  "equipment_type": "UPS network card",
  "applies_to": "Riello UPS units fitted with a NetMan 204 network card (manual 0MNACCSA4ENUL); the UPS table is generic, and values a UPS does not supply read 0xFFFF.",
  "summary": "NetMan 204 is Riello UPS's Ethernet card. Besides SNMP and BACnet it serves a fixed Modbus TCP table on port 502 with UPS state bits, input/bypass/output measurements, battery data, nominal ratings and a small command block. This map covers that whole published UPS table.",
  "transport": [
    "TCP"
  ],
  "defaults": {
    "unit_id": null,
    "baud": null,
    "parity": null,
    "data_bits": null,
    "stop_bits": null,
    "tcp_port": 502
  },
  "addressing": {
    "convention": "1-based",
    "note": "The tables print both a register NUMBER and an ADDRESS column, and a footnote says register n is sent as n-1 (e.g. register 12, input voltage V1, is address 11). State bits likewise: bit number n is bit address n-1. This map uses the ADDRESS column."
  },
  "default_word_order": "CDAB",
  "firmware": null,
  "source": {
    "title": "NetMan 204 user manual",
    "doc_number": "0MNACCSA4ENUL",
    "revision_date": null,
    "url": "https://www.riello-ups.com/uploads/file/768/2768/0MNACCSA4ENUL__MAN_ACC_NETMAN_204_EN_.pdf",
    "pages": "pp. 65-68 (Modbus TCP/IP protocol); p. 11 and p. 33 (enable); p. 15 (reset defaults)"
  },
  "notes": [
    "Function codes 1/2 read the state bits, 3/4 read all registers (the same table either way, listed here as holding registers), and 6/16 write only the command registers.",
    "State bits are listed as discrete inputs at their bit addresses (bit number minus 1). The manual gives bit numbers, not the bit position inside registers 1-4, so the register words themselves are not decoded here.",
    "Left out because the manual does not say whether they are signed: battery current (51), negative battery voltage (50), internal UPS temperature (62) and sensor temperatures (63, 64).",
    "Special flag registers 121-128 (Sentry 'SENTR' status codes) are not decoded; the manual points to each UPS manual for them.",
    "Gaps in the table (e.g. 9-11, 19-21, 45-47) are reserved. Any measurement the connected UPS does not provide reads 0xFFFF."
  ],
