{
 "manufacturer": "Intesis (HMS Networks)",
 "manufacturer_slug": "intesis",
 "model": "INMBSPAN001I100 Panasonic Etherea (domestic) AC to Modbus RTU gateway",
 "model_slug": "inmbspan001i100",
 "short_model": "INMBSPAN001I100 Panasonic",
 "aliases": [
  "INMBSPAN001I100",
  "Intesis Panasonic Etherea Modbus",
  "Intesis Panasonic domestic Modbus"
 ],
 "equipment_type": "VRF / split AC gateway",
 "applies_to": "Panasonic Etherea-line domestic split units, user's manual r1.5 (09/2025). Some registers only on 2013 (PKE series) and later models.",
 "summary": "Modbus RTU server that connects to a Panasonic Etherea domestic split unit. Holding registers cover on/off, mode, fan, both vanes, setpoint, powerful/quiet/ECO modes, compressor state, demand response, outdoor and return temperatures, power, current and daily/total energy counters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 2,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "Tables give a 'protocol address' (base 0) and a 'PLC address' (base 1); the protocol address is the wire address and is used for 'documented'."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Intesis INMBSPAN001I100 User's Manual - Modbus RTU interface for Panasonic Etherea air conditioners",
  "doc_number": "User's Manual r1.5 EN",
  "revision_date": "2025-09",
  "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-inmbspan001i100.pdf",
  "pages": "pp. 8-12 (registers), pp. 13-14 (temperature notes), pp. 15-18 (DIP switches), p. 19 (functions)"
 },
 "notes": [
  "All registers are 16-bit unsigned holding registers; the 'no value' marker printed -32768 is raw 0x8000 (32768).",
  "Energy counters are given as MSW/LSW register pairs with the most significant word at the lower address (72/73, 74/75, 76/77), so they are mapped as UINT32 high word first (ABCD). The manual's text '0..65535 (hours)' on those rows is a copy slip; the unit is stated as watt-hours.",
  "Temperatures follow SW4: x1 °C, x10 °C or °F. The register footnote calls x10 the default but the DIP-switch table marks x1 and Celsius as factory setting, so scale 1 / °C is used; with x10 set use 0.1.",
  "FC16 is accepted only with a length of 1, so the two words of Total energy (76/77) must be written one at a time.",
  "Left out: machine threshold and custom setpoint-limit registers 1151-1156, because the manual does not say whether they follow the SW4 x1/x10 setting.",
  "Error code list not reproduced; see manual section 7."
 ],
