 "integration": {
  "summary": "Read 6 registers from 0x0000 (function 03) for concentration, cell current and temperature as CDAB floats; read 0x0200 once for the unit.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Concentration"
   },
   {
    "table": "holding_register",
    "address": 4,
    "why": "Temperature"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Cell current (for calibration)"
   },
   {
    "table": "holding_register",
    "address": 512,
    "why": "Unit code"
   }
  ],
  "enable": "Modbus RTU is the native interface; change address and serial format with JUMO DSM software or registers 0x0400-0x0402.",
  "watchdog": null,
  "quirks": [
   "Floats are low word first (CDAB).",
   "Only RTU mode is supported."
  ],
  "setup": [
   "M12 pins: 2 = +24 V, 3 = GND, 4 = RS-485 B, 5 = RS-485 A.",
   "Check the type-specific default address before commissioning several sensors on one bus."
  ],
  "gotchas": [
   "Sensors ship uncalibrated; a calibration only becomes active when the date/time stamp is written.",
   "Replace the membrane/electrolyte when the slope falls below 30 % of the nominal slope (0x030A)."
  ]
 },
