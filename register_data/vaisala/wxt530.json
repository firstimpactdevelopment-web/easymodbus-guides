{
  "manufacturer": "Vaisala",
  "manufacturer_slug": "vaisala",
  "model": "WXT530 series weather transmitters (Modbus RTU)",
  "model_slug": "wxt530",
  "short_model": "WXT530",
  "aliases": [
    "WXT531",
    "WXT532",
    "WXT533",
    "WXT534",
    "WXT535",
    "WXT536"
  ],
  "equipment_type": "Sensor (weather transmitter)",
  "applies_to": "WXT531-WXT536 weather transmitters with firmware 3.85 or later in Modbus RTU mode (user guide M211840EN-G).",
  "summary": "The WXT530 series are compact Vaisala weather transmitters that measure wind, pressure, temperature, humidity, rain and (WXT536) external inputs. From firmware 3.85 the RS-485 user port can run Modbus RTU. All values are 16-bit integers with a scale factor; this map covers the configuration holding registers and the instant, min, max and average input registers in metric and imperial units.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 19200,
    "parity": "Even",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "1-based",
    "note": "Every register table prints both the 1-based register number and the hex address (register 1 = 0x0000), and the text refers to holding register number 10 as 0x0009; the hex address is what goes on the wire."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "WXT530 Series User Guide",
    "doc_number": "M211840EN-G",
    "revision_date": "2023-05",
    "url": "https://docs.vaisala.com/r/M211840EN-G/en-US",
    "pages": "Appendix B Modbus protocol, pp. 173-189 (Tables 57-74); default serial settings Table 24, p. 73"
  },
  "notes": [
    "Holding registers 1-11 hold configuration and functions (read with function 03, write with function 16); measurements and device status are input registers (function 04).",
    "Every value is a single 16-bit register; there are no 32-bit values.",
    "Values are stored as value x scaling factor; divide the raw value by the listed factor. Signed values read 32767 when invalid or unavailable, unsigned values 65535.",
    "Available quantities depend on the model; input registers 3-8 tell which parameters and sensors are present (high/low byte 00 = available, 07 = not available).",
    "Do not poll faster than the update interval of the value (for example 1 min for averages).",
    "Tipping bucket rain gauges and level sensors are not supported over Modbus."
  ],
