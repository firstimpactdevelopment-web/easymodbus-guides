  "unit_id": 1,
  "baud": 19200,
  "parity": "Odd",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Addresses are printed in hex (0064H) and go into the request unchanged; the manual's Modbus example resets energy by writing 2 words at data item 0064H. The MEWTOCOL DT number in decimal equals the hex Modbus address."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "KW7M Eco-POWER METER User's Manual",
  "doc_number": "ARCT1F434E-6",
  "revision_date": "2016-06",
