 "integration": {
  "summary": "Wire RS485 to terminals 8 (A) and 10 (B), poll unit 1 at 9600 baud 8E1 with function 04 and decode live values as high-word-first floats from 5000h. Write 2 to 4026h once (function 06) so the 6000h energy registers come back as floats.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 20482,
    "why": "Voltage L1"
   },
   {
