 "equipment_type": "Motor management and protection relay",
 "applies_to": "TeSys T LTMR Modbus controllers (LTMR..M..), with or without the LTMEV40 expansion module, per DOCA0130EN-03 (02/2024).",
 "summary": "The TeSys T LTMR protects and controls a motor and talks Modbus RTU on its network port. Registers are grouped by number: monitoring at 450-539 (trips, status, alarms, currents, voltage and power), configuration at 540-699 and commands at 704-705. Most values are 16-bit; phase currents are 32-bit with a selectable word order.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "The guide numbers registers from 0 (identification block 0-99), calls each number an 'address', and its PLC examples read 'address 455' and write 'address 704' directly, so the printed number is the wire address."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "TeSys T LTMR Motor Management Controller Modbus Communication Guide",
  "doc_number": "DOCA0130EN-03",
  "revision_date": "2024-02",
  "url": "https://download.se.com/files?p_Doc_Ref=DOCA0130EN",
  "pages": "Port settings pp. 22-23; functions and examples pp. 25-27; register groups and formats pp. 29-31; data types pp. 34-37; monitoring pp. 45-52; configuration/settings pp. 52-60; commands p. 61"
 },
 "notes": [
  "32-bit values (UDInt) follow the 'Network port endian setting' (bit 10 of register 602): 1 = most significant word first (factory setting), 0 = least significant word first. The map assumes the factory setting.",
  "Registers marked note 1 (voltage, power, power factor, voltage trip/alarm bits, extra I/O) exist only with the LTMEV40 expansion module. Frequency (474) is always present but reads 0 without it.",
  "Factory network settings: address 1 (treated as undefined), baud and parity on autodetection (19200 and even tried first). Parity none uses 2 stop bits, even/odd use 1.",
  "Left out: identification and statistics blocks (0-449), trip history, the full configuration area, user map 800-999 and custom logic registers.",
  "At most 100 registers per request; functions 03, 06, 16 and 43 are supported."
 ],
