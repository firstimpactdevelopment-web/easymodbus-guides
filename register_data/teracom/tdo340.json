  "integration": {
    "summary": "Switch relays with function 05 on coils 1-4, or write PDU 100 (bitmask) / 101-104 with function 06. Set the watchdog timeout (PDU 305) and per-relay actions (PDU 301-304) before commissioning.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 100,
        "why": "All relays bitmask"
      },
      {
        "table": "holding_register",
        "address": 101,
        "why": "Relay 1"
      },
      {
        "table": "coil",
        "address": 1,
        "why": "Relay 1 coil"
      },
      {
        "table": "holding_register",
        "address": 305,
        "why": "Watchdog timeout"
      },
      {
        "table": "holding_register",
        "address": 301,
        "why": "Relay 1 comms-loss action"
      },
      {
        "table": "holding_register",
        "address": 200,
        "why": "Power-up behaviour"
      }
    ],
    "enable": "Modbus RTU is the only interface and is always active; there is nothing to switch on. Factory settings are address 1, 19200 baud, 8E1.",
    "watchdog": "PDU 305 sets a comms-loss timeout in seconds (0 = off); any valid request addressed to the module restarts it. On expiry each relay follows its PDU 301-304 action; relays then hold until a new command arrives.",
    "quirks": [
      "Baud rate and framing changes only take effect after the device is powered off and on again."
    ],
    "setup": [
      "Set unit ID (PDU 10), baud (PDU 11) and framing (PDU 12), then power-cycle the device.",
      "Terminate both ends of the RS-485 bus with 120 ohm; the built-in resistor is enabled by wiring Term to RS485-. A daisy chain is recommended."
    ],
    "gotchas": []
  },
