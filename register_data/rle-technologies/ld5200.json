{
  "manufacturer": "RLE Technologies",
  "manufacturer_slug": "rle-technologies",
  "model": "LD5200 leak detection controller (Modbus RTU / Modbus TCP slave)",
  "model_slug": "ld5200",
  "short_model": "LD5200",
  "aliases": [
    "LD5200"
  ],
  "equipment_type": "Sensor (leak detection controller)",
  "applies_to": "RLE LD5200 distance-read leak detection controller, user guide version 04.22 (firmware 2.3.1).",
  "summary": "The LD5200 monitors a water-sensing cable and reports where along the cable a leak is. As a Modbus slave on its EIA-485 ports (or Modbus over Ethernet) it gives leak, cable-break and contamination status, leak distance and current, cable resistances, virtual-zone alarms and the status of the slave panels it polls as a Modbus master. Thresholds and alarm delays are writable holding registers.",
  "transport": [
    "RTU",
    "TCP"
  ],
  "defaults": {
    "unit_id": null,
    "baud": 9600,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "Modicon",
    "note": "RLE says the start register is numbered from zero: 40001 = 0, 30001 = 0. So input register 30002 (leak distance) is wire address 1 with FC4, holding register 40016 is address 15 with FC3/FC6/FC16."
  },
  "default_word_order": "ABCD",
  "firmware": "Documented with firmware 2.3.1",
  "source": {
    "title": "LD5200 User Guide",
    "doc_number": "Version 04.22",
    "revision_date": "2022-04",
    "url": "https://WWW.RLETECH.COM/wp-content/uploads/2022/04/LD5200_UserGuide-04-22.pdf",
    "pages": "pp. 87-101 (ch. 5 Modbus communication: tables 5.3, 5.5, 5.6, 5.7); p. 78 (table 4.12 port options)"
  },
  "notes": [
    "Float word order: the guide labels 38001 as the float MSW and 38002 as the LSW, so the leak-location float is ABCD.",
    "Only the first block of Modbus slave zones (2-16, registers 30012-30042) is listed. Later blocks cover 16 zones each: 30043 flags zones 17-32 with status/distance pairs from 30044, 30076 flags zones 33-48, and so on up to zone 128 at 30272/30273.",
    "Holding registers 40003-40015 are spare.",
    "Distance registers are in feet or meters depending on register 30003.",
    "The guide calls the Ethernet option 'Modbus/TCP/UDP' with its own slave unit identifier (1-254); it does not list a separate map, so the same registers are assumed to apply over Ethernet. The TCP port is not given.",
    "The leak trip range differs inside the guide: the Modbus table shows 25-295 uA, the LCD settings page says 25-175 uA.",
    "Bit 15 of 30012 is labeled zone 16 although bit 0 is zone 2, so the bits of 30012 are not listed."
  ],
  "integration": {
    "summary": "Read input registers 30001-30011 with FC4: status bits for leak / cable break / contamination, leak distance and unit, leak current and cable data. Read 38001-38002 for the leak position as a float in meters.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "Leak / cable break / contamination status"
      },
      {
        "table": "input_register",
        "address": 1,
        "why": "Leak distance"
      },
      {
        "table": "input_register",
        "address": 2,
        "why": "Distance unit"
      },
      {
        "table": "input_register",
        "address": 3,
        "why": "Leak current"
      },
      {
        "table": "input_register",
        "address": 8000,
        "why": "Leak location in meters (float)"
      },
      {
        "table": "input_register",
        "address": 9,
        "why": "Virtual zone alarms 1-16"
      }
    ],
    "enable": "Set an EIA-485 port function to Modbus-Slave and give it a slave address (1-254, 0 = disabled) and baud rate in the Comm Port Settings menu (LCD) or the Modbus/EIA-485 web page. For Ethernet, set the Modbus/TCP/UDP slave unit identifier on the same page.",
    "watchdog": null,
    "quirks": [
      "RTU only on the serial ports, fixed 8 data bits, no parity, 1 stop bit; baud 9600 (default), 19200 or 38400.",
      "As a slave the LD5200 accepts only one master."
    ],
    "setup": [
      "Three EIA-485 ports (TB5/TB6); port 2 can also be BACnet MS/TP or N2.",
      "When the LD5200 is a master for distance-read panels, the first slave must use address 2, the next 3, and so on."
    ],
    "gotchas": [
      "A missing end-of-line terminator on the sensing cable shows as a cable fault."
    ]
  },
