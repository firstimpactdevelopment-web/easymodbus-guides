{
 "manufacturer": "Inovance",
 "manufacturer_slug": "inovance",
 "model": "MD500-PLUS series AC drive",
 "model_slug": "md500-plus",
 "short_model": "MD500-PLUS",
 "aliases": [
  "MD500-PLUS",
  "MD500 PLUS",
  "MD500T-PLUS",
  "Inovance MD500-PLUS"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "Inovance MD500-PLUS drives with the MD38TX1 RS-485 extension card, Modbus RTU slave, per software guide 19011580 rev. A04.",
 "summary": "Inovance's general-purpose vector drive for asynchronous and permanent-magnet motors. With the MD38TX1 RS-485 card it acts as a Modbus RTU slave. Speed goes to 1000H as a signed percentage of maximum frequency, run commands to 2000H, status and fault codes come from 3000H and 8000H, and every parameter has its own hex address (F/A groups at FxxxH/AxxxH, U0 monitors at 70xxH). This map covers the control block, the core U0 monitors with their data types and units, and the FD communication parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 2,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Addresses are hex and go on the wire unchanged: the guide's reverse-run example is 01 06 20 00 00 02, writing 2 to 2000H. Parameter addresses are the group code (F0-FE, A0-AC, 70 for U0) followed by the parameter number in hex (F3-12 = 0xF30C)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "MD500-PLUS Series General-Purpose AC Drive Software Guide",
  "doc_number": "19011580 A04",
  "revision_date": "2021-11",
  "url": "https://inovance.eu/fileadmin/downloads/Manuals/EN/MD500-PLUS/MD500-PLUS_Software_Guide_EN_A04_19011580.pdf",
  "pages": "PDF pp. 8-10, 40, 57 (parameter list F0, F9, FD), pp. 89-90 (Table 1-1 monitoring parameters, basic units), U0 parameter descriptions (data types), printed pp. 692-705 (appendix: communication data addresses, Fd group)"
 },
 "notes": [
  "Every register is one 16-bit word. Scales come from the 'Basic Unit' column of Table 1-1; signedness comes from the data type printed in each U0 parameter description.",
  "Left out: U0-14 (unit printed differently in the two tables), U0-22/U0-23, U0-32/U0-33/U0-36/U0-38 (position/debug values) and everything from U0-58 on, because Table 1-1 and the parameter descriptions give different addresses for those rows (e.g. U0-59 at 0x7035 vs 0x703B).",
  "The 1000H-1020H 'stop/run parameter' block is listed without units, so it is left out; read the U0 group instead.",
  "F9-14 holds the same fault code as 8000H; the guide prints the 8000H codes in hex (001AH = 26).",
  "Function codes: 03H read, 06H write, 10H multi-write; up to 12 consecutive registers per request, and a request must not run past the end of a parameter group."
 ],
