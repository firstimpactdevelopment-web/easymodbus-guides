 "integration": {
  "summary": "Set CF-01 to CF-04 for the serial line and CF-08 to Modbus-RTU, then AA101 = 08 and AA111 = 03. Write the signed frequency to 10502/10503, run and stop with coil 1, and poll dA-01, dA-02, dA-40 and the trip monitor.",
  "minimum_registers": [
   {
    "table": "coil",
    "address": 0,
    "why": "Run/stop"
   },
   {
    "table": "coil",
    "address": 3,
    "why": "Trip reset"
   },
   {
    "table": "holding_register",
    "address": 10501,
    "why": "RS485 set frequency"
   },
   {
    "table": "holding_register",
    "address": 10000,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 10001,
    "why": "Output current"
   },
   {
    "table": "holding_register",
    "address": 10039,
    "why": "DC bus voltage"
   },
   {
    "table": "holding_register",
    "address": 1000,
    "why": "Latest trip factor"
   },
   {
    "table": "coil",
    "address": 22,
    "why": "Inverter ready"
   }
  ],
  "enable": "Select Modbus-RTU with CF-08, then set AA101 = 08 (speed from RS485) and AA111 = 03 (run command from RS485). Coils 1 and 2 only act when AA111 = 03.",
  "watchdog": "CF-06 sets the communication timeout (0.00-100.00 s); when it expires error E041 is raised, and CF-05 picks the action (trip, trip after stop, ignore, free-run stop or deceleration stop).",
  "quirks": [
   "Wire address is the printed number minus 1.",
   "Two-register values are high word first.",
   "Register numbers changed between firmware Ver. 1.xx and 2.00; check the firmware with dC-50 before using this map."
  ],
  "setup": [
   "CF-01 baud (03-10 = 2400-115200 bps), CF-02 station 1-247, CF-03 parity, CF-04 stop bits; CF-07 adds a reply delay.",
   "One request handles at most 32 coils or 16 registers; a coil read of 0 or more than 32 coils returns exception 03h."
  ],
  "gotchas": [
   "The [NDc] output signal can be assigned to an output terminal to flag a communication loss."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/hitachi/sj-p1",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
