 "integration": {
  "summary": "Put the HAND/OFF/AUTO switch in AUTO, set H5-01..H5-03 at the keypad and power-cycle, set the drive's reference and run source to serial, then write 0001H/0002H with function 10H and poll 0020H-002DH.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 1,
    "why": "Run/stop and fault reset"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Frequency reference"
   },
   {
    "table": "holding_register",
    "address": 32,
    "why": "Drive status"
   },
   {
    "table": "holding_register",
    "address": 33,
    "why": "Fault details"
   },
   {
    "table": "holding_register",
    "address": 36,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 44,
    "why": "Drive status 2 incl. comm timeout"
   }
  ],
  "enable": "Set H5-01 (default 1F hex), H5-02 (default 3 = 9600) and H5-03 (default none) and cycle power. The HAND/OFF/AUTO switch must be in AUTO for serial run/stop and speed control; OFF overrides a serial run command. For monitoring only, just the H5 parameters are needed.",
  "watchdog": "H5-05 = 1 enables CE detection after the H5-09 time; H5-04 sets the reaction. 002CH bit F shows a comm time-out.",
  "quirks": [
   "Registers are hex and 0-based.",
   "Function codes 03H, 06H, 08H and 10H.",
   "0001H bit 0 is run/stop and bit 1 is direction, unlike the stand-alone P7 (bit 0 forward, bit 1 reverse).",
   "Parameter writes need 0 written to 0900H (EEPROM) or 0910H (RAM)."
  ],
  "setup": [
   "Drive terminals S+, S-, R+, R-; for RS-485 jumper S+ to R+ and S- to R-. Up to 31 drives.",
   "Terminating resistor: DIP switch S1-1 on the drive terminal board, ON only at the end of the line.",
   "8 data bits, 1 stop bit; 1200-19200 baud."
  ],
  "gotchas": [
   "The OFF position of the HAND/OFF/AUTO switch takes precedence over a serial run command."
  ]
 },
