 "model": "KW8M Eco-POWER METER",
 "model_slug": "kw8m",
 "short_model": "KW8M",
 "aliases": [
  "AKW8111",
  "AKW8111H"
 ],
 "equipment_type": "Energy meter",
 "applies_to": "Panasonic KW8M AKW8111 and AKW8111H (logging/demand version) with Modbus RTU selected, manual ARCT1F440E-8.",
 "summary": "The KW8M is a panel-mount energy meter for single- and three-phase circuits with a pulse counter input and an RS485 port running MEWTOCOL or Modbus RTU. Holding registers carry energy, current, voltage, power, PF, frequency, load on/off hours and pulse counts; the AKW8111H adds demand values and logging. This map covers the common table and the H-only demand and status registers.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 19200,
  "parity": "Odd",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "The table prints hex data items (0064H) that go into the request unchanged; the manual's example resets energy by writing 2 words at 0064H. The MEWTOCOL DT number in decimal equals the hex Modbus address."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "KW8M Eco-POWER METER User's Manual",
  "doc_number": "ARCT1F440E-8",
  "revision_date": "2016-08",
  "url": "https://mediap.industry.panasonic.eu/assets/custom-upload/Factory%20%26%20Automation/Eco-POWER%20METERS/Manuals/mn_kw8m_user_pidsx_en.pdf",
  "pages": "Section 7.4.2 Data Register List, manual pp. 62-66 (PDF pp. 71-75)"
 },
 "notes": [
  "Word order: every 32-bit row is printed as two registers marked <LSB> (lower address) and <MSB> (higher address), so the low word comes first (CDAB).",
  "The 'integral active power for arbitrary period' row (0062H) prints its unit as 0.01kW; it is listed without a unit.",
  "Left out: the AKW8111H log-data block (4E20H onward and F6CCH onward) and calendar-timer settings, which are log records rather than live values.",
  "Registers not listed read 0."
 ],
 "integration": {
  "summary": "Switch the protocol to MODBUS(RTU) in Mode 3, then poll with function 03: 0064H energy (2 words, 0.01 kWh), 00B0H active power, 006BH-006DH currents, 00AAH-00AEH voltages, 006FH PF and 0070H frequency.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 100,
    "why": "Integral active energy"
   },
   {
    "table": "holding_register",
    "address": 176,
    "why": "Active power"
   },
   {
    "table": "holding_register",
    "address": 107,
    "why": "Current L1"
   },
   {
    "table": "holding_register",
    "address": 170,
    "why": "Voltage L1"
   },
   {
    "table": "holding_register",
    "address": 111,
    "why": "Power factor"
   },
   {
    "table": "holding_register",
    "address": 112,
    "why": "Frequency"
   }
  ],
  "enable": "Protocol defaults to MEWTOCOL; change it to MODBUS(RTU) in setting Mode 3 together with station number, speed, format and response time.",
  "watchdog": null,
  "quirks": [
   "Modbus RTU only works with the 8-bit formats; the default format 8bit-o is odd parity.",
   "Out-of-range writes are acknowledged but ignored."
  ],
  "setup": [
   "Defaults: station 1, 19200 bps, 8bit-o, response time 5 ms.",
   "Set phase/wire, CT type and voltage range in Mode 1 before reading values."
  ],
  "gotchas": [
   "AKW8111H: switch the backup battery ON and initialise the main-unit memory (Mode 4) after setting the calendar timer (Mode 5), or log data may be wrong.",
   "Settings written over Modbus are stored in EEPROM; avoid cyclic writes."
  ]
 },
