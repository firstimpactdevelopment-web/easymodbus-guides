  "integration": {
    "summary": "Set 8-30 = [2] Modbus RTU plus 8-31 address, 8-32 baud and 8-33 parity, keep 8-02 = FC port, then drive the compressor with the control-word coils (coil 11 data valid, coil 7 start) and read 16-13 frequency, 16-14 current, 16-10 power and 16-90 alarm word.",
    "minimum_registers": [
      {
        "table": "coil",
        "address": 6,
        "why": "CTW bit 6: ramp stop / start"
      },
      {
        "table": "coil",
        "address": 10,
        "why": "CTW bit 10: data valid"
      },
      {
        "table": "coil",
        "address": 43,
        "why": "STW: running"
      },
      {
        "table": "holding_register",
        "address": 16129,
        "why": "16-13 Frequency, 0.1 Hz"
      },
      {
        "table": "holding_register",
        "address": 16139,
        "why": "16-14 Motor current, 0.01 A"
      },
      {
        "table": "holding_register",
        "address": 16099,
        "why": "16-10 Power, 0.001 kW"
      },
      {
        "table": "holding_register",
        "address": 16899,
        "why": "16-90 Alarm word"
      }
    ],
    "enable": "8-30 Protocol = [2] Modbus RTU, 8-31 Address (1-247), 8-32 Baud Rate, 8-33 Parity/Stop Bits. 8-01 Control Site chooses digital inputs and/or control word; 8-02 Control Source must be FC Port; 8-50..8-56 decide how bus bits combine with digital inputs (most default to Logic OR).",
    "watchdog": "8-03 Control Timeout Time (0.1-200 s, default 20 s) and 8-04 Control Timeout Function (default Off; Freeze output, Stop, Jogging, Max. speed, Stop and trip, N2 override release) act when the control word is not updated in time.",
    "quirks": [
      "Parameter register = parameter number x 10, request address = that minus 1.",
      "32-bit values are high word first (ABCD).",
      "CTW bit 10 (coil 11) must be 1 or the control word is ignored.",
      "Coil 65 chooses whether parameter writes also go to EEPROM."
    ],
    "setup": [
      "Defaults: address 1, even parity with 1 stop bit; the protocol default is FC, so 8-30 must be changed to Modbus RTU.",
      "The guides say the default baud rate depends on the protocol chosen in 8-30 and do not print the Modbus default, so set 8-32 explicitly (2400-115200)."
    ],
    "gotchas": [
      "Changing 8-30 Protocol may change the baud rate (8-32); re-check it after switching to Modbus."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
