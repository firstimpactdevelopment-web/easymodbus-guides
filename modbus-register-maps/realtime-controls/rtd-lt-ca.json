{
 "manufacturer": "Realtime Control Systems",
 "manufacturer_slug": "realtime-controls",
 "model": "RTD-LT/CA Modbus interface for Daikin Altherma LT (split, CA) air-to-water heat pumps",
 "model_slug": "rtd-lt-ca",
 "short_model": "RTD-LT/CA",
 "aliases": [
  "RTD-LT/CA",
  "RTD-LT-CA",
  "Daikin RTD-LT/CA"
 ],
 "equipment_type": "Heat pump Modbus interface",
 "applies_to": "RTD-LT/CA on the P1/P2 bus of Daikin Altherma Split LT CA hydroboxes (heating only and heating/cooling), with an EKRUCAL1 as main controller; all modes except Sequencer. Instructions 22570-2.09.12.",
 "summary": "Modbus RTU slave for Daikin Altherma LT split hydroboxes. Holding registers set leaving-water, room and DHW setpoints, mode, on/off, quiet, boost and weather-dependent operation for main and multi-zone; input registers return status flags, temperatures x100, flow, run hours, setpoint limits and 32-bit energy consumed / produced.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": 9600,
  "parity": "None",
  "data_bits": null,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "The manual states register base 0 and writes H0010 / I0010 for holding / input register 10, so the number after H or I is the wire address. 32-bit values use two consecutive registers, high word first."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Instructions pour l'installation de la RTD-LT/CA (RTD-LT/CA Installation Instructions, French)",
  "doc_number": "22570-2.09.12",
  "revision_date": null,
  "url": "https://res.cloudinary.com/sonepar-fr/raw/upload/s--STyMjHQz--/v1/documents/121/FR_RTD-LT-CA_Installation_Instructions_22570-2.09.12.pdf",
  "pages": "pp. 16-22 (Modbus configuration, special values, update mode, control, read-back, setpoint limits, energy)",
  "unofficial": true
 },
 "notes": [
  "The source is the French edition of the Realtime Control Systems installation instructions, from a Sonepar (distributor) file host. The maker's own site (realtime-controls.co.uk) was offline and no Daikin-hosted copy was found, so the link is marked unofficial.",
  "All values are 16-bit unless stated. Temperatures marked 'x100' are signed: raw 2150 = 21.50 °C, raw 65036 = -5.00 °C. Holding-register setpoints are printed in whole °C with no x100 marking and are listed at scale 1.",
  "Fault codes are in the 'RTD ASCII' format described in the RTD-NET instructions (two characters packed high byte / low byte).",
  "Supported function codes: 03 and 04 (1..10 registers), 06, and 16 (1..10 registers).",
  "32-bit counters (energy, run hours) are unsigned with the high word in the lower register, as both the data-type table and the register tables state.",
  "Special values: 32767 = register not implemented, 32768 = function not available, 32769 = waiting for a value from the unit.",
  "Each control register has an update-mode register at +200 (H0201 for H0001 and so on); only H0201 is listed.",
  "Min/max setpoint registers for multizone (I0303/I0304, I0403/I0404) and DHW boost (I0306/I0406) follow the same pattern and are not listed.",
  "In Sequencer mode the map changes to the RTD-W map; this file does not cover Sequencer mode.",
  "Modbus address 0..63 on SW1 (0..15 in Smart Grid mode)."
 ],
