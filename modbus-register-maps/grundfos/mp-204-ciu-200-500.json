 "integration": {
  "summary": "Set the CIU 200 slave address on the two hex switches, keep 19200 8E1, then poll 00201-00208 for status and alarm, and 00301-00354 for measurements. Start, stop and trip the pump through ControlRegister 00101.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 100,
    "why": "Start/stop, trip and reset commands"
   },
   {
    "table": "holding_register",
    "address": 200,
    "why": "Running, ready and fault flags"
   },
   {
    "table": "holding_register",
    "address": 201,
    "why": "Operating mode"
   },
   {
    "table": "holding_register",
    "address": 203,
    "why": "Alarm code"
   },
   {
    "table": "holding_register",
    "address": 204,
    "why": "Active warnings"
   },
   {
    "table": "holding_register",
    "address": 311,
    "why": "Mean line current"
   },
   {
    "table": "holding_register",
    "address": 327,
    "why": "Power consumption"
   },
   {
    "table": "holding_register",
    "address": 329,
    "why": "Energy counter"
   }
  ],
  "enable": "The MP 204 needs no setting for remote control; configure it with the R100, Grundfos GO or PC Tool first, then connect the CIU. OnOffReq (bit 2 of 00101) starts and stops the motor; the device acts on the last command from Modbus, remote or buttons.",
  "watchdog": null,
  "quirks": [
   "Reset and trip bits act on a rising edge. With AutoAckControlBits = 1 (default) the CIU clears them itself; with 0 you must clear them and watch 00208.",
   "Data block values are unsigned unless stated; 0xFFFF means not available."
  ],
  "setup": [
   "CIU 200: address on rotary switches SW6/SW7 (hex, high and low nibble), speed on SW4/SW5 (9600, 19200 default, 38400, or software-defined), parity on SW3 (even/1 stop default, or none/2 stop), termination on SW1/SW2.",
   "CIU 500: Modbus TCP on port 502."
  ],
  "gotchas": [
   "Changing RegisterOffset (00002) moves every register above 00100; leave it at 0.",
   "Single-phase motors report different meanings in the L1-L3 voltage and current registers (neutral, main winding, auxiliary winding)."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/grundfos/mp-204-ciu-200-500",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
