      {
        "table": "holding_register",
        "address": 20,
        "why": "Channels 1-16"
      },
      {
        "table": "holding_register",
        "address": 21,
        "why": "Channels 17-32"
      },
      {
        "table": "holding_register",
        "address": 100,
        "why": "Counter 1"
      },
      {
        "table": "holding_register",
        "address": 102,
        "why": "Counter 2"
      }
    ],
    "enable": "Modbus TCP server and RTU slave are on by default; channel direction and counters are configured in the web server.",
    "watchdog": "Per the web-server chapter, each channel set as an output has an optional watchdog (default disabled, timeout default 100 s) triggered by no Modbus traffic or no output writes; the output then takes its configured watchdog state.",
    "quirks": [
      "Offset is the wire address.",
      "Counters are MSW first on this model."
    ],
    "setup": [
      "Factory IP is 192.168.90.101; change it before adding a second unit."
    ],
    "gotchas": [
