{
  "manufacturer": "Grundfos",
  "manufacturer_slug": "grundfos",
  "model": "IO 113 pump protection module (Modbus RTU)",
  "model_slug": "io-113",
  "short_model": "IO 113",
  "aliases": [
    "IO113",
    "IO 113 with SM 113",
    "98288208"
  ],
  "equipment_type": "Pump protection / monitoring module (Sensor)",
  "applies_to": "Grundfos IO 113 interface module for wastewater and sewage pumps (with or without the SM 113 sensor board) set to Modbus with DIP switch 9; document edition 1.7, January 2015.",
  "summary": "The IO 113 supervises a submersible sewage pump: winding and bearing temperatures, insulation resistance, vibration, water in oil, moisture and PTC switches, run hours and starts. With DIP switch 9 on it answers as a Modbus RTU slave. This map covers the measured and peak values, alarm and warning codes and bits, the command registers, the alarm limits and the counters.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": 231,
    "baud": 19200,
    "parity": "Even",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "0-based",
    "note": "Register numbers are printed in decimal and used directly as the telegram address: the read example requests 0x07C8 (1992, t_support_bear) and the START example writes 0x07F5 (2037)."
  },
  "default_word_order": "ABCD",
  "firmware": null,
  "source": {
    "title": "Operating the IO113 via Modbus",
    "doc_number": "98288208 0115 (Edition 1.7)",
    "revision_date": "2015-01",
    "url": "https://api.grundfos.com/literature/Grundfosliterature-4363039.pdf",
    "pages": "p. 2 (comm settings), pp. 10-15 (event codes, bit meanings), p. 18 (telegram examples), pp. 19-20 (data item overview)"
  },
  "notes": [
    "Only function 03 is supported for reading (plus 06, 16 and 08 sub-function 0). Telegrams may not exceed 80 bytes and at most 4 registers can be written per telegram; only two configuration parameters can be written per telegram because they are forwarded to the SM 113 over the power line.",
    "Counters are split into _hi and _lo registers with _hi at the lower address, so they are listed as ABCD 32-bit values.",
    "A 16-bit value of 0x00FF means not available unless stated otherwise.",
    "Items marked for unit type 2 (power-line communication with SM 113) are only valid with the SM 113 sensor board: bearing temperatures, insulation resistance and vibration.",
    "Vibration values use a scaling of 20 mm/s per 254 counts (about 0.0787 mm/s per count).",
    "Left out: wio_output_offset 2056 (no scaling or access printed) and sensors_present_set 2062 (write-only preset with no value list). Front LED bit fields are long multi-bit codes and are not decoded here."
  ],
