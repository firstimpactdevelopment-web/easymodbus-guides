  "integration": {
    "summary": "Read input registers 200-225 for currents, voltage, power and energy, and 101/107 for breaker state and trips. Open, close or reset with a function-16 write of command type and parameter to registers 0-1.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 101,
        "why": "CB open/closed, tripped, remote"
      },
      {
        "table": "input_register",
        "address": 107,
        "why": "Which protection tripped"
      },
      {
        "table": "input_register",
        "address": 203,
        "why": "Pole A current"
      },
      {
        "table": "input_register",
        "address": 217,
        "why": "DC voltage"
      },
      {
        "table": "input_register",
        "address": 218,
        "why": "Total active power"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Commands"
      }
    ],
    "enable": "Fit the PR120/D-M module and set the external bus address, baud and protocol on the trip unit. Remote mode (state 2 bit 9) is needed for open/close commands.",
    "watchdog": null,
    "quirks": [
      "32-bit values are low word first.",
      "Measures are input registers (function 4).",
      "Commands always need function 16 with both registers."
    ],
    "setup": [
      "Set the external-bus address (1-247), baud (9600/19200), addressing type and frame format (E,8,1 / O,8,1 / N,8,2 / N,8,1) on the trip unit."
    ],
    "gotchas": [
      "Slave ID register 700 tells PR122DC (0x59) from PR123DC (0x58)."
    ]
  },
