  "unit_id": 240,
  "baud": 19200,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 2,
  "tcp_port": null
 },
 "addressing": {
  "convention": "1-based",
  "note": "The guide numbers registers in decimal from 1 and also prints the 0-based hex address used in the request. Register 1 is address 0x0000 on the wire; the guide's example frame reads relative humidity at address 0x0000."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "XMP10 User Guide",
  "doc_number": "M213279EN-A",
  "revision_date": "2026-04",
  "url": "https://docs.vaisala.com/r/M213279EN-A/en-US",
  "pages": "Appendix A Modbus reference, pp. 80-88 (Tables 17-25, example frames A.6)"
 },
 "notes": [
  "All registers are holding registers: read with function 03, write with function 16.",
  "32-bit floats and 32-bit integers put the least significant word at the listed register (CDAB), as the guide states; its example response for RH shows the low word first.",
  "Integer registers are printed with units such as '%RH * 10', so divide the raw value by 10 (scale 0.1). 0x8000 (32768) means the value is not available; 0x7FFF and 0x8001 mean at or beyond the 16-bit range.",
  "Register 513 reads 0 when an error is active and 1 when there is none, exactly as printed.",
  "Error codes 1024, 16384 and 32768 (calibration expiry and invalid communication settings) are visible only in Insight or Indigo80, so they are not listed as Modbus bits.",
  "The text-string test register (7940) is left out because the guide does not give its register length in a way that fixes the read size.",
  "Bit rate and parity changes take effect after a restart (register 1542). Incompatible settings can lock out Modbus; Insight can override them."
 ],
