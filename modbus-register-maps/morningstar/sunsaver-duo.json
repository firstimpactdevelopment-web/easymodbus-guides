{
 "manufacturer": "Morningstar",
 "manufacturer_slug": "morningstar",
 "model": "SunSaver Duo dual-battery PWM charge controller (Modbus RTU via MeterBus)",
 "model_slug": "sunsaver-duo",
 "short_model": "SunSaver Duo",
 "aliases": [
  "SunSaver Duo",
  "SSDuo"
 ],
 "equipment_type": "Solar charge controller (PWM, dual battery)",
 "applies_to": "Morningstar SunSaver Duo through the MSC MeterBus-to-RS-232 adapter; Modbus specification V04 (19 March 2019). 16-bit registers only.",
 "summary": "The SunSaver Duo is a PWM solar charge controller that charges two separate batteries. Via its RJ-11 MeterBus port and Morningstar's MSC adapter it speaks Modbus RTU: both battery voltages and charge currents, solar voltage, duty cycles, charge setpoints in use, state and fault bits, plus EEPROM custom settings and a few coils.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 2,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "The hex PDU address in Morningstar's table is the wire address; the spec says all listed addresses are request-PDU addresses, and its example reads battery 1 voltage at 0x0000 (0x5CD0 = 23760 / 1800 = 13.20 V)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "SunSaver Duo MODBUS Specification",
  "doc_number": "V04",
  "revision_date": "2019-03-19",
  "url": "https://www.morningstarcorp.com/wp-content/uploads/technical-doc-sunsaver-duo-modbus-specification-en.pdf",
  "pages": "p. 3 (parameters), pp. 4-7 (RAM, EEPROM, coils, bit tables), pp. 8-15 (definitions), p. 16 (examples)"
 },
 "notes": [
  "Left out: the 32-bit hourmeter and amp-hour counters (0x0013-0x001A). The register table puts the HI word first, but the spec's own two-word example reads the hourmeter LO word at 0x0013 and HI at 0x0014, and the revision history says the HI/LO addresses were swapped in an earlier version. The word order cannot be settled from the document.",
  "Left out: the 'reset amp-hours' coil, because the table gives 0x0010 and the definitions page gives 0x0017 (which is also the min/max reset coil).",
  "Scaling formulas (n / 1800 for battery voltages, n / 1032 for solar voltage, n / 673 for currents, 0-417 = 0-100 % for duty/priority) are converted to multipliers.",
  "Left out: the pre-scaled temperatures at 0x0100-0x0105 (F and C copies), because the spec gives no data type or signedness for them and sub-zero readings are expected.",
  "Only the 'DIP off' custom voltages are listed for each battery; the 'DIP on' set (0xE00C-0xE011, 0xE018-0xE01D) follows the same layout. The two ID registers 0xE000/0xE001 are not listed because the table and the definitions disagree on which range belongs to which ID.",
  "Battery detect registers follow the register table (0x010F, 0x0110); the definitions page repeats the battery-state addresses for them, which looks like a copy error.",
  "Any EEPROM write (FC 0x06) sets an 'EEPROM changed' fault that needs a controller reset."
 ],
 "integration": {
  "summary": "Through the MSC adapter at 9600 8N2, ID 1, read 0x0000-0x0010 for both battery voltages, solar voltage and charge currents, and 0x0108-0x0110 for state, faults and battery states.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Battery 1 voltage"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Battery 2 voltage"
   },
   {
    "table": "holding_register",
    "address": 3,
    "why": "Charge current battery 1"
   },
   {
    "table": "holding_register",
    "address": 4,
    "why": "Charge current battery 2"
   },
   {
    "table": "holding_register",
    "address": 264,
    "why": "Controller state"
   },
   {
    "table": "holding_register",
    "address": 265,
    "why": "Fault bitfield"
   }
  ],
  "enable": "The meter port auto-detects Meterbus or Modbus; connect the MSC adapter and poll. Coil 0x00F1 switches the port back to Meterbus for a remote meter.",
  "watchdog": null,
  "quirks": [
   "Both FC 0x03 and FC 0x04 are supported for reading.",
   "EEPROM values that need updating are saved once every 24 hours; coil 0x0016 forces it."
  ],
  "setup": [
   "Serial: 9600 baud, 8 data bits, no parity, 2 stop bits, no flow control."
  ],
  "gotchas": [
   "The RJ-11 port is MeterBus, not RS-485; Morningstar's MSC adapter is needed."
  ]
 },
