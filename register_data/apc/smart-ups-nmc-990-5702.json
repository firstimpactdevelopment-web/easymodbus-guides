{
  "manufacturer": "APC",
  "model": "Smart-UPS / Smart-UPS VT / MGE Galaxy 3500 (NMC Modbus map 990-5702)",
  "short_model": "Smart-UPS Modbus (990-5702)",
  "aliases": [
    "990-5702",
    "AP9630",
    "AP9631",
    "AP9635",
    "Smart-UPS VT",
    "MGE Galaxy 3500",
    "Schneider Electric APC Smart-UPS"
  ],
  "equipment_type": "UPS",
  "applies_to": "APC Smart-UPS (excluding SMT, SMX, SURTD and SRT prefixes), Smart-UPS VT and MGE Galaxy 3500 through Network Management Card AP9630/AP9631/AP9635 (TCP) or AP9635 (RTU), part number 990-5702.",
  "summary": "APC's older Smart-UPS family, plus the three-phase Smart-UPS VT and MGE Galaxy 3500, publish a compact Modbus map through the Network Management Card. Everything is a single 16-bit holding register: status words with per-bit flags, battery charge and runtime, input/output voltages and frequency, per-phase currents and load, transfer settings and an 8-character UPS ID. Modbus TCP is on AP9630/AP9631/AP9635 cards; RTU only on AP9635.",
  "transport": [
    "TCP",
    "RTU"
  ],
  "defaults": {
    "unit_id": null,
    "baud": null,
    "parity": null,
    "data_bits": null,
    "stop_bits": null,
    "tcp_port": null
  },
  "addressing": {
    "convention": "Modicon",
    "note": "The map prints the Modicon number (40001...) next to the absolute address in hex and decimal; note 10 states that absolute address 0 equals register 40001 and is address zero on the wire."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "Modbus Register Map - MGE Galaxy 3500, Smart-UPS VT, and Smart-UPS",
    "doc_number": "990-5702",
    "revision_date": "2018-08",
    "url": "https://media.distributordatasolutions.com/schneider2/2020q3/documents/8a7edbbda9bc66f4fc6a910f8bcea3af8cb87a47.pdf",
    "pages": "pp. 1-5",
    "unofficial": true
  },
  "notes": [
    "Source host: the PDF is the APC/Schneider document served from Schneider Electric's product-data CDN for distributors; the apc.com download link refuses automated requests.",
    "All registers are one word, transmitted MSB first; signed values are two's complement. Strings are one character per register.",
    "Single-register reads of reserved/undefined addresses return an error; block reads starting on a valid register return zeros for undefined ones. Addresses 0x0050 and above are invalid.",
    "Left out: 40054 'Output Current Phase A' because the table prints its unit as V while the matching phase B/C registers are in A; and Status Words 6-7, which are reserved for future use.",
    "Many registers are marked as not supported on all UPS models.",
    "Status bits are only consistent within one register, not across registers."
  ],
