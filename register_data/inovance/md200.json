  "integration": {
    "summary": "Set F0-02 = 2 and F0-03 = 9, then write the speed as a signed percentage of F0-10 to 1000H (10000 = 100.00 %) and a run code to 2000H. Poll 3000H for run state, 8000H for faults and 7000H-7006H for frequency, voltage, current, power and torque.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 8192,
        "why": "Run / stop / reset command"
      },
      {
        "table": "holding_register",
        "address": 4096,
        "why": "Speed reference as % of max frequency"
      },
      {
        "table": "holding_register",
        "address": 12288,
        "why": "Forward / reverse / stopped"
      },
      {
        "table": "holding_register",
        "address": 32768,
        "why": "Fault code"
      },
      {
        "table": "holding_register",
        "address": 28672,
        "why": "Running frequency"
      },
      {
        "table": "holding_register",
        "address": 28676,
        "why": "Output current"
      },
      {
        "table": "holding_register",
        "address": 28674,
        "why": "DC bus voltage"
      }
    ],
    "enable": "F0-02 = 2 (communication) accepts run commands from 2000H; F0-03 = 9 (communication) makes 1000H the main frequency. FD-00..FD-02 set baud, format and address; FD-05 = 1 selects standard Modbus.",
    "watchdog": "FD-04 sets a communication timeout (0.0 s = off); when exceeded the drive reports a communication error (Err16).",
    "quirks": [
      "1000H is a percentage, not Hz: 10000 = +100.00 % of F0-10, negative values reverse.",
      "Output current resolution over Modbus is 0.01 A by default, 0.1 A when FD-06 = 1.",
      "Default serial format is 8-N-2 (FD-01 = 0), not 8-N-1."
    ],
    "setup": [
      "FD-02 address (default 1), FD-00 ones digit = baud (default 5 = 9600 bit/s), FD-01 = data format.",
      "Restore factory settings over Modbus by writing the user password to 1F00H, then 1 to 1F01H."
    ],
    "gotchas": [
      "Repeated parameter writes to FxxxH go to EEPROM; use the 0xxxH RAM alias for values that change often."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
