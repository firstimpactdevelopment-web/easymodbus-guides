{
 "manufacturer": "Intesis (HMS Networks)",
 "manufacturer_slug": "intesis",
 "model": "INMBSHIT016O000 Hitachi VRF to Modbus RTU / TCP gateway (16 / 64 indoor units)",
 "model_slug": "inmbshit016o000",
 "short_model": "INMBSHIT016O000 Hitachi VRF",
 "aliases": [
  "INMBSHIT016O000",
  "INMBSHIT064O000",
  "HI-AC-MBS-16",
  "HI-AC-MBS-64",
  "Intesis Modbus Server Hitachi VRF"
 ],
 "equipment_type": "VRF / split AC gateway",
 "applies_to": "Intesis Modbus Server - Hitachi VRF, order codes INMBSHIT016O000 / INMBSHIT064O000 (legacy HI-AC-MBS-16 / HI-AC-MBS-64), user manual User Manual r1.2 EN.",
 "summary": "Multi-unit Modbus server for Hitachi VRF systems (H-Link bus). Every configured indoor unit gets a 100-register block with control, temperatures and status, each outdoor unit gets a 25-register block, and low addresses hold 'all units' commands. Modbus RTU and Modbus TCP work together.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "0-based",
  "note": "The manual states formula results are link-layer addresses with the first register at 0, so they are wire addresses. Indoor unit index Ui (1..64, from the MAPS Units Configuration tab) uses Ui x 100 + offset; outdoor unit address OU (1..64) uses OU x 25 + 10000 + offset. This file lists Ui = 1 (100..127) and OU = 1 (10025..10030)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Intesis Modbus Server - Hitachi VRF User Manual",
  "doc_number": "User Manual r1.2 EN",
  "revision_date": "2022-02",
  "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-inmbshitxxxo000.pdf",
  "pages": "pp. 8-11 (Modbus interface and address map)"
 },
 "notes": [
  "Only indoor index 1 and outdoor address 1 are listed. For index Ui add (Ui-1) x 100 (Ui 2 on/off = 200); for outdoor OU add (OU-1) x 25.",
  "Outdoor discharge and suction pressure (OU*25+10000+6 / +7) are left out: the manual labels them '(x10 °C)' but gives a range in MPa, so the unit and scale are unclear.",
  "Outdoor temperature, frequency and current carry no x10 marker in the manual, so they are listed at scale 1 as printed.",
  "Fan speed (Ui*100+2) prints '3-High, 3-High+', a duplicate code; only 0..2 are decoded. The broadcast registers 10 and 11 set High and High+ separately.",
  "The manual spells the communication-status value 'Not Exit'; read as 'not existing'."
 ],
