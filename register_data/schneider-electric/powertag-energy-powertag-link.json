  "integration": {
    "summary": "Connect to the gateway on TCP port 502, use each sensor's Modbus address as the unit ID, and read 3000-3110 (floats) plus the 64-bit energy registers 3204-3212.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 2999,
        "why": "Phase A current"
      },
      {
        "table": "holding_register",
        "address": 3027,
        "why": "Phase A-N voltage"
      },
      {
        "table": "holding_register",
        "address": 3059,
        "why": "Total active power"
      },
      {
        "table": "holding_register",
        "address": 3083,
        "why": "Total power factor"
      },
      {
        "table": "holding_register",
        "address": 3203,
        "why": "Total active energy (not resettable)"
      },
      {
        "table": "holding_register",
        "address": 3211,
        "why": "Total active energy received"
      }
    ],
    "enable": "Modbus TCP is on by default on the gateway. The gateway gives each paired wireless device a Modbus address (1-247), which can be changed on its web pages.",
    "watchdog": null,
    "quirks": [
      "Unit ID selects the sensor, not the gateway; 255 addresses the gateway itself.",
      "Energy is in Wh/VARh/VAh as signed 64-bit integers.",
      "Not every register is filled by every sensor type."
    ],
    "setup": [
      "The gateway takes its IP address by DHCP by default; a static IPv4 address can be set on its web pages.",
      "Check or edit each wireless device's Modbus address in that device's parameters on the web pages."
    ],
    "gotchas": [
      "The gateway flags a communication-loss alarm when it hears nothing from a device for 6 times that device's communication period.",
      "The guide lists two misprinted hex addresses; trust the decimal register numbers."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
