 "integration": {
  "summary": "Read 30001-30072 (and the demand block 30083-30106) with FC04 and decode each register pair as a big-endian float. Settings are floats at 46003+ written with FC16.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "Voltage L1"
   },
   {
    "table": "input_register",
    "address": 6,
    "why": "Current L1"
   },
   {
    "table": "input_register",
    "address": 52,
    "why": "Total active power"
   },
   {
    "table": "input_register",
    "address": 62,
    "why": "Average power factor"
   },
   {
    "table": "input_register",
    "address": 70,
    "why": "Frequency"
   }
  ],
  "enable": "Set the Modbus address (46047, default 1) and Comsetup code (46045, default 8 = 9600 8N1) from the front panel or over Modbus.",
  "watchdog": null,
  "quirks": [
   "Setup values are floats too: system type 3 reads back as 40 40 00 00.",
   "Reading or writing half a float returns exception 02.",
   "If a password is set, write it to 46033 before changing setup registers."
  ],
  "setup": [
   "Comsetup (46045) packs baud 4800-57600, parity and stop bits into one code; see the value list."
  ],
  "gotchas": [
   "Per-phase PF and line-to-line voltages are only valid for the wiring types noted in each description."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/rishabh-instruments/rish-delta-power-nx",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
