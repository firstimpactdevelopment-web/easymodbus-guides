 ],
 "equipment_type": "Sensor (remote I/O module, RTD inputs)",
 "applies_to": "R-4RTD-8DIDO in the Series R I/O manual MI-00604-29-EN.",
 "summary": "The R-4RTD-8DIDO is a Seneca R-series remote I/O with four RTD temperature inputs and eight digital channels that can be inputs or outputs, plus eight 32-bit counters. It serves Modbus TCP on a two-port Ethernet switch and Modbus RTU on RS-485. This map covers temperatures, resistances, engineering values, status flags, digital I/O and counters.",
 "transport": [
  "TCP",
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 38400,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Holding-register tables print the 4x number (40001) and the 0-based offset (0); coils print 1 / offset 0 and discrete inputs 10001 / offset 0. The offset is the wire address."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Series R I/O with protocol - User Manual",
  "doc_number": "MI-00604-29-EN",
  "revision_date": "2026-09-03",
  "url": "https://www.seneca.it/media/6848135/mi00604-29-en.pdf",
  "pages": "Modbus conventions pp. 95-100; R-4RTD-8DIDO tables pp. 203-208; defaults in the web-server chapter pp. 73-81"
 },
 "notes": [
  "The protocol page lists function codes 01, 03, 05, 06, 15 and 16; the tables also give the digital inputs as 1x input status read with function 02. Modbus RTU runs on RS-485 and Modbus TCP serves up to 8 clients.",
  "32-bit values are printed MSW at the lower address (ABCD).",
  "Factory settings from the manual: static IP 192.168.90.101/24, gateway 192.168.90.1, Modbus TCP port 502, station address 1; RS-485 38400 baud, 8 data bits, no parity, 1 stop bit, address 1.",
  "RW* registers are stored in flash and survive about 10,000 writes.",
  "Temperature floats are in the unit chosen per channel in the web server (°C, K, °F or Ohm).",
  "Left out: the signed 16-bit temperature copies at 40057-40060, because the table gives no scale for them.",
  "The table prints the reserved range as 40014..40029 / offset 13..39; the offset end looks like a typo and is not used here."
 ],
