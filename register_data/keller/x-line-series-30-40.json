  "integration": {
    "summary": "Read 4 registers from 0x0100 (function 03) for P1 and its temperature as ABCD floats, or 0x0002-0x000B for all process values. Use the x100 integers at 0x0010 if your master has no float support.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 2,
        "why": "Pressure P1 (bar)"
      },
      {
        "table": "holding_register",
        "address": 8,
        "why": "Sensor temperature"
      },
      {
        "table": "holding_register",
        "address": 256,
        "why": "P1 + TOB1 in one read"
      },
      {
        "table": "holding_register",
        "address": 524,
        "why": "Channel error bits"
      },
      {
        "table": "holding_register",
        "address": 17,
        "why": "P1 as x100 integer"
      }
    ],
    "enable": "Modbus is always active alongside the KELLER protocol; no initialisation command is needed.",
    "watchdog": null,
    "quirks": [
      "Modbus CRC is sent low byte first; the KELLER protocol sends it high byte first.",
      "Address 250 reaches any device regardless of its address (point-to-point use only).",
      "Older firmware limits a read to 2 or 4 registers per request."
    ],
    "setup": [
      "Defaults: address 1, 9600 baud, 8N1. 115200 baud, parity and 2 stop bits are set in register 0x0200."
    ],
    "gotchas": [
      "Single-register writes (function 06) are refused in the 0x03xx and 0xFFxx ranges and on float registers; use function 16."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
