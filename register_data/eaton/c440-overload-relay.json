  "integration": {
    "summary": "Read 398 once for the current multiplier, then poll 300 (state), 301-304 (currents), 305 (thermal memory) and 306 (latched faults). Write 332 bit 1 to reset or bit 0 to trip.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 299,
        "why": "Motor state"
      },
      {
        "table": "holding_register",
        "address": 303,
        "why": "Average current (scale by 398)"
      },
      {
        "table": "holding_register",
        "address": 397,
        "why": "Current scale value"
      },
      {
        "table": "holding_register",
        "address": 304,
        "why": "Thermal memory"
      },
      {
        "table": "holding_register",
        "address": 305,
        "why": "Latched fault bits"
      },
      {
        "table": "holding_register",
        "address": 331,
        "why": "Remote trip / reset"
      }
    ],
    "enable": "Modbus TCP is served by the C441 Ethernet module; the IP is set by DHCP, NV memory or the DIP switches (register 143 shows the method; 192.168.1.254 is the restore address). Remote motor control also depends on the comm idle/loss settings 251-254.",
    "watchdog": "Register 110 sets the Modbus TCP com timeout in ms (0 = off); 251-254 choose whether the motor stops or holds on comm idle or loss, and 111-114 set the adapter relays' fault and idle states.",
    "quirks": [
      "Register numbers are 1-based; subtract 1 on the wire.",
      "Coil numbers in the manual are bit views of registers (coil = 16 x (register - 1) + bit + 1), not separate data."
    ],
    "setup": [
      "IP address mode is set by the DIP switch on the module: 0 = restore 192.168.1.254, 1-253 = last octet with the rest from NV memory, 254 = NV memory (factory 192.168.1.254), 255 = DHCP.",
      "The C440 table has no serial-port registers: the C441U/C441V serial port is the link to the C440, so use Modbus TCP."
    ],
    "gotchas": [
      "Several values change scale with hardware or a scale register; check the notes before trusting raw numbers."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
