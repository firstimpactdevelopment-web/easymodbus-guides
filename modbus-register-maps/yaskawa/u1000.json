{
 "manufacturer": "Yaskawa",
 "manufacturer_slug": "yaskawa",
 "model": "U1000 Industrial MATRIX drive (MEMOBUS/Modbus RTU)",
 "model_slug": "u1000",
 "short_model": "U1000",
 "aliases": [
  "CIMR-UU",
  "U1000 Industrial MATRIX Drive"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "Yaskawa U1000 matrix drives using the built-in RS-422/485 MEMOBUS/Modbus port (terminals R+, R-, S+, S-), per technical manual SIEP C710636 04E.",
 "summary": "Yaskawa's U1000 is a regenerative matrix-converter variable frequency drive with a built-in MEMOBUS/Modbus RTU port. Commands go to hex registers 0001H-000FH, status, faults and monitors are read from 0020H, and each parameter has its own hex address in the parameter list. This map covers the command block, status, fault and alarm words, fixed-unit monitors and the b1/H5 communication parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 31,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Register numbers are hex and sent unchanged: the manual's read example uses starting number 00H 20H for 0020H. Parameters use the hex address printed under each parameter in the parameter list (H5-01 (425) = 0425H)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "YASKAWA U1000 Industrial MATRIX Drive Technical Manual",
  "doc_number": "SIEP C710636 04E",
  "revision_date": "2024-03",
  "url": "https://www.yaskawa.com/delegate/getAttachment?documentId=SIEPC71063604&cmd=documents&documentName=SIEPC71063604.pdf",
  "pages": "Appendix C: H5 setup pp. 633-636, function codes p. 639, message examples pp. 641-642, C.9 data table pp. 643-647, Enter command p. 659; parameter list b1 p. 419, H5 p. 559"
 },
 "notes": [
  "Frequency registers 0002H, 0023H and 0024H use the units chosen in o1-03, so they are left unscaled.",
  "Register 0031H is printed as Control Circuit Voltage (1 Vdc units).",
  "Left out: 0025H output voltage (unit switched by H5-10), 0026H output current (0.1 A in the table, but the manual gives model-dependent current units elsewhere), 0027H output power and 0028H torque reference (no unit given), 0032H torque reference (sign not stated), 002FH frequency reference bias, 003EH/003FH output frequency in r/min and % (sign not stated), 00ABH rated current, and the U1/U2/U3/U4 blocks at 0040H-0097H.",
  "Only function codes 03H (max 16 registers), 08H and 10H are supported, so use 10H even for one register.",
  "With H5-11 = 0, parameter writes take effect only after writing 0 to 0900H (EEPROM) or 0910H (RAM). Reading 0900H/0910H returns an error.",
  "The manual's list of Modbus operations allows reading and writing parameters except H5-xx, so the H5 entries here are marked read-only for reference; set them from the keypad."
 ],
