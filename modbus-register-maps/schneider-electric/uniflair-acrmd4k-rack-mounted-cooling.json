 "integration": {
  "summary": "Write coil 00001 (wire 0) to switch the unit on or off and holding 40121 / 40122 for the return / outlet air setpoints in tenths of °C. Poll input registers 30002-30003 for air temperatures, 30176 for operating mode and input status 10002-10003 for the serious / common alarm outputs.",
  "minimum_registers": [
   {
    "table": "coil",
    "address": 0,
    "why": "Unit on/off"
   },
   {
    "table": "input_register",
    "address": 1,
    "why": "Air return temperature"
   },
   {
    "table": "input_register",
    "address": 2,
    "why": "Air outlet temperature"
   },
   {
    "table": "input_register",
    "address": 175,
    "why": "Operation mode"
   },
   {
    "table": "discrete_input",
    "address": 1,
    "why": "Serious alarm output"
   },
   {
    "table": "discrete_input",
    "address": 2,
    "why": "Common alarm output"
   },
   {
    "table": "holding_register",
    "address": 120,
    "why": "Air return temperature setpoint"
   },
   {
    "table": "holding_register",
    "address": 121,
    "why": "Air outlet temperature setpoint"
   }
  ],
  "enable": "Not described in the register map. The unit's Modbus address and baud rate are themselves writable at holding 40216 / 40217.",
  "watchdog": null,
  "quirks": [
   "Use the decimal absolute register as the wire address (Modicon number minus the 0/1/3/4 prefix and minus 1).",
   "Two separate settings share holding 40183 as bits 10 and 11."
  ],
  "setup": [
   "Baud rate choices per holding 40217: 2400, 4800, 9600 or 19200. Parity, stop bits and the default address are not stated in the map."
  ],
  "gotchas": [
   "The humidity and pressure input registers are printed with a temperature unit in the map; check them against the unit display."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/schneider-electric/uniflair-acrmd4k-rack-mounted-cooling",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
