  "integration": {
    "summary": "Poll input registers 0x00-0x1F with function 04 for voltage, current, powers and power factor, then 0x6C and 0x70 for import/export energy. Each value is a float in two registers, high word first.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "Voltage"
      },
      {
        "table": "input_register",
        "address": 6,
        "why": "Current"
      },
      {
        "table": "input_register",
        "address": 12,
        "why": "Active power"
      },
      {
        "table": "input_register",
        "address": 30,
        "why": "Power factor"
      },
      {
        "table": "input_register",
        "address": 70,
        "why": "Frequency"
      },
      {
        "table": "input_register",
        "address": 108,
        "why": "Active import energy"
      },
      {
        "table": "input_register",
        "address": 112,
        "why": "Active export energy"
      }
    ],
    "enable": "Modbus is always on in the Modbus versions; set address, baud rate and parity/stop bits in the front-panel setup menu.",
    "watchdog": null,
    "quirks": [
      "Read two registers per value and never start a read in the middle of a float (exception 02).",
      "Keep one request to 40 parameters (80 registers) or fewer."
    ],
    "setup": [
      "Factory settings: address 1, 9600 baud, no parity, 1 stop bit (nonE1).",
      "Parity choices are nonE1, nonE2, EVEn and odd.",
      "Broadcast address 0 is not supported."
    ],
    "gotchas": [
      "Energy needs the overflow counter for very large totals."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
