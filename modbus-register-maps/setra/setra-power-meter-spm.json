{
 "manufacturer": "Setra Systems",
 "manufacturer_slug": "setra",
 "model": "Setra Power Meter (SPM) multi-circuit power meter",
 "model_slug": "setra-power-meter-spm",
 "short_model": "Setra SPM",
 "aliases": [
  "SPM",
  "Setra Power Meter",
  "SS-SPM-MODBUS_G"
 ],
 "equipment_type": "Power meter (multi-circuit)",
 "applies_to": "Setra Power Meter (SPM) family, per Modbus register master list SS-SPM-MODBUS_G; this map covers the device block, both voltage inputs and Load 1.",
 "summary": "The Setra Power Meter is a multi-circuit meter with two voltage inputs and up to 48 configurable loads, each with three phases of CT inputs, reachable over Modbus RTU or Modbus TCP. Values are 32-bit floats and unsigned integers, most significant byte first. This map covers device identity and settings, both voltage inputs (voltages, angles, THD, frequency, service type) and the full Load 1 block with its three phases; Loads 2-48 repeat the same layout at higher addresses.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "Each row gives an 'Absolute Address' and a 'Modbus Register'. The list starts at absolute address 0 (Device_Name, register 30000), and every register number is 30000 + the absolute address, so the absolute address is the wire address for an input-register read: Vin1 L1-N is absolute 104 (register 30104)."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Setra Power Meter Modbus Register Master List",
  "doc_number": "SS-SPM-MODBUS_G",
  "revision_date": null,
  "url": "https://content.setra.com/hubfs/modbus-register-list.pdf",
  "pages": "Device and voltage inputs p. 1; pulse I/O p. 2; Load 1 pp. 3-4"
 },
 "notes": [
  "Word order: every block of uint32/float32 values is headed 'Data Format: Big-Endian (high byte first, or most significant byte first)'. That describes the 32-bit values themselves, so the most significant byte, and with it the high word, comes first in the lower register: ABCD.",
  "Loads 2-48 follow the Load 1 layout in later blocks (Load 2 starts at absolute 580); they are not repeated here.",
  "Left out: 'id' identifier rows, pulse counts and scalers (user-configurable units), the Modbus slave address row, the date/time string and reserved rows.",
  "Input registers (function 04) are implied by the 3xxxx register numbers.",
  "Left out: the kVAh+ and kVAh- rows (total and per phase). Their names say apparent energy but the unit column prints kilo-volt-amperes-reactive-hour, so the unit is not settled.",
  "Addressing: the 'Absolute Address' column starts at 0 for the first register (Device_Name), so it is used as the wire address; the 'Modbus Register' column is that number plus 30000."
 ],
