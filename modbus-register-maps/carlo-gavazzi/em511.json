{
 "manufacturer": "Carlo Gavazzi",
 "manufacturer_slug": "carlo-gavazzi",
 "model": "EM511 single-phase energy meter (Modbus RTU)",
 "model_slug": "em511",
 "short_model": "EM511",
 "aliases": [
  "EM511-IS",
  "EM511DINAV81XS1X",
  "EM511DINAV81XS1PFA",
  "EM511DINAV81XS1PFB",
  "EM511DINAV81XS1SFA"
 ],
 "equipment_type": "Energy meter",
 "applies_to": "EM511 direct-connected single-phase DIN meters with RS485 and digital input (X, PFA, PFB, SFA versions), protocol rev. 1.8.",
 "summary": "The EM511 is a one-module single-phase energy meter (up to 45 A direct) with an RS485 Modbus RTU port and a digital input. Readings are 32-bit integers sent low word first with fixed weights. This map covers V, A, W, VA, var, PF, frequency, demand, THD, import/export and tariff energy, run hours, I/O and alarm status, alarm and tariff setup, serial settings and resets.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": null,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Rows give a 6-digit Modicon number (3xxxxx, function 04) and the hex physical address used in the frame; 300001 / 0000h is wire address 0. Function 03 reads the same values (replace the leading 3 with 4)."
 },
 "default_word_order": "CDAB",
 "firmware": "Rows apply to all firmware unless noted (X 1.0, PFx 1.0)",
 "source": {
  "title": "EM511 Communication Protocol",
  "doc_number": "rev. 1.8",
  "revision_date": "2023-05-23",
  "url": "https://www.gavazziautomation.com/fileadmin/images/PIM/OTHERSTUFF/COMPRO/EM511%20CP%20Rev1.8.pdf",
  "pages": "Data format p. 10; tables PDF pp. 12-22"
 },
 "notes": [
  "Word order: INT32, UINT32 and UINT64 values are sent least significant word first, bytes MSB first (CDAB).",
  "The document is labelled 'internal version' but is published on Carlo Gavazzi's own site.",
  "Rows marked n.a. in the source always read 0 and are left out.",
  "Left out: the mirror block at 0100h-017Eh, the INT64 energy block at 0500h-0532h (no word order stated for INT64), the run-hour/frequency rows that sit inside that block (0534h-053Eh), energy offsets (4100h-4210h), page filter and display settings, serial-number and name ASCII words, and reserved rows.",
  "The part-number table shows hex 0702 for both PFB (1794) and SFA (1795); the decimal codes are used here.",
  "4020h is factory reset: write 0x0A0A then 0xC1A0 within one second.",
  "Start-up current of run hour counter is printed as Modicon 304360 next to hex 110Bh; the hex address (wire 4363) is used."
 ],
