 "integration": {
  "summary": "Poll each submeter's address with FC 03: 13952-14017 for phase values, 14336-14355 for totals, 14464-14473 for frequency and unbalance, and 14720 onward for energy. Decode 32-bit integers low word first and apply the PT-ratio-dependent units.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 13952,
    "why": "V1 voltage"
   },
   {
    "table": "holding_register",
    "address": 13958,
    "why": "I1 current"
   },
   {
    "table": "holding_register",
    "address": 14336,
    "why": "Submeter total kW"
   },
   {
    "table": "holding_register",
    "address": 14342,
    "why": "Submeter total PF"
   },
   {
    "table": "holding_register",
    "address": 14468,
    "why": "Frequency"
   },
   {
    "table": "holding_register",
    "address": 14720,
    "why": "kWh import"
   },
   {
    "table": "holding_register",
    "address": 14722,
    "why": "kWh export"
   }
  ],
  "enable": "Pick Modbus RTU or ASCII and the base address in the COM1 setup (46448-46452) or on the front panel; Modbus/TCP runs on the Ethernet option at port 502 (network setup at 46576).",
  "watchdog": null,
  "quirks": [
   "One physical device answers on many slave addresses: one per active submeter, counted up from the base address.",
   "32-bit values are low word first (CDAB); the low word always sits at an even address.",
   "Voltage and power units jump from 0.1 V / 0.001 kW to 1 V / 1 kW when a PT ratio above 1 is configured."
  ],
  "setup": [
   "Leave address gaps between devices on one bus: with 12 submeters each, use base addresses 1, 13, 25 and so on.",
   "Assign submeters without gaps in the channel assignment setup so the device does not use extra addresses.",
   "If password protection is on, write the password to 44378-44379 before any write."
  ],
  "gotchas": [
   "Broadcast address 0 is not supported.",
   "FC 04 returns the same data as FC 03."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/satec/bfm136-036",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
