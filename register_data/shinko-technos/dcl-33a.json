  ],
  "equipment_type": "Sensor (digital temperature controller)",
  "applies_to": "Shinko DCL-33A with the C5 serial option, plain (non-block) Modbus protocol setting; manual No.DCL32CE3.",
  "summary": "The DCL-33A is a PID temperature controller. With the C5 option it speaks Shinko protocol, Modbus ASCII or Modbus RTU on RS485. The map covers SV, PID, alarm, heater-burnout and loop-break settings, input type, PV, MV and the status word.",
  "transport": [
    "RTU",
    "ASCII"
  ],
  "defaults": {
    "unit_id": 0,
    "baud": 9600,
    "parity": "Even",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "hex 0-based",
    "note": "Registers are listed as hex data items (0001H) that go into the request unchanged. The manual adds that the matching Modicon holding-register number is the item in decimal plus 40001 (0001H = 40002)."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "Communication Instruction Manual DCL-33A (C5)",
    "doc_number": "No.DCL32CE3",
    "revision_date": "2019-09",
    "url": "https://shinko-technos.co.jp/e/manual/english/DCL32CE3.pdf",
    "pages": "Section 7.1, pp. 23-25; communication settings p. 3"
  },
  "notes": [
    "This map is for the plain 'MODBUS RTU mode' / 'MODBUS ASCII mode' protocol setting. The 'Block Read/Write available' settings use the different layout of section 7.2 and are not covered.",
    "All data are 16-bit; negatives are two's complement. Values with a decimal point are sent as whole numbers; apply the decimal point place (001AH).",
    "Units of PID times, cycles and MV are not printed in the command table.",
    "Protocol, instrument number, speed, parity and stop bit are keypad-only settings."
  ],
  "integration": {
    "summary": "Set the protocol to MODBUS RTU in Auxiliary function setting mode 1, give the unit a non-zero instrument number, then read PV 0080H, MV 0081H and status 0085H with function 03 and write SV1 (0001H) with function 06.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 128,
        "why": "Process value"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Set value SV1"
      },
      {
        "table": "holding_register",
        "address": 129,
        "why": "OUT1 manipulated value"
      },
      {
        "table": "holding_register",
        "address": 133,
        "why": "Status bits"
      },
      {
        "table": "holding_register",
        "address": 26,
        "why": "Decimal point for scaling"
      },
      {
        "table": "holding_register",
        "address": 11,
        "why": "Alarm 1 value"
      }
    ],
    "enable": "Requires the C5 option. Hold the two keys shown in the manual (p. 3) together for about 3 s to reach Auxiliary function setting mode 1, then set Communication protocol to MODBUS RTU mode (not the Block Read/Write variant), instrument number, speed, parity and stop bit.",
    "watchdog": null,
    "quirks": [
      "Instrument number defaults to 0, which is the Modbus broadcast address; set 1-95.",
      "Writes over Modbus work even when the set value lock is on."
    ],
    "setup": [
      "Factory defaults: Shinko protocol, instrument 0, 9600 bps, even parity, 1 stop bit.",
      "Speeds 2400-38400 bps; do not add a terminator, the unit has built-in pull-up and pull-down resistors."
    ],
    "gotchas": [
      "Non-volatile memory is rated about 1,000,000 writes; avoid cyclic writes."
    ]
  },
