  "integration": {
    "summary": "Read holding registers (function 03) from 19000: 60 registers give volts, amps, power, CosPhi, frequency and per-phase energy as big-endian floats; 19060-19077 adds three-phase and delivered energy in Wh. Use Modbus TCP over Ethernet or RTU on RS-485.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 19000,
        "why": "Voltage L1-N"
      },
      {
        "table": "holding_register",
        "address": 19012,
        "why": "Current L1"
      },
      {
        "table": "holding_register",
        "address": 19026,
        "why": "Total real power"
      },
      {
        "table": "holding_register",
        "address": 19034,
        "why": "Total apparent power"
      },
      {
        "table": "holding_register",
        "address": 2109,
        "why": "Total power factor"
      },
      {
        "table": "holding_register",
        "address": 19050,
        "why": "Frequency"
      },
      {
        "table": "holding_register",
        "address": 13995,
        "why": "Consumed energy total"
      },
      {
        "table": "holding_register",
        "address": 19076,
        "why": "Delivered energy total"
      }
    ],
    "enable": "Modbus is available on Ethernet and on the RS-485 port. Set the Modbus address (14326) and IP/DHCP settings on the device or in GridVis.",
    "watchdog": null,
    "quirks": [
      "Addresses are used as printed (0-based).",
      "Floats are ABCD (high word first); add 32768 to an address for little-endian.",
      "Energy is in Wh and varh, not kWh.",
      "Rotation field (19052) is a float: 1, 0 or -1."
    ],
    "setup": [
      "RS-485 on the device itself: 8 data bits, no parity, 2 stop bits; baud 9.6, 19.2, 38.4, 57.6, 115.2 or 921.6 kbps.",
      "Set CT/VT ratios (14176-14206) so the floats read in primary units."
    ],
    "gotchas": [
      "19068 in the frequent block is tariff 1 consumed energy only; use 13995 for the full consumed total.",
      "Many rows in the settings area are marked 'only for internal use'; do not write them."
    ]
  },
