{
 "manufacturer": "Carlo Gavazzi",
 "manufacturer_slug": "carlo-gavazzi",
 "model": "EM580 three-phase AC energy meter for EV chargers (Modbus RTU)",
 "model_slug": "em580",
 "short_model": "EM580",
 "aliases": [
  "EM580-IS",
  "EM580DINAV23XS2DEB",
  "EM580DINAV23XS3DEB",
  "EM580DINAV23XS2DET",
  "EM580DINAV23XS3DET",
  "EM580DINAV23XS2DEA",
  "EM580DINAV23XS3DEA"
 ],
 "equipment_type": "Energy meter",
 "applies_to": "EM580-IS MID/Eichrecht AC meters (DEB, DET, DEA variants, 256/384-bit signatures), protocol version 1.11.",
 "summary": "The EM580 is a DIN-rail three-phase AC energy meter for AC charging stations, with signed (Eichrecht) energy data and an RS485 Modbus RTU port. Readings are 32-bit integers sent low word first with fixed weights. This map covers per-phase and system V, A, W, VA, var, PF, frequency, energy totals, the device state word, serial settings and the main OCMF charging-session registers.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": null,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Rows give a 6-digit Modicon number (3xxxxx with function 04, 4xxxxx with function 03) and the hex physical address used in the frame; 300001 / 0000h is wire address 0. Functions 03 and 04 are equivalent."
 },
 "default_word_order": "CDAB",
 "firmware": "Display-string and transaction-ID registers need firmware 1.5.3 onward",
 "source": {
  "title": "EM580 Modbus Communication Protocol - Public version",
  "doc_number": "Version 1.11",
  "revision_date": "2025-04-08",
  "url": "https://www.gavazziautomation.com/fileadmin/images/PIM/OTHERSTUFF/COMPRO/EM580_CPP.pdf",
  "pages": "Data format p. 8; tables PDF pp. 12-31"
 },
 "notes": [
  "Word order: INT32, UINT32 and UINT64 values are least significant word first with bytes MSB first (CDAB).",
  "Left out: the mirror INT32 block at 0102h-0146h (same values, different layout), INT64 energy at 0500h-052Ch and the INT64 UTC timestamp at 7032h (no stated word order for signed 64-bit), the 32-bit frequency at 053Ch (part of the INT64 block), signed OBIS maps at 0800h, public keys and signatures, serial number and device tag ASCII words, page filters, OCMF identification and custom-string fields, the OCMF buffer, maintenance mode and the cable-loss datalogger.",
  "The display shows EEE when the high word of a variable is 7FFFh (over range).",
  "No total-energy reset register is published for this meter; 4020h is factory reset (write 0x0A0A, then 0xC1A0 within 5 s)."
 ],
