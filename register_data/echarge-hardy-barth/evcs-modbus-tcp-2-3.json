  "integration": {
    "summary": "Connect to port 502 at Unit ID 1. Set ChargeMode (40107) to MANUAL, then write the current target and Start_Stop_Charging together in one FC16 frame (40202-40203); poll EVCS_State, ErrorCode and the meter block from 30001/31001.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 201,
        "why": "Charge current target"
      },
      {
        "table": "holding_register",
        "address": 202,
        "why": "Pause / allow energy"
      },
      {
        "table": "input_register",
        "address": 0,
        "why": "Station state"
      },
      {
        "table": "input_register",
        "address": 3,
        "why": "Error code"
      },
      {
        "table": "input_register",
        "address": 1014,
        "why": "Charging power"
      },
      {
        "table": "input_register",
        "address": 1022,
        "why": "Meter energy total"
      },
      {
        "table": "holding_register",
        "address": 207,
        "why": "Heartbeat for the failsafe"
      },
      {
        "table": "holding_register",
        "address": 104,
        "why": "Configured maximum current"
      }
    ],
    "enable": "The Modbus TCP server listens on port 502 by default. An installer may set an IP allow-list in the station's web configuration; ask for your EMS address to be added.",
    "watchdog": "Failsafe_Timeout (40204, 0 = off or 10-3600 s). If no accepted write to 40202, 40203, 40208 or 40209 arrives within the timeout, the station applies Failsafe_Current_Target (40206), sets Failsafe_Active (30027) and ErrorCode 7. Write Heartbeat (40208) at least every timeout/2.",
    "quirks": [
      "Start (40203 = 1) is rejected with exception 03 while the current target is 0; write both in one FC16 frame.",
      "While 40203 = 0 the charger is offered 0 A whatever 40202 says.",
      "Temperature (30025) is a u32 integer, not a float.",
      "A change of charge mode resets the station's limit to its maximum and overrides the Modbus current target.",
      "Unit IDs 0 and 255 are refused with exception 0B."
    ],
    "setup": [
      "Static IP or DHCP (default) on the station's Ethernet port; Modbus TCP port 502, Unit ID 1.",
      "Up to 32 connections total and 4 per source IP; 50 requests/s per IP (burst 100).",
      "Idle connections close after 5 minutes."
    ],
    "gotchas": [
      "Before an EMS stops controlling the station, write a current with 40203 = 1 and set 40204 = 0, or the station can stay limited to 0 A.",
      "Read-only integrations should keep the failsafe off (40204 = 0); stations updated from MapVersion 2.0.0 often keep a saved 20 s / 0 A failsafe.",
      "A phase switch (40209) only runs during an active session; confirm it at ActualPhase (30303)."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
