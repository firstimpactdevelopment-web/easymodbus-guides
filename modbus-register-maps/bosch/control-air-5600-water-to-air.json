 "integration": {
  "summary": "Set the BAS port to Modbus and EIA-485, address the controller with the rotary dials, then poll discrete input 10002 (unit in alarm) and the UPM alarm bits, read the mode registers (30059/30060) and command occupancy with coil 00001.",
  "minimum_registers": [
   {
    "table": "coil",
    "address": 0,
    "why": "BAS occupancy command"
   },
   {
    "table": "discrete_input",
    "address": 1,
    "why": "Unit in alarm"
   },
   {
    "table": "discrete_input",
    "address": 7,
    "why": "Compressor stage 1 output"
   },
   {
    "table": "discrete_input",
    "address": 34,
    "why": "UPM high-pressure alarm"
   },
   {
    "table": "input_register",
    "address": 59,
    "why": "Zone mode status"
   },
   {
    "table": "holding_register",
    "address": 123,
    "why": "Set zone mode"
   },
   {
    "table": "coil",
    "address": 5,
    "why": "BAS loop enable (heat/cool allowed)"
   }
  ],
  "enable": "Communications jumper in the top (EIA-485) position; BAS Port Settings DIP switches SW3/SW4 select Modbus and SW1/SW2 the baud (9.6, 19.2, 38.4 or 76.8 kbps). The Applications Manual gives the switch table.",
  "watchdog": null,
  "quirks": [
   "All analog values are floats with an unstated word order, so only the binary and signed points are listed here.",
   "Runtime and UPM reset coils are momentary: write 1, then 0."
  ],
  "setup": [
   "Rotary dials (tens/ones) set the address up to 99; the controller only reads them at power-up.",
   "Parity, stop bits and default address are not stated in the documents."
  ],
  "gotchas": [
   "Occupancy command (coil 00001) defaults to unoccupied, which keeps the unit off until the BAS sets it.",
   "Coil 00006 (BAS loop enable) must be 1 for heating/cooling."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/bosch/control-air-5600-water-to-air",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
