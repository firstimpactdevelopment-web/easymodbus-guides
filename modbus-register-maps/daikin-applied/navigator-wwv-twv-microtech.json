 "integration": {
  "summary": "Fit the Modbus module, set address and baud at the keypad (Modbus Setup), apply so the controller reboots, then poll holding registers with function 03. Read 1 (Local/Remote) and 316 (Units) first; use 9 to enable, 34 for mode, 35 and 37 for cool and heat setpoints, 38 for capacity limit, and 5 plus 28-33 for alarms.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Local/Remote - network commands only work in Remote"
   },
   {
    "table": "holding_register",
    "address": 14,
    "why": "Chiller status"
   },
   {
    "table": "holding_register",
    "address": 16,
    "why": "Leaving chilled water temperature"
   },
   {
    "table": "holding_register",
    "address": 12,
    "why": "Actual capacity"
   },
   {
    "table": "holding_register",
    "address": 8,
    "why": "Network enable command"
   },
   {
    "table": "holding_register",
    "address": 34,
    "why": "Cooling setpoint command"
   },
   {
    "table": "holding_register",
    "address": 37,
    "why": "Capacity limit command"
   },
   {
    "table": "holding_register",
    "address": 4,
    "why": "Any alarm active"
   },
   {
    "table": "holding_register",
    "address": 29,
    "why": "Active fault index"
   },
   {
    "table": "holding_register",
    "address": 315,
    "why": "English/Metric flag"
   }
  ],
  "enable": "A Modbus communication module must be attached to the unit controller. Set Network Address and Baud Rate at the keypad (password 5321, View/Set Unit > Modbus Setup), then Apply Changes = Yes to reboot the controller. Chiller Local/Remote (register 1) must read Remote (0) - it can only be changed at the keypad - or enable, mode, setpoint, capacity-limit and clear-alarm writes are ignored.",
  "watchdog": "The module's Com LED Timeout (0-3600 s, default 3 s) only turns the BUS LED red when the master stops polling; no control fallback on communication loss is documented. Enable, mode and clear-alarm commands have a Null value that falls back to Disable / Cool / Normal when nothing writes them.",
  "quirks": [
   "Printed register numbers are 1-based without the 4xxxx prefix: subtract 1 for the wire address.",
   "32-bit run-hour counters are low word first (CDAB).",
   "Most analog values are x10 and follow the English/Metric Units register (316); the multiplier does not change with units.",
   "Alarm codes carry the alarm index in the high byte; the low byte holds circuit (bits 5-7), compressor (bits 2-4) and level (bits 0-1: 1 warning, 2 problem, 3 fault)."
  ],
  "setup": [
   "Address 1-247 (default 1); baud 4800/9600/19200/38400 (default 38400); parity Even/Odd/None (default None); Two Stop Bits Yes/No (default Yes).",
   "RS-485 is 3-wire (+, -, REF) shielded twisted pair, daisy-chained. The module's Load Resistor setting (default No) switches in termination; set Yes only on the first or last device.",
   "Response Delay defaults to 5 ms; raise it only for slow masters.",
   "Network parameters revert to defaults after an application software field upgrade - recheck them."
  ],
  "gotchas": [
   "Writes are silently ignored while register 1 reads Local (1).",
   "Chiller Mode Setpoint only matters when Available Modes at the keypad is not Cool Only.",
   "Some manual-reset lockouts (low evaporator pressure, high condenser pressure, freeze) cannot be cleared from the network."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/daikin-applied/navigator-wwv-twv-microtech",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
