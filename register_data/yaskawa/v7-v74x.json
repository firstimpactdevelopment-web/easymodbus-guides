  "integration": {
    "summary": "Set n153 (address), n154 (baud) and n155 (parity), then n003 = 2 and n004 = 6 to take run and reference from Modbus. Write 0001h/0002h and poll 0020h-0031h.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1,
        "why": "Run/stop, direction, reset"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Frequency reference"
      },
      {
        "table": "holding_register",
        "address": 32,
        "why": "Run/ready/fault"
      },
      {
        "table": "holding_register",
        "address": 33,
        "why": "Fault content"
      },
      {
        "table": "holding_register",
        "address": 36,
        "why": "Output frequency"
      },
      {
        "table": "holding_register",
        "address": 39,
        "why": "Output current"
      },
      {
        "table": "holding_register",
        "address": 44,
        "why": "Status incl. comm timeout"
      }
    ],
    "enable": "n153 slave address 1-31 (default 0), n154 baud (default 2 = 9600), n155 parity (default 2 = none). n003 = 2 and n004 = 6 select built-in Modbus RTU for run/stop and frequency reference. n157 = 0 for 2-wire RS-485.",
    "watchdog": "n151 selects the time-out response: 0 coast (default), 1 ramp with n020, 2 ramp with n022, 3 continue with alarm, 4 disabled. 002Ch bit F shows a communication timeout.",
    "quirks": [
      "Registers and addresses are hex.",
      "1-8 registers per 03h read.",
      "Parameter writes (0101h-01B3h) go to an off-line area until 0 is written to 0910h (ACCEPT) or 0900h (ENTER, about 100,000 writes).",
      "Network digital inputs are ORed with the physical terminals."
    ],
    "setup": [
      "Modbus is available on the keypad RJ-45 jack or the R+/R-/S+/S- terminals.",
      "Slave address 1-20h (1-32) per the protocol chapter; n153 accepts 0-31.",
      "Baud 2400-19200."
    ],
    "gotchas": [
      "Factory default n153 = 0 means the drive does not answer reads until an address is set."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
