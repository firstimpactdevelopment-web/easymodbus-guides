  "integration": {
    "summary": "Set DIP S1-3 off (Modbus), S1-4 off for RTU (on = ASCII), S1-5 on for RS-485, S1-7 for the baud rate and S2 for the address, press RESET on the A12 board, then poll 30006/30007 for output voltage and current and 10001-10012 for alarms.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 5,
        "why": "Output voltage, 0.1 V"
      },
      {
        "table": "input_register",
        "address": 6,
        "why": "Output current, 0.1 A"
      },
      {
        "table": "discrete_input",
        "address": 6,
        "why": "Common alarm"
      },
      {
        "table": "discrete_input",
        "address": 3,
        "why": "AC input failure"
      },
      {
        "table": "discrete_input",
        "address": 2,
        "why": "DC output failure"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Float voltage setpoint"
      },
      {
        "table": "coil",
        "address": 0,
        "why": "Equalize / float mode"
      }
    ],
    "enable": "DIP S1-3 OFF selects Modbus (ON = DNP3); S1-4 OFF = RTU, ON = ASCII; S1-5 ON = RS-485, OFF = RS-232; S1-7 ON = 19200, OFF = 9600; S1-8 enables Ethernet; S1-2 OFF uses factory-default configuration values; S2-1...S2-8 set the address bits b7...b0. Changes take effect after pressing RESET (SW10) on the A12 board or cycling both charger breakers.",
    "watchdog": null,
    "quirks": [
      "Values are scaled integers: divide by the multiplier (10 for volts and amps, 100 for revisions).",
      "For telephone-modem links the manual recommends Modbus ASCII because RTU timing is tighter."
    ],
    "setup": [
      "Up to 32 chargers per RS-485 segment; 2-wire half-duplex.",
      "Advanced settings (DNP3, Ethernet, Modbus TCP) need the setup program over RS-232 at 9600 8N1 with S1-1 ON."
    ],
    "gotchas": [
      "Chargers built before 2003 may need a new or reprogrammed main control board (software 3.00+) before the module works."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
