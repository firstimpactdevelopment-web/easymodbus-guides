{
 "manufacturer": "Shinko Technos",
 "manufacturer_slug": "shinko-technos",
 "model": "SGxL signal conditioner series (Modbus RTU)",
 "model_slug": "sgxl",
 "short_model": "SGxL",
 "aliases": [
  "SGBL",
  "SGCL",
  "SGDL",
  "SGIL",
  "SGLL",
  "SGML",
  "SGPL",
  "SGRL",
  "SGSL",
  "SGTL",
  "SGUL"
 ],
 "equipment_type": "Sensor (signal conditioner)",
 "applies_to": "Shinko SGxL signal conditioners (SGBL, SGCL, SGDL, SGIL, SGLL, SGML, SGPL, SGRL, SGSL, SGTL, SGUL); SGFL and SGJL are not covered. Manual No.SGxL1CE3.",
 "summary": "The SGxL family are signal conditioners that turn DC, thermocouple or RTD inputs into analog output signals, with an RS-485 Modbus RTU port. Every item is a signed 16-bit register. The map covers input and output range settings, filtering, manual output, communication settings, the measured input, output value and the status word.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 38400,
  "parity": "Odd",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Registers are listed as hex data items (0001H) that go into the request unchanged. The manual adds that the matching Modicon holding-register number is the item in decimal plus 40001 (0001H = 40002)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Communication Instruction Manual SGxL",
  "doc_number": "No. SGxL1CE3",
  "revision_date": "2022-03",
  "url": "https://shinko-technos.co.jp/e/manual/english/SGxL1CE3.pdf",
  "pages": "Command table pp. 15-20; data notes p. 21; communication settings pp. 3-4"
 },
 "notes": [
  "Output 2 items (0040H-0050H) are left out: the manual marks them as console-software data that cannot be used.",
  "Input type codes are not listed here because the code table changes with model and input group (pp. 15-16).",
  "0001H-0002H accept single-register function 03/06 only; 0010H-0084H also accept function 10H; read-only items accept 03 or 04.",
  "All data are 16-bit two's complement and values with a decimal point are sent without it.",
  "Multi-Display character registers 0070H-0077H are omitted (front-panel label characters)."
 ],
 "integration": {
  "summary": "Wire RS-485, set the instrument number on the keypad (default 1, 38400 bps, 8 bits odd parity), then read input value 00B0H, output value 00B1H and status 00B2H.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 176,
    "why": "Measured input value"
   },
   {
    "table": "holding_register",
    "address": 177,
    "why": "Output 1 value"
   },
   {
    "table": "holding_register",
    "address": 178,
    "why": "Over/underscale and mode status"
   },
   {
    "table": "holding_register",
    "address": 19,
    "why": "Input decimal point"
   },
   {
    "table": "holding_register",
    "address": 20,
    "why": "Input value at 0% output"
   },
   {
    "table": "holding_register",
    "address": 21,
    "why": "Input value at 100% output"
   }
  ],
  "enable": "Modbus RTU is always on. Set instrument number, speed, data bit/parity, stop bit and response delay in Communication setting mode, then choose Save.",
  "watchdog": null,
  "quirks": [
   "Serial RS-485 and the console (USB tool cable) cannot be used together; unplug the tool cable for Modbus.",
   "Writing communication settings over the bus takes effect on the unit; update the master to match."
  ],
  "setup": [
   "Factory defaults: instrument number 1, 38400 bps, 8 data bits, odd parity, 1 stop bit, 10 ms response delay.",
   "Speeds 9600, 19200 or 38400 bps; up to 31 units on one line."
  ],
  "gotchas": [
   "Exception 18 (12H) is returned while the keypad is in setting mode.",
   "Non-volatile memory is good for about one million writes; 0002H is the exception and is not stored."
  ]
 },
