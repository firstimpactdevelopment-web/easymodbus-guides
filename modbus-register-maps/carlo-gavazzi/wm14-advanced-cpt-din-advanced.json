{
 "manufacturer": "Carlo Gavazzi",
 "manufacturer_slug": "carlo-gavazzi",
 "model": "WM14 Advanced / CPT-DIN Advanced power analyzer (legacy)",
 "model_slug": "wm14-advanced-cpt-din-advanced",
 "short_model": "WM14 Advanced",
 "aliases": [
  "WM14-96 Advanced",
  "WM14 A",
  "CPT-DIN Advanced",
  "CPT A",
  "CPT-DIN A"
 ],
 "equipment_type": "Power meter (power analyzer)",
 "applies_to": "WM14 Advanced (revision 5 onward) and CPT-DIN Advanced (revision 6 onward) with RS485 (or RS232 on CPT-DIN), protocol version 2 revision 2 (2008-01-09).",
 "summary": "The WM14 Advanced panel analyzer and the CPT-DIN Advanced DIN-rail transducer are older Carlo Gavazzi meters with an optional RS485 Modbus RTU port. Measurements are IEEE 754 floats sent low word first. This map covers voltages, currents, powers, PF, frequency, asymmetry, demand, max/min and THD values, the model code, alarm outputs, CT/VT ratio, integration times, serial settings and the reset command.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Rows give a 6-digit Modicon number (3xxxxx) and the hex physical address; the hex address goes in the frame, so 300001 / 0000h is wire address 0. A few printed Modicon numbers do not match their hex address (0058h is printed 300099, 01A8h is printed 300417); the hex value is used."
 },
 "default_word_order": "CDAB",
 "firmware": "WM14 rev. 5+, CPT-DIN rev. 6+",
 "source": {
  "title": "WM14 Advanced / CPT-DIN Advanced Communication Protocol",
  "doc_number": "Version 2 Revision 2",
  "revision_date": "2008-01-09",
  "url": "https://www.gavazziautomation.com/fileadmin/images/PIM/OTHERSTUFF/COMPRO/WM14%20A%20and%20CPT%20A%20CP%20v2r2%20ENG%200108.pdf",
  "pages": "Serial settings p. 4; functions pp. 5-7; data format and float byte order p. 9; tables pp. 11-20"
 },
 "notes": [
  "Float word order: the protocol lists the frame bytes as bits 15-8, 7-0, 31-24, 23-16 of the IEEE 754 value, i.e. low word first (CDAB).",
  "Left out: the UINT32 energy counters and hour counter (0056h-005Fh). The word-order sentence covers only UINT16 and UINT64 integers, so the order of these 32-bit integers is not stated.",
  "Left out: filter settings, system type (its value list is garbled in the source), output control and digital output/alarm blocks, analogue output setup and virtual alarm words.",
  "Up to 12 registers per read on the RS485 port (28 on the CPT-DIN RS232 port).",
  "Reads use function 03 or 04; writes use function 06."
 ],
