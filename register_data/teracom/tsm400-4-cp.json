  "integration": {
    "summary": "Read CO2 and pressure as floats at PDU 106-109 with function 03, or as plain 16-bit values at PDU 603-604.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 106,
        "why": "CO2 ppm (float)"
      },
      {
        "table": "holding_register",
        "address": 108,
        "why": "Pressure hPa (float)"
      },
      {
        "table": "holding_register",
        "address": 603,
        "why": "CO2 ppm (uint16)"
      },
      {
        "table": "holding_register",
        "address": 604,
        "why": "Pressure hPa (uint16)"
      },
      {
        "table": "holding_register",
        "address": 2002,
        "why": "CO2 self-calibration on/off"
      }
    ],
    "enable": "Modbus RTU is the only interface and is always active; there is nothing to switch on. Factory settings are address 1, 19200 baud, 8E1.",
    "watchdog": null,
    "quirks": [
      "Baud rate and framing changes only take effect after the device is powered off and on again.",
      "Word order for every 32-bit value is set by the Data order register (PDU 13); check it before blaming the scaling."
    ],
    "setup": [
      "Set unit ID (PDU 10), baud (PDU 11) and framing (PDU 12), then power-cycle the device.",
      "Terminate both ends of the RS-485 bus with 120 ohm; the built-in resistor is enabled by shorting the RS485- and TERM terminals. A daisy chain is recommended."
    ],
    "gotchas": []
  },
