  "integration": {
    "summary": "Set address, baud and parity on the board DIP switches, set parameter H5 ModBus to Active, then write 40001 and the commands: enable only = 40001 0x0001 + 40002 0x0001; enable + BMS = 40001 0x0005 + 40002 0x0001 + 40003 rate; BMS only = 40001 0x0004 + 40003. Monitor 30009-30016.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "Configuration bits"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Enable command"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Rate (%) or setpoint command"
      },
      {
        "table": "input_register",
        "address": 8,
        "why": "Outlet temperature"
      },
      {
        "table": "input_register",
        "address": 11,
        "why": "Firing rate"
      },
      {
        "table": "input_register",
        "address": 13,
        "why": "Status code"
      },
      {
        "table": "input_register",
        "address": 14,
        "why": "Blocking code"
      },
      {
        "table": "input_register",
        "address": 15,
        "why": "Lockout code"
      }
    ],
    "enable": "Monitoring works with the default control setup. To send commands set parameter H5 ModBus to Active (see the Armor service manual), choose the enable/BMS demand configuration, and re-send 40001 before each command.",
    "watchdog": "Two timers: a BAS-supplied tank temperature must be refreshed within parameter H6 ModBus Time (the operation section gives 1-255 s; the configuration section says 5-120 s, default 10 s); all other commands time out after a fixed 4 minutes, after which the control reverts to its local inputs.",
    "quirks": [
      "Modicon addressing: 30009 is input register 8 on the wire.",
      "Temperatures are degrees C x 10.",
      "A setpoint sent through 40003 is the 0-10 V equivalent percentage interpolated from the BMS low/high setpoint parameters, not degrees.",
      "Read the lockout code only when the status code is 40."
    ],
