 "integration": {
  "summary": "Poll input registers 0000h-0005h (function 04 or 03) for V, A and W and 0010h-0027h for energy; values are INT32 low word first with fixed weights. For signed charging sessions follow the OCMF procedure around 7040h and 7100h.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "DC voltage"
   },
   {
    "table": "input_register",
    "address": 2,
    "why": "DC current"
   },
   {
    "table": "input_register",
    "address": 4,
    "why": "DC power"
   },
   {
    "table": "input_register",
    "address": 16,
    "why": "Imported energy total"
   },
   {
    "table": "input_register",
    "address": 32,
    "why": "Exported energy total"
   },
   {
    "table": "holding_register",
    "address": 20498,
    "why": "Device state / transducer health"
   },
   {
    "table": "holding_register",
    "address": 28741,
    "why": "Charging session status"
   }
  ],
  "enable": "RS485 and Ethernet are both active. Serial settings at 2000h-2004h take effect after writing 1 to 2010h; Ethernet settings at 2100h-210Dh after writing 1 to 210Eh or a power cycle.",
  "watchdog": null,
  "quirks": [
   "32-bit and 64-bit unsigned values are low word first.",
   "Totals are 0.1 kWh resolution; run hours are in 1/100 h.",
   "Certified versions block the total-energy reset."
  ],
  "setup": [
   "Serial defaults: address 1, 9600 baud, no parity, 1 stop bit.",
   "Ethernet defaults: 192.168.1.10 / 255.255.255.0, gateway 192.168.1.1, port 502, DHCP off.",
   "With DHCP on, read the assigned address at 2120h-2123h."
  ],
  "gotchas": [
   "Max RS485 answer time is 500 ms; use a long enough timeout.",
   "After reading an OCMF file, write 0 to 7100h or no new session can start."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/carlo-gavazzi/dcm1",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
