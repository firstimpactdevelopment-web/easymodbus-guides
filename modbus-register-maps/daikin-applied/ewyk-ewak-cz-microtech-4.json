 "integration": {
  "summary": "Fit a POL902 module, set its address and serial settings at the keypad, then poll holding registers. Read Unit Status (col 15) and leaving water temperature (col 17); enable with col 9, choose Cool/Heat with col 34 and send setpoints to cols 35/37 in tenths of °C.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Local/Network source"
   },
   {
    "table": "holding_register",
    "address": 14,
    "why": "Unit status"
   },
   {
    "table": "holding_register",
    "address": 16,
    "why": "Leaving water temperature"
   },
   {
    "table": "holding_register",
    "address": 12,
    "why": "Actual capacity"
   },
   {
    "table": "holding_register",
    "address": 8,
    "why": "Network enable command"
   },
   {
    "table": "holding_register",
    "address": 33,
    "why": "Operation mode command"
   },
   {
    "table": "holding_register",
    "address": 34,
    "why": "Cool setpoint command"
   },
   {
    "table": "holding_register",
    "address": 36,
    "why": "Heat setpoint command"
