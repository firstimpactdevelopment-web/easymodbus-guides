 "integration": {
  "summary": "Read holding registers (function 03) from 19000 over Modbus TCP or RTU: the block gives volts, amps, power, CosPhi, frequency, energy and THD as big-endian floats. For all-tariff energy totals read 6508 (consumed) and 6520 (delivered); 19636 gives the total power factor.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 19000,
    "why": "Voltage L1-N"
   },
   {
    "table": "holding_register",
    "address": 19012,
    "why": "Current L1"
   },
   {
    "table": "holding_register",
    "address": 19026,
    "why": "Total real power"
   },
   {
    "table": "holding_register",
    "address": 19636,
    "why": "Total power factor"
   },
   {
    "table": "holding_register",
    "address": 19050,
    "why": "Frequency"
   },
   {
    "table": "holding_register",
    "address": 6508,
    "why": "Consumed real energy, all tariffs"
   },
   {
    "table": "holding_register",
    "address": 6520,
    "why": "Delivered real energy, all tariffs"
   }
  ],
  "enable": "The address list does not describe how to enable Modbus or pick the port; it only lists the RS-485 and IP settings rows (several marked internal use).",
  "watchdog": null,
  "quirks": [
   "Addresses are used as printed (0-based).",
   "Floats are ABCD; add 32768 to an address to get the same value little-endian.",
   "Energy is in Wh and varh, not kWh."
  ],
  "setup": [
   "RS-485: 8 data bits, no parity; the device transmits 2 stop bits (the master may use 1 or 2).",
   "Set CT/VT ratios (6689-6701) so the float values read in primary units; 19716 shows whether the ratios are locked."
  ],
  "gotchas": [
   "19068 is tariff 1 only; use 6508 for the consumed total.",
   "Writing to the RW energy rows presets the counters."
  ]
 },
