  "integration": {
    "summary": "Set Fieldbus interface type = Modbus RTU and Fieldbus control = On on the softstarter, then write the control word 0400h with bit 5 (auto mode) and bit 2 (start), and poll 0300h status, 0202h-0204h phase currents and 2000h diagnostics.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1024,
        "why": "Control word: start/stop/auto mode/reset"
      },
      {
        "table": "input_register",
        "address": 768,
        "why": "Status word: running, fault, ready"
      },
      {
        "table": "input_register",
        "address": 514,
        "why": "Phase current L1"
      },
      {
        "table": "input_register",
        "address": 512,
        "why": "Motor current in % of Ie"
      },
      {
        "table": "input_register",
        "address": 513,
        "why": "Thermal load"
      },
      {
        "table": "input_register",
        "address": 8192,
        "why": "Diagnostic word (faults/protections)"
      }
    ],
    "enable": "On the softstarter set Fieldbus interface type = internal Modbus RTU, Fieldbus control = On (Off for monitoring only), the internal Modbus RTU baud rate (9.6-76.8 kbaud) and frame format (8O1, 8E1, 8N2, 8N1), and the Fieldbus address (1-247).",
    "watchdog": "301Ch Internal Modbus RTU timeout (0.5-60.0 s, default 0.5 s) with 3019h Fieldbus fault reaction (Trip or Switch to local). A loss shows as fault EF40 and diagnostic bit 'Fieldbus fault'.",
    "quirks": [
      "Addresses are hex protocol addresses sent as-is.",
      "Stop has priority over start, and both are ignored unless auto mode is set in exactly one place (coil 0105h or control word bit 5).",
      "The default comm timeout is only 0.5 s, so the master must poll continuously."
    ],
    "setup": [
      "The Modbus RTU adaptor plugs into the PSE fieldbus connector; fit termination at both line ends.",
      "After writing 4064h (baud) the master must switch to the new rate to keep talking."
    ],
    "gotchas": [
      "Parameter writes fail while the motor is ramping; read 2003h for the reason and the parameter number.",
      "The motor may start unexpectedly when switching between fieldbus and hardwired control if a start signal is present."
    ]
  },
