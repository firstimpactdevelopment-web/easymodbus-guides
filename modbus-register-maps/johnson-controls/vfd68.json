 "integration": {
  "summary": "Set P.549 = 1 (Modbus RTU), a station number in P.117 and the speed/parity in P.118/P.120, then use function 03/06/16 on 4xxxx holding registers: command the drive with 40009 (bit 1 forward, bit 2 reverse) and 40014 (0.01 Hz), and monitor 40201-40214 and 40501.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 8,
    "why": "Run command (write) / drive status (read)"
   },
   {
    "table": "holding_register",
    "address": 13,
    "why": "Frequency command in 0.01 Hz"
   },
   {
    "table": "holding_register",
    "address": 200,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 201,
    "why": "Output current"
   },
   {
    "table": "holding_register",
    "address": 213,
    "why": "Output power"
   },
   {
    "table": "holding_register",
    "address": 500,
    "why": "Latest fault code"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Fault reset"
   }
  ],
  "enable": "On the operation panel set P.549 = 1 (Modbus RTU) and P.117 = 1-247 (0 means the drive never replies), then P.118/P.120 for speed and parity; these parameters can only be set when P.160 = 0.",
  "watchdog": "P.122 (PU communication check time interval: 0, 0.1-999.8 s or 9999, default 9999; the bulletin does not explain the 0 and 9999 settings) and P.502 (stop mode at communication error: coast with E.PUE, decelerate then E.PUE, or decelerate with E.PUE shown but no fault output).",
  "quirks": [
   "Register numbers are 4xxxx; subtract 40001 for the PDU address.",
   "Default station number 0 means broadcast-only: the drive will not answer until P.117 is set.",
   "Parity and stop bits are linked: no parity forces 2 stop bits, odd/even use 1.",
   "Writing to 40014 changes the RAM value only; 40015 writes the frequency to EEPROM."
  ],
  "setup": [
   "RJ45 PU port pins (Table 87): 1 and 7 SG (ground), 3 RDA, 4 SDB, 5 SDA, 6 RDB. Do not connect pins 2 and 8 (drive power supply).",
   "Speeds 4800/9600/19200/38400 bps, 8 data bits, up to 32 drives per segment."
  ],
  "gotchas": [
   "Supported function codes are 03, 06, 08, 16 and 70 (H46 access log).",
   "Reading a non-existent register in a block returns 0 instead of an error unless every register in the block is invalid."
  ]
 },
