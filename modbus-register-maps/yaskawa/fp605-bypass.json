{
 "manufacturer": "Yaskawa",
 "manufacturer_slug": "yaskawa",
 "model": "FP605 enclosed bypass (MEMOBUS/Modbus RTU)",
 "model_slug": "fp605-bypass",
 "short_model": "FP605 Bypass",
 "aliases": [
  "FP605 Enclosed Bypass",
  "FP605 bypass package"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "Yaskawa FP605 enclosed bypass packages using the bypass board RS-485 port (TB3) with H5-08 = 0 (MEMOBUS/Modbus); Technical Reference SIEPYAIF6B01C, section 10.6.",
 "summary": "Yaskawa's FP605 fan and pump drive packaged with a bypass contactor board. The bypass board's RS-485 port speaks MEMOBUS/Modbus RTU (or N2, P1, BACnet). Drive command and monitor registers start at 0001H and 0020H, and the bypass adds its own command word and digital I/O registers at 8400H-8403H. This map covers drive and bypass control, status, fault bits and the b1/H5/Z3-12 setup parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 31,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Register numbers are hex and are sent unchanged: the manual's read example asks for starting register 0020H as bytes 00 20. Parameters use the hex number printed under each parameter (H5-01 = 0425H, Z3-12 = 850BH)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "FP605 Enclosed Bypass Technical Reference",
  "doc_number": "SIEPYAIF6B01C",
  "revision_date": null,
  "url": "https://www.yaskawa.com/delegate/getAttachment?documentId=SIEPYAIF6B01&cmd=documents&documentName=SIEPYAIF6B01.pdf",
  "pages": "b1 p. 151, H5 parameters pp. 285-289, Z3-12 in chapter 5; section 10.6 MEMOBUS/Modbus: Table 10.19 specs, function codes and read example pp. 727-729, Table 10.30 command data pp. 734-738, Table 10.31 monitor data pp. 739-742."
 },
 "notes": [
  "H5-08 defaults to 3 (BACnet) on this package; it must be set to 0 for Modbus.",
  "Frequency registers 0002H, 0023H and 0024H use the units chosen in o1-03, so they are left unscaled.",
  "Left out: 0007H/0008H analog outputs, 0025H output voltage (unit switched by H5-10), 0026H/0027H output current and power, 002DH and later monitors not checked row by row, the U-monitor, fault-trace and fault-description blocks from 0040H, 15FFH (no unit given), the clock registers 3004H-3030H and emergency-override registers 3A93H-3A96H.",
  "The command table prints run bits 0/1 with both meanings (forward run / run and reverse run / reverse) without naming the selecting parameter; on the drive this is H5-12, which is not in the bypass H5 list.",
  "Supported function codes are 03H, 08H, 10H, 5AH and 67H; there is no 06H, so use 10H even for a single register.",
  "With H5-11 = 0 (default), parameter writes take effect only after the Enter command (0900H or 0910H)."
 ],
