  "integration": {
    "summary": "Poll the block from 0x0000 with function 04 (at most 20 variables, 40 registers, per frame), then read the leakage registers C392-C399. All 32-bit values are high word first with fixed scale.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "L1 phase voltage (V x10)"
      },
      {
        "table": "input_register",
        "address": 2,
        "why": "L1 current (mA)"
      },
      {
        "table": "input_register",
        "address": 66,
        "why": "Three-phase apparent power"
      },
      {
        "table": "input_register",
        "address": 40,
        "why": "Frequency (Hz x10)"
      },
      {
        "table": "input_register",
        "address": 60,
        "why": "Consumed active energy"
      },
      {
        "table": "input_register",
        "address": 50071,
        "why": "Earth leakage current (mA)"
      },
      {
        "table": "input_register",
        "address": 50066,
        "why": "Total reclosing operations"
      },
      {
        "table": "input_register",
        "address": 50064,
        "why": "Relay status"
      }
    ],
    "enable": "Modbus RTU is the standard protocol (Protocol register 0x2742 = 0). Set the peripheral number from the front panel (hold PROG for more than 3 s) or register 0x2743, and speed and framing with 0x2744-0x2747; reset the device for Modbus setup changes to apply.",
    "watchdog": null,
    "quirks": [
      "A frame may carry at most 20 variables (40 registers).",
      "Energies come both as a single Wh/varh counter and as a whole-unit plus remainder pair; use the pair for large totals.",
      "Reset commands are coils written with function 05 and FF00.",
      "The trip/reset register C3AC operates the breaker remotely; treat it as a control point."
    ],
    "setup": [
      "Defaults from the setup tables: peripheral number 1, 19200 baud, no parity, 8 data bits, 1 stop bit.",
      "Only 9600 and 19200 baud are offered.",
      "Up to 32 devices per RS-485 bus, 1200 m maximum."
    ],
    "gotchas": [
      "Writing C3AC = 1 trips the breaker and cuts the load."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
