 "integration": {
  "summary": "Read printed registers 1-21 and 28-42 (wire 0-20 and 27-41) in two requests for status, temperatures and alarms. To command the chiller, set Control Source = BAS and Remote Enable = Enable at the HMI, then write Chiller Enable (printed 9), Cool Setpoint (35) and Capacity Limit (38).",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 7,
    "why": "Chiller on/off"
   },
   {
    "table": "holding_register",
    "address": 14,
    "why": "Run mode"
   },
   {
    "table": "holding_register",
    "address": 16,
    "why": "Evaporator leaving water temperature"
   },
   {
    "table": "holding_register",
    "address": 12,
    "why": "Actual capacity"
   },
   {
    "table": "holding_register",
    "address": 32,
    "why": "Active fault alarm code"
   },
   {
    "table": "holding_register",
    "address": 8,
    "why": "Chiller enable command"
   },
   {
    "table": "holding_register",
    "address": 34,
    "why": "Cool setpoint from network"
   }
  ],
  "enable": "Install the Modbus communication module, set Control Source to BAS (for the enable command) and Remote Enable to Enable (for setpoint, mode and capacity limit) at the unit HMI.",
  "watchdog": null,
  "quirks": [
   "Printed numbers are 1-based without the 4 prefix.",
   "Run hours are two registers, high word first.",
   "While the chiller is in Local, the network mode, cool and ice setpoints, capacity limit and clear-alarm registers are ignored."
  ],
  "setup": [
   "Network parameters are set at the HMI; see Daikin IM 1283 for the Modbus module settings."
  ],
  "gotchas": [
   "A value of 2 (Null) on the enable or clear-alarm registers releases the point back to its default.",
   "Some manual-reset alarms (low evaporator pressure, high condenser pressure, freeze) cannot be cleared from the network."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/daikin-applied/magnitude-wme-microtech",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
