 "equipment_type": "Soft starter",
 "applies_to": "ADXL soft starters fitted with the EXC1042 RS-485 board, per Lovato protocol addendum I454IGB03_22.",
 "summary": "The Lovato ADXL is a soft starter for three-phase motors. With the optional EXC1042 RS-485 board it answers Modbus RTU or ASCII (the addendum also lists Modbus TCP as a protocol choice). This map covers voltage, currents, powers, power factor, frequency, torque, thermal status, thyristor temperature, I/O bits, the start/stop commands, the command register and the parameter-access selectors.",
 "transport": [
  "RTU",
  "ASCII",
  "TCP"
 ],
