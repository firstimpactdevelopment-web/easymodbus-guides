  "integration": {
    "summary": "Assign Modbus to the serial port (or enable Modbus on the Ethernet adapter) and set the Modbus address in MENU > COMMUNICATION, then poll 30006/30007 for DC output voltage and current, the discrete inputs for alarms, and write setpoints to 40001-40021.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 5,
        "why": "DC output voltage, 0.1 V"
      },
      {
        "table": "input_register",
        "address": 6,
        "why": "DC output current, 0.1 A"
      },
      {
        "table": "discrete_input",
        "address": 6,
