  "integration": {
    "summary": "Read holding registers 1-6 in one request (function 03) for CO2 and temperature as CDAB floats. Write compensation values to the volatile registers 521-528 if they change often.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "CO2 concentration"
      },
      {
        "table": "holding_register",
        "address": 4,
        "why": "Probe temperature"
      },
      {
        "table": "holding_register",
        "address": 2048,
        "why": "Device status"
      },
      {
        "table": "holding_register",
        "address": 2051,
        "why": "Active error bits"
      },
      {
        "table": "holding_register",
        "address": 520,
        "why": "Live pressure compensation"
      }
    ],
    "enable": "Modbus RTU over RS-485 is one of the probe's output modes, chosen at order or later by configuration. From Vaisala Industrial Protocol, switch with the serial command smode modbus. If pin 5 is tied to GND (pin 3) the probe is locked in analog mode and Modbus is not available.",
    "watchdog": null,
    "quirks": [
      "Float word order is low word first (CDAB); use \"word-swapped\" in masters that expect high word first.",
      "Read each 32-bit value in a single transaction."
    ],
    "setup": [
      "Defaults: address 240, 19200 baud, no parity, 8 data bits, 2 stop bits.",
      "Change address and serial settings with registers 769-772, or in Vaisala Insight PC software."
    ],
    "gotchas": [
      "Register 258 must be multiplied by 10.",
      "Relative humidity compensation only works with temperature and pressure compensation also enabled."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
