{
 "manufacturer": "GE Multilin",
 "manufacturer_slug": "ge-multilin",
 "model": "Multilin PQMII power quality meter",
 "model_slug": "multilin-pqmii",
 "short_model": "PQMII",
 "aliases": [
  "PQM II",
  "GE Multilin PQMII",
  "PQM2"
 ],
 "equipment_type": "Power meter (power quality meter)",
 "applies_to": "Multilin PQMII per instruction manual GEK-113532 (communications guide chapter).",
 "summary": "The Multilin PQMII is a panel-mount power quality meter, now documented by GE Vernova. It speaks Modbus RTU on its RS-485 ports, with all data in one hexadecimal memory map. This map covers currents, voltages, power, power factor, energy, demand, frequency, THD and the command registers.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "The memory map prints addresses in hex, and the manual's examples send that hex value on the wire (e.g. a read of 3 registers starting at 006B). Actual values are input registers, setpoints and commands holding registers; function 03 and 04 both read either area."
 },
 "default_word_order": "ABCD",
 "firmware": "Software revision 2.2x",
 "source": {
  "title": "PQMII Power Quality Meter Communications Guide",
  "doc_number": "GEK-113532 (manual P/N 1601-9090-A1)",
  "revision_date": null,
  "url": "https://www.gevernova.com/grid-solutions/sites/default/files/resources/products/manuals/pqmii/gek-113532-GEV.pdf",
  "pages": "long-integer rule and worked example COMM-4/5; functions COMM-5 to COMM-13; memory map COMM-14 onward (actual values from COMM-16); data formats COMM-57"
 },
 "notes": [
  "Word order: the manual says long integers occupy two registers, high-order register first, and its worked example (02F0 = 004Fh, 02F1 = 35D1h -> 51911.21 kW) confirms ABCD.",
  "Data formats: F1 unsigned 16-bit, F2 signed 16-bit, F3 unsigned 32-bit, F4 signed 32-bit. Scales are copied from the Units and Scale column (0.01 x kW, 0.1 x %, 0.01 x Hz).",
  "Up to 125 registers can be read in one request; up to 60 written.",
  "Phase B current THD (0479h) is left out because its units/scale cell is blank in the table. Min/max time stamps, tariff energies/costs, per-harmonic data and setpoints are left out.",
  "The user-definable area (index 0180h-01F7h, data 0100h-0177h) can gather scattered registers into one block.",
  "Communication defaults are not listed: the RS-485 setpoint rows (e.g. baud rate at 1018h) give codes whose meaning is not readable in this copy of the table."
 ],
