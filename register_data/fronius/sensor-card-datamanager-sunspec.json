  "integration": {
    "summary": "Enable Modbus on the Datamanager and poll the sensor card at unit ID 245 + its Solar Net address. Read 40072 for irradiance and 40079-40086 for temperatures and wind speed.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 40069,
        "why": "Model ID 302 confirms the layout"
      },
      {
        "table": "holding_register",
        "address": 40071,
        "why": "Global horizontal irradiance"
      },
      {
        "table": "holding_register",
        "address": 40078,
        "why": "Module temperature (sensor 1)"
      },
      {
        "table": "holding_register",
        "address": 40082,
        "why": "Ambient temperature (sensor 2)"
      },
      {
        "table": "holding_register",
        "address": 40085,
        "why": "Wind speed"
      }
    ],
    "enable": "In the Datamanager web interface open Settings > Modbus and set data output to tcp (or rtu). The sensor card must be connected to the Datamanager via Solar Net.",
    "watchdog": null,
    "quirks": [
      "The sensor card is a separate Modbus device: unit ID = 245 + Solar Net address (0-2 -> 245-247).",
      "Unlike the inverter and meter models, the sensor card layout does not change between float and int+SF."
    ],
    "setup": [
      "Sensor card Solar Net address 0 -> unit ID 245, 1 -> 246, 2 -> 247."
    ],
    "gotchas": [
      "Points marked not supported (humidity, pressure, wind direction and others) still exist in the block; ignore them."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
