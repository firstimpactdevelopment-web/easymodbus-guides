 "integration": {
  "summary": "Poll input registers with function 04 in two-register pairs starting at 0x0000; floats arrive high word first. Total power is at 0x0034, import and export kWh at 0x0048 and 0x004A.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "Phase 1 voltage"
   },
   {
    "table": "input_register",
    "address": 6,
    "why": "Phase 1 current"
   },
   {
    "table": "input_register",
    "address": 52,
    "why": "Total system power"
   },
   {
    "table": "input_register",
    "address": 62,
    "why": "Total power factor"
   },
   {
    "table": "input_register",
    "address": 70,
    "why": "Frequency"
   },
   {
    "table": "input_register",
    "address": 72,
    "why": "Import kWh"
   },
   {
    "table": "input_register",
    "address": 74,
    "why": "Export kWh"
   }
  ],
  "enable": "Modbus RTU is always on at the RS485 terminals. To change the system type, write the password (default 0000) as a float to 40025 first; it times out after one minute unless 40015 or 40025 is read.",
  "watchdog": null,
  "quirks": [
   "Every value, including enumerations such as baud rate, is a float in two registers; write settings with function 16, one parameter per message.",
   "Node address and parity changes only take effect after the meter restarts.",
   "The reset register uses the six-digit number 461457 (hex F010) and is write-only."
  ],
  "setup": [
   "Defaults: address 1, 9600 baud, 8 data bits, no parity, 1 stop bit.",
   "Selectable baud rates: 2400, 4800, 9600, 19200, 38400.",
   "Terminate both ends of the RS485 line with 120 ohm resistors; up to 32 nodes and 1200 m."
  ],
  "gotchas": [
   "The document says broadcast is supported in one place and not supported in another; do not rely on address 0.",
   "Requesting more than 40 values in one read returns an exception."
  ]
 },
