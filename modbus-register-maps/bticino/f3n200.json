 "integration": {
  "summary": "Read holding registers with function 03 from 51280: the 16-bit block gives voltages, currents, frequency, power, power factor and energy without any word-order question. The 32-bit block at 50512 is more precise but its word order is not documented, so test it on a live meter before using it.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 51284,
    "why": "Phase 1 voltage"
   },
   {
    "table": "holding_register",
    "address": 51288,
    "why": "Phase 1 current"
   },
   {
    "table": "holding_register",
    "address": 51292,
    "why": "Total active power"
   },
   {
    "table": "holding_register",
    "address": 51295,
    "why": "Total power factor"
   },
   {
    "table": "holding_register",
    "address": 51287,
    "why": "Frequency"
   },
   {
    "table": "holding_register",
    "address": 51311,
    "why": "Imported active energy"
   }
  ],
  "enable": "Modbus address (1-247), baud rate, parity and stop bits are programmable; the table does not say where. To change setup over Modbus, write the registers, write 0xA1 to 57856 (E200) to store, then 0xB2 to reboot.",
  "watchdog": null,
  "quirks": [
   "Values are read with function 03 even though the table calls them input registers."
  ],
  "setup": [
   "RS-485 two-wire, RTU mode, 8 data bits; baud 2400-38400, parity none/odd/even and 1 or 2 stop bits are programmable.",
   "The table does not state factory defaults for address, baud or parity."
  ],
  "gotchas": [
   "Setup changes are not applied until 0xA1 (store) and 0xB2 (reboot) are written to 57856.",
   "Reset codes at 1024 can be OR-ed together; 0x1000 resets all parameters."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/bticino/f3n200",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
