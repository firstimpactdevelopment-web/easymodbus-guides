  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 7,
  "stop_bits": 2,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Each row gives a 4xxxx reference and the hex data address used in the frame: Cell Voltage 1 is reference 40001 at data address 0000H, overall voltage is 41025 at 0400H. Wire address = reference - 40001."
 },
