 "integration": {
  "summary": "Poll 200-202 for setpoint, PV and output power. Write 200 to change the setpoint, 214 to run/stop control and 213 for manual/automatic.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 201,
    "why": "Process variable"
   },
   {
    "table": "holding_register",
    "address": 200,
    "why": "Setpoint"
   },
   {
    "table": "holding_register",
    "address": 202,
    "why": "Output power 0.1 %"
   },
   {
    "table": "holding_register",
    "address": 214,
    "why": "Run control"
   },
   {
    "table": "holding_register",
    "address": 213,
    "why": "Manual/automatic"
   },
   {
    "table": "holding_register",
    "address": 279,
    "why": "Decimal point position"
   }
  ],
  "enable": "Fit the RS-485 option and set address and serial parameters on the controller.",
  "watchdog": null,
  "quirks": [
   "Addresses are 0-based.",
   "Temperature PV is x10 regardless of the decimal-point setting."
  ],
  "setup": [
   "Up to 247 controllers on one RS-485 line; terminals 3 (D1/D+/B), 2 (D0/D-/A), 1 (GND)."
  ],
  "gotchas": [
   "Setpoint writes are limited to SPLL/SPHL (220/221)."
  ]
 },
