{
 "manufacturer": "BTicino",
 "manufacturer_slug": "bticino",
 "model": "M7000CBNCU03 automatic transfer switch controller (Modbus)",
 "model_slug": "m7000cbncu03",
 "short_model": "M7000CBNCU03",
 "aliases": [
  "M7000CBNCU03",
  "4 226 82",
  "422682",
  "Legrand 4 226 82"
 ],
 "equipment_type": "Transfer switch controller",
 "applies_to": "BTicino M7000CBNCU03 (Legrand cat. no. 4 226 82) automatic changeover controller, Modbus RTU/ASCII via the M7000CBNRS485 expansion module or the IR-USB / IR-WiFi front interfaces, per document LE09509AA-01/17-01.",
 "summary": "The M7000CBNCU03 is BTicino's automatic transfer (changeover) controller for two supply lines. With the RS485 expansion module, or the front optical USB/WiFi interface, it speaks Modbus RTU or ASCII. This map covers both lines' voltages and frequencies, battery voltage, run-time and switching counters, the alarm word, keypad, input, line, breaker and output-function status words and the global status double word.",
 "transport": [
  "RTU",
  "ASCII"
 ],
 "defaults": {
  "unit_id": 5,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "1-based",
  "note": "Table addresses are hex and one higher than the wire address. The manual says the request address is the table address minus 1, and its example reads breaker-1 switching alarms (table 3A hex) with the frame 01 04 00 39 00 02."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "M7000CBNCU03 Centralina di commutazione automatica - Protocollo di comunicazione Modbus",
  "doc_number": "LE09509AA-01/17-01",
  "revision_date": "2017-01",
  "url": "https://assets.legrand.com/pim/NP-FT-GT/LE09509AA.pdf",
  "pages": "Parameters (menu M08) p. 4; functions and example p. 6; measures p. 11-12; status bits pp. 13-16; commands pp. 16-17; global status p. 18"
 },
 "notes": [
  "The source is in Italian; names here are our English translations.",
  "Word order: the manual's example answers 00 00 00 07 for 7 alarms, so 2-word values are high word first (ABCD).",
  "Measurements are read with function 04 (input registers) or 03; the manual also lists 06, 07, 16 and 17. Function 06 works only on addresses above 1000 hex.",
  "Defaults of the COM parameters (P08.n.01-05) as printed: node address 05, 19200 baud, 8 bits even parity, 1 stop bit, Modbus RTU.",
  "Left out: line 2 voltage/breaker status, printed at 2176/2177 hex while the line 1 rows are 2074/2075 (probably 2076/2077, but not certain); the input-functions status at 2078 (listed as 2 words of 'unsigned integer'); display-message and LED status words; the generic counters CNT1-4 and limits LIM1-4; and all command registers (2F00-2FF0, 4F00), whose wiring into this map would need the full parameter manual.",
  "Left out: the digital-outputs status word. The status table puts it at 2140 hex, but the bit table below it reads the outputs at 2072 hex, so the address is uncertain."
 ],
