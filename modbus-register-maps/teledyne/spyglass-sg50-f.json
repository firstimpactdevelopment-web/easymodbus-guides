  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "The manual prints register addresses in hex starting at 0x0000 (alarm relay), so the hex value is the wire address: 0x0010 = address 16."
 },
