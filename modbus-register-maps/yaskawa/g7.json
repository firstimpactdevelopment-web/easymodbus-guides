{
 "manufacturer": "Yaskawa",
 "manufacturer_slug": "yaskawa",
 "model": "G7 drive (CIMR-G7U, legacy) - Modbus RTU",
 "model_slug": "g7",
 "short_model": "G7",
 "aliases": [
  "CIMR-G7U",
  "G7U",
  "G7 Drive"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "Yaskawa G7 (CIMR-G7U) drives using built-in Modbus RTU on terminals R+/R-/S+/S-, per the Modbus Communication Manual G7 TM.G7.11 (rev 07-01).",
 "summary": "The G7 is Yaskawa's legacy high-performance vector drive with built-in Modbus RTU. Commands are written to hex registers 0001h-000Fh, detailed fault/alarm words are read from 0010h-001Bh, status from 0020h-002Dh, U1/U2/U3 monitors from 0031h upward, and every parameter has its own hex address. This map covers the command block, all status/fault words, monitors with their published units, decoded fault history, and the b1/H5 parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 31,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "All addresses are hex and sent unchanged: the manual's read example uses starting register 00h 20h to read 0020h-0023h. Parameter addresses are the hex values in the parameter tables (b1-01 = 0180h, H5-01 = 0425h); ENTER/ACCEPT are printed as 900/910 (0900h/0910h)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Modbus Communication Manual G7",
  "doc_number": "TM.G7.11 Rev 07-01",
  "revision_date": "2007-01-05",
  "url": "https://www.yaskawa.com/delegate/getAttachment?documentId=TM.G7.11&cmd=documents&documentName=TM.G7.11.pdf",
  "pages": "p. 21 (03h example), p. 42 (command registers), pp. 44-51 (monitor registers), p. 54 (b1), p. 67 (H5), p. 78 (ENTER/ACCEPT), p. 79 (fault decoding table 4.17)"
 },
 "notes": [
  "Frequency and speed monitors (0023h, 0024h, 0040h, 0041h, 0044h) scale with o1-03 and are left raw.",
  "Output current is 0.01 A at 0026h but 0.1 A at 0042h, exactly as printed in Table 4.3.",
  "Left out because the sign is not stated: output power (0027h, 0033h, 0047h), torque reference (0028h, 0048h), Iq/Id (0032h, 0051h, 0052h), PID levels and PID input/output (0038h-003Ah, 0063h-0065h), ASR and ACR monitors. 0025h output voltage reference is omitted because its unit switches with H5-10.",
  "Fault values for U2-01/U2-02/U3-xx are the decimal codes of Table 4.17 (e.g. 33 = CE).",
  "The command registers here differ from those of the CM090 Modbus TCP/IP option card, which is not covered.",
  "Broadcast (slave 0) uses 0001h and 0002h only; see the manual's Table 4.2.",
  "8 data bits and 1 stop bit for RS-422/485 come from the free G7 user manual TM.G7.01 (https://www.yaskawa.com/delegate/getAttachment?documentId=TM.G7.01&cmd=documents&documentName=TM.G7.01.pdf); TM.G7.11 states them only for the RS-232 port."
 ],
