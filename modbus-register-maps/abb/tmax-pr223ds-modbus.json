 "integration": {
  "summary": "Read input registers 30101-30156 with function 4 for currents, voltages, power and energy, and 30034-30036 for status, alarms and trips. Write 1 to 40001 / 40003 to open or close.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 33,
    "why": "CB open/closed/tripped, local/remote"
   },
   {
    "table": "input_register",
    "address": 35,
    "why": "Which protection tripped"
   },
   {
    "table": "input_register",
    "address": 100,
    "why": "Phase 1 current"
   },
   {
    "table": "input_register",
    "address": 119,
    "why": "Total active power"
