 "integration": {
  "summary": "Enable BUS control in the installer menu, connect to BMS2 at 19200 baud, no parity, 2 stop bits, address 17, and poll the status and alarm registers 2030-2073 with function 03. Write 2700 to switch the heat pump and the 2705-2715 BUS-control flags before writing setpoints 2720-2759.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 2045,
    "why": "Heat pump on/off/emergency"
   },
   {
    "table": "holding_register",
    "address": 2065,
    "why": "Alarm level"
   },
   {
    "table": "holding_register",
    "address": 2066,
    "why": "Lock alarm code"
   },
   {
    "table": "holding_register",
    "address": 2030,
    "why": "DHW production status"
   },
   {
    "table": "holding_register",
    "address": 2700,
    "why": "Switch heat pump"
   },
   {
    "table": "holding_register",
    "address": 2705,
    "why": "DHW setpoint by BUS flag"
   },
   {
    "table": "holding_register",
    "address": 2720,
    "why": "DHW setpoint by BUS"
   }
  ],
  "enable": "Installer menu > Installation > Remote control > BUS Control > enable. Check the BMS2 port settings (protocol 'MB Extended') in the same Remote control submenu. On the source manager BUS control is always on.",
  "watchdog": null,
  "quirks": [
   "All values are single 16-bit registers with a fixed gain (0.1 for temperatures, pressures, humidity and setpoints).",
   "Counters over 999 are split: value = high part x 1000 + low part (2103/2104, 2105/2106).",
   "BUS setpoints are clamped to their ranges and only apply when the matching BUS-control flag is set; the final setpoints in 2150-2164 show the result (not mapped here because their sign is not stated).",
   "Date/time writes need the matching confirmation register (2695-2699) set to 1."
  ],
  "setup": [
   "RS-485 on the BMS2 port, 3-wire shielded twisted pair (Tx/Rx-, Tx/Rx+, GND).",
   "Defaults: 19200 baud, no parity, 2 stop bits; address 17 for a heat pump, 15 supervisor, 14 source manager.",
   "On ecoAIR outdoor units BMS2 links to the indoor unit, so an optional RS-485 card on the BMS port is needed for BUS access.",
   "Supported functions: 03, 06, 16."
  ],
  "gotchas": [
   "ecoAIR outdoor units serve this list only when configured as block slave or stand-alone.",
   "Check the API version shown in the user menu (Information) matches HP24_Client; older software uses a different list."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/ecoforest/ecogeo-ecoair-hp24",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
