  "integration": {
    "summary": "Set the module address with the DIP/rotary switches, connect RS-485 at 9600 8E1, wait until bits 0-2 of an indoor unit's communication status (50 + n*50) read 7, then read and write its 50-register block.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 50,
        "why": "Indoor unit 0 communication status"
      },
      {
        "table": "holding_register",
        "address": 52,
        "why": "Indoor unit 0 on/off"
      },
      {
        "table": "holding_register",
        "address": 53,
        "why": "Indoor unit 0 mode"
      },
      {
        "table": "holding_register",
        "address": 58,
        "why": "Indoor unit 0 set temperature"
      },
      {
        "table": "input_register",
        "address": 59,
        "why": "Indoor unit 0 room temperature"
      },
      {
        "table": "input_register",
        "address": 63,
        "why": "Indoor unit 0 error code"
      },
      {
        "table": "input_register",
        "address": 0,
        "why": "Module error status"
      }
    ],
    "enable": "Set the Modbus address (1-247) as the sum of the ON DIP switches plus the rotary switch value, connect R1/R2 to the outdoor unit, and give every indoor unit an address 0-47. Reset the module after changing indoor unit addresses or the central-control option.",
    "watchdog": null,
    "quirks": [
      "Per-unit blocks: address = 50 + indoor address x 50 + offset.",
      "Temperatures are x10 integers.",
      "Holding values update only after the indoor unit reports a change."
    ],
    "setup": [
      "Fixed serial format: 9600 bps, 8 data bits, even parity, 1 stop bit.",
      "RS-485 2-wire, up to 1000 m; DC 12 V supply."
    ],
    "gotchas": [
      "Leave at least 10 ms after each response before the next request.",
      "Repeated identical writes are sent to the unit each time; write only when a change is needed.",
      "After power-up all registers read 0 until tracking of the outdoor/indoor units completes."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
