  "integration": {
    "summary": "Connect over Modbus TCP and read plant totals with logical device ID 0: active power at 40525, input power at 40521 and daily/total yield at 40562/40560. Limit the total output of all inverters by writing 40420 (kW x 10) or 40428 (% x 10).",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 40525,
        "why": "Plant active power"
