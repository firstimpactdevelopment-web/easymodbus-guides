 "integration": {
  "summary": "Set the LA (address) and Lb (baud) parameters, then poll holding registers with function 03: Probe 1 at 0x0201 (tenths), relay bits at 0x0181 and alarm bits at 0x0301. Write On/Standby (0x0501), the setpoint SP (0x0601, tenths) and trigger defrosts through 0x28B0.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 513,
    "why": "Cabinet probe temperature"
   },
   {
    "table": "holding_register",
    "address": 1537,
    "why": "Control setpoint"
   },
   {
    "table": "holding_register",
    "address": 1281,
    "why": "Run / standby command"
   },
   {
    "table": "holding_register",
    "address": 385,
    "why": "Relay output states"
   },
   {
    "table": "holding_register",
    "address": 769,
    "why": "Alarm and probe-failure flags"
   },
   {
    "table": "holding_register",
    "address": 10416,
    "why": "Start/stop a defrost (0Dh/0Ch)"
   },
   {
    "table": "holding_register",
    "address": 1544,
    "why": "Temperature unit"
   }
  ],
  "enable": "Modbus RTU is built in; set the Modbus address (LA) and baud rate (Lb) parameters at the controller.",
  "watchdog": null,
  "quirks": [
   "Use the hex Base 0 column as the wire address; the HR: column is 1-based.",
   "Temperatures are in tenths; their printed ranges go below zero, so read them as signed (the guide does not state signedness).",
   "Defrost command register takes 0Dh to start and 0Ch to stop a defrost."
