  "integration": {
    "summary": "Connect the TG to the RS-485 bus and poll; it learns the protocol, baud and parity from traffic. Its address is 100 + the last two serial digits. Read R320 (gas 1), R170 (state) and R210/R230 (relays) with FC 03; floats are high word first.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 320,
        "why": "Sensor 1 gas concentration"
      },
      {
        "table": "holding_register",
        "address": 330,
        "why": "Sensor 2 gas concentration"
      },
      {
        "table": "holding_register",
        "address": 170,
        "why": "System state"
      },
      {
        "table": "holding_register",
        "address": 210,
        "why": "Fan relay"
      },
      {
        "table": "holding_register",
        "address": 230,
        "why": "Alarm relay"
      },
      {
        "table": "holding_register",
        "address": 158,
        "why": "Sensor 1 remaining life"
      }
    ],
    "enable": "No setup needed: with Auto Protocol, Auto Baud and Auto Parity active (factory default) the TG adapts to the bus. Fix the settings via R122-R128 once the network is stable.",
    "watchdog": null,
    "quirks": [
      "Addresses are raw (R320 = address 320).",
      "Floats and UINT32 are big-endian, high word first.",
      "Writing R124 turns auto-baud off and cannot be undone remotely if the new rate is wrong."
    ],
    "setup": [
      "Default slave address = 100 + last two digits of the serial number.",
      "Auto baud 9600-115200; parity even/odd/none detected automatically."
    ],
    "gotchas": [
      "Writing 9699690 to R190 erases all configuration including the address.",
      "With Auto Reset Statistics on, every read of a min/max/average resets it."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
