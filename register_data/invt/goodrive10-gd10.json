  "integration": {
    "summary": "Set P00.01 = 2 so run commands come from Modbus, and P00.06 = 8 so the speed reference does too. Write the frequency to 2001H in 0.01 Hz and a run/stop code to 2000H, then poll 2100H, 2102H and 3000H-3004H.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 8192,
        "why": "Run / stop / fault reset command"
      },
      {
        "table": "holding_register",
        "address": 8193,
        "why": "Speed reference in 0.01 Hz"
