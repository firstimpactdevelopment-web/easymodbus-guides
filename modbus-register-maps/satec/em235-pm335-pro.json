{
 "manufacturer": "SATEC",
 "manufacturer_slug": "satec",
 "model": "EM235 / PM335 PRO advanced power meter",
 "model_slug": "em235-pm335-pro",
 "short_model": "EM235 / PM335 PRO",
 "aliases": [
  "EM235",
  "PM335 PRO",
  "PM335PRO",
  "SATEC EM235",
  "SATEC PM335"
 ],
 "equipment_type": "Power meter (revenue / power quality)",
 "applies_to": "SATEC EM235 and PM335 PRO advanced power meters, per Modbus reference guide BG0613 Rev. A8 (Sept 2025).",
 "summary": "The EM235 and PM335 PRO are SATEC revenue and power quality meters with RS-485, Ethernet and optional I/O. Their 32-bit register set carries 1-second phase and total values, demands and energy counters as integers, low word first. This map covers volts, amps, power, PF, THD, frequency, unbalance, present demands, energy totals, digital I/O, basic wiring/CT/PT setup, COM1 settings, password and clear commands.",
 "transport": [
  "RTU",
  "ASCII",
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "The guide numbers registers from 0 and says to add 40001 (or 400001 above 9999) to get Modicon holding-register numbers, so the printed address is the wire address: 13952 is requested as 13952 (Modicon 413953)."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "EM235/PM335 PRO Advanced Power Meter - Modbus Communications Protocol Reference Guide",
  "doc_number": "BG0613 Rev. A8",
  "revision_date": "2025-09",
  "url": "https://www.satec-global.com/wp-content/uploads/2025/09/EM235-PM335-PRO-Modbus-Guide.pdf",
  "pages": "Addressing p. 6, data formats pp. 7-8; 32-bit registers pp. 57-72; control/status pp. 137-141; setup pp. 145-151; data units p. 221; F26 wiring codes p. 237"
 },
 "notes": [
  "Addressing: the guide says to add 40001 to a register address to get the Modicon holding-register number (400001 above 9999), so printed addresses are 0-based wire addresses.",
  "Word order: 32-bit values are sent with the low-order word in the first (even) register and the high-order word in the second, so they are CDAB here.",
  "Units U1 (voltage) and U3 (power) depend on the PT ratio: with PT ratio = 1 they are 0.1 V and 0.001 kW/kvar/kVA (the scales used here); with PT ratio > 1 they become 1 V and 1 kW/kvar/kVA. U2 (current) is always 0.01 A.",
  "Function 04 can be used the same way as function 03.",
  "Energy registers use unit U5, set by 'number of energy decimal places' (46258, 0-3, default 0). The scale here (1 kWh/kvarh/kVAh) is for the default; with 1, 2 or 3 decimals use 0.1, 0.01 or 0.001.",
  "Rows marked DC-applicable in the guide also read on DC models.",
  "Left out: 16-bit scaled registers, 1/2-cycle, 0.2-second and 3-second values, low/high phase values, harmonics and interharmonics, IEEE 519 statistics, min/max logs, billing/TOU, setpoints, files and COM2-COM5 settings."
 ],
