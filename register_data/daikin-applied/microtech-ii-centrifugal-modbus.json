{
  "manufacturer": "Daikin Applied",
  "manufacturer_slug": "daikin-applied",
  "model": "MicroTech II centrifugal chillers WSC/WDC/WPV/WMC/WCC/HSC/HDC/TSC (Modbus module)",
  "model_slug": "microtech-ii-centrifugal-modbus",
  "short_model": "MicroTech II centrifugal",
