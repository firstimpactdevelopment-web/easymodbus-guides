{
 "manufacturer": "Datakom",
 "model": "DKG-705",
 "short_model": "DKG-705",
 "aliases": [
  "DKG 705",
  "DKG705"
 ],
 "equipment_type": "Generator controller",
 "applies_to": "Datakom DKG-705 AMF, parallel-to-mains and dual genset synchronization unit with J1939, Modbus application manual V-02-07 (14.04.2008).",
 "summary": "The DKG-705 is a Datakom genset controller for automatic mains failure, mains paralleling and dual-genset synchronization. Its Modbus RTU slave runs on the RS232 port (or RS422/485 via an external converter) and exposes mains and genset voltages, currents, frequencies, engine values, alarm and relay bit fields, J1939 engine data and a register for changing the operating mode. All data is read with function 03 and written one register at a time with function 06.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Register addresses are printed in hex and go straight into the request; the manual's example 01 03 00 20 00 10 reads 16 registers starting at 20h (32 decimal)."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "DKG-705 Modbus Application Manual",
  "doc_number": "V-02-07",
  "revision_date": "2008-04-14",
  "url": "https://www.datakom.com.tr/upload/Files/705_MODBUS.pdf",
  "pages": "Register definitions, pp. 5-13"
 },
 "notes": [
  "Word order: the manual states that for data longer than 16 bits the least significant register comes first, so the 32-bit engine-hours value is CDAB.",
  "Coefficients: the 'coefficient' column is the factor the value was multiplied by before storing (e.g. x10 oil pressure in bars), so scale here is 1/coefficient.",
  "Registers marked '8bit' carry their value in the low byte only; the high byte must be ignored.",
  "Left out: genset and mains active, reactive and apparent power and power factor. Active and reactive power use a sign-magnitude format (high 8 bits sign, low 24 bits value), PF is a signed byte, and the manual gives no power unit.",
  "Left out: the clock registers (BCD), charge input ratio and GOV/AVR output percentages (fractional encodings), synchroscope angle (sign-magnitude), J1939 temperatures (offset), the parameter block from 1000h and most J1939 warning slots.",
  "The source names phase sets R/S/T and U/V/W but does not say which is mains and which is genset."
 ],
