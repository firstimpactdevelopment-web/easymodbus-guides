 "integration": {
  "summary": "Read unit status and alarm coils, room/delivery temperature, humidity and operating mode; write the on/off coil and the cold/hot setpoints (x10).",
  "minimum_registers": [
   {
    "table": "coil",
    "address": 1,
    "why": "Unit status"
   },
   {
    "table": "coil",
    "address": 2,
    "why": "Alarm present"
   },
   {
    "table": "coil",
    "address": 8,
    "why": "On/off command"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Cold temperature setpoint"
   },
   {
    "table": "holding_register",
    "address": 6,
    "why": "Room temperature"
   },
   {
    "table": "holding_register",
    "address": 21,
    "why": "Ambient humidity"
   },
   {
    "table": "holding_register",
    "address": 142,
    "why": "Unit operating mode"
   },
   {
    "table": "holding_register",
    "address": 160,
    "why": "Active alarm code"
   }
  ],
  "enable": "Fit the Modbus serial board, then in the User menu (User password) set P30.01 Enable supervision = Y, P30.02 BMS address, P30.03 protocol = Modbus and P30.04 baud rate. Set P30.05 On/Off by BMS = Y so the on/off coil works.",
  "watchdog": null,
  "quirks": [
   "Numbering starts at 1: coil 002 is wire address 1 and register 40002 is wire address 1 (subtract 40001).",
   "Integer variables sit 128 registers above their software address."
  ],
  "setup": [
   "Up to 200 units on one network; polling time grows with the number of units.",
   "Line settings are fixed at 8 data bits, no parity, 2 stop bits."
  ],
  "gotchas": [
   "A probe in alarm reads -999 (-99.9 after scaling); a probe or parameter that is not configured reads -888."
  ]
 },
