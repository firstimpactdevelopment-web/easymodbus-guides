{
 "manufacturer": "Yaskawa",
 "manufacturer_slug": "yaskawa",
 "model": "Z1000U HVAC matrix drive (MEMOBUS/Modbus RTU)",
 "model_slug": "z1000u",
 "short_model": "Z1000U",
 "aliases": [
  "Z1000U HVAC MATRIX Drive",
  "Z1000U Matrix"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "Yaskawa Z1000U HVAC matrix drives using the built-in serial terminals with H5-08 = 0 (MEMOBUS/Modbus), per programming manual SIEP C710636 10D.",
 "summary": "Yaskawa's low-harmonic matrix drive for HVAC fans and pumps, with a built-in serial port that runs MEMOBUS/Modbus RTU, Metasys N2, APOGEE FLN or BACnet. Command registers (run bits, frequency reference, PID target, outputs) start at 0001H, status and monitor registers at 0020H, and parameters are reachable at their hex numbers. This map covers command and status words, key monitors, fault/alarm bits and the b1/H5 setup parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 31,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Register numbers are hex and sent unchanged: the manual's read example asks slave 2 for starting register 0020H as Starting No. 00H 20H. Parameters use the hex numbers in the parameter list (H5-01 = 0425H)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Z1000U HVAC MATRIX Drive Programming Manual",
  "doc_number": "SIEP C710636 10D",
  "revision_date": null,
  "url": "https://www.yaskawa.com/delegate/getAttachment?documentId=SIEPC71063610&cmd=documents&documentName=SIEPC71063610.pdf",
  "pages": "H5 parameter list p. 226, b1 list in Appendix A, B.4 H5 descriptions pp. 285-287, function codes and read example in B.5-B.7, B.9 MEMOBUS/Modbus data table pp. 295-300, Enter command section."
 },
 "notes": [
  "Frequency registers 0002H, 0023H and 0024H use the units chosen in o1-03, so they are left unscaled.",
  "Left out: analog/pulse output settings (0007H, 0008H, 000AH, 001BH-001DH), 0025H output voltage (unit switched by H5-10), 0026H output current (unit footnote varies), 0027H output power, 0028H/0032H torque reference, 002FH frequency reference bias, 003EH/003FH output frequency in r/min or 0.01 % (sign not stated), the U-monitor and fault-trace blocks from 0040H and 00ABH rated current.",
  "0031H is printed as Control Circuit Voltage (1 Vdc units) in this manual; it is kept with that name.",
  "The H5 parameter table prints H5-02's address as (426); it is listed here as 0426H, between the printed 0425H and 0427H.",
  "Only function codes 03H (read, max. 16 registers), 08H (loopback) and 10H (write multiple) are supported; use 10H for single writes.",
  "With H5-11 = 0 (default), parameter writes take effect only after the Enter command (0900H or 0910H). Command registers do not need Enter.",
  "Data length 8 bits and 1 stop bit are fixed. H5-02 = 8 (115.2 kbps) is not available when H5-08 = 0 (Modbus)."
 ],
