 "integration": {
  "summary": "Read holding registers 40035-40048 (address 34, 14 registers) in one FC03 request: faults, status, concentration, %FS, temperature and blanked readings, with floats low word first. Use subroutine 31 (with the alarm bits in 40003) to reset latched alarms.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 34,
    "why": "Fault bits"
   },
   {
    "table": "holding_register",
    "address": 35,
    "why": "Status bits (caution/warning/alarm/fault)"
   },
   {
    "table": "holding_register",
    "address": 42,
    "why": "Gas concentration (blanked)"
   },
   {
    "table": "holding_register",
    "address": 38,
    "why": "Concentration % full scale"
   },
   {
    "table": "holding_register",
    "address": 40,
    "why": "Temperature"
   },
   {
    "table": "holding_register",
    "address": 46,
    "why": "Loop current"
   }
  ],
  "enable": "Modbus is a factory-installed option. Set slave address on the transmitter at Menu > Setup > Modbus and baud/parity at Menu > Setup > System > Commun.",
  "watchdog": null,
  "quirks": [
   "Floats and longs are CDAB.",
   "FC01/02/04 return zeros rather than exceptions.",
   "Report Slave ID returns 1100."
  ],
  "setup": [
   "Defaults: address 1, 9600 baud, N,8,1.",
   "Baud can be 300-28.8k; parity options N81, N82, E81, O81."
  ],
  "gotchas": [
   "The transmitter answers within about 250 ms, so poll no faster than about 3 times a second.",
   "D12 units with IR sensors use a different register table."
  ]
 },
