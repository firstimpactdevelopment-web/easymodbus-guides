    "address": 20492,
    "why": "Current L1"
   },
   {
    "table": "input_register",
    "address": 20498,
    "why": "Total active power (kW)"
   },
   {
    "table": "input_register",
    "address": 20522,
    "why": "Total power factor"
   },
   {
    "table": "input_register",
    "address": 20488,
    "why": "Grid frequency"
   },
   {
