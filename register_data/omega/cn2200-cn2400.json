  "integration": {
    "summary": "Read PV, target setpoint and output as one 6-register block from 8002h (function 03), decode as ABCD floats, and write a new setpoint with function 16 to 8004h. Use 273 for auto/manual and 74 for alarm and sensor-break flags.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 32770,
        "why": "Process variable (float)"
      },
      {
        "table": "holding_register",
        "address": 32772,
        "why": "Target setpoint (float, write with FC16)"
      },
      {
        "table": "holding_register",
        "address": 32774,
        "why": "Output power (float)"
      },
      {
        "table": "holding_register",
        "address": 32778,
        "why": "Working setpoint (float, read only)"
      },
      {
        "table": "holding_register",
        "address": 273,
        "why": "Auto/manual"
      },
      {
        "table": "holding_register",
        "address": 74,
        "why": "Alarm and sensor-break flags"
      }
    ],
    "enable": "Comms hardware must be fitted: on the CN2400 the plug-in H module sets RS-232/422/485, while CN2200 comms is fixed when ordered. Set the slave address with Addr in the Cms list.",
    "watchdog": null,
    "quirks": [
      "Two address spaces: plain 16-bit (scaled by display resolution) and IEEE floats at 2 x address + 8000h.",
      "Function 06 is refused in the IEEE region; use function 16."
    ],
    "setup": [
      "Set the address in the Cms list (1-254) and match baud/parity on the master.",
      "RTU only, 8 data bits, 1 stop bit."
    ],
    "gotchas": [
      "Reading an unconfigured parameter returns an undefined value, not an exception.",
      "The handbook's manual-mode example selects manual (273 = 1) before changing output power at 3.",
      "Keep reads to 32 words on a CN2200 (125 on a CN2400)."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
