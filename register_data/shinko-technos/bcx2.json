{
  "manufacturer": "Shinko Technos",
  "manufacturer_slug": "shinko-technos",
  "model": "BCS2 / BCR2 / BCD2 digital indicating controller (C5, C5W options)",
  "model_slug": "bcx2",
  "short_model": "BCx2",
  "aliases": [
    "BCS2",
    "BCR2",
    "BCD2",
    "BCx2"
  ],
  "equipment_type": "Sensor (digital temperature controller)",
  "applies_to": "Shinko BCx2 series (BCS2, BCR2, BCD2) with the C5 or C5W communication option, standard (not JC-allocated) command set; manual No.BCx2CE6.",
  "summary": "The BCx2 series are PID temperature controllers sharing one command set. With the C5/C5W option they talk Shinko protocol, Modbus ASCII or Modbus RTU on RS485; every item is a 16-bit holding register. This map covers the setup and PID settings, SV memories, event outputs, heater burnout and loop break alarms, run modes, PV, MV, current SV, heater current and the status words.",
  "transport": [
    "RTU",
    "ASCII"
  ],
  "defaults": {
    "unit_id": 0,
    "baud": 9600,
    "parity": "Even",
    "data_bits": 7,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "hex 0-based",
    "note": "Registers are listed as hex data items (0001H) that go into the request unchanged. The manual adds that the matching Modicon holding-register number is the item in decimal plus 40001 (0001H = 40002)."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "Communication Instruction Manual BCD2, BCR2, BCS2 (C5W, C5)",
    "doc_number": "No.BCx2CE6",
    "revision_date": "2019-12",
    "url": "https://shinko-technos.co.jp/e/manual/english/BCx2CE6.pdf",
    "pages": "Section 7.1, pp. 26-33; communication settings pp. 4-5"
  },
  "notes": [
    "This map is for the standard 'MODBUS RTU' / 'MODBUS ASCII' protocol settings. The 'JC command allocated' protocol settings switch the unit to the older JC-series layout (section 7.2) and are not covered.",
    "All data are 16-bit; negatives are two's complement. Items marked 'decimal point ignored' are sent as whole numbers; apply the decimal point place (0005H).",
    "Read-only items from 0100H can be read with function 03 or 04.",
    "00E2H means control output ON/OFF, auto/manual, or program STOP/RUN depending on the OUT/OFF key function in 00E0H; in each case 0 is the first state (output ON / automatic / STOP) and 1 the second (output OFF / manual / RUN).",
    "The table lists SV1 at both 0001H and 000EH (followed by SV2-SV4 at 000FH-0011H).",
    "Left out: program-pattern settings (005EH-0077H), unit model and error status words, and section 8 SV digital transmission.",
    "Units of PID times, cycles and MV are not printed in the command table."
  ],
  "integration": {
    "summary": "In Engineering mode 1 choose MODBUS RTU, an 8-bit data format and a non-zero instrument number. Then poll PV 0100H, OUT1 MV 0101H and status flags 010DH/010EH; write SV1 at 0001H.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 256,
        "why": "Process value"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Set value SV1"
      },
      {
        "table": "holding_register",
        "address": 257,
        "why": "OUT1 manipulated value"
      },
      {
        "table": "holding_register",
        "address": 269,
        "why": "Output and alarm status"
      },
      {
        "table": "holding_register",
        "address": 270,
        "why": "Run mode status"
      },
      {
        "table": "holding_register",
        "address": 5,
        "why": "Decimal point for scaling"
      }
    ],
    "enable": "Requires the C5 or C5W option. Hold the up and down keys for 3 s in RUN mode to enter Engineering mode 1, then set Communication protocol to MODBUS RTU (not the JC command allocated variant), instrument number, speed, data bit/parity and stop bit.",
    "watchdog": null,
    "quirks": [
      "Factory data format is 7 bits/Even; Modbus RTU needs one of the 8-bit choices.",
      "Instrument number defaults to 0, the Modbus broadcast address; set 1-95.",
      "Response delay time (default 10 ms) adds to every reply."
    ],
    "setup": [
      "Factory defaults: Shinko protocol, instrument 0, 9600 bps, 7 bits/Even, 1 stop bit, response delay 10 ms.",
      "Speeds 9600, 19200 or 38400 bps."
    ],
    "gotchas": [
      "Writing 1234H to 00FEH returns every setting to factory default.",
      "Settings are stored in non-volatile memory; avoid cyclic writes."
    ]
  },
