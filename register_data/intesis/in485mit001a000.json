  "integration": {
    "summary": "Plug the supplied cable into CN105 on the Ecodan board, set SW1 position 5 ON for Modbus RTU, pick the baud on SW1 6-8 and the address on SW2 1-6, reboot, then read holding registers with function 03 (max 50 per request) and write one register at a time with 06.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 130,
        "why": "System on/off"
      },
      {
        "table": "holding_register",
        "address": 142,
        "why": "Heat/cool mode"
      },
      {
        "table": "holding_register",
        "address": 160,
        "why": "Zone 1 setpoint"
      },
      {
        "table": "holding_register",
        "address": 276,
        "why": "DHW setpoint"
      },
      {
        "table": "holding_register",
        "address": 180,
        "why": "Zone 1 reference temperature"
      },
      {
        "table": "holding_register",
        "address": 285,
        "why": "DHW tank temperature"
      },
      {
        "table": "holding_register",
        "address": 304,
        "why": "Outdoor temperature"
      },
      {
        "table": "holding_register",
        "address": 107,
        "why": "Error flag"
      },
      {
        "table": "holding_register",
        "address": 109,
        "why": "Ecodan error code"
      },
      {
        "table": "holding_register",
        "address": 119,
        "why": "Modbus control lock (keep 0)"
      }
    ],
    "enable": "SW1 position 5 ON selects Modbus RTU (factory default is BACnet MS/TP). Keep register 119 (Modbus control lock) at 0 or BMS commands are ignored.",
    "watchdog": null,
    "quirks": [
      "Function 16 is accepted only with a quantity of one register.",
      "At most 50 registers per read.",
      "Factory serial setting is 2400 baud, 8-N-2; 8-N-1 is detected automatically.",
      "Temperature scale and unit change with SW2 positions 7 and 8."
    ],
    "setup": [
      "SW1 5 = protocol (ON = Modbus RTU); SW1 6-8 = baud (all OFF = 2400 for Modbus).",
      "SW2 1-6 = Modbus address 1-63 (binary, position 1 = least significant); SW2 7 = x1/x10; SW2 8 = °C/°F.",
      "SW3 1 ON = 120 ohm termination; SW3 2-3 ON = bus biasing.",
      "Wire B-, A+ and SG; the gateway is powered from the Ecodan via the 1.5 m CN105 cable, which should not be lengthened.",
      "DIP changes take effect only after a gateway reboot (or write 1 to register 463)."
    ],
    "gotchas": [
      "Writing 1 to register 118 locks out the Ecodan's own remote control.",
      "Writing a room temperature to 181/256 switches on virtual temperature; the unit then follows the BMS value.",
      "In cooling, only control type 0 (flow temperature) is allowed, and only one zone may use room temperature control."
    ]
  },
  "verified": {
    "date": "2026-10-29",
    "method": "independent re-check of every register against the source PDF"
  }
}
