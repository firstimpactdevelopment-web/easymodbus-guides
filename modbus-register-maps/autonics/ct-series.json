  "convention": "Modicon",
  "note": "Each row prints a 6-digit reference (000001/100001/300001/400001 style) followed by the hex protocol address in brackets, e.g. 301004 (03EB); the bracketed hex value is the wire address."
 },
 "default_word_order": "CDAB",
 "firmware": null,
 "source": {
  "title": "User Manual for Communication - Counters/Timers CT Series",
  "doc_number": "MCC-CTC1-V1.3-EN",
