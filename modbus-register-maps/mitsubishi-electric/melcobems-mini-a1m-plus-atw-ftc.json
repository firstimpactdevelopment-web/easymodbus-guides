 "integration": {
  "summary": "Connect the A1M+ to the FTC controller as described in its installation instructions and to the BMS RS-485 line, then read 40014 to confirm an ATW system is detected and 40010 for faults. Switch the system with 40026, set the tank and zone targets at 40031/40055/40057, and poll flow, return, tank and room temperatures from 40094-40118.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 13,
    "why": "System type detected (1 = ATW)"
   },
   {
    "table": "holding_register",
    "address": 9,
    "why": "Fault code, 0x8000 = no error"
   },
   {
    "table": "holding_register",
    "address": 25,
    "why": "System on/off"
   },
   {
    "table": "holding_register",
    "address": 30,
    "why": "DHW tank setpoint"
   },
   {
    "table": "holding_register",
    "address": 54,
    "why": "Zone 1 thermostat target"
   },
   {
    "table": "holding_register",
    "address": 101,
    "why": "Flow temperature"
   },
   {
    "table": "holding_register",
    "address": 105,
    "why": "Tank water temperature"
   },
   {
    "table": "holding_register",
    "address": 93,
    "why": "Zone 1 room temperature"
   },
   {
    "table": "holding_register",
    "address": 99,
    "why": "Outdoor ambient temperature"
   },
   {
    "table": "holding_register",
    "address": 80,
    "why": "Heat source in use"
   }
  ],
  "enable": "No enable step is described in the register tables; the gateway answers once it is powered from the unit and its Modbus address, baud rate and parity (40005-40007) match the master. See the separate MelcoBEMS MINI installation instructions.",
  "watchdog": null,
  "quirks": [
   "Temperatures are x100 for most points but x10 for outdoor ambient (40100) and DHW temperature drop (40092).",
   "Each signed temperature has an unsigned twin one address higher for masters that cannot handle negative values.",
   "Baud-rate code 0 and code 4 both mean 9600 in the table.",
   "Holding registers support FC 03, FC 06 and FC 16; registers marked READ ONLY cannot be written."
  ],
  "setup": [
   "Set the Modbus address (1-247), baud rate and parity in 40005-40007 to match the BMS.",
   "Energy values (40283-40299) are reported as a kWh part plus a Wh part (x10 Wh); add them for the full reading."
  ],
  "gotchas": [
   "Value 0x6999 (hex register) or 6999 (decimal register) means the gateway cannot talk to the heat pump controller, not a heat pump fault.",
   "Operating mode register 40027 is not marked for FTC units; use the zone A/C mode registers 40029/40030 and DHW mode 40028 instead."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/mitsubishi-electric/melcobems-mini-a1m-plus-atw-ftc",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
