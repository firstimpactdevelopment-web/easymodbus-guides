  "integration": {
    "summary": "Read 400001-400039 for generator electrical values and 400059-400076 for engine data, then multiply the percentages by the ratings at 400105-400109 to get volts, amps and kW. Watch 400652 for genset state and 400653 for the master switch position.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 3,
        "why": "Generator L-L average voltage, % of rated"
      },
      {
        "table": "holding_register",
        "address": 11,
        "why": "Generator average current, % of rated"
      },
      {
        "table": "holding_register",
        "address": 12,
        "why": "Generator frequency"
      },
      {
        "table": "holding_register",
        "address": 16,
        "why": "Total real power, % of rated kW"
      },
      {
        "table": "holding_register",
        "address": 60,
        "why": "Engine speed"
      },
      {
        "table": "holding_register",
        "address": 61,
        "why": "Battery voltage"
      },
      {
        "table": "holding_register",
        "address": 651,
        "why": "Genset state"
      },
      {
        "table": "holding_register",
        "address": 652,
        "why": "Master switch position"
      }
    ],
    "enable": "Use Kohler SiteTech to set the Modbus address (1-247, unique per unit) and baud rate (9600, 19200, 38400 or 57600) on the controller.",
    "watchdog": null,
    "quirks": [
      "Electrical values are percent of rating, not engineering units.",
      "Counters use LW/HW register pairs (low word first).",
      "0xFFC0 in any register means unsupported in this application."
    ],
    "setup": [
      "Serial format is 8 data bits, no parity, 1 stop bit.",
      "Read 409999 = 49 to confirm the controller type."
    ],
    "gotchas": [
      "Maximum 50 registers per read and 16 per write; do not start a block read on an undefined register."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
