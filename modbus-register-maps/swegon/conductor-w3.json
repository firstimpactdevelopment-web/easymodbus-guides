 "integration": {
  "summary": "Read 3x0028-3x0030 (temperatures x10), 3x0022 (state) and 3x0055/3x0056 (damper positions); write 4x0002 for state and 4x0036-4x0043 for airflow levels. Temperature setpoints are not in this map because the manual gives no scaling for them.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 27,
    "why": "Regulator temperature sensor x10"
   },
   {
    "table": "input_register",
    "address": 28,
    "why": "Room unit 1 temperature x10"
   },
   {
    "table": "input_register",
    "address": 21,
    "why": "Application state"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Application transition"
   },
   {
    "table": "input_register",
    "address": 54,
    "why": "Supply air damper position"
   },
   {
    "table": "input_register",
    "address": 55,
    "why": "Extract air damper position"
   },
   {
    "table": "discrete_input",
    "address": 5,
    "why": "Active alarms"
   },
   {
    "table": "holding_register",
    "address": 35,
    "why": "Normal supply airflow level"
   }
  ],
  "quirks": [
   "Reference numbers use the 0x/1x/3x/4x prefix; subtract 1 inside each table.",
   "Application transition values 2, 3, 5 and 9 can only be read, not written."
  ],
  "enable": "Set the BMS address, baud, parity and stop bits in system parameters P_101-P_104 from the room unit (service level).",
  "watchdog": null,
  "setup": [
   "RS-485, Modbus RTU; the controller is a slave on the BMS bus.",
   "Changes to the BMS parameters are made from the CONDUCTOR room unit."
  ],
  "gotchas": [
   "Many values only matter in a given application state (manual, economy, boost, night cool); check 3x0022 before writing.",
   "Register numbering differs between the W1, W3 and W4 tables; use the table for the exact model and software."
  ]
 },
