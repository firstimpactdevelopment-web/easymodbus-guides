 "integration": {
  "summary": "Connect RS-485 to an active Modbus master and let the meter auto-detect the line, then read the float pairs at R600 (total kW), R700 (kWh), R420 (V) and R520 (A) with function 03.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 600,
    "why": "Total real power"
   },
   {
    "table": "holding_register",
    "address": 700,
    "why": "Total real energy"
   },
   {
    "table": "holding_register",
    "address": 420,
    "why": "Average voltage"
   },
   {
    "table": "holding_register",
    "address": 520,
    "why": "Average current"
   },
   {
    "table": "holding_register",
    "address": 550,
    "why": "Power factor"
   },
   {
    "table": "holding_register",
    "address": 410,
    "why": "Frequency"
   },
   {
    "table": "holding_register",
    "address": 400,
    "why": "System condition flags"
   }
  ],
  "enable": "Modbus is on by default (protocol Auto). Lock baud/parity/protocol with R122-R128 for permanent installations.",
  "watchdog": null,
  "quirks": [
   "Read and write both registers of a 32-bit value together.",
   "Units change with R163/R173/R133/R153; check them before scaling.",
   "The meter answers the global address 255 as well as its own address."
  ],
  "setup": [
   "Default address = 100 + last two digits of the serial number.",
   "Hold the Setup button while powering up to clear learned line settings."
  ],
  "gotchas": [
   "Writing a new baud rate cuts communication until the master matches it.",
   "On a mixed-baud network auto-detection is unpredictable; set the line settings manually."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/senva/em-rs485",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
