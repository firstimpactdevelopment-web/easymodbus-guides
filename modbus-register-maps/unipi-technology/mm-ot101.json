 "integration": {
  "summary": "In controller mode, clear coil 0, set the CH/DHW enable flags in the master status byte of register 0 and write the control setpoint to register 1 (f8.8), one register per write, repeated periodically. Read boiler status and temperatures from registers 0, 17, 25, 26 and 28.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Status flags (CH/DHW enable, flame, fault)"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Control setpoint"
   },
   {
    "table": "holding_register",
    "address": 17,
    "why": "Relative modulation level"
   },
   {
    "table": "holding_register",
    "address": 25,
    "why": "Boiler flow temperature"
   },
   {
    "table": "holding_register",
    "address": 28,
    "why": "Return water temperature"
   },
   {
    "table": "coil",
    "address": 0,
    "why": "Monitor / controller mode"
   }
  ],
  "enable": "Set address (1-7), baud (9600/19200) and parity with the internal DIP switch: switch 1 = baud (ON 19200), switch 2 = parity (ON even), switches 3-5 = address weights 4/2/1. The gateway starts in monitor mode after power-up.",
  "watchdog": null,
  "quirks": [
   "Registers 0-127 must be written one register at a time; multi-register writes work only for 1000 and up (memory only).",
   "f8.8 values: read as signed 16-bit and divide by 256.",
   "Direct reads to the boiler can take up to about 800 ms; set the master timeout accordingly."
  ],
  "setup": [
   "Default: address 1, 19200 baud, even parity.",
   "On some versions parity is fixed to even regardless of the switch.",
   "120-ohm termination is enabled with switch SW2."
  ],
  "gotchas": [
   "The gateway returns to monitor mode after power-up, so the controller must re-select controller mode.",
   "In controller mode the PLC must send commands to the boiler periodically."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/unipi-technology/mm-ot101",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
