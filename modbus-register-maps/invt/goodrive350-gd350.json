 "integration": {
  "summary": "Set P00.01 = 2 and P00.02 = 0 so run commands come from Modbus, and P00.06 = 8 so the speed reference does too. Write the frequency to 2001H in 0.01 Hz and a run/stop code to 2000H, then poll 2100H, 2102H and 3000H-3004H.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 8192,
    "why": "Run / stop / fault reset command"
   },
   {
    "table": "holding_register",
    "address": 8193,
    "why": "Speed reference in 0.01 Hz"
   },
   {
    "table": "holding_register",
    "address": 8448,
    "why": "Running / stopped / fault state"
   },
   {
    "table": "holding_register",
    "address": 8450,
    "why": "Active fault code"
   },
   {
    "table": "holding_register",
    "address": 12288,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 12292,
    "why": "Output current"
   },
   {
    "table": "holding_register",
    "address": 12290,
    "why": "DC bus voltage"
   }
  ],
  "enable": "P00.01 = 2 gives the run command to communication; P00.02 = 0 picks Modbus as that channel. P00.06 (A frequency source) = 8 makes 2001H the speed reference. P09.00 must select Modbus before 2002H/2003H act as PID reference/feedback. P14.00-P14.02 set address, baud and format.",
  "watchdog": "P14.04 sets a bus-silence timeout (0.0 s = off). When it runs out the drive raises CE (fault 18) and P14.05 decides whether it coasts, keeps running or stops with its stop mode.",
  "quirks": [
   "Parameter Pxx.yy sits at hex register (xx << 8) | yy: P14.01 = 0E01H, P07.27 = 071BH.",
   "Setting the top bit of a parameter address (for example 8007H for P00.07) writes RAM only and spares the EEPROM; those aliases cannot be read.",
   "Scaled values follow the decimals printed in the parameter list or address table (one decimal = x10, two decimals = x100), per the manual's fieldbus-scale section. Registers with a negative printed range are typed INT16 here."
  ],
  "setup": [
   "P14.00 slave address (default 1), P14.01 baud (default 4 = 19200 bps), P14.02 format (default 1 = E,8,1 RTU).",
   "Read with function 03H; write with 06H or 10H."
  ],
  "gotchas": [
   "Frequent parameter writes wear the EEPROM; use the RAM alias (address + 8000H) for values that change often.",
   "Some parameters cannot be changed while the drive runs; the drive answers with exception 08H."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/invt/goodrive350-gd350",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
