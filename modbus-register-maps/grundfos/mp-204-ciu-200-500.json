{
 "manufacturer": "Grundfos",
 "manufacturer_slug": "grundfos",
 "model": "MP 204 motor protector with CIU 200 / CIU 500 (Modbus)",
 "model_slug": "mp-204-ciu-200-500",
 "short_model": "MP 204 Modbus",
 "aliases": [
  "MP 204",
  "CIU 200 Modbus RTU",
  "CIU 250 GSM/GPRS",
  "CIU 500 Modbus TCP",
  "98393513"
 ],
 "equipment_type": "Pump motor protection relay",
 "applies_to": "Grundfos MP 204 electronic motor protector connected over GENIbus to a CIU 200 (Modbus RTU), CIU 250 (GSM/GPRS) or CIU 500 (Modbus TCP) box; functional profile 98393513 (2014-11).",
 "summary": "The MP 204 is Grundfos's electronic motor protector for single- and three-phase pump motors. A CIU communication box talks GENIbus to the MP 204 and presents it as a Modbus slave, with blocks for CIU settings, CIU status, one control register, protector status and measured data. The map covers start/stop and trip commands, alarm and warning codes, phase voltages and currents, power factor, power, energy, run hours, start counters and insulation resistance.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "1-based",
  "note": "Registers are printed as 5-digit register numbers; the telegram examples address register X as X-1 (ControlRegister 00101 is written at address 0x0064). The RegisterOffset register 00002 shifts every address above 00100 if it is changed from its default 0."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Modbus for MP 204 - CIU 200 Modbus RTU, CIU 250 GSM/GPRS, CIU 500 Ethernet for Modbus TCP - Functional profile and user manual",
  "doc_number": "98393513 1114",
  "revision_date": "2014-11",
  "url": "https://api.grundfos.com/literature/Grundfosliterature-6012935.pdf",
  "pages": "pp. 5-8 (RTU specs, DIP switches), 14-24 (function codes, register blocks), 30-33 (telegram examples)"
 },
 "notes": [
  "All registers can be read with function 03 or 04 (the same data is in both tables); they are listed here as holding registers. Control and configuration registers are written with 06 or 16.",
  "32-bit values are split into HI and LO registers with the HI (high-order) part at the lower address, so they are ABCD.",
  "A raw value of 65535 (0xFFFF) means 'not available'. Several values exist only for 1-phase or only for 3-phase motors, or need the optional sensors (Tempcon, Pt100).",
  "Motor temperatures are given in 0.01 K as printed; the manual does not say whether an offset of 273.15 applies, so no offset is set here.",
  "Left out: CIU 250-only registers (GSM real-time clock 00080-00097, GeneralStatus/PIN bits 00029, GSM battery 00033, NoDataActivityTimeout 00008, GSM signal and IP address 00236-00239) and the free user registers 00751-00800.",
  "Software-defined parity and stop-bit defaults (none / 1 stop bit) apply only in software-defined mode; the DIP-switch default is even parity, 1 stop bit."
 ],
