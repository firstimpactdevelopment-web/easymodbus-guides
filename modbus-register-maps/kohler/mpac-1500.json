 "aliases": [
  "MPAC 1500",
  "MPAC1500",
  "Kohler MPAC 1500 ATS"
 ],
 "equipment_type": "Transfer switch",
 "applies_to": "Kohler MPAC 1500 ATS controllers, Modbus RTU on main logic board RS-485 ports 1/2 or Modbus TCP on the Ethernet port, per section 13 of TP-6113.",
 "summary": "The MPAC 1500 is a Kohler automatic transfer switch controller. Its Modbus map gives normal (N) and emergency (E) source voltages and frequencies, load current, contactor position and source availability, transition mode, time-delay status, accessory and I/O states, transfer statistics and write-only test and manual-operation commands. This map covers the monitoring block, nominal ratings, transition mode, I/O and accessory status, maintenance counters and the command registers.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": null,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "This section prints 5-digit holding-register references starting at 40001, so 40001 is wire address 0 and 41350 is wire address 1349."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Modbus Communications Protocol Operation (generator set, transfer switch and power monitor controllers)",
  "doc_number": "TP-6113 12/21p",
  "revision_date": "2021-12",
  "url": "https://resources.kohler.com/power/kohler/industrial/pdf/tp6113.pdf",
  "pages": "Serial settings p. 15; functions and exceptions p. 17; MPAC 1500 setup pp. 214-215; register guide p. 216; registers pp. 217-226; device ID p. 232"
 },
 "notes": [
  "Serial port 1 defaults to Modbus address 1 and port 2 to address 2; Modbus TCP uses unit ID 3 from the factory.",
  "The 2-register maintenance counters (41300-41311) are stated as most significant word first, so they are ABCD. 41012-41013 (duration of last outage) is a 2-word value without a stated word order and is left out.",
  "40057 (transition mode) is in the guide's distributor-password group: the guide says to send the data register and the password (40058) in the same request. 40042 has its own password register at 40040. Calibration and factory settings also need the distributor-level password and are not listed.",
  "Left out: synchronizing settings, time delays and trip points (40059-40107), programmable I/O event-code assignments, expansion board states, accessory setup, exerciser, common alarms, customer strings, clock/DST registers, packed date fields and the event history."
 ],
