  "integration": {
    "summary": "Read the AC floats at PDU 100-107 or DC floats at PDU 500-507 with function 03; the x1000 int32 blocks suit masters without float support.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 100,
        "why": "AC voltage input 1"
      },
      {
        "table": "holding_register",
