{
 "manufacturer": "SATEC",
 "manufacturer_slug": "satec",
 "model": "BFM136/036 branch feeder monitor",
 "model_slug": "bfm136-036",
 "short_model": "BFM136",
 "aliases": [
  "BFM136",
  "BFM036",
  "BFM 136",
  "SATEC BFM136"
 ],
 "equipment_type": "Power meter (multi-circuit branch feeder monitor)",
 "applies_to": "SATEC BFM136 and BFM036 multi-circuit meters per Modbus reference guide BG0395 Rev. A8 (July 2024); per-submeter 32-bit measurement registers plus shared setup.",
 "summary": "The BFM136/036 measures up to 36 current channels grouped into submeters (12 three-phase submeters by default) on shared voltage inputs. Each submeter answers on its own Modbus address counted up from the device base address, and every submeter exposes the same register map. This map covers the 1-second phase, total and auxiliary values, present demands and energy totals in 32-bit integer form, plus wiring, CT/PT, COM1 and password setup.",
 "transport": [
  "RTU",
  "ASCII",
  "TCP"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "0-based",
  "note": "The guide numbers registers 0-65535 and says to add 40001 (or 400001 above 9999) to get the Modicon holding-register number, so printed addresses go straight into the frame: 13952 is wire address 13952 (Modicon 413953)."
 },
 "default_word_order": "CDAB",
 "firmware": "Exported kWh/kvarh and exported kW/kvar demands need firmware 18.5.1 or later",
 "source": {
  "title": "Branch Feeder Monitor BFM136/036 - MODBUS Communications Protocol Reference Guide",
  "doc_number": "BG0395 Rev. A8",
  "revision_date": "2024-07",
  "url": "https://www.satec-global.com/wp-content/uploads/2025/09/BFM136__036_MODBUS_Com_Guide.pdf",
  "pages": "Addressing and submeters pp. 6-7; data formats pp. 8-9; password p. 10; 32-bit values pp. 33-36; authorization register p. 46; basic setup p. 49; COM setup p. 52; password setup p. 54; units p. 71"
 },
 "notes": [
  "Each submeter has its own Modbus slave address: submeter 1 = device base address N, submeter 2 = N+1 and so on (up to 40 addresses). The factory base address is 1 and the device occupies addresses 1-12 (12 three-phase submeters). Read the measurement registers from each submeter's address.",
  "Setup registers are shared by all submeters and can be written through any submeter address, except the COM port setup, which only the base address accepts.",
  "32-bit values carry the low-order word in the first (even) register, so they are listed CDAB.",
  "Units U1 (voltage) and U3 (power) depend on PT ratio: with PT ratio 1 they are 0.1 V and 0.001 kW/kvar/kVA (the scales used here); with PT ratio above 1 they become 1 V and 1 kW/kvar/kVA. U2 (current) is always 0.01 A.",
  "Energy totals are in 0.1 kWh / 0.1 kvarh / 0.1 kVAh steps and roll over at the energy roll value set in the device options.",
  "Left out: 16-bit scaled registers (need per-site HI/LO arithmetic), 1-cycle values, phasors, min/max logs, maximum demands and the Billing/TOU tariff registers (the maximum-demand table repeats a 'V2' row label where V3 is expected), setpoints and file-transfer blocks.",
  "The guide's basic setup block (46208-46271) and demand setup block (46240-46255) overlap as printed; only basic setup offsets +0 to +17 are listed."
 ],
