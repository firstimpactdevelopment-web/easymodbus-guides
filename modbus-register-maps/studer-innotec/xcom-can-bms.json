 "integration": {
  "summary": "Fit an Xcom-485i on the Studer communication bus and poll it as a Modbus RTU slave. Each Studer device answers at its own unit ID (offset set by DIP switches 1-2); read infos with function 04 and parameters with 03, always 2 registers at a time, and decode as big-endian float.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "Battery voltage"
   },
   {
    "table": "input_register",
    "address": 2,
    "why": "Battery current"
   },
   {
    "table": "input_register",
    "address": 4,
    "why": "State of charge"
   },
   {
    "table": "input_register",
    "address": 6,
    "why": "Battery power"
   },
   {
    "table": "input_register",
    "address": 122,
    "why": "BMS charge voltage limit"
   },
   {
    "table": "input_register",
    "address": 126,
    "why": "BMS charge current limit"
   }
  ],
  "enable": "Install the Xcom-485i on the Studer bus. DIP switches 1-2 set the unit-ID offset (0, 32, 64 or 128) and switches 7-8 set the baud rate (9600, 19200, 38400 or 115200). Frames are 8 data bits, even parity, 1 stop bit.",
  "watchdog": null,
  "quirks": [
   "Unit 61 addresses the first Xcom-CAN BMS; multicast unit 60 reads the first such device and writes to all of them at once.",
   "Values are floats even for on/off and enumerated items: 1.0 = 0x3F800000."
  ],
  "setup": [
   "With DIP 1-2 off: unit 1 = Xcom-485i gateway, 2 = system, 10 = all Xtenders, 11-19 = single Xtenders, 20 = all VarioTracks, 21-35 = single VarioTracks, 40 = all VarioStrings, 41-55 = single VarioStrings, 60 = all BSP/Xcom-CAN BMS, 61 = the single BSP or Xcom-CAN BMS. Add the DIP offset to each.",
   "Single devices are numbered in the order shown on the RCC remote's device list.",
   "Allow up to 1 s for a reply and send one request at a time; the gateway is slower when the Studer bus is busy."
  ],
  "gotchas": [
   "Writing a parameter at its base register stores it in flash; cyclic writes should use base + 6000 (RAM only).",
   "Some parameters restart an internal timer or algorithm when changed while running.",
   "Parameter levels (Basic/Expert/Installer/QSP) are the RCC access levels printed in the appendix."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/studer-innotec/xcom-can-bms",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
