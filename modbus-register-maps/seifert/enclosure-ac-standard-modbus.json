 "integration": {
  "summary": "Poll holding registers 0-27 with function 03. Set bit 0 of register 4 to use network setpoints, then write the setpoints (tenths of a degree) to registers 0-3.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 12,
    "why": "Internal (control) temperature"
   },
   {
    "table": "holding_register",
    "address": 13,
    "why": "Operating state"
   },
   {
    "table": "holding_register",
    "address": 14,
    "why": "Alarm bits"
   },
   {
    "table": "holding_register",
    "address": 15,
    "why": "Output status"
   },
   {
    "table": "holding_register",
    "address": 16,
    "why": "Door contacts"
   },
   {
    "table": "holding_register",
    "address": 0,
    "why": "Network cooling setpoint"
   },
   {
    "table": "holding_register",
    "address": 4,
    "why": "Enable flags (network setpoints)"
   }
  ],
  "enable": "Write register 4 (SET_ENABLE_FLAGS) with bit 0 set using function 06 so the controller uses Modbus setpoints instead of its potentiometers (not available on Carel-controller units).",
  "watchdog": null,
  "quirks": [
   "Register 4 cannot be written with function 16 (write multiple); use function 06.",
   "Setting any undocumented bit in register 4 returns exception 03."
  ],
  "setup": [
   "Defaults: unit address 1, 19200 baud, 8 data bits, even parity, 1 stop bit.",
   "To change the address write 0x0ADD to register 40, then the new address within 10 seconds."
  ],
  "gotchas": [
   "Switching the temperature unit changes every temperature register; set it before writing setpoints."
  ]
 },
