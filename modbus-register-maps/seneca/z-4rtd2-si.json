 "integration": {
  "summary": "Read holding registers 1-13 (function 03): error flags, four scaled integers and four floats. Check the burnout and out-of-range bits in register 1 before trusting a value.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 1,
    "why": "Error / burnout flags"
   },
   {
    "table": "holding_register",
    "address": 6,
    "why": "Channel 1 float"
   },
   {
    "table": "holding_register",
    "address": 8,
