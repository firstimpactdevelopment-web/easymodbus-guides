{
 "manufacturer": "Rishabh Instruments",
 "manufacturer_slug": "rishabh-instruments",
 "model": "RISH Delta VAF NX volt/amp/frequency panel meter",
 "model_slug": "rish-delta-vaf-nx",
 "short_model": "Delta VAF NX",
 "aliases": [
  "RISH Delta VAF NX",
  "Delta VAF NX",
  "RISH Delta VAF"
 ],
 "equipment_type": "Power meter",
 "applies_to": "Rishabh RISH Delta VAF NX programmable panel meters with RS-485 Modbus RTU, per operating manual AMAN-00IM-0118 Rev. F.",
 "summary": "The RISH Delta VAF NX is a 96 x 96 mm panel meter that shows voltage, current, power factor and frequency on 1-phase and 3-phase networks, with an RS-485 Modbus RTU port. Every value is an IEEE 754 float in two registers: measurements are input registers (FC04) from 30001, mirrored as holding registers at 40001+, and setup parameters sit at 46003-46085. This map covers the measured values, run/on hours and the setup block.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "The manual prints 3X/4X register numbers. Wire address = number - 30001 (FC04) or - 40001 (FC03/FC16): the Volts 3 example (30005) starts at 00 04 and the system-type example (46003) starts at 17 72 (6002)."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Operating Manual RISH Delta VAF NX",
  "doc_number": "AMAN-00IM-0118 Rev. F",
  "revision_date": "2025-02",
  "url": "https://rishabh.co.in/uploads/product/rish-delta-vaf-nx-77/O%20M%20RISH_Delta_VAF_NXl_REV_F.pdf",
  "pages": "pp. 23-25 (data format, examples, Table 3 3X registers), pp. 28-32 (4X examples, Table 4, explanations, Table 5 RS485 set-up code)"
 },
 "notes": [
  "The data-format table states IEEE 754 floats, most significant byte first; the Volts 3 example returns 43 5B 41 21 (219.25 V), so ABCD is the default. 46049 can switch to reversed order.",
  "Every 3X value can also be read with FC03 at the number plus 10000; only the 3X copies are listed (the manual misprints the 4X copy of 30225 as 402254).",
  "The register table has no unit column, so units are left blank.",
  "Left out: 30243 (printed with the same name as 30231), the min/max history from 31301 and the user-assignable registers (35201-35239).",
  "Up to 40 parameters (80 registers) per read request."
 ],
