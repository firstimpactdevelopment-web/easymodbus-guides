 "integration": {
  "summary": "Set P9.02 to an RTU mode, P3.00 to serial operation and P4.00 = 5 for serial frequency source, then write speed (P9.26, x10) and run (P9.27). Monitor Status Monitor 1/2 and output frequency at 2100h-2103h.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 2330,
    "why": "Speed reference"
   },
   {
    "table": "holding_register",
    "address": 2331,
    "why": "Run/stop"
   },
   {
    "table": "holding_register",
    "address": 2332,
    "why": "Direction"
   },
   {
    "table": "holding_register",
    "address": 8448,
    "why": "Fault code"
   },
   {
    "table": "holding_register",
    "address": 8449,
    "why": "Run state bits"
   },
   {
    "table": "holding_register",
    "address": 8451,
    "why": "Output frequency"
   }
  ],
  "enable": "Set P3.00 (source of operation) to 3 or 4 and P4.00 (source of frequency) to 5 for serial control, as referenced in Status Monitor 2; set P9.00-P9.02 for address, baud and protocol from the keypad.",
  "watchdog": "P9.04 enables communication time-out detection, P9.05 sets the time (0.1-60.0 s) and P9.03 selects the reaction (keep running, ramp stop, coast stop).",
  "quirks": [
   "Factory protocol is Modbus ASCII, not RTU.",
   "Speed reference has an implied decimal: write 600 for 60.0 Hz.",
   "Hex addresses are wire addresses: 091Ah = 2330 decimal = 42331 Modicon."
  ],
  "setup": [
   "P9.00 address 1-254, P9.01 baud code (the setup example uses 01 = 9600 baud), P9.02 protocol/format.",
   "Writes to P0-P8 parameters can be grouped through the block transfer parameters P9.11 onward."
  ],
  "gotchas": [
   "Some faults only show in Status Monitor 1 after a hard trip; warnings may not appear there."
  ]
 },
