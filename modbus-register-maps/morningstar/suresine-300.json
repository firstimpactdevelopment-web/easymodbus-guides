 "applies_to": "Morningstar SureSine-300 (115 V and 220 V versions) via the MSC MeterBus adapter; Modbus specification V03 (29 Oct 2008).",
 "summary": "The SureSine-300 is a Morningstar sine-wave inverter (115 V and 220 V versions). Through its RJ-11 meter port and Morningstar's MSC adapter it speaks Modbus RTU: battery voltage, heatsink temperature, fault/alarm bits, load state and nominal output settings in RAM, a remote-off and reset register, and EEPROM custom disconnect/reconnect voltages.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 2,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "The spec says all listed addresses are request-PDU addresses, so the hex value in the PDU column goes on the wire unchanged (logical address = PDU + 1)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "SureSine-300 Modbus Specification",
  "doc_number": "V03",
  "revision_date": "2008-10-29",
  "url": "https://www.morningstarcorp.com/wp-content/uploads/technical-doc-suresine-modbus-specification-en.pdf",
  "pages": "p. 2 (parameters), pp. 3-4 (RAM and EEPROM tables), pp. 5-8 (definitions)"
 },
 "notes": [
  "Voltage scaling is n x 16.92 x 2^-16 (V03 corrected this from 2^-15), converted to the multiplier 16.92/65536.",
  "Left out: AC output current 0x0001/0x0005, because its scale depends on the version (full scale 6.4 A on 220 V units, 17 A on 115/127 V units: n x 6.4 or 17 x 2^-15). Also the raw thermistor and remote-on voltages (no scaling given), the hourmeter 0xE040 and serial number 0xE044-0xE047 (size and word order not stated).",
  "The parameters page still says 'TriStar' (copied text); the defaults it gives (9600 8N2, ID 1) are for the SureSine.",
  "The definitions section repeats several addresses (e.g. hertz and volts both 0x000D, EEPROM entries shifted by one, with LVD warning timer 2 described as a voltage); the register tables are followed here.",
  "Any EEPROM write sets an 'EEPROM changed' fault until the inverter is reset; writes are not verified. FC 0x03/0x04 read, FC 0x06 writes."
 ],
 "integration": {
  "summary": "Via the MSC adapter at 9600 8N2, ID 1, read 0x0000-0x000E: battery voltage (x 16.92/65536), heatsink temperature, faults, alarms and load state. Write a non-zero value to 0x000F to switch the AC output off remotely.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 4,
    "why": "Battery voltage"
   },
   {
    "table": "holding_register",
    "address": 11,
    "why": "Load state"
   },
   {
    "table": "holding_register",
    "address": 7,
    "why": "Faults"
   },
   {
    "table": "holding_register",
    "address": 8,
    "why": "Alarms"
   },
   {
    "table": "holding_register",
    "address": 6,
    "why": "Heatsink temperature"
   },
   {
    "table": "holding_register",
    "address": 15,
    "why": "Remote AC off"
   }
  ],
  "enable": "No enable step; connect a Morningstar MSC MeterBus-to-RS-232 adapter to the meter port.",
  "watchdog": null,
  "quirks": [
   "The disconnect state (load state 5) is only entered through the meter or the m_disconnect register.",
   "Output voltage and frequency registers show the nominal setting, not live measurements."
  ],
  "setup": [
   "Serial: 9600 baud, 8 data bits, no parity, 2 stop bits, no flow control."
  ],
  "gotchas": [
   "Reset the inverter after EEPROM writes to clear the settings-edit fault."
  ]
 },
