 "integration": {
  "summary": "Read input registers (FC04) from offset 0: platform 1 mass is a big-endian float at offset 0 and its status bits at offset 5. To zero or tare, write the matching bit to the Command register at offset 500, then clear it before the next use.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "Platform 1 mass"
   },
   {
    "table": "input_register",
    "address": 5,
    "why": "Platform 1 status (stable, zero, errors)"
   },
   {
    "table": "input_register",
    "address": 4,
    "why": "Displayed unit"
   },
   {
    "table": "input_register",
    "address": 2,
    "why": "Platform 1 tare"
   },
   {
    "table": "holding_register",
    "address": 500,
    "why": "Zero / tare / print command bits"
   }
  ],
  "enable": "Turn Modbus on in the indicator menu under SETUP / Peripherals / Modbus; settings are described in the indicator software manual.",
  "watchdog": null,
  "quirks": [
   "Commands act on the rising edge of a bit: write 0 before writing the same bit again.",
   "Parameter commands: write the value register(s) and the 'Command with parameter' bit, using FC16."
  ],
  "setup": [
   "Modbus communication is configured under SETUP / Peripherals / Modbus; the indicator software manual covers the individual settings.",
   "RS-485 is not available on the PUE C32."
  ],
  "gotchas": [
   "Platform 2 registers only answer on the PUE HX7.",
   "The manual's write examples mix two numbering styles (40000 + offset and Modicon); go by the offset column."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/radwag/pue-c32-hx7-hx5ex",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
