{
 "manufacturer": "Hitachi",
 "manufacturer_slug": "hitachi",
 "model": "SJ700-2 series inverter (Modbus RTU)",
 "model_slug": "sj700-2",
 "short_model": "SJ700-2",
 "aliases": [
  "SJ700",
  "SJ700-2",
  "SJ700 series"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "Hitachi SJ700-2 series inverters using the built-in RS485 port (TM2) in Modbus-RTU mode (C079), per instruction manual NT204DX.",
 "summary": "The SJ700-2 is Hitachi's general-purpose sensorless-vector inverter with a built-in RS485 port that speaks Hitachi ASCII or Modbus RTU. Commands and status flags are coils, the frequency reference and monitors are holding registers, and 32-bit values are split into high and low registers. This map covers the run and terminal coils, status coils, frequency command, key d-monitors and accel/decel times.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": 8,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "1-based",
  "note": "Coil and register numbers are printed in hex (0001h). The manual says the starting number in a request is 1 less than the coil or register number, e.g. reading coils from 0007h sends 00 06. So wire address = printed number - 1."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Hitachi Inverter SJ700-2 Series Instruction Manual",
  "doc_number": "NT204DX",
  "revision_date": "2009-02",
  "url": "https://www.hitachi-iesa.com/sites/default/files/support/inverter/docs/NT204DX_1.pdf",
  "pages": "4-114 (comm specs), 4-131 to 4-139 (Modbus function examples), 4-140 to 4-145 (coil and register lists)"
 },
 "notes": [
  "32-bit values are two registers labelled (high) then (low), so ABCD.",
  "The trip-monitoring block 0010h-004Eh (trip counter, six trip records, programming error code) is documented but not included in this map.",
  "Inverter status A (0003h) is left out because its value list is cut off in the table, and cumulative RUN time (1015h) because its 0.1 resolution has no unit printed.",
  "Cumulative power (1013h) is listed raw with 0.1 resolution as printed; the manual gives the value as input power divided by the b079 display gain, so no fixed unit is assigned.",
  "Function-mode parameter registers (1201h and up) are documented in the manual but not listed here.",
  "Communication error coils 004Ah-004Eh stay set until an error reset.",
  "Coil 0013h is left out: the table names it RUN (running) but its setting column reads 1 = tripping, 0 = normal.",
  "Coil 0049h (data writing in progress) is left out: the Enter-command note points to coil 001Ah for that flag, while the coil table puts OTQ at 001Ah and data writing at 0049h."
 ],
