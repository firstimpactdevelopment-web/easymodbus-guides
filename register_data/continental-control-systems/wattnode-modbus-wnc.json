  "integration": {
    "summary": "Set the address and baud on the DIP switches, set CtAmps (1603), then read floats from 1001-1034 (documented numbers; wire 1000-1033) in one request, decoding each pair low word first.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 1000,
        "why": "EnergySum (kWh)"
      },
      {
        "table": "holding_register",
        "address": 1008,
        "why": "PowerSum (W)"
      },
      {
        "table": "holding_register",
        "address": 1016,
        "why": "Average L-N voltage"
      },
      {
        "table": "holding_register",
        "address": 1162,
        "why": "Current phase A"
      },
      {
        "table": "holding_register",
        "address": 1138,
        "why": "Average power factor"
      },
      {
        "table": "holding_register",
        "address": 1032,
        "why": "Frequency"
      },
      {
        "table": "holding_register",
        "address": 1602,
        "why": "CtAmps (must match the CTs)"
      }
    ],
    "enable": "Modbus RTU on RS-485 is always on. Address and baud come from the DIP switches unless overridden at 1652-1656 (write 1234 to 1651 to apply).",
    "watchdog": null,
    "quirks": [
      "32-bit values are low word first (CDAB).",
      "Documented numbers are one-based; subtract 1 on the wire.",
      "Float energy loses resolution above 100,000 kWh; the integer energy registers keep 0.1 kWh."
    ],
    "setup": [
      "Default 9600 baud (DIP switch 8 down), N81.",
