 "integration": {
  "summary": "Read holding registers 3-4 and 29-42 for temperature, water activity, ppm and relative saturation (CDAB floats). Set the oil type first so ppm is meaningful.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 34,
    "why": "Water content ppm"
   },
   {
    "table": "holding_register",
    "address": 28,
    "why": "Water activity"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Oil temperature"
   },
   {
    "table": "holding_register",
    "address": 512,
    "why": "Error status"
   },
   {
    "table": "holding_register",
    "address": 770,
    "why": "Oil type"
   }
  ],
  "enable": "Order the transmitter with the Modbus configuration option, or set the serial mode to MODBUS with the SMODE serial command (applied at the next power-up).",
  "watchdog": null,
  "quirks": [
   "Floats are low word first (CDAB); pick \"word-swapped\" float in masters that default to high word first.",
   "Read or write each 32-bit value in one transaction."
  ],
  "setup": [
   "Defaults: address 240, 19200 baud, no parity, 8 data bits; stop bits are 1 or 2 depending on the ordered configuration (check register 1539).",
   "Change Modbus serial settings with Insight, the Indigo80 or registers 1537-1540; give each device on a shared bus a unique address (1-247)."
  ],
  "gotchas": [
   "Use the test registers (7937 on) to confirm float format and addressing before trusting readings."
  ]
 },
