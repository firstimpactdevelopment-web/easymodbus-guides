    "unit_id": null,
    "baud": null,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "Modicon",
    "note": "This section prints 5-digit holding-register references starting at 40001, so 40001 is wire address 0 and 41350 is wire address 1349."
  },
  "default_word_order": "ABCD",
  "firmware": null,
  "source": {
    "title": "Modbus Communications Protocol Operation (generator set, transfer switch and power monitor controllers)",
    "doc_number": "TP-6113 12/21p",
    "revision_date": "2021-12",
    "url": "https://resources.kohler.com/power/kohler/industrial/pdf/tp6113.pdf",
    "pages": "Serial settings p. 15; functions and exceptions p. 17; MPAC 1000 setup pp. 201-202; register guide and registers pp. 203-209"
  },
  "notes": [
    "The MPAC 1000 map has no load-current registers; 40016-40021 are reserved.",
    "The 2-register maintenance counters (41300-41311) are stated as most significant word first, so they are ABCD. 41012-41013 (duration of last outage) has no stated word order and is left out.",
    "Left out: time delays and trip points (40032-40064), output/input event-code assignments, software-controlled RDOs, I/O module status words, accessory setup, exerciser, common alarms, customer strings, clock/DST registers, packed date fields and the event history."
  ],
