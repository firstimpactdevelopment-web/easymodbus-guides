  "manufacturer": "Belimo",
  "manufacturer_slug": "belimo",
  "model": "Thermal Energy Meter (TEM) DN 15-50, Version 4 (Modbus RTU / TCP)",
  "model_slug": "thermal-energy-meter-v4",
  "short_model": "Belimo TEM V4",
  "aliases": [
    "22PE-1U",
    "22PEM-1UC",
    "22PE..-1U..",
    "22PF",
    "Belimo Thermal Energy Meter",
    "Belimo TEM"
  ],
  "equipment_type": "Energy meter (thermal / BTU meter)",
  "applies_to": "Belimo Thermal Energy Meter DN 15...50 version 4 (22PE..-1U.., 22PF-..U..), interface description V4.2.0 edition 2025-11.",
  "summary": "Ultrasonic thermal energy (BTU) meter with flow and two temperature sensors, readable over Modbus RTU or Modbus TCP. One flat register table carries flow, supply/return temperatures, delta T, glycol, heating and cooling power and energy, volume, nominal values, unit selection and a health bitmask.",
  "transport": [
    "RTU",
    "TCP"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 38400,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 2,
    "tcp_port": null
  },
  "addressing": {
    "convention": "1-based",
    "note": "Belimo lists 'No.' (from 1) and 'Address' (from 0) for each register; 'documented' is the No. column, so No. 8 is wire address 7. All data sit in one table, reachable with FC03 reads and FC06/FC16 writes; FC04 and FC02 also work as alternatives."
  },
  "default_word_order": "CDAB",
  "firmware": null,
  "source": {
    "title": "Modbus Interface Description - Thermal Energy Meter (TEM), DN 15...50 (Version 4)",
    "doc_number": "V4.2.0, EN 2025-11/B",
    "revision_date": "2025-11",
    "url": "https://www.belimo.com/mam/general-documents/system_integration/Modbus/belimo_Modbus-Register_TEM_V4_2_en-gb.pdf",
    "pages": "p. 3 (comm settings), p. 4 (data types, 32-bit LSW first), pp. 5-7 (overview), pp. 8-15 (descriptions)"
  },
  "notes": [
    "Word order: the manual says 32-bit values use two consecutive registers with the least significant word first (register No. x = low word, x+1 = high word); both must be written together with FC16. Mapped as CDAB.",
    "Values are unsigned unless marked signed; the signed ones are the sensor 1 temperature and temperature 1/2 registers. Unsupported registers read 65535.",
    "Left out: flow, power, volume and nominal-flow/power registers 'in selected unit' (Nos. 10/11, 32/33, 38/39, 64/65, 113/114, 164/165), because the printed scale applies to several units at once and does not map cleanly to every unit choice. Energy in selected unit (70/71, 76/77) is listed since its scale is 1 for every unit.",
    "The power-cooling-in-selected-unit row is printed as 'No. 32, Address 30' in the description table but 'No. 32, Address 31' in the overview; it is omitted anyway.",
    "Registers above No. 100 that are writable are stored permanently; do not write them cyclically.",
    "The PDF was downloaded for checking from a distributor mirror (zotsupply.com) that carries the same edition; the link above is Belimo's own copy."
  ],
