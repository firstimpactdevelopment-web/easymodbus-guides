{
 "manufacturer": "Rishabh Instruments",
 "manufacturer_slug": "rishabh-instruments",
 "model": "RISH EM DC 6000 programmable DC energy meter",
 "model_slug": "rish-em-dc-6000",
 "short_model": "EM DC 6000",
 "aliases": [
  "RISH EM DC 6000",
  "EMDC 6000",
  "EM DC6000"
 ],
 "equipment_type": "Energy meter (DC)",
 "applies_to": "Rishabh RISH EM DC 6000 single-channel programmable DC energy meters with RS-485 Modbus, per interface definition DMAN-00IM-0862 Rev. 0 (12/2020).",
 "summary": "The RISH EM DC 6000 is a programmable single-channel DC energy meter with relay outputs, a real-time clock and data logging. Modbus RTU on RS-485 delivers every value as a 32-bit float. This map covers voltage, current, power, import/export energy and ampere-hours, demands, min/max values, relay and timer status, the clock, and the main communication and scaling settings.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": null,
  "parity": null,
  "data_bits": 8,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "The manual prints 30001/40001-style addresses next to the hex start address actually sent (30001 = 0x0000). Wire address = printed number - 30001 (input registers) or - 40001 (holding registers); every value here was cross-checked against the printed hex address."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "RISH EM DC 6000 - Interface Definition",
  "doc_number": "DMAN-00IM-0862 Rev. 0",
  "revision_date": "2020-12",
  "url": "https://rishabh.co.in/uploads/product/single-channel-dc-energy-meter-rish-emdc-6000-123/ID-EMDC%206000.pdf",
  "pages": "pp. 6-8 (protocol, example frames), pp. 9-10 (Table 1), pp. 14-17 (Table 3), p. 19 (word order)"
 },
 "notes": [
  "Measured values are IEEE-754 32-bit floats in two registers. The manual's example responses (e.g. data bytes 43 5B 41 21 for a current reading) put the most significant register first, so ABCD is the default order.",
  "Register 40073 (Word Order) can switch the meter to reversed register order; the manual says to write 2141.0 to it and the meter detects which order was used. If floats look wrong, check this setting.",
  "Rows whose printed hex address does not match the decimal 3X/4X address in the manual were left out rather than guessed.",
  "Left out: the 32-bit integer energy tables (their integer word order is not demonstrated in the manual), user-assignable registers and data-log blocks.",
  "Where the register table has no unit column, units are left blank; energy registers follow the energy unit (Wh/kWh/MWh) configured on the meter, and 'OF' / overflow registers count roll-overs of the matching energy register.",
  "The manual's 4X copies of measured values start at 44097 (hex 0x1000), not at 40001; this map lists the 3X addresses only.",
  "Units are only given where the example frames show them (V, A, W); energy follows the Energy Output setting (40061)."
 ],
 "integration": {
  "summary": "Read measured values with FC04 (or FC03 at the 4X copies) in pairs of registers and decode them as ABCD floats. Settings are floats too and are written with FC16.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "DC voltage"
   },
   {
    "table": "input_register",
    "address": 2,
    "why": "DC current"
   },
   {
    "table": "input_register",
    "address": 4,
    "why": "DC power"
   },
   {
    "table": "input_register",
    "address": 6,
    "why": "Import energy"
   },
   {
    "table": "input_register",
    "address": 10,
    "why": "Export energy"
   },
   {
    "table": "input_register",
    "address": 90,
    "why": "Relay 1 status"
   }
  ],
  "enable": "Modbus RTU on RS-485 is built in; set the slave address, baud rate and parity from the meter's setup menu or the RS-485 setup register.",
  "watchdog": null,
  "quirks": [
   "Each parameter is two registers; reading or writing only half of a float returns an Illegal Data Address exception.",
   "Addresses are Modicon-style: subtract 30001 or 40001 for the wire address.",
   "Limit each read to 40 parameters (80 registers) or less."
  ],
  "setup": [
   "Slave address range 1-247; broadcast (address 0) is not supported.",
   "Allow about 200 ms for the meter to answer before retrying."
  ],
  "gotchas": [
   "If a password lock is set, write the valid password to the Password register before changing any 4X setting; a wrong password returns exception code 2."
  ]
 },
