 "integration": {
  "summary": "Set H5-08 = 0, H5-01..H5-03 at the keypad and power-cycle; set b1-01 = 2 and b1-02 = 2 to take reference and run from Modbus. Write 0001h/0002h together with function 10h and poll 0020h-002Dh plus 0042h-0046h.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 1,
    "why": "Run/stop, direction, reset"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Frequency reference"
   },
   {
    "table": "holding_register",
    "address": 32,
    "why": "Run/ready/fault"
   },
   {
    "table": "holding_register",
    "address": 33,
    "why": "Fault summary"
   },
   {
    "table": "holding_register",
    "address": 44,
    "why": "Status incl. comm timeout"
   },
   {
    "table": "holding_register",
    "address": 65,
    "why": "Output frequency"
   },
   {
    "table": "holding_register",
    "address": 66,
    "why": "Output current"
   },
   {
    "table": "holding_register",
    "address": 128,
    "why": "Current fault code"
   }
  ],
  "enable": "H5-08 = 0 selects Memobus/Modbus (1 = Metasys N2, 2 = APOGEE FLN). Set H5-01 (default 1Fh), H5-02 (default 3 = 9600) and H5-03 (default none) and cycle power. b1-01 = 2 and b1-02 = 2 hand reference and run to serial communications.",
  "watchdog": "H5-05 = 1 (default) enables CE detection after H5-09 (default 2.0 s); H5-04 sets the reaction: 0 ramp, 1 coast, 2 fast-stop, 3 alarm only (default), 4 run at d1-04. 002Ch bit F flags a comm timeout.",
  "quirks": [
   "Registers and the slave address are hex.",
   "Function codes 03h, 06h, 08h and 10h; the parameter manual allows 1-8 registers per read.",
   "Serial parameter writes go to RAM; write 0 to 0900h (ENTER) to keep them over power loss (100,000 write limit). Run-locked parameters need 0910h (ACCEPT).",
   "Network multi-function inputs are ORed with the terminals."
  ],
  "setup": [
   "RS-485: jumper S+ to R+ and S- to R-; up to 31 drives.",
   "Slave address 1-20h (1-32), default 1Fh; 0 is broadcast.",
   "8 data bits, 1 stop bit; 1200-19200 baud."
  ],
  "gotchas": [
   "H5-08 must be 0; an E7 left on N2 or FLN will not answer Modbus.",
   "Fault trace values are not stored for CPF00/CPF01/CPF03, UV1 and UV2."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/yaskawa/e7",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
