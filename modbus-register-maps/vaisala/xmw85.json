 "integration": {
  "summary": "Read holding registers 1-6 in one request for CO2, RH and temperature (CDAB floats), or 257-259 as integers (RH and T x10).",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "CO2 ppm"
   },
   {
    "table": "holding_register",
    "address": 2,
    "why": "Relative humidity"
   },
   {
    "table": "holding_register",
    "address": 4,
    "why": "Temperature"
   },
   {
    "table": "holding_register",
    "address": 512,
    "why": "Device status"
   }
  ],
  "enable": "Set the Modbus address, bit rate and parity with the DIP switches before power-up.",
  "watchdog": null,
  "quirks": [
   "Floats are low word first (CDAB); pick \"word-swapped\" float in masters that default to high word first.",
   "Read each 32-bit value in one transaction."
  ],
  "setup": [
   "Address (1-247), bit rate (4800, 9600, 19200, 38400 or 57600; 76800 and 115200 are not supported) and parity (None or Even) are set with DIP switches; the guide gives no factory default.",
   "1 and 2 stop bits are both accepted automatically.",
   "Up to 8 transmitters per RS-485 line; turn on the 120 ohm termination DIP switch only on the last device if the bus has no other terminator."
  ],
  "gotchas": [
   "Use test registers 7937 (reads -12345) and 7938 (reads -123.45) to confirm float format and addressing before trusting readings."
  ]
 },
