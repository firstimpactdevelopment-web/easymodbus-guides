  "integration": {
    "summary": "Set the slave address on SW1, wire DB/DA/GND, then write H0001-H0005 for setpoint, fan, mode, louvre and on/off and poll I0020-I0035 for group status. Use the update registers to decide whether the wall controller stays usable.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 5,
        "why": "Group on/off"
      },
      {
        "table": "holding_register",
        "address": 3,
        "why": "Mode"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Setpoint"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Fan speed"
      },
      {
        "table": "input_register",
        "address": 23,
        "why": "Average return air"
      },
      {
        "table": "input_register",
        "address": 21,
        "why": "Any unit faulted"
      },
      {
        "table": "input_register",
        "address": 22,
        "why": "Fault code"
      },
      {
        "table": "input_register",
        "address": 20,
        "why": "Units found"
      }
    ],
    "enable": "No enable step: holding-register writes act on the group straight away. The update registers (H0010-H0015) choose Last Touch (default), Central (locks keypad buttons), Local or On Change behaviour.",
    "watchdog": "Optional, set by a SW1 DIP switch: if no holding-register write arrives for 120 s all units are switched on with their current settings, and remote controllers are either unlocked or left as they are depending on the switch.",
    "quirks": [
      "Temperatures above 32767 are negative: subtract 65536, then divide by 100.",
      "In Last Touch mode a master that rewrites the same value every scan overrides the wall controller; use On Change (3) if your master writes cyclically.",
      "Coil and per-unit thermo readings exist only when the RTD is the P1/P2 MAIN controller."
    ],
    "setup": [
      "9600 baud, no parity, 1 stop bit by default (other rates available on request from the maker).",
      "Slave address 0..63 on SW1.",
      "Daisy-chain DB(+), DA(-) and GND; no star or ring wiring; up to 500 m without repeaters.",
      "Power 15-24 V DC from the indoor unit PCB (X18A/X35A) or a separate supply."
    ],
    "gotchas": [
      "Infra-red BRC receivers must be set to SUB when the RTD is MAIN.",
      "If the P1/P2 bus is not found within 1 minute the RTD raises an alarm on its fault output."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
