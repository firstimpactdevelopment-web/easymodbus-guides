 "integration": {
  "summary": "Read input registers 0000h-0005h (function 04 or 03) for volts, amps and watts, and 0010h-0027h for energy and Ah; decode INT32 low word first and apply the fixed weights (V and W x10, A x1000, kWh and Ah x10).",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "DC voltage"
   },
   {
    "table": "input_register",
    "address": 2,
    "why": "DC current"
   },
   {
    "table": "input_register",
    "address": 4,
    "why": "DC power"
   },
   {
    "table": "input_register",
    "address": 16,
    "why": "Imported energy total"
   },
   {
    "table": "input_register",
    "address": 32,
    "why": "Exported energy total"
   },
   {
    "table": "holding_register",
    "address": 20498,
    "why": "Device state / over-range flags"
   }
  ],
  "enable": "Modbus RTU is always on. Set address, baud, parity and stop bits at 2000h-2003h, then write 1 to 2010h to apply them.",
  "watchdog": null,
  "quirks": [
   "32-bit values are low word first (CDAB).",
   "Energy totals carry 0.1 kWh resolution; run hours are in 1/100 h.",
   "On certified (signed) versions the total-energy reset is blocked."
  ],
  "setup": [
   "Defaults: address 1, 9600 baud, no parity, 1 stop bit, 20 ms reply delay.",
   "Terminate both bus ends with 120 ohm; above 1000 m or 160 devices add a repeater."
  ],
  "gotchas": [
   "New serial settings only take effect after writing 1 to 2010h.",
   "Max answer time is about 160 ms; retry 2-3 times before declaring the meter offline."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/carlo-gavazzi/dct1",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
