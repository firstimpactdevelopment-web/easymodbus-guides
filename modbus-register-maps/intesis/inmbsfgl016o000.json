{
 "manufacturer": "Intesis (HMS Networks)",
 "manufacturer_slug": "intesis",
 "model": "INMBSFGL016O000 Fujitsu VRF to Modbus RTU / TCP gateway (up to 16 indoor units)",
 "model_slug": "inmbsfgl016o000",
 "short_model": "INMBSFGL016O000 Fujitsu VRF",
 "aliases": [
  "INMBSFGL016O000",
  "FJ-AC-MBS-16",
  "Intesis Modbus Server Fujitsu VRF"
 ],
 "equipment_type": "VRF / split AC gateway",
 "applies_to": "Intesis Modbus Server - Fujitsu VRF, order code INMBSFGL016O000 (legacy FJ-AC-MBS-16), user manual r1.0 (02/2020); up to 16 indoor units configured in MAPS.",
 "summary": "Multi-unit Modbus server that joins a Fujitsu VRF network and exposes every configured indoor unit as its own 100-register block, plus outdoor-unit status blocks and 'all units' broadcast commands. Modbus RTU and Modbus TCP run at the same time. The map lists the first indoor unit and the first outdoor unit; other units follow a fixed formula.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "0-based",
  "note": "The manual states the formula results are link-layer addresses with the first register at 0, so the printed numbers go on the wire unchanged. Indoor unit with MAPS ID n (0..31) uses (n+1) x 100 + offset; outdoor unit ID n uses (n+1) x 25 + 10000 + offset. This file lists ID 0 (indoor 100..124, outdoor 10025..10028)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Intesis Modbus Server - Fujitsu VRF User Manual",
  "doc_number": "User Manual r1.0 EN",
  "revision_date": "2020-02",
  "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-inmbsfgl016o000.pdf",
  "pages": "pp. 8-11 (Modbus interface and address map)"
 },
 "notes": [
  "Only indoor unit ID 0 and outdoor unit ID 0 are listed. For indoor ID n add n x 100 to the listed indoor address (ID 1 on/off = 200); for outdoor ID n add n x 25 (ID 1 error = 10052).",
  "The ID is the 'ID' field of the Fujitsu VRF configuration in MAPS (0..31), not the Fujitsu refrigerant address.",
  "Temperatures are tenths of a degree in °C or °F depending on the temperature scale chosen in MAPS; °C is shown here.",
  "Fan-speed register 102 has two value sets depending on whether the indoor unit has 4 or 6 speeds, so no single enum is given.",
  "The manual prints register 124 as '0 = Thermo OFF, 1 = Thermo ON'; it is copied as printed.",
  "The Fujitsu error code list is in the manual; not reproduced here."
 ],
