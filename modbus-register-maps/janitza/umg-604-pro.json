 "integration": {
  "summary": "Read holding registers (function 03) from 19000: 60 registers give volts, amps, power, CosPhi, frequency and per-phase energy as big-endian floats; 19060-19077 adds the three-phase and delivered energy totals in Wh. Over Ethernet use Modbus TCP; over RS-485 use RTU at the device's address.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 19000,
    "why": "Voltage L1-N"
   },
   {
    "table": "holding_register",
    "address": 19012,
    "why": "Current L1"
   },
   {
    "table": "holding_register",
    "address": 19026,
    "why": "Total real power"
   },
   {
    "table": "holding_register",
    "address": 19034,
    "why": "Total apparent power"
   },
   {
    "table": "holding_register",
    "address": 1373,
    "why": "Total power factor"
   },
   {
    "table": "holding_register",
    "address": 19050,
    "why": "Frequency"
   },
   {
    "table": "holding_register",
    "address": 9851,
    "why": "Consumed energy total"
   },
   {
    "table": "holding_register",
    "address": 19076,
    "why": "Delivered energy total"
   }
  ],
  "enable": "The 604-PRO answers Modbus on Ethernet and, as a slave, on RS-485. Set the Modbus address, baud rate and IP settings on the device or in GridVis (see the device manual).",
  "watchdog": null,
  "quirks": [
   "Addresses are used as printed (0-based).",
   "Floats are ABCD (high word first). Add 32768 to an address for little-endian.",
   "Energy is in Wh and varh, not kWh.",
   "Rotation field (19052) is a float: 1, 0 or -1."
  ],
  "setup": [
   "RS-485: 8 data bits, no parity, 2 stop bits on the device's own port; baud 9.6, 19.2, 38.4, 57.6, 115.2 or 921.6 kbps.",
   "Set CT/VT ratios first so the floats read in primary units.",
   "Writing 1 to 9997 clears real/apparent energy; 9998 clears reactive energy."
  ],
  "gotchas": [
   "The 'rate 1' consumed row in the 19000 block (19068) is tariff 1 only; use 9851 for the full consumed total.",
   "Short-format values elsewhere in the list skip the transformer ratios; do not mix them with the float values."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/janitza/umg-604-pro",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
