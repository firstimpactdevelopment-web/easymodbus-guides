  "integration": {
    "summary": "Read the loop values with function 03 as CDAB floats: process value at 164 (loop 1), active setpoint at 238, controller output at 184; add 150 per further loop. Analog inputs start at register 0.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 164,
        "why": "Loop 1 process value"
      },
      {
        "table": "holding_register",
        "address": 238,
        "why": "Loop 1 active setpoint"
      },
      {
        "table": "holding_register",
        "address": 184,
        "why": "Loop 1 PID output"
      },
      {
        "table": "holding_register",
        "address": 170,
        "why": "Loop 1 control deviation"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Analog input 1"
      }
    ],
    "enable": "Fit the RS-485 (or RS-232) interface module and set the station address and line settings on the controller; addresses 1-255 are allowed, 0 is broadcast.",
    "watchdog": null,
    "quirks": [
      "REAL values are low word first (even register = low word).",
      "Always read or write both registers of a REAL together.",
      "Function 04 behaves like 03 and 02 like 01."
    ],
    "setup": [
      "RS-485: up to 32 stations, cable under 1200 m, stubs under 0.3 m, electrically isolated; RS-232 for a single PC up to 10 m."
    ],
    "gotchas": [
      "Gaps in the register table (e.g. 60-69, 78-79) are unassigned."
    ]
  },
