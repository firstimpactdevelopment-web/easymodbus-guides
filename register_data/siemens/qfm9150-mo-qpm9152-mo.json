    "enable": "DIP2 switch 7 OFF (default) lets the master configure address, baud and format via registers 764-768; ON uses the DIP switches (DIP1 = address, DIP2 = baud/parity/stop).",
    "watchdog": null,
    "quirks": [
      "Register number minus 1 = wire address.",
      "The temperature register follows the unit chosen in register 401 (°C or °F).",
      "Address 246 is reserved for Climatix on-event addressing."
    ],
    "setup": [
      "Bus termination is a jumper (OFF by default).",
      "A push-button hold of 10-13 s resets address, baud and format to factory defaults."
    ],
    "gotchas": [
      "If an invalid address is set by DIP switch, new values for registers 764-768 are not applied."
    ]
  },
