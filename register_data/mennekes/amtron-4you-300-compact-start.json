  "integration": {
    "summary": "Every 10 s or faster, write 0x55AA to 0x0D00 (heartbeat); write 1 to 0x0D05 (release) and the current limit as a float to 0x0302 with function 16. Read 0x0100 (EVSE state), 0x0E00 (error), 0x0512 (power) and 0x0B02 (session energy).",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 3328,
        "why": "Heartbeat from the energy manager"
      },
      {
        "table": "holding_register",
        "address": 3333,
        "why": "Charging release"
      },
      {
        "table": "holding_register",
        "address": 770,
        "why": "Charging current limit"
      },
      {
        "table": "holding_register",
        "address": 256,
        "why": "EVSE state"
      },
      {
        "table": "holding_register",
        "address": 3584,
        "why": "Active error code"
      },
      {
        "table": "holding_register",
        "address": 1298,
        "why": "Total charging power"
      },
      {
        "table": "holding_register",
        "address": 2818,
        "why": "Session energy"
      },
      {
        "table": "holding_register",
        "address": 3332,
        "why": "1- or 3-phase request"
      }
    ],
    "enable": "Set DIP switches S1-4 and S1-5 to ON and reboot; the wallbox then runs as a Modbus satellite at address 50 (10-50 can be set with the MENNEKES configuration tool).",
    "watchdog": "The energy manager must write 0x55AA to 0x0D00 at least every 10 s. What happens when it stops depends on 0x030E: 0 keeps charging with the last values received, 1 pauses charging, 6-32 charges at that fallback current. With no fallback active and no EV connected, the wallbox goes to error state (code 200 = energy manager not available); 0x0E01 shows when the fallback is active.",
    "quirks": [
      "0x0302 = 0 means unlimited, not stop; to pause, write a value between 0.01 and 5.99 A.",
      "Floats and uint32 values need function 16 for writes; function 6 is only for single-register values.",
      "Requested Phases (0x0D04) is ignored unless 0x030C reads 2 (phase-switch capable hardware, 11 kW models)."
    ],
    "setup": [
      "RS-485: Modbus A = +, B = -.",
      "Default 57600 baud, 8 data bits, no parity, 2 stop bits; other rates from 9600 to 57600 baud and 8E1 / 8O1 framing can be chosen with the MENNEKES configuration tool."
    ],
    "gotchas": [
      "After a reboot or communication error the wallbox needs 0x0D00, 0x0D05 and 0x0302 written again before it returns to idle and charges.",
      "MENNEKES recommends changing the current no faster than every 5 s and avoiding frequent pauses; some EVs (e.g. Fiat 500e) need the current set to 0 before a phase change."
    ]
  },
