{
 "manufacturer": "Janitza",
 "manufacturer_slug": "janitza",
 "model": "UMG 96RM power analyser (basic device, RS-485 Modbus RTU)",
 "model_slug": "umg-96rm",
 "short_model": "UMG 96RM",
 "aliases": [
  "UMG96RM",
  "UMG 96 RM",
  "UMG 96RM-P",
  "UMG 96RM-CBM",
  "UMG 96RM-PN",
  "Janitza UMG96RM"
 ],
 "equipment_type": "Power meter (power analyser)",
 "applies_to": "UMG 96RM basic device from firmware release 1.14, per address list 1.040.034.t; the same list covers the shared registers of the -P, -CBM and -PN extensions. Other UMG 96RM variants (e.g. the Ethernet -E / -EL) are not covered by this list.",
 "summary": "The UMG 96RM is Janitza's power analyser. The basic device has an RS-485 port running Modbus RTU; measurements are published as big-endian 32-bit IEEE floats (with fixed-resolution short and integer copies elsewhere in the list), and a 'frequently required readings' block at 19000-19120 holds volts, amps, power, power factor, frequency and energy. This map covers that block, total and per-phase power factor and the main communication, transformer and reset parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 115200,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "Addresses are printed as the protocol address and are used unchanged in the request: 19000 is requested as address 19000 (0x4A38). The list itself starts at address 0 (device address parameter), which only makes sense as a 0-based address. In a 1-based or Modicon tool, enter 19001 / 419001."
 },
 "default_word_order": "ABCD",
 "firmware": "From firmware release 1.14",
 "source": {
  "title": "Power Analyser UMG 96 RM - Basic device, Extension UMG 96RM-PN, UMG 96RM-P, UMG 96RM-CBM - Modbus-address list and Formulary (from firmware rel. 1.14)",
  "doc_number": "1.040.034.t",
  "revision_date": "2023-01",
  "url": "https://www.janitza.com/files/download/manuals/current/UMG96RM/Basic/janitza-mal-umg96rm-en.pdf",
  "pages": "Functions p. 4; transfer parameters, byte order, number formats p. 5; parameters pp. 14-16; frequently required readings p. 17; measured values float p. 18"
 },
 "notes": [
  "Byte order: the listed addresses return data big-endian (high byte first, and for 32-bit values the high word in the lower register = ABCD). Adding 32768 to any address returns the same value little-endian; that alternate block is not listed here.",
  "Float vs integer: the main measurements are FLOAT (IEEE 754, 2 registers). Most values also exist as SHORT registers (e.g. 3526-3935) with a fixed resolution per row (V x0.1, PF x0.01, current in mA), and energy exists as 32-bit INT counters (5448+). Those blocks are left out: the SHORT rows use fixed per-row resolutions, and the list states that the integer energy values do not include the CT/VT ratios. Use the float block.",
  "The list contradicts itself on integer energy: the general notes say float and integer values include the transformer ratios, but the integer energy table says its values do not. Another reason to use the float block.",
  "Data types in the list: SHORT = signed 16-bit, INT = signed 32-bit, UINT = unsigned 32-bit, FLOAT = 32-bit IEEE 754.",
  "Left out: 19068, printed as 'Real energy L1..L3, consumed, rate 1' with index [1] while all neighbouring energy rows are index [0], so it is unclear whether it is the consumed total or tariff 1 only. Use 19060 (L1..L3 total) and 19076 (delivered), or the per-phase consumed rows.",
  "Left out: per-phase inductive and capacitive reactive energy (19094-19098, 19102-19106) to keep the map short; they follow the same pattern.",
  "Transfer parameters conflict: p. 5 says the UMG 96RM uses 2 stop bits with no parity, while parameter 3 defaults to 0 = 1 stop bit, no parity. Check parameter 3 on the device; default stop bits are left blank.",
  "Supported functions: 03, 04, 06, 16 and 23 (read/write multiple). The list names the measured values as 4X holding registers; function 04 is also accepted.",
  "Registers refresh every 200 ms.",
  "Parameter 508 (write to EEPROM) exists but the list does not say when it is required; it is not listed."
 ],
 "integration": {
  "summary": "Read holding registers (function 03) from address 19000: a 60-register block (19000-19059) returns all volts, amps, power, CosPhi and frequency as big-endian floats, and 19060-19077 adds total and delivered real energy in Wh. The short values (and, per the energy table, the integer energy counters) leave out the CT/VT ratios, so use the floats.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 19000,
    "why": "Voltage L1-N"
   },
   {
    "table": "holding_register",
    "address": 19012,
    "why": "Current L1"
   },
   {
    "table": "holding_register",
    "address": 19026,
    "why": "Total real power"
   },
   {
    "table": "holding_register",
    "address": 19034,
    "why": "Total apparent power"
   },
   {
    "table": "holding_register",
    "address": 834,
    "why": "Total power factor"
   },
   {
    "table": "holding_register",
    "address": 19050,
    "why": "Frequency"
   },
   {
    "table": "holding_register",
    "address": 19060,
    "why": "Real energy total"
   },
   {
    "table": "holding_register",
    "address": 19076,
    "why": "Real energy delivered"
   }
  ],
  "enable": "The basic device talks Modbus RTU on its RS-485 port. Set the device address (parameter 0), baud rate (parameter 1) and stop bits/parity (parameter 3) from the front buttons or over Modbus.",
  "watchdog": null,
  "quirks": [
   "Addresses are used as printed (0-based); 19000 is wire address 19000.",
   "Floats are big-endian, high word first (ABCD). Add 32768 to an address to get the same value little-endian.",
   "Energy is in Wh, power in W and var - not kWh/kW.",
   "Rotation field (19052) is a float: 1, 0 or -1."
  ],
  "setup": [
   "Defaults: address 1, 115.2 kbps, 8 data bits, no parity. Baud choices 9600-115200.",
   "Set CT/VT ratios (parameters 10-32) so the float values read in primary units.",
   "Writing 1 to 507 clears all energy counters; 506 clears min/max values."
  ],
  "gotchas": [
   "The default 115.2 kbps is faster than most BMS masters default to; match it or lower it on the meter.",
   "The SHORT and INT blocks look tempting but use fixed resolutions or skip the transformer ratios; mixing them with float values gives wrong readings.",
   "This list covers the basic device and its -P, -CBM and -PN extensions only; for other UMG 96RM variants (e.g. the Ethernet -E) check the model and its own documentation first."
  ]
 },
