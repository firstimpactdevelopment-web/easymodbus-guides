  "integration": {
    "summary": "Read D2001-D2013 in one block for errors, PV, SP, output and alarms; write the target setpoint to D2101 (loop 2: D2151) and switch AUTO/MAN, RUN/STOP and REMOTE/LOCAL with D2301, D2304 and D2306.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 2002,
        "why": "Loop-1 PV (D2003)"
      },
      {
        "table": "holding_register",
        "address": 2003,
        "why": "Loop-1 control setpoint (D2004)"
      },
      {
        "table": "holding_register",
        "address": 2004,
        "why": "Loop-1 output (D2005)"
      },
      {
        "table": "holding_register",
        "address": 2007,
        "why": "Operation mode status (D2008)"
      },
      {
        "table": "holding_register",
        "address": 2010,
        "why": "Loop-1 alarm status (D2011)"
      },
      {
        "table": "holding_register",
        "address": 2100,
        "why": "Loop-1 target setpoint (D2101)"
      },
      {
        "table": "holding_register",
        "address": 2300,
        "why": "AUTO/MAN (D2301)"
      },
      {
        "table": "holding_register",
        "address": 2303,
        "why": "RUN/STOP (D2304)"
      }
    ],
    "enable": "Set the communication setup parameters (protocol MBRTU or MBASC, baud, parity, stop bits, data length, address) on the keypad. Ethernet models use Modbus/TCP on port 502 by default.",
    "watchdog": null,
    "quirks": [
      "Address D register n at wire address n-1 (D2101 = 0834H).",
      "Write values without the decimal point (50.0 with one decimal place = 500).",
      "To take the setpoint from communication, put the loop in REMOTE (D2306 = 1) with the remote source set to communication, then write D2331."
    ],
    "setup": [
      "Factory defaults: Modbus RTU, 19200 bps, even parity, 1 stop bit, 8 data bits, address 1."
    ],
    "gotchas": [
      "Available registers depend on the suffix code (single/dual loop, options) and parameter settings; blank addresses must not be read or written."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
