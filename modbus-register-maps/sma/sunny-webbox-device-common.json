 "equipment_type": "Solar inverter (via Sunny WebBox gateway)",
 "applies_to": "SMA devices reached through a Sunny WebBox (fw 1.52+) on unit IDs 3-247 whose family uses the common address set; SB n000US and SB nn000TL-US-12 families use their own tables instead.",
 "summary": "The register set the Sunny WebBox offers for each connected SMA device on its own unit ID (3-247). It covers serial number, event number, power limits, energy and runtime counters, DC input, AC power, line voltages, current, frequency, reactive/apparent power and internal temperatures.",
 "transport": [
  "TCP"
 ],
