{
 "manufacturer": "Shinko Technos",
 "manufacturer_slug": "shinko-technos",
 "model": "ACD-13A / ACR-13A / ACD-15A / ACR-15A digital indicating controller (C, C5 options)",
 "model_slug": "acd-acr-13a-15a",
 "short_model": "ACD/ACR-13A",
 "aliases": [
  "ACD-13A",
  "ACR-13A",
  "ACD-15A",
  "ACR-15A"
 ],
 "equipment_type": "Sensor (digital temperature controller)",
 "applies_to": "Shinko ACD/ACR-13A (PID) and ACD/ACR-15A (valve positioning) with the C or C5 communication option; manual No.ACDR1CE8.",
 "summary": "The ACD/ACR-13A are PID temperature controllers and the ACD/ACR-15A are valve-positioning versions with open/close outputs and a feedback potentiometer input. With the serial option they speak Shinko protocol, Modbus ASCII or Modbus RTU. The map covers SV and alarm values for memory 1, PID zone 1, input, output and event settings, run/manual control, PV, MV, current SV and status flags.",
 "transport": [
  "RTU",
  "ASCII"
 ],
 "defaults": {
  "unit_id": 0,
  "baud": 9600,
  "parity": "Even",
  "data_bits": 7,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Registers are listed as hex data items (0001H) that go into the request unchanged. The manual adds that the matching Modicon holding-register number is the item in decimal plus 40001 (0001H = 40002)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Communication Instruction Manual ACD/R-13A, ACD/R-15A (C, C5)",
  "doc_number": "No. ACDR1CE8",
  "revision_date": "2020-03",
  "url": "https://shinko-technos.co.jp/e/manual/english/ACDR1CE8.pdf",
  "pages": "Section 7, pp. 12-14 and 17-18; communication settings p. 3"
 },
 "notes": [
  "All data are 16-bit two's complement; items marked 'decimal point ignored' are whole numbers, so apply the decimal point place (0033H).",
  "Items marked 13A or 15A apply only to that model type, per the manual's tags.",
  "Left out: event output allocations and later settings on pp. 14-16, CT current and remaining read items on p. 19, program steps and PID zones 2-5 (separate command tables on pp. 19-21).",
  "SV memory 1 values at 0001H-000BH are shared with program step 1.",
  "Input type changes take about 2 s to answer; set the master timeout to 2 s or more."
 ],
 "integration": {
  "summary": "Select MODBUS RTU in the Communication group, use an 8-bit data format and a non-zero instrument number, then read PV 0A00H, MV 0A01H and status 0A06H/0A07H; write SV at 0001H.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 2560,
    "why": "Process value"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Set value (memory 1)"
   },
   {
    "table": "holding_register",
    "address": 2561,
    "why": "Output MV"
   },
   {
    "table": "holding_register",
    "address": 2566,
    "why": "Output and alarm status"
   },
   {
    "table": "holding_register",
    "address": 209,
    "why": "Control output OFF or program RUN/STOP"
   },
   {
    "table": "holding_register",
    "address": 51,
    "why": "Decimal point for scaling"
   }
  ],
  "enable": "Requires the C or C5 option. From the PV/SV display step through the Engineering and Input groups to the Communication group (key sequence on p. 3), then set Communication protocol to MODBUS RTU, instrument number, speed, data bit/parity and stop bit.",
  "watchdog": null,
  "quirks": [
   "Factory format is 7 bits/Even, suited to Shinko protocol; Modbus RTU needs an 8-bit choice.",
   "Instrument number defaults to 0, the Modbus broadcast address; set 1-95."
  ],
  "setup": [
   "Factory defaults: Shinko protocol, instrument 0, 9600 bps, 7 bits/Even, 1 stop bit.",
   "Speeds 9600, 19200, 38400 bps."
  ],
  "gotchas": [
   "Key lock set to Prohibited (00D4H) reverts to Allowed after a power cycle."
  ]
 },
