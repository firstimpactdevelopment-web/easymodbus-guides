{
 "manufacturer": "Fuji Electric",
 "manufacturer_slug": "fuji-electric",
 "model": "FRENIC-HVAC / FRENIC-AQUA inverters (RS-485 Modbus RTU)",
 "model_slug": "frenic-hvac-aqua",
 "short_model": "FRENIC-HVAC / AQUA",
 "aliases": [
  "FRENIC-HVAC",
  "FRENIC-AQUA",
  "FRN-AR",
  "FRN-AQ"
 ],
 "equipment_type": "Variable frequency drive (HVAC / pump)",
 "applies_to": "Fuji Electric FRENIC-HVAC (AR) and FRENIC-AQUA (AQ) inverters on the RS-485 port in Modbus RTU mode (y10 = 0); RS-485 Communication User's Manual 24A7-E-0021b.",
 "summary": "FRENIC-HVAC and FRENIC-AQUA drives for fans and pumps speak Modbus RTU on their RS-485 port. Every function code (F, E, H, y, S, M ...) is a holding register found by a fixed group/number rule; the S codes carry frequency, run and PID commands and the M codes carry monitors, status words and alarm history. This map lists the communication command and monitor codes and the link settings.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": 8,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "parameter-derived",
  "note": "Each function code is a holding register at 40000 + group code x 256 + number (manual Table 3.2: F=0, E=1, H=4, S=7, M=8, y=14). In the frame the high byte is the group code and the low byte the number, so the wire address is group x 256 + number; the manual's examples send 08 06 for M06 and 07 01 for S01."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "RS-485 Communication User's Manual (FRENIC-HVAC / FRENIC-AQUA)",
  "doc_number": "24A7-E-0021b",
  "revision_date": null,
  "url": "https://americas.fujielectric.com/files/24A7-E-0021b.pdf",
  "pages": "pp. 2-19 to 2-22 (H30, y codes), 3-4 to 3-5 (address rule, Table 3.2), 3-12 (examples), 5-2 to 5-15 (S and M codes), 5-66 to 5-67 (data formats 14-16)"
 },
 "notes": [
  "All function code data are single 16-bit words; no 32-bit values are used in this map.",
  "Per-unit values (S01, S12, S13, M01, M06, M68, M72, M73) use +/-20000 = 100 % or maximum frequency; convert with the drive's maximum frequency (F03).",
  "M09 output frequency is unsigned over Modbus RTU (0.00-655.35 Hz); the signed range in the table applies to the Fuji general-purpose inverter protocol.",
  "Codes marked not supported on HVAC/AQUA in the manual (torque and flux commands, motor temperature M22) are left out.",
  "Accel/decel times (F07/F08, S08/S09) use Fuji's packed floating-point format [12] and are not listed.",
  "M14 bit 6 (TL, torque limiting) is left out: the bit table lists it, but the bit diagram of format 16 shows bit 6 as unused (0).",
  "M86 uses alarm-history format 41: the low byte is the light alarm code and the high byte counts consecutive repeats of the same alarm."
 ],
