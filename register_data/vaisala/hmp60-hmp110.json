  "integration": {
    "summary": "Read holding registers 1-4 for RH and temperature as CDAB floats; add 9-10 for dew point. Check register 513 for errors.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "Relative humidity"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "Temperature"
      },
      {
        "table": "holding_register",
        "address": 8,
        "why": "Dew/frost point"
      },
      {
        "table": "holding_register",
        "address": 512,
        "why": "Error status"
      },
      {
        "table": "holding_register",
        "address": 515,
        "why": "Error code"
      }
    ],
    "enable": "Order the probe with the Modbus option, or connect through the service port and set the start-up mode with the smode modbus command, then reset or power cycle.",
    "watchdog": null,
    "quirks": [
      "Floats are low word first (CDAB); pick \"word-swapped\" float in masters that default to high word first.",
      "Read or write each 32-bit value in one transaction."
    ],
    "setup": [
      "Defaults: address 240, 19200 baud, no parity, 8 data bits, 2 stop bits, response delay 0.",
      "Up to 32 probes per RS-485 segment at 19200 bps or lower; give each a unique address.",
      "Allow up to 2 s after power-up before the first request."
    ],
    "gotchas": [
      "Use the test registers (7937 on) to confirm float format and addressing before trusting readings."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
