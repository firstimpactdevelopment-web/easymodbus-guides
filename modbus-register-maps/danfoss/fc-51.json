 "integration": {
  "summary": "Set 8-30 = Modbus, 8-31 address, 8-32/8-33 baud and parity, keep 8-02 = FC RS485, then drive the unit with coils 1-16 (write coils 3, 4, 5, 7 and 11 = 1 to run) and the reference on coils 17-32. Read coils 33-48 for status and holding registers 16130/16140 for frequency and current.",
  "minimum_registers": [
   {
    "table": "coil",
    "address": 6,
    "why": "Start (1) / ramp stop (0)"
   },
   {
    "table": "coil",
    "address": 10,
    "why": "Data valid - must be 1"
   },
   {
    "table": "coil",
    "address": 43,
    "why": "Running status"
   },
   {
    "table": "coil",
    "address": 35,
    "why": "Alarm status"
   },
   {
    "table": "coil",
    "address": 39,
    "why": "Warning status"
   },
   {
    "table": "holding_register",
    "address": 16129,
    "why": "16-13 Frequency, 0.1 Hz"
   },
   {
    "table": "holding_register",
    "address": 16139,
    "why": "16-14 Motor current, 0.01 A"
   },
   {
    "table": "holding_register",
    "address": 8299,
    "why": "8-30 Protocol"
   }
  ],
  "enable": "Set 8-30 Protocol = [2] Modbus RTU (takes effect only after the drive is powered off and on), 8-31 Address (1-247, factory 1), 8-32 baud (19200 is the default once Modbus is chosen) and 8-33 parity (factory even, 1 stop bit). 8-02 must stay [1] FC RS485 and 8-01 Control Site decides whether terminals, the control word or both act; 8-50 to 8-56 (factory Logic OR) set how bus and terminal commands combine.",
  "watchdog": "8-03 Control Word Timeout Time (0.1-6500 s, factory 1.0 s) with 8-04 Control Word Timeout Function: Off (factory), Freeze output, Stop, Jogging, Max. speed, or Stop and trip.",
  "quirks": [
   "Parameter register = 10 x parameter number, wire address = that minus 1 (16-13 -> 16129).",
   "Control word bits are active-low for stops: coils 3-5 must be 1 (no DC brake, no coast, no quick stop) and coil 7 = 1 starts.",
   "Coil 11 (data valid) must be 1 or the control word is ignored."
  ],
  "setup": [
   "Coil 65 = 1 makes parameter writes go to EEPROM as well as RAM; leave it 0 for cyclic writes.",
   "Array parameters need holding register 9 (IND) set to the index first."
  ],
  "gotchas": [
   "With factory 8-04 = Off the drive keeps running if the master stops polling.",
   "Holding registers 50000-50210 (and 2810-2911) are described in the design guide alongside an instruction to set 8-30 = FC; use the coils for Modbus control."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/danfoss/fc-51",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
