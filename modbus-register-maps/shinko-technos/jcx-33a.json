{
 "manufacturer": "Shinko Technos",
 "manufacturer_slug": "shinko-technos",
 "model": "JCS-33A / JCM-33A / JCR-33A / JCD-33A digital indicating controller (C5 option)",
 "model_slug": "jcx-33a",
 "short_model": "JCx-33A",
 "aliases": [
  "JCS-33A",
  "JCM-33A",
  "JCR-33A",
  "JCD-33A",
  "JCx-33A"
 ],
 "equipment_type": "Sensor (digital temperature controller)",
 "applies_to": "Shinko JCx-33A series (JCS, JCM, JCR, JCD-33A) with the C5 option; communication manual No.JC3CE11.",
 "summary": "The JCx-33A series are PID temperature controllers sharing one command set. With the C5 option they speak Shinko protocol, Modbus ASCII or Modbus RTU on RS485, and every item is a signed 16-bit holding register. The map covers SV and limits, PID, alarm, heater burnout and loop break settings, auto/manual and output OFF, PV, MV and the status word.",
 "transport": [
  "RTU",
  "ASCII"
 ],
 "defaults": {
  "unit_id": 0,
  "baud": 9600,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Registers are listed as hex data items (0001H) that go into the request unchanged. The manual adds that the matching Modicon holding-register number is the item in decimal plus 40001 (0001H = 40002)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Communication Instruction Manual JCS, JCM, JCR, JCD-33A (C5)",
  "doc_number": "No.JC3CE11",
  "revision_date": "2013-01",
  "url": "https://shinko-technos.co.jp/e/manual/english/JC3CE11.pdf",
  "pages": "Command table pp. 9-11; communication settings p. 2"
 },
 "notes": [
  "All data are 16-bit two's complement. Values with a decimal point are sent as whole numbers; apply the decimal point place (001AH).",
  "Units of PID times, cycles and MV are not printed in the command table.",
  "PID values are updated after AT ends; read them once status bit 11 returns to 0.",
  "Protocol, instrument number, speed, parity and stop bit are keypad-only settings."
 ],
 "integration": {
  "summary": "Set Communication protocol to Modbus RTU in Auxiliary function setting mode 1 and give the unit a non-zero instrument number; then poll PV 0080H, OUT1 MV 0081H and status 0085H and write SV1 at 0001H.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 128,
    "why": "Process value"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Set value SV1"
   },
   {
    "table": "holding_register",
    "address": 129,
    "why": "OUT1 manipulated value"
   },
   {
    "table": "holding_register",
    "address": 133,
    "why": "Output, alarm and error status"
   },
   {
    "table": "holding_register",
    "address": 55,
    "why": "Control output OFF"
   },
   {
    "table": "holding_register",
    "address": 26,
    "why": "Decimal point for scaling"
   }
  ],
  "enable": "Requires the C5 option. Enter Auxiliary function setting mode 1 by holding the key pair shown on p. 2 for about 3 s, press the advance key 4 times to reach Communication protocol, and choose Modbus RTU; then set instrument number, speed, parity and stop bit.",
  "watchdog": null,
  "quirks": [
   "Instrument number defaults to 0, the Modbus broadcast address; set 1-95.",
   "Send alarm type before alarm value and input type before other settings, because changing them resets dependent values."
  ],
  "setup": [
   "Factory defaults: Shinko protocol, instrument 0, 9600 bps, even parity, 1 stop bit.",
   "Speeds 2400, 4800, 9600, 19200 bps; no terminator needed, the unit has built-in pull-up/pull-down resistors."
  ],
  "gotchas": [
   "Clearing the key-change flag during keypad setting mode returns exception 18 (12H)."
  ]
 },
