  "integration": {
    "summary": "Set the Midea indoor-unit address in register 1210, then write 0-4 and poll 5, 10, 11 and 66. Write room temperature to 22 to make a Modbus-side sensor drive the unit.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "On/off"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Mode"
      },
      {
