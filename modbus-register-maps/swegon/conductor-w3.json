{
 "manufacturer": "Swegon",
 "manufacturer_slug": "swegon",
 "model": "CONDUCTOR W3 room controller (air and water, Modbus RTU)",
 "model_slug": "conductor-w3",
 "short_model": "CONDUCTOR W3",
 "aliases": [
  "CONDUCTOR RE W3",
  "Conductor W3"
 ],
 "equipment_type": "Thermostat / room controller (chilled beam with supply and extract air dampers)",
 "applies_to": "Swegon CONDUCTOR W3 room controller, software 1.38 and later (technical manual updated 2015-06-15).",
 "summary": "CONDUCTOR W3 is the Swegon room controller that handles both the water circuits (cooling/heating) and the supply and extract air dampers of a room, for demand-controlled waterborne climate systems. Over Modbus RTU it exposes alarms, sensor temperatures, outputs and damper positions, plus airflow levels per state, the application-state request and PI tuning. The temperature setpoints are left out because the manual does not give their scaling.",
 "transport": [
  "RTU"
 ],
