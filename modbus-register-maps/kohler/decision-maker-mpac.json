 "short_model": "DM MPAC",
 "aliases": [
  "Decision-Maker MPAC 750",
  "Decision-Maker MPAC 1200",
  "Decision-Maker MPAC 1500",
  "DM MPAC"
 ],
 "equipment_type": "Transfer switch",
 "applies_to": "Kohler Decision-Maker MPAC 750, 1200 and 1500 ATS controllers, Modbus RTU on the logic board RS-485 port or Modbus TCP, per section 14 of TP-6113.",
 "summary": "The Decision-Maker MPAC controllers are Kohler automatic transfer switch controllers sharing one Modbus map. It gives source A (1) and source B (2) voltages and frequencies, load current, contactor position and source availability, transition mode, time-delay status, accessory and I/O states, transfer statistics and write-only test and manual-operation commands. This map covers the monitoring block, nominal ratings, transition mode, I/O and accessory status, maintenance counters and the command registers.",
 "transport": [
  "RTU",
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": 19200,
  "parity": "None",
  "data_bits": null,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "Modicon",
  "note": "This section prints 6-digit holding-register references starting at 400001, so 400001 is wire address 0 and 401350 is wire address 1349."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Modbus Communications Protocol Operation (generator set, transfer switch and power monitor controllers)",
  "doc_number": "TP-6113 12/21p",
  "revision_date": "2021-12",
  "url": "https://resources.kohler.com/power/kohler/industrial/pdf/tp6113.pdf",
  "pages": "Functions and exceptions p. 17; communication settings p. 236; register guide p. 237; registers pp. 238-260; device ID p. 265"
 },
 "notes": [
  "Factory communication settings: 19200 baud, no parity, 1 stop bit (parity and stop bits are not adjustable), Modbus TCP unit ID 2; the serial slave address is listed with default 0, so set it before use.",
  "The 2-register history counters (401300-401311) are stated as most significant word first, so they are ABCD. 401012 (duration of last outage, 2 words) has no stated word order and is left out.",
  "The guide puts 400039-400058 (including the transition override at 400039 and transition/operation modes at 400057) in its distributor-password setup group and says to send the data register and the password (400040, 400058) in the same request. Factory settings and calibration are also password protected and not listed.",
  "Left out: synchronizing settings, time delays and trip points, I/O module events, expansion board states, accessory setup, load control, exerciser, common alarms, ATS strings, network/UART configuration, clock/DST, packed date fields, event history, current-based load control, prime power and min/max logging."
 ],
