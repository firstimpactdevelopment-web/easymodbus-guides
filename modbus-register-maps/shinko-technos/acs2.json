{
 "manufacturer": "Shinko Technos",
 "manufacturer_slug": "shinko-technos",
 "model": "ACS2 digital indicating controller (C5, C5W options)",
 "model_slug": "acs2",
 "short_model": "ACS2",
 "aliases": [
  "ACS2-C5",
  "ACS2-C5W"
 ],
 "equipment_type": "Sensor (digital temperature controller)",
 "applies_to": "Shinko ACS2 with the C5 or C5W serial option, Shinko protocol / MODBUS RTU command set; manual No.ACS2CE3.",
 "summary": "The ACS2 is a Shinko PID temperature controller with SV memories, program control and several PID modes. With the C5/C5W option it speaks Shinko protocol, Modbus RTU or MC protocol on RS485; all items are 16-bit holding registers. This map covers SV memories, input setup, EV1 alarm handling, control mode and key function settings, and the full read block from 03E8H (PV, MV, SV, status, error and heater current).",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 0,
  "baud": 9600,
  "parity": "Even",
  "data_bits": 7,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Registers are listed as hex data items (0001H) that go into the request unchanged. The manual adds that the matching Modicon holding-register number is the item in decimal plus 40001 (0001H = 40002)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Communication Instruction Manual ACS2 (C5W, C5)",
  "doc_number": "No. ACS2CE3",
  "revision_date": "2026-08",
  "url": "https://shinko-technos.co.jp/e/manual/english/ACS2CE3.pdf",
  "pages": "Section 7.1, pp. 21-29 (only pp. 21, 23, 26, 28-29 used); communication settings p. 4"
 },
 "notes": [
  "Only a subset of the setting table is mapped: PID terms, EV2/EV3, output and many other setting items on pp. 22-27 are left out, as are program pattern commands (section 7.1.3 onward).",
  "All data are 16-bit two's complement. Items marked 'decimal point ignored' are whole numbers; apply the decimal point of the input range.",
  "Error status flag (03F5H): the manual states 0 = normal, 1 = error only for bit 11; the other bits are listed without a polarity legend.",
  "Writing data clear (00D8H) restores factory settings including communication settings; not mapped here."
 ],
 "integration": {
  "summary": "In the Communication setting group choose MODBUS RTU, an 8-bit data format and a non-zero instrument number. Poll PV 03E8H, OUT1 MV 03E9H, status 03ECH/03EDH and errors 03F5H; write SV1 at 0001H.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 1000,
    "why": "Process value"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Set value SV1"
   },
   {
    "table": "holding_register",
    "address": 1001,
    "why": "OUT1 manipulated value"
   },
   {
    "table": "holding_register",
    "address": 1004,
    "why": "Output and alarm status"
   },
   {
    "table": "holding_register",
    "address": 1013,
    "why": "Error status"
   },
   {
    "table": "holding_register",
    "address": 1005,
    "why": "Run mode status"
   }
  ],
  "enable": "Requires the C5 or C5W option. In RUN mode step through the setting groups to the Communication setting group and enter it (keys shown on p. 4), set Communication protocol to MODBUS RTU mode, then instrument number, speed, data bit/parity and stop bit.",
  "watchdog": null,
  "quirks": [
   "Factory data format is 7 bits/Even; Modbus RTU needs an 8-bit choice.",
   "Instrument number defaults to 0, the Modbus broadcast address; set 1-95.",
   "Modbus ASCII is not offered on this model; protocols are Shinko, MODBUS RTU, MC protocol and SVTC."
  ],
  "setup": [
   "Factory defaults: Shinko protocol, instrument 0, 9600 bps, 7 bits/Even.",
   "Speeds 9600 to 115200 bps."
  ],
  "gotchas": [
   "Data clear (00D8H) also resets communication settings, so the unit may stop answering with the current master settings."
  ]
 },
