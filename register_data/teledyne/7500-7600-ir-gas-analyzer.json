{
  "manufacturer": "Teledyne Analytical Instruments",
  "manufacturer_slug": "teledyne",
  "model": "7500 / 7600 infrared gas analyzer (Modbus RTU)",
  "model_slug": "7500-7600-ir-gas-analyzer",
  "short_model": "7500/7600",
  "aliases": [
    "Teledyne 7500",
