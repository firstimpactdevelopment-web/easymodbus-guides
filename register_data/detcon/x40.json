{
  "manufacturer": "Teledyne Detcon",
  "manufacturer_slug": "detcon",
  "model": "Model X40 integrated alarm and control system (Modbus slave port)",
  "model_slug": "x40",
  "short_model": "X40",
  "aliases": [
    "X40-08-N4X",
    "X40-32-N4X",
    "X40-32-N1P",
    "X40 controller"
  ],
  "equipment_type": "Sensor controller (gas detection)",
  "applies_to": "Teledyne Detcon X40 gas detection controllers (8 and 32 channel, N4X and N1P enclosures), instruction manual Document #3672 Rev. 3.8, slave port register map.",
  "summary": "The X40 is a Teledyne Detcon gas detection controller that collects up to 32 wired or wireless sensors (CXT sensors, alarm stations, repeaters) and drives alarms. A Modbus RTU slave port lets a BMS or PLC read every channel: one register with the gas reading and one with alarm, fault, calibration, battery, decimal-point and device-type bits. This map lists all 64 registers.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": null,
    "baud": 9600,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "0-based",
    "note": "Table 4 numbers the registers from 40000 (channel 1 reading), so the digits after the leading 4 are the wire address: channel n reading = 2(n-1), status = 2(n-1)+1."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "X40 Instruction Manual",
    "doc_number": "Document #3672, Rev. 3.8",
    "revision_date": "2023-01-18",
    "url": "https://www.teledynegasandflamedetection.com/en-us/Products/docs/controllers-x40-usermanual-english.pdf",
    "pages": "p. 41 (slave port settings, Table 4 register map), p. 42 (status register bits)"
  },
  "notes": [
    "Readings carry no fixed scale: status bits 7-6 give the decimal point (00 = none, 01 = divide by 10, 10 = divide by 100, 11 = undefined, treat as none).",
    "Status bits 15-13 give the device type on that channel: 000 disabled, 001 CXT sensor, 010 alarm station, 011 SmartHMI, 100 repeater, 101 sensor, 110/111 undefined (sensor).",
    "Bits 4, 6 and 7 are only active for sensor devices. Bit 11 is not used.",
    "The manual does not name the function code; the 4xxxx register numbers indicate holding registers (function 03).",
    "The slave address is set in the controller menu; no default is stated in this section."
  ],
