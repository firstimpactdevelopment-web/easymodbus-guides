{
  "manufacturer": "Carlo Gavazzi",
  "manufacturer_slug": "carlo-gavazzi",
  "model": "EM100 / ET100 series (EM111, EM112, ET112)",
  "model_slug": "em111-em112-et112",
  "short_model": "EM111/EM112",
  "aliases": [
    "EM111",
    "EM112",
    "ET112",
    "EM110",
    "EM111-DIN",
    "EM112-DIN",
    "ET112-DIN",
    "EM111DINAV81XS1X",
    "EM112DINAV01XS1X",
    "ET112DINAV01XS1X"
  ],
  "equipment_type": "Energy meter",
  "applies_to": "Single-phase EM111, EM112 energy meters and ET112 bidirectional meter with the S1 (RS485 Modbus RTU) port, protocol version 2 revision 14.",
  "summary": "The EM111/EM112 are Carlo Gavazzi's single-phase DIN-rail energy meters, and the ET112 is the bidirectional version for PV and storage. The S1 versions have an RS485 Modbus RTU port; values are 32-bit integers sent low word first with fixed weights, readable with function 03 or 04. This map covers voltage, current, powers, demand, PF, frequency, total/partial/tariff energy, high-resolution energy totals, hour counter, identification, setup, serial settings and resets.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 9600,
    "parity": "None",
    "data_bits": null,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "Modicon",
    "note": "Registers are printed as a 6-digit Modicon number for function 04 (3xxxxx; use 4xxxxx for function 03) and as the hex physical address placed in the frame. Wire address = physical address (300001 / 0000h is address 0). Setup rows are written with function 06 and are listed as holding registers; 1010h/1012h are printed with the hex address only."
  },
  "default_word_order": "CDAB",
  "firmware": null,
  "source": {
    "title": "EM100 Series and ET100 Series Communication Protocol",
    "doc_number": "Version 2 Revision 14",
    "revision_date": null,
    "url": "https://www.gavazziautomation.com/fileadmin/images/PIM/OTHERSTUFF/COMPRO/EM111_EM112_ET112_CP.pdf",
    "pages": "Data format p. 7; tables pp. 8-14"
  },
  "notes": [
    "Word order: the protocol states INT32/UINT32/UINT64 are LSW first with bytes MSB first, so 32-bit values are CDAB.",
    "Functions 03 and 04 are equivalent; up to 50 registers per request.",
    "Table 2.4-4 (0100h-0189h) mirrors the same values, with PF as INT32; it is not duplicated here.",
    "The integer/decimal split totalizers (0400h-040Fh) exist only on EM111/EM112 from firmware b.10, in units made from 1 January 2020 (serial YR2020 001xxxU onward).",
    "Registers marked 'not available, value = 0' (tariffs 3-4, negative partials, kVAh, THD) are left out.",
    "Left out: the INT64 energy block at 0500h (no value weight given), kWh-per-pulse settings (1020h/1022h, no weight), the ASCII serial-number letters (5000h-5006h), and kWh(-) total integer part (0408h), whose Notes cell is empty in the document, so its weight is not stated (its decimal-part partner 040Ah is printed with a weight and is kept).",
    "In measurement mode A (and PFA models) energy always counts as imported; mode B (PFB, ET112) separates kWh(+) and kWh(-) and current/power go negative when exporting."
  ],
  "integration": {
    "summary": "Read input registers 0000h-0023h with function 04 (or 03) in one request; decode INT32 values low word first and apply the fixed weights (V and W x10, A and PF x1000, energy x10).",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 0,
        "why": "Voltage"
      },
      {
        "table": "input_register",
        "address": 2,
        "why": "Current"
      },
      {
        "table": "input_register",
        "address": 4,
        "why": "Active power"
      },
      {
        "table": "input_register",
        "address": 14,
        "why": "Power factor"
      },
      {
        "table": "input_register",
        "address": 16,
        "why": "Imported energy"
      },
      {
        "table": "input_register",
        "address": 32,
        "why": "Exported energy"
      }
    ],
    "enable": "S1 versions carry the RS485 Modbus RTU port. Address, baud rate, parity and stop bits are in registers 2000h-2003h (or the instrument's own setup menu, see its manual).",
    "watchdog": null,
    "quirks": [
      "INT32 values are low word first (CDAB).",
      "Function 06 only for writes; broadcast to address 0 is supported.",
      "Measurement mode (1103h) can only be written on non-MID X versions."
    ],
    "setup": [
      "Defaults: address 1, 9600 baud, no parity, 1 stop bit.",
      "Terminate the master end with 120 ohm and the last meter by bridging A- to T.",
      "Use a repeater for runs longer than 1000 m or more than 160 instruments on one bus."
    ],
    "gotchas": [
      "Total energy reset (4001h) is documented for non-MID X versions only."
    ]
  },
