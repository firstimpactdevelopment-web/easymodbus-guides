 "integration": {
  "summary": "Read input registers 0000h-0057h in one request (function 04 or 03): INT32 values low word first, V/W/VA/var x10, A x1000, PF and Hz as INT16 x1000 and x10. Use 7040h/7045h/7100h for OCMF signed sessions.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 0,
    "why": "V L1-N"
   },
   {
    "table": "input_register",
    "address": 12,
    "why": "A L1"
   },
   {
    "table": "input_register",
    "address": 40,
    "why": "W sys"
   },
   {
    "table": "input_register",
    "address": 49,
    "why": "PF sys"
   },
   {
    "table": "input_register",
    "address": 51,
    "why": "Frequency"
   },
   {
    "table": "input_register",
    "address": 52,
    "why": "Imported kWh total"
   },
   {
    "table": "input_register",
    "address": 78,
    "why": "Exported kWh total"
   },
   {
    "table": "holding_register",
    "address": 28741,
    "why": "Charging session status"
   }
  ],
  "enable": "Modbus RTU on the RS485 port is always active; set address and line settings at 2000h-2004h and write 1 to 2010h to apply.",
  "watchdog": null,
  "quirks": [
   "32-bit values are CDAB.",
   "PF sign shows import/export; the separate L/C words give lead/lag."
  ],
  "setup": [
   "Defaults: address 1, 9600 baud, no parity, 1 stop bit.",
   "Max answer time 500 ms, typical 40 ms."
  ],
  "gotchas": [
   "Write 0 to 7100h after reading the OCMF file or a new session will not start.",
   "Sync the clock (7031h/7032h) at least every 24 h for signed data."
  ]
 },
