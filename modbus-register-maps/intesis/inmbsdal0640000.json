 "integration": {
  "summary": "Configure the gateway in Intesis MAPS with fixed Modbus addresses, then write arc power level (sa x 100 + 15) or the group/broadcast level registers and read actual level (sa x 100 + 6) and ballast status (+5).",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 15,
    "why": "Set level of short address 0"
   },
   {
    "table": "holding_register",
    "address": 6,
    "why": "Actual level of short address 0"
   },
   {
    "table": "holding_register",
    "address": 5,
    "why": "Ballast status"
   },
   {
    "table": "holding_register",
    "address": 0,
    "why": "Failure bits for sa 0-15"
   },
   {
    "table": "holding_register",
    "address": 6400,
    "why": "Group 0 level"
   },
   {
    "table": "holding_register",
    "address": 6800,
    "why": "Broadcast level"
   }
  ],
  "enable": "All settings (Modbus RTU/TCP parameters, slave number, IP, Fixed address mode) are made in the Intesis MAPS configuration tool.",
  "watchdog": null,
  "quirks": [
   "The two-channel model (1280000) is Modbus TCP only.",
   "Writes use FC06 or FC16; reads FC03 or FC04."
  ],
  "setup": [
   "RTU: 1200..115200 baud, parity and stop bits selectable, EIA-485 or EIA-232.",
   "TCP: port 502 by default, plus keep-alive and IP settings in MAPS."
  ],
  "gotchas": [
   "Status registers only refresh after an update; write 1 to register 4 to trigger a full ECG status update."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/intesis/inmbsdal0640000",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
