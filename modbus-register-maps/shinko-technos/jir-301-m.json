  "pages": "Section 7.1, pp. 24-26; communication settings p. 3"
 },
 "notes": [
  "This map is for the plain 'MODBUS RTU mode' / 'MODBUS ASCII mode' settings. The 'Block Read/Write available' settings use the different layout of section 7.2 and are not covered.",
  "All data are 16-bit two's complement. Items marked 'decimal point ignored' are whole numbers; apply the decimal point place (0008H).",
  "Item 0018H is not listed in the single-item table and is left out.",
  "Protocol, instrument number, speed, parity and stop bit are keypad-only settings."
 ],
 "integration": {
  "summary": "Choose MODBUS RTU and a non-zero instrument number on the keypad, then read PV at 0080H and status at 0081H with function 03.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 128,
    "why": "Process value"
   },
   {
    "table": "holding_register",
    "address": 129,
    "why": "Alarm and over/underscale status"
   },
   {
    "table": "holding_register",
    "address": 8,
    "why": "Decimal point for scaling"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Alarm 1 value"
   }
  ],
  "enable": "Requires the C5 option. In the keypad setup, step with the MODE key to Communication protocol and pick MODBUS RTU mode, then set instrument number, speed, parity and stop bit.",
  "watchdog": null,
  "quirks": [
   "Instrument number defaults to 0, the Modbus broadcast address; set 1-95.",
   "Parity and stop bit only apply to the Modbus settings."
  ],
  "setup": [
   "Factory defaults: Shinko protocol, instrument 0, 9600 bps, even parity, 1 stop bit.",
   "Speeds 2400-38400 bps."
  ],
  "gotchas": [
   "Settings are stored in non-volatile memory; avoid cyclic writes."
  ]
 },
