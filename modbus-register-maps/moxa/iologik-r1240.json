 "integration": {
  "summary": "Read the raw analog values and channel status with function 04 and set each channel range with function 03/06. The host-connection watchdog (0x7564, timeout 0x7565) is shared by the whole series.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 30000,
    "why": "Model ID check"
   },
   {
    "table": "holding_register",
    "address": 30052,
    "why": "Enable communication watchdog"
   },
   {
    "table": "holding_register",
    "address": 30053,
    "why": "Watchdog timeout"
   },
   {
    "table": "input_register",
    "address": 704,
    "why": "First analog input raw value"
   },
   {
    "table": "input_register",
    "address": 992,
    "why": "First analog input status"
   }
  ],
  "enable": "Set the device ID (1-99) on the two rotary dials. Put the Initial/Run switch on Initial to configure the unit at 9600 baud, no parity, 8 data bits, 1 stop bit (with ioSearch or the SYS_port* registers), then switch back to Run.",
  "watchdog": "SYS_modbusWatchdogFuntion (0x7564) enables the host-connection watchdog, SYS_modbusWatchdogTimeout (0x7565) sets the timeout in seconds (factory default 10 s), SYS_modbusWatchdogStatus (0x7566) shows a timeout. It is disabled by default; safe-status settings only act when it is enabled.",
  "quirks": [
   "System registers sit at 0x7530 and up (six-digit references 330001/430002).",
   "Write 404 to SYS_restartDevice or SYS_loadFactoryDefault to trigger them."
  ],
  "setup": [
   "Device ID 1-99 on the rotary dials (x1 and x10).",
   "The Dual/Rep switch selects two separate RS-485 ports or repeater mode; SYS_rs485PortMode reports which is active.",
   "Baud rate codes: 1=1200 ... 4=9600, 5=19200 ... 9=921600."
  ],
  "gotchas": [
   "Factory defaults (reset button held 5 s, ioSearch, or SYS_loadFactoryDefault) return the serial settings to 9600 n 8 1 and disable the watchdog."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/moxa/iologik-r1240",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
