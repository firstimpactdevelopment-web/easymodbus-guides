  "integration": {
    "summary": "Read 400001-400028 for generator output and 400033-400047 for engine data in one or two FC 03 requests, check 400079/400080 for switch position and programming mode, and use 401306/401307 for remote timed starts once the controller is in remote programming mode.",
    "minimum_registers": [
