  "integration": {
    "summary": "Set bus address, baud (parameter A) and frame (parameter C) in the pump menu, then write the control mode (H 42), the duty point (H 1) and the pump command (H 40). Poll status (I 404 if present), error code (I 940) and the measured values in the I 1-I 10 block.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 40,
        "why": "On/off command (bit 3 = 1 when writing, if listed)"
      },
      {
        "table": "holding_register",
        "address": 42,
        "why": "Control mode"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Setpoint (duty point, 0.5 % steps)"
      },
      {
        "table": "input_register",
        "address": 404,
        "why": "Operation status flags"
      },
      {
        "table": "input_register",
        "address": 940,
        "why": "Active warning/error code"
      },
      {
        "table": "input_register",
        "address": 1,
        "why": "Actual pressure"
      },
      {
        "table": "input_register",
        "address": 2,
        "why": "Flow"
      },
      {
        "table": "input_register",
        "address": 4,
        "why": "Power input"
      }
    ],
    "enable": "Plug in the CIF module Modbus RTU and set the bus address (menu <5.2.3.0>), baud rate (parameter A, <5.2.4.0>: 5 = 9600, 6 = 19200, 7 = 38400 ...) and frame (parameter C, <5.2.5.0>: 2 = 8N1, 3 = 8N2, 6 = 8E1, 10 = 8O1). OFF as bus address disables the interface.",
    "watchdog": "The bus command timer (H 300, timeout in H 400 where supported) can switch the pump to the preset command, mode and duty point (H 402-405) when the master stops refreshing it.",
    "quirks": [
      "Register numbers are raw wire addresses; do not subtract 1.",
      "Duty points are in 0.5 % steps (200 = 100 %).",
      "Unsupported control-mode values are ignored by the pump."
    ],
    "setup": [
      "Where a setpointSignalSource register is listed, select IF-Module (value 1) as the setpoint source if the duty point should come from the bus.",
      "Terminate the RS-485 line at both ends."
    ],
    "gotchas": [
      "Temperatures are in kelvin.",
      "Last write wins between the bus, the pump display and other remote controls."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
