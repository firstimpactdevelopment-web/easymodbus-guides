 "manufacturer": "Lovato Electric",
 "manufacturer_slug": "lovato-electric",
 "model": "FFL700DP / FFL800DP diesel engine fire pump controllers",
 "model_slug": "ffl700dp-ffl800dp",
 "short_model": "FFL...DP",
 "aliases": [
  "FFL700DP",
