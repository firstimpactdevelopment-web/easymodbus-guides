 "integration": {
  "summary": "Fit the EXC1042 RS-485 board, set P08 serial parameters, then read currents (08h-0Dh), total power (3Ah), thermal status (FB0h) and thyristor temperature (FB2h) as big-endian 32-bit values. Start and stop with a 1 written to 1002h and 1003h.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 7,
    "why": "L1 current"
   },
   {
    "table": "input_register",
    "address": 57,
    "why": "Total active power"
   },
   {
    "table": "input_register",
    "address": 4015,
    "why": "Motor thermal status"
   },
   {
    "table": "input_register",
    "address": 4017,
    "why": "Thyristor temperature"
   },
   {
    "table": "input_register",
    "address": 3967,
    "why": "Motor hours (seconds)"
   },
   {
    "table": "holding_register",
    "address": 4097,
    "why": "Start command"
   },
   {
    "table": "holding_register",
    "address": 4098,
    "why": "Stop command"
   }
  ],
  "enable": "Install the EXC1042 RS-485 communication board, then in menu 01-SETUP > P08 COMMUNICATION set node address (08.01), baud rate (08.02), data format (08.03), stop bits (08.04) and protocol (08.05).",
  "watchdog": null,
  "quirks": [
   "Table addresses are one above the wire address.",
   "32-bit values are high word first.",
   "Phase active powers are kW/100000 but total active power is kW/10000."
  ],
  "setup": [
   "Defaults: node 1, 9600 baud, 8 data bits, no parity, 1 stop bit, Modbus RTU.",
   "Data format choices: 8 bit none/odd/even and 7 bit odd/even."
  ],
  "gotchas": [
   "Without the EXC1042 board the soft starter has no Modbus port.",
   "Only function 06 is listed for writes; function 16 is not among the supported functions."
  ]
 },
