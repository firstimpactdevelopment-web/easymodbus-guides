  "integration": {
    "summary": "At 9600 8N1, address 0x57: write 0x0001 to holding register 0x0003 to start measuring, then read six input registers from 0x0006 with function 04 for PM1.0, PM2.5 and PM10 as big-endian floats in ug/m3.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 3,
        "why": "Start measurement command"
      },
      {
        "table": "input_register",
        "address": 6,
        "why": "PM1.0"
      },
      {
        "table": "input_register",
        "address": 8,
        "why": "PM2.5"
      },
      {
        "table": "input_register",
        "address": 10,
        "why": "PM10"
      },
      {
        "table": "input_register",
        "address": 14,
        "why": "Status flags"
      },
      {
        "table": "input_register",
        "address": 4,
        "why": "Operating status"
      }
    ],
    "enable": "Set the module's DIP switch to the UART side; Modbus RTU is then active at the stored address and baud rate.",
    "watchdog": null,
    "quirks": [
      "Measurement must be started after every power cycle.",
      "Baud and parity changes take effect after a reboot.",
      "Changing the algorithm restarts measurement; blockage and vibration settings are re-applied when changed. After changing the measurement mode, send a start command."
    ],
    "setup": [
      "Defaults: 9600 baud, 8 data bits, no parity, 1 stop bit, address 0x57.",
      "The wiki wiring example connects the board R/T pins to a UART adapter (RainbowLink V2)."
    ],
    "gotchas": [
      "If a PM value reads 0 or NaN, check bit 9 of status flags (0x000E).",
      "Full-scale PM range is 1000 ug/m3; bit 1 of status flags flags PM2.5 out of range."
    ]
  },
