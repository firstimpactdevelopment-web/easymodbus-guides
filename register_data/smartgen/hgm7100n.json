  "integration": {
    "summary": "Poll holding registers 0000-0045 for alarms, modes and I/O, 0064-0143 for measurements and 0189-0213 for states and counters with FC03. Remote keys are single FC05 writes of FF00 to coils 0000-0015.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "Common alarm and mode flags"
      },
      {
        "table": "holding_register",
        "address": 189,
        "why": "Genset running state"
      },
      {
        "table": "holding_register",
        "address": 193,
        "why": "Transfer switch state"
      },
      {
        "table": "holding_register",
        "address": 34,
        "why": "Mains/gen normal and on-load flags"
      },
      {
        "table": "holding_register",
        "address": 84,
        "why": "Generator frequency"
      },
      {
        "table": "holding_register",
        "address": 95,
        "why": "Phase A current"
      },
      {
        "table": "holding_register",
        "address": 142,
        "why": "Battery voltage"
      },
      {
        "table": "coil",
        "address": 0,
        "why": "Remote start key"
      }
    ],
    "enable": "Give each controller a unique slave address (the protocol allows 1-255) in the controller parameters before networking several units; the document does not state the default address.",
    "watchdog": null,
    "quirks": [
      "Only FC03, FC05 and FC06 are supported; status bits are read from holding registers, not with FC01/FC02.",
