 "integration": {
  "summary": "Pick RTU (RS-485, 38400 8N2, address 1) or TCP (port 502), keep Setpoint source = Bus, choose Control mode (No. 117), then write the setpoint to No. 1 (address 0) and poll flow, temperatures, power and energy. Read each 32-bit value as a two-register pair, low word first.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Setpoint, 0.01 %"
   },
   {
    "table": "holding_register",
    "address": 116,
    "why": "Control mode: position / flow / power"
   },
   {
    "table": "holding_register",
    "address": 7,
    "why": "Flow l/s"
   },
   {
    "table": "holding_register",
    "address": 19,
    "why": "Temperature 1 (external) °C"
   },
   {
    "table": "holding_register",
    "address": 21,
    "why": "Temperature 2 (integrated) °C"
   },
   {
    "table": "holding_register",
    "address": 27,
    "why": "Cooling power kW"
   },
   {
    "table": "holding_register",
    "address": 33,
    "why": "Heating power kW"
   },
   {
    "table": "holding_register",
    "address": 65,
    "why": "Cooling energy kWh"
   },
   {
    "table": "holding_register",
    "address": 71,
    "why": "Heating energy kWh"
   },
   {
    "table": "holding_register",
    "address": 104,
    "why": "Fault flags"
   }
  ],
  "enable": "Modbus RTU and TCP are configured with the Belimo Assistant app or the valve's built-in web server (address, baud, frame, IP). Setpoint source (No. 119) defaults to Bus.",
  "watchdog": "Bus fail setpoint is No. 109 and the timeout No. 110 (0-3600 s, 0 = off, default 120 s once a fail setpoint is set): if neither No. 1 nor No. 2 is renewed in time the valve goes to the fail setpoint. Belimo marks No. 110 as not functional in this edition, so test it before relying on it.",
  "quirks": [
   "Register No. is 1-based; subtract 1 for the wire address.",
   "32-bit pairs are low word first (CDAB) and must be written with a single FC 16 to just those two registers.",
   "Each quantity appears in SI, imperial and 'selected unit' registers; the selected-unit registers follow No. 148-151."
  ],
  "setup": [
   "RTU default frame 1-8-N-2 at 38400 baud, address 1; 9600-115200 baud supported.",
   "TCP default port 502 over the Ethernet socket.",
   "Max. 32 RTU nodes per segment without a repeater; terminate with 120 ohm."
  ],
  "gotchas": [
   "Unsupported values read 65535 - treat it as 'not available', not as a real reading.",
   "Temperatures are signed; read them as INT16."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/belimo/energy-valve-v4",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
