{
 "manufacturer": "Camille Bauer Metrawatt",
 "manufacturer_slug": "camille-bauer",
 "model": "SINEAX CAM universal measurement device (Modbus/TCP)",
 "model_slug": "sineax-cam",
 "short_model": "SINEAX CAM",
 "aliases": [
  "SINEAX CAM",
  "CAM"
 ],
 "equipment_type": "Power meter (universal measuring / power quality device)",
 "applies_to": "SINEAX CAM with Ethernet (Modbus/TCP) bus card; document W 157471, change 2014-018. Instantaneous values, THD/TDD, system analysis, analog inputs, I/O states.",
 "summary": "The SINEAX CAM is a Swiss universal measurement device for heavy-current networks with plug-in I/O modules. With the Modbus/TCP bus card it publishes its measurements as holding registers (mostly IEEE 754 floats), relay and digital output states as coils and digital inputs as discrete inputs. This map covers firmware info, the full instantaneous value block, THD/TDD, symmetrical components, analog inputs and the I/O states.",
 "transport": [
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": 502
 },
 "addressing": {
  "convention": "Modicon",
  "note": "Registers are printed 4xxxx and coils/inputs 0xxxx/1xxxx. The manual's own example: U1N at 40102 is sent as address 101 (0x65). Coil 1 is address 0, discrete input 10003 is address 2."
 },
 "default_word_order": "CDAB",
 "firmware": "Analysis firmware 1.32+ (timestamp), 1.37+ (system analysis block), 1.39+ (tariff register 41485)",
 "source": {
  "title": "Modbus/TCP interface SINEAX CAM",
  "doc_number": "W 157471 (modification 2014-018, 18.06.14)",
  "revision_date": "2014-06-18",
  "url": "https://api-usa.com/pdf/cb/Modbus_TCP_Interface_CAM.pdf",
  "unofficial": true,
  "pages": "pp. 5-9 (ports, addressing, float format), pp. 11-22 (device info, measurements, I/O, meters)"
 },
 "notes": [
  "Host: this copy is hosted on api-usa.com, not on a Camille Bauer site; no public copy was found on camillebauer.com.",
  "Float word order: the manual says the first register holds bits 0-15 and the second bits 16-31, and its U1N example reads 0xE878 then 0x436B (= 234.908 V). That is low word first, CDAB.",
  "Power units: the manual does not print units for P, Q, S (only V and A are given, in the system-analysis table and the U1N example), so units are left blank here; check against the device display.",
  "Left out: every UINT32 / TIME value (energy meters 41400-41482, logic-function words 43917-43923, timestamps 40096-40098 and min/max times), because the document gives no word order for 32-bit integers. Energy meters also need a scaling exponent whose register is not listed for the standard meters.",
  "Left out: min/max floats 40584-40666, harmonics 40200-40493 (UINT16 x 0.1 %, same scale as THD), mean values 41030-41322 (meaning depends on configuration) and parameter blocks.",
  "Availability depends on the connection type (single phase, split phase, 3-wire, 4-wire); registers that do not apply read 0.",
  "Function codes 0x05 and 0x06 (single coil/register write) and 0x04 (input registers) are not implemented; use 0x0F and 0x10."
 ],
 "integration": {
  "summary": "Connect to TCP port 502 and read 40100-40187 in one FC3 request: 44 floats with voltage, current, power, frequency and power factor, low word first. THD/TDD sit in 40190-40196 as tenths of a percent.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 101,
    "why": "Voltage L1-N"
   },
   {
    "table": "holding_register",
    "address": 117,
    "why": "Current L1"
   },
   {
    "table": "holding_register",
    "address": 133,
    "why": "Active power system"
   },
   {
    "table": "holding_register",
    "address": 157,
    "why": "Frequency"
   },
   {
    "table": "holding_register",
    "address": 159,
    "why": "Power factor system"
   },
   {
    "table": "holding_register",
    "address": 190,
    "why": "Voltage THD phase 1"
   }
  ],
  "enable": "Assign IP address, mask and gateway with the CB-Manager software (factory IP 192.168.1.101). The Modbus/TCP port can be changed there, but 502 is always supported.",
  "watchdog": null,
  "quirks": [
   "Floats are low word first (CDAB).",
   "Use FC 0x10 / 0x0F for writes; single-write function codes are not implemented.",
   "The manual's TCP examples use unit ID 0xFF since the IP address selects the device."
  ],
  "setup": [
   "At least 5 simultaneous Modbus/TCP clients are supported.",
   "Up to two NTP servers can be set in CB-Manager for clock synchronisation (port 123)."
  ],
  "gotchas": [
   "Several blocks only exist from a given analysis firmware version (1.32, 1.37, 1.39); read FV_OUTPUT at 40007 first.",
   "Register 40016 (CFG_DIGIO) is writable and changes module I/O direction; do not write it by accident."
  ]
 },
