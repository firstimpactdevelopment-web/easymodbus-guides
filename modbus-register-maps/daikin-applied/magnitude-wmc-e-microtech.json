 "integration": {
  "summary": "Plug in the BAS module, set BAS Network Protocol = Modbus with address, baud, parity and stop bits on the HMI, cycle power, then set Control Source = BAS. Poll with function 03; use 9 to enable, 34 for mode, 37 for the heating setpoint, 38 for capacity limit and 5/28-30 for alarms.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Local/Network state"
   },
   {
    "table": "holding_register",
    "address": 14,
    "why": "Chiller status"
   },
   {
    "table": "holding_register",
    "address": 16,
    "why": "Leaving chilled water temperature"
   },
   {
    "table": "holding_register",
    "address": 12,
    "why": "Actual capacity"
   },
   {
    "table": "holding_register",
    "address": 8,
    "why": "Network enable command"
   },
   {
    "table": "holding_register",
    "address": 37,
    "why": "Capacity limit command"
   },
   {
    "table": "holding_register",
    "address": 4,
    "why": "Any alarm active"
   },
   {
    "table": "holding_register",
    "address": 29,
    "why": "Active fault index"
   },
   {
    "table": "holding_register",
    "address": 315,
    "why": "English/Metric flag"
   },
   {
    "table": "holding_register",
    "address": 36,
    "why": "Heating setpoint command"
   }
  ],
  "enable": "On the HMI (Manager password 2526): Configuration > BAS Configuration > BAS Module Connected = Yes, then cycle power; Protocol tab BAS Network Protocol = Modbus and set units; Settings tab Address, Baud Rate, Parity and Modbus Stop Bits; cycle power again. Finally Configuration > Commission > Control Source = BAS, otherwise enable, setpoint, mode, capacity-limit and clear-alarm writes are ignored.",
  "watchdog": null,
  "quirks": [
   "Printed register numbers are 1-based without the 4xxxx prefix: subtract 1 for the wire address.",
   "32-bit counters are high word first (ABCD).",
   "Most analog values are x10 and follow the English/Metric setting; the multiplier does not change.",
   "Each alarm class has four registers: index (28-30) plus module type, module ID and payload (2001-2009)."
  ],
  "setup": [
   "Address 0-247 (default 1); baud 9600/19200/38400/57600/76800 (default 19200); parity Even/Odd/None (default None); stop bits 1 or 2 (default 1).",
   "RS-485 lands on the module's 'J3 Disp' 4-pin connector, using only + and -. End-of-line and bias resistors are field-supplied.",
   "The same module also does BACnet IP and MS/TP; one protocol is active, chosen by BAS Network Protocol (default None/LON)."
  ],
  "gotchas": [
   "Nothing answers until BAS Module Connected = Yes and the panel has been power-cycled.",
   "Control Source = Local or Remote Switch silently ignores network commands; register 1 shows Local/Remote."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/daikin-applied/magnitude-wmc-e-microtech",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
