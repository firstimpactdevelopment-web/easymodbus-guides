{
 "manufacturer": "Shinko Technos",
 "manufacturer_slug": "shinko-technos",
 "model": "JCL-33A digital indicating controller (C5 option)",
 "model_slug": "jcl-33a",
 "short_model": "JCL-33A",
 "aliases": [
  "JCL-33A-C5",
  "JCL-33A C5"
 ],
 "equipment_type": "Sensor (digital temperature controller)",
 "applies_to": "Shinko JCL-33A with the C5 option, protocol set to plain 'Modbus RTU mode' or 'Modbus ASCII mode' (not the Block Read/Write modes, which use another layout); manual No.JCL3CE3.",
 "summary": "The JCL-33A is a digital indicating temperature controller; with the C5 option it talks Shinko protocol, Modbus ASCII or Modbus RTU over RS485. Every value is a signed 16-bit holding register. This map covers the set value, PID and alarm settings, input type, run/stop, program steps, PV, MV and the status flags.",
 "transport": [
  "RTU",
  "ASCII"
 ],
 "defaults": {
  "unit_id": 0,
  "baud": 9600,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Registers are listed as hex data items (0001H) that go into the request unchanged. The manual adds that the matching Modicon holding-register number is the item in decimal plus 40001 (0001H = 40002)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Communication Instruction Manual JCL-33A (C5)",
  "doc_number": "No.JCL3CE3",
  "revision_date": "2018-11",
  "url": "https://shinko-technos.co.jp/e/manual/english/JCL3CE3.pdf",
  "pages": "Section 7.1 command table, manual pp. 21-23 (PDF pp. 21-23); data notes p. 29"
 },
 "notes": [
  "This map is for the plain 'Modbus RTU mode' / 'Modbus ASCII mode' protocol setting. The 'Block Read/Write available' protocol settings use a different register layout (section 7.2 of the manual) and are not covered here.",
  "All data are 16-bit; negatives are two's complement. Values with a decimal point are sent as whole numbers, so apply the decimal point place (001AH) or the input type range.",
  "Units of PID times, cycles and MV are not printed in the command table; they match the keypad settings described in the main instruction manual.",
  "Protocol, instrument number, speed, parity and stop bit can only be set from the keypad, not over Modbus.",
  "Writes during keypad setting mode return exception 18 (12H); writes the unit cannot accept now (e.g. during AT) return exception 17 (11H)."
 ],
 "integration": {
  "summary": "Pick Modbus RTU in Auxiliary function setting mode 1, give each unit a non-zero instrument number, then read PV at 0080H and status at 0085H with function 03; write SV1 at 0001H with function 06.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 128,
    "why": "Process value"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Set value SV1"
   },
   {
    "table": "holding_register",
    "address": 129,
    "why": "OUT1 manipulated value"
   },
   {
    "table": "holding_register",
    "address": 133,
    "why": "Output/alarm/error status bits"
   },
   {
    "table": "holding_register",
    "address": 55,
    "why": "Control on/off (run/stop)"
   },
   {
    "table": "holding_register",
    "address": 26,
    "why": "Decimal point for scaling"
   }
  ],
  "enable": "Requires the C5 communication option. Set Communication protocol to Modbus RTU (not the Block Read/Write variant) in Auxiliary function setting mode 1, then instrument number, speed, parity and stop bit.",
  "watchdog": null,
  "quirks": [
   "Instrument number 0 is the factory default but is the Modbus broadcast address, so set 1-95 before polling.",
   "Writable registers accept writes even when the keypad set value lock is on.",
   "ON/OFF register 0037H: 0 = ON (STOP), 1 = OFF (RUN)."
  ],
  "setup": [
   "Factory defaults: Shinko protocol, instrument 0, 9600 bps, even parity, 1 stop bit.",
   "Modbus RTU uses 8 data bits; parity and stop bit are selectable.",
   "Up to 31 units per RS485 line, 1.2 km maximum."
  ],
  "gotchas": [
   "Settings are stored in non-volatile memory rated for about 1,000,000 writes; don't write SV cyclically.",
   "Undefined data items may return random data or errors; use only listed items."
  ]
 },
