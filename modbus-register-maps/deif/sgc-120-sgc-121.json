 "integration": {
  "summary": "Poll holding registers 1-59 with function 03 for live values and 78 for genset status. To start or stop remotely, write 2 (START) or 1 (STOP) to register 0 with function 16; write 4 to go to AUTO.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 1,
    "why": "Generator L1-N voltage"
   },
   {
    "table": "holding_register",
    "address": 7,
    "why": "Generator frequency"
   },
   {
    "table": "holding_register",
    "address": 23,
    "why": "Load L1 current"
   },
   {
    "table": "holding_register",
    "address": 29,
    "why": "Total kW"
   },
   {
    "table": "holding_register",
    "address": 56,
    "why": "Battery voltage"
   },
   {
    "table": "holding_register",
    "address": 78,
    "why": "Genset status flags"
   },
   {
    "table": "holding_register",
    "address": 0,
    "why": "Mode-change command"
   }
  ],
  "enable": "Set Communication mode to Modbus in the RS485 COMM menu, then set the server ID (1-247), baud rate and parity.",
  "watchdog": null,
  "quirks": [
   "Only functions 03 and 16 are supported.",
   "Register 0 reads back the protocol revision but accepts mode-key writes."
  ],
  "setup": [
   "Baud 1200-115200 selectable; parity None/Even/Odd; stop bits 1 or 2.",
   "RS-485 is on terminals 15 (B) and 16 (A); the port has a built-in 120 ohm termination resistor.",
   "Up to 255 registers per request; the manual gives a 250 ms no-response timeout."
  ],
  "gotchas": [
   "Phase frequencies are labelled R, Y, B (L1, L2, L3)."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/deif/sgc-120-sgc-121",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
