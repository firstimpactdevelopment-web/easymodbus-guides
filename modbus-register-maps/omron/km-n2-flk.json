{
 "manufacturer": "Omron",
 "manufacturer_slug": "omron",
 "model": "KM-N2-FLK multi-circuit power monitor",
 "model_slug": "km-n2-flk",
 "short_model": "KM-N2-FLK",
 "aliases": [
  "KM-N2-FLK",
  "KM-N2"
 ],
 "equipment_type": "Power meter (multi-circuit power monitor)",
 "applies_to": "Omron KM-N2-FLK power monitor (catalog N200-E1-04).",
 "summary": "The KM-N2-FLK is a compact power monitor that meters up to four 1-phase 2-wire circuits (or two 1P3W/3P3W circuits), each circuit answering on its own Modbus RTU address. Every value is a 32-bit integer in two holding registers, high word first, with fixed scaling (voltage x10, current x1000, power x10). The map covers the measured values, energy counters, key settings and the command register.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": null,
  "baud": 9600,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "The address map prints Modbus addresses in hex and they go on the wire unchanged; the manual's example reads voltage 1 with start address 0000 and 2 registers. Each value takes two registers, so read an even count."
 },
 "default_word_order": "ABCD",
 "firmware": null,
 "source": {
  "title": "Power Monitor model KM-N2-FLK Users Manual",
  "doc_number": "N200-E1-04",
  "revision_date": "2023-05",
  "url": "https://files.omron.eu/downloads/latest/manual/en/n200_km-n2_users_manual_en.pdf",
  "pages": "Section 6.2 Modbus (frames, read/write and command examples) and section 6.4 Address map (measurement values and parameter area)"
 },
 "notes": [
  "Word order: the read example returns 0000 then 0960 for voltage 1 (2400 = 240.0 V), so the high word comes first (ABCD). Negative values are two's complement.",
  "Scaling per the address map: voltage x10, current x1000, power factor x100, frequency x10, active and reactive power x10; energy counters are x1 in the unit named.",
  "Each circuit of the unit is its own Modbus slave. Circuit A's address is set on the rotary switch; circuits B-D automatically take the next addresses in order, and any address above 99 is invalid. The registers here repeat for every circuit.",
  "Settings in the 2000-2210 range can only be read or written after the 'move to setting mode' command (0x0700 to address FFFF); send 'move to measuring mode' (0x0400) afterwards. Measured values can be read in either mode.",
  "Read requests are limited to 2-50 registers and only over consecutive addresses.",
  "Left out: pulse output, voltage selection, data length, conversion factor/unit, LCD, alarm, tariff, model and status registers (2010-2012, 2204, 220C, 2210-240A)."
 ],
