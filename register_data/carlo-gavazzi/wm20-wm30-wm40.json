{
  "manufacturer": "Carlo Gavazzi",
  "manufacturer_slug": "carlo-gavazzi",
  "model": "WM20 / WM30 / WM40 power analyzers",
  "model_slug": "wm20-wm30-wm40",
  "short_model": "WM20/WM30/WM40",
  "aliases": [
    "WM20",
    "WM30",
    "WM40",
    "WM20-96",
    "WM30-96",
    "WM40-96"
  ],
  "equipment_type": "Power meter (power analyzer)",
  "applies_to": "WM20, WM30 and WM40 modular power analyzers with an RS485 (or Ethernet) Modbus module, protocol internal version rev. 4.0 (2018-03-28); WM30 = firmware letter X, WM40 = Y, WM20 = Z.",
  "summary": "The WM20, WM30 and WM40 are Carlo Gavazzi's modular panel power analyzers. Unlike the smaller CG meters, live values are IEEE-754 floats (in base units) and energies are 64-bit counters in Wh/varh, both sent low word first. This map covers per-phase and system voltage, current, power, PF, frequency, asymmetry, phase sequence, total/partial/tariff energy, identification, RS485 settings and energy reset commands.",
  "transport": [
    "RTU",
    "TCP"
  ],
  "defaults": {
    "unit_id": null,
    "baud": null,
    "parity": null,
    "data_bits": null,
    "stop_bits": null,
    "tcp_port": null
  },
  "addressing": {
    "convention": "Modicon",
    "note": "Registers are printed as a 6-digit Modicon number for function 04 (3xxxxx; first digit becomes 4 for function 03) beside the hex physical address placed in the frame. Wire address = physical address (300081 / 0050h is address 0x50). Setup and command rows are written with 06/10h and are listed as holding registers."
  },
  "default_word_order": "CDAB",
  "firmware": "Per-row compatibility codes in the source (X0/Y0/Z0 = all firmware of WM30/WM40/WM20)",
  "source": {
    "title": "WM20-WM30-WM40 Communication Protocol",
    "doc_number": "Internal version rev. 4.0",
    "revision_date": "2018-03-28",
    "url": "https://www.gavazziautomation.com/fileadmin/images/PIM/OTHERSTUFF/COMPRO/WM20_WM30_WM40_CP.pdf",
    "pages": "Data format p. 10; firmware/ID pp. 11-12; instantaneous p. 12-13; energy pp. 17-18; RS485 pp. 26-27; commands pp. 37-41"
  },
  "notes": [
    "Float word order: the document lists the frame bytes as float bits 15-8, 7-0, 31-24, 23-16, i.e. low word first with MSB-first bytes (CDAB).",
    "Integer word order: UINT16/UINT64 are MSB-first inside a word and LSW first across words (p. 10). Under this library's 64-bit convention CDAB means least significant word first with all four words reversed, which is exactly what the document describes: words arrive W0 (least) to W3 (most).",
    "Float units are not printed separately; the variable names (V, A, W, VA, var, Hz, %) are the engineering units, so no scaling is applied.",
    "Energy counters are in Wh / varh (not kWh); divide by 1000 for kWh.",
    "Tariff energies (0524h-0583h) are WM40 only; RS485 settings at 1130h-1132h are documented for WM30 and WM20 only (WM40 uses a different communication module table, not mapped here).",
    "Left out: the hour counter (0520h), whose value packs hours x100 plus minutes in the remainder rather than a plain scale; K-factor, temperature, analogue-input and the model-dependent 'A' rows at 0090h-009Ah, which overlap by model; odd/even THD, TDD, max/min/demand blocks; harmonic tables; module and alarm configuration; clock; record-file and special-register (42h) functions.",
    "Removed on verification: total THD floats (00A0h-00B0h). The table names them 'THD tot ...' without any unit, and the document never says whether the float is a percentage or a ratio, so the scaling is ambiguous. (Asymmetry rows 008Ah/008Ch print '%' in the name and are kept.)"
  ],
  "integration": {
    "summary": "Read input registers 0050h-008Fh as floats (low word first) for live values and 0500h-051Fh as UINT64 Wh/varh counters (least significant word first).",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 80,
        "why": "V L1-N (float)"
      },
      {
        "table": "input_register",
        "address": 96,
        "why": "A L1 (float)"
      },
      {
        "table": "input_register",
        "address": 110,
        "why": "W system (float)"
      },
      {
        "table": "input_register",
        "address": 134,
        "why": "PF system"
      },
      {
        "table": "input_register",
        "address": 136,
        "why": "Frequency"
      },
      {
        "table": "input_register",
        "address": 1280,
        "why": "Total kWh(+) in Wh"
      },
      {
        "table": "input_register",
        "address": 1288,
        "why": "Total kWh(-) in Wh"
      },
      {
        "table": "input_register",
        "address": 11,
        "why": "Model ID (WM20/30/40)"
      }
    ],
    "enable": "Fit an RS485 (or Ethernet) communication module. Change RS485 address/baud/parity in 1130h-1132h, then write 1 to 3052h (or power-cycle) to apply.",
    "watchdog": null,
    "quirks": [
      "Floats are low word first (CDAB).",
      "64-bit energy counters are least significant word first and in Wh/varh.",
      "Up to 125 registers per read; functions 03/04 equivalent; 06 and 10h for writes."
    ],
    "setup": [
      "Terminate the last instrument and the host; above 1000 m use a line amplifier.",
      "WM20/WM30 RS485 baud options: 9600, 19200, 38400, 115200; parity none/odd/even."
    ],
    "gotchas": [
      "New RS485 settings take effect only after the update command 3052h or a power cycle."
    ]
  },
