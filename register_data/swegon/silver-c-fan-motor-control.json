  "integration": {
    "summary": "Set coil 7 (Control) to 0 so speed comes from Modbus, write the speed setpoint in 0.01 % to holding register 0 and switch the motor with coil 0. Poll input registers 3-8 for output, speed, temperature, voltage, current and power, and discrete inputs 0-27 for alarms.",
    "minimum_registers": [
      {
        "table": "coil",
        "address": 0,
        "why": "Motor on/off"
      },
      {
        "table": "coil",
        "address": 7,
        "why": "Speed source Modbus or 0-10 V"
      },
      {
        "table": "holding_register",
        "address": 0,
        "why": "Speed setpoint 0.01 %"
      },
      {
        "table": "input_register",
        "address": 3,
        "why": "Actual output %"
      },
      {
        "table": "input_register",
        "address": 4,
        "why": "Actual speed"
      },
      {
        "table": "input_register",
        "address": 8,
        "why": "Input power W"
      },
      {
        "table": "discrete_input",
        "address": 10,
        "why": "Internal stop alarm"
      },
      {
        "table": "coil",
        "address": 1,
        "why": "Alarm reset"
      }
    ],
    "enable": "Communication settings are changed with the TBLZ-4-75 hand-held terminal (or the matching holding registers). Coil 7 selects whether speed follows Modbus or the 0-10 V input. Coil 18 can lock the configuration against Modbus writes.",
    "watchdog": "Comm. timeout 0-240 s, factory 10 s (holding register 21). What the fan does on timeout is not described.",
    "quirks": [
      "Factory slave address is 54 decimal (0x36); the addressing pins on connector A/B select 54-57 so several fan controllers share one bus.",
      "Coils are written with FC05 using 0xFF00 for ON.",
      "Factory serial setting is 38400 baud, no parity, 1 stop bit; the alternative factory setting is 115200, even parity."
    ],
    "setup": [
      "Connect to terminals Bus A / Bus B / GND or to RJ12 connector A or B; connector C is the master port for external sensors.",
      "Use the hand-held terminal to change address, baud rate, parity and timeout."
    ],
    "gotchas": [
      "Do not use RJ12 connector C for the BMS; it is a master port.",
      "Speed and limit registers change units between EC (rpm) and FC (0.01 Hz) configurations."
    ]
  },
  "verified": {
    "date": "2026-11-17",
    "method": "independent re-check of every register against the source PDF"
  }
}
