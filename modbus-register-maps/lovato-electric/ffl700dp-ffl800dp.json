 "integration": {
  "summary": "Read the alarm words 2200h-2205h and the global status 2210h for supervision, plus engine speed, battery voltages and fuel level. Subtract one from every table address.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 8719,
    "why": "Global status (MAN/AUT, alarm, engine started)"
   },
   {
    "table": "input_register",
    "address": 8703,
    "why": "Alarms A01-A16"
   },
   {
    "table": "input_register",
    "address": 8704,
    "why": "Alarms A17-A32 (failure to start)"
   },
   {
    "table": "input_register",
    "address": 5,
    "why": "Engine speed"
   },
   {
    "table": "input_register",
    "address": 3853,
    "why": "Battery A voltage"
   },
   {
    "table": "input_register",
    "address": 4003,
    "why": "Fuel level"
   }
  ],
  "enable": "In SETUP, menu M17 (communication), set node address, port speed, data format, stop bits and protocol for the port in use; port 1 is the built-in RS-485.",
  "watchdog": null,
  "quirks": [
   "Table addresses are one above the wire address.",
   "32-bit values are high word first.",
   "Function 06 writes only to addresses above 1000h."
  ],
  "setup": [
   "Defaults: node 01, 9600 baud, 8 data bits, no parity, 1 stop bit, Modbus RTU.",
   "Up to 3 communication ports can be configured (n = 1...3)."
  ],
  "gotchas": [
   "The example frame in the document labels the battery A register as 'number of switching alarms of breaker 1'; the address (0F0Eh sent as 0F 0D) and the value (12.07 VDC) are battery A."
  ]
 },
