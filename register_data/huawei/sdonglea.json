{
  "manufacturer": "Huawei",
  "manufacturer_slug": "huawei",
  "model": "SDongleA smart dongle (Modbus TCP)",
  "model_slug": "sdonglea",
  "short_model": "SDongleA",
  "aliases": [
    "SDongleA-01",
    "SDongleA-02-CN",
    "SDongleA-03-EU",
    "SDongleA-03-AU",
    "SDongleA-03-KR",
    "SDongleA-03-JP",
    "SDongleA-03-CN"
  ],
  "equipment_type": "Solar inverter gateway (smart dongle)",
  "applies_to": "Huawei SDongleA WLAN/WLAN-FE/4G dongles with firmware V100R001C00SPC100 or later, per MODBUS Interface Definitions issue 05.",
  "summary": "The SDongleA is Huawei's smart dongle. It acts as a Modbus TCP server for itself (logical device ID 100) and for the inverters, power meter and other devices it manages (IDs 1-247). This map covers the dongle's own registers: identity, network and traffic status, plant-level input, load, grid and battery power, time settings, management-server and NTP settings, and the reset and device-search commands.",
  "transport": [
    "TCP"
  ],
  "defaults": {
    "unit_id": 100,
    "baud": null,
    "parity": null,
    "data_bits": null,
    "stop_bits": null,
    "tcp_port": null
  },
  "addressing": {
    "convention": "0-based",
    "note": "Register addresses are sent as printed. The read example puts 0x89C0 (35264, the mobile signal-strength register) in the request, so 35264 goes on the wire unchanged."
  },
  "default_word_order": "ABCD",
  "firmware": "V100R001C00SPC100 or later",
  "source": {
    "title": "SDongleA V100R001C00 MODBUS Interface Definitions",
    "doc_number": "Issue 05",
    "revision_date": "2022-07-06",
    "url": "https://community.symcon.de/uploads/short-url/qyJdcRAZ1Ks4UonBY9Ddh3kXA4Y.pdf",
    "pages": "p. 2 (models, firmware), pp. 3-9 (register table), pp. 10-12 (addressing, device IDs, encoding), pp. 15-16 (read example)",
    "unofficial": true
  },
  "notes": [
    "Huawei publishes this document only behind a support-site login; the copy linked is a forum upload of the unaltered Huawei PDF.",
    "Data encoding is big-endian for addresses and data, with the leftmost byte sent first, so 32-bit values are read high word first (ABCD).",
    "Gain is a divisor: power has gain 1000 in kW (so 1 count = 1 W) and traffic gain 100 in MB.",
    "The read example's text names register 32306 but its frame bytes request 0x89C0 (35264); the frame bytes were used to settle the numbering.",
    "Left out: Device operation (47402, 11 registers mixing an SN string with a command word), whose layout is better taken from the source directly.",
    "The TCP port is not stated in this document."
  ],
