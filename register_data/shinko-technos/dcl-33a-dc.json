  ],
  "equipment_type": "Sensor (digital temperature controller)",
  "applies_to": "Shinko DCL-33A DC with the C5 option; communication manual No.DCL3CDCE2.",
  "summary": "The DCL-33A DC is a Shinko PID temperature controller variant with its own communication manual and command table. With the C5 option it speaks Shinko protocol, Modbus ASCII or Modbus RTU on RS485; all items are signed 16-bit holding registers. The map covers SV, PID, alarm, heater burnout and loop break settings, input type, PV, MV, status and heater current.",
  "transport": [
    "RTU",
    "ASCII"
  ],
  "defaults": {
    "unit_id": 0,
    "baud": 9600,
    "parity": "Even",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "hex 0-based",
    "note": "Registers are listed as hex data items (0001H) that go into the request unchanged. The manual adds that the matching Modicon holding-register number is the item in decimal plus 40001 (0001H = 40002)."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "Communication Instruction Manual DCL-33A DC (C5)",
    "doc_number": "No.DCL3CDCE2",
    "revision_date": "2014-03",
    "url": "https://shinko-technos.co.jp/e/manual/english/DCL3CDCE2.pdf",
    "pages": "Section 7 command table, pp. 11-13; communication settings p. 2"
  },
  "notes": [
    "All data are 16-bit two's complement. Values with a decimal point are sent as whole numbers; apply the decimal point place (001AH).",
    "Units of PID times, cycles and MV are not printed in the command table.",
    "Protocol, instrument number, speed, parity and stop bit are keypad-only settings."
  ],
  "integration": {
    "summary": "Choose Modbus RTU in Auxiliary function setting mode 1 and set a non-zero instrument number, then poll PV 0080H, MV 0081H/0082H and status 0085H; write SV at 0001H.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 128,
        "why": "Process value"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "Set value"
      },
      {
        "table": "holding_register",
        "address": 129,
        "why": "OUT1 manipulated value"
      },
      {
        "table": "holding_register",
        "address": 133,
        "why": "Status bits"
      },
      {
        "table": "holding_register",
        "address": 26,
        "why": "Decimal point for scaling"
      }
    ],
    "enable": "Requires the C5 option. Hold the key pair shown on p. 2 for 3 s to enter Auxiliary function setting mode 1, press the advance key twice to reach Communication protocol, choose Modbus RTU, then set instrument number, speed, parity and stop bit.",
    "watchdog": null,
    "quirks": [
      "Instrument number defaults to 0, the Modbus broadcast address; set 1-95."
    ],
    "setup": [
      "Factory defaults: Shinko protocol, instrument 0, 9600 bps, even parity, 1 stop bit.",
      "Speeds 2400, 4800, 9600, 19200 bps."
    ],
    "gotchas": [
      "This map differs from the DCL-33A manual DCL32CE3; check which manual matches the unit."
    ]
  },
