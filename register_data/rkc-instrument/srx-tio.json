{
  "manufacturer": "RKC Instrument",
  "manufacturer_slug": "rkc-instrument",
  "model": "SRX module type controller, TIO temperature control module (Modbus RTU)",
  "model_slug": "srx-tio",
  "short_model": "SRX TIO",
  "aliases": [
    "SRX",
    "X-TIO-A",
    "X-TIO-B",
    "SRX TIO module",
    "RKC SRX"
  ],
  "equipment_type": "Sensor (modular temperature controller)",
  "applies_to": "RKC SRX two-channel temperature control (TIO) modules, basic type X-TIO-A and extension type X-TIO-B, with Modbus selected; DI and DO module maps are not included.",
  "summary": "The SRX is a DIN-rail modular controller: each TIO module runs two PID loops, and extension, DI and DO modules share the bus of a basic TIO module. With DIP switch 6 set to Modbus, each TIO module answers Modbus RTU on RS-485 with channel 1 data at 0000H and channel 2 data at 1000H. This map covers measured values, events, setpoints, PID, manual output, program run control and the key input setup items.",
  "transport": [
    "RTU"
  ],
  "defaults": {
    "unit_id": 1,
    "baud": 9600,
    "parity": "None",
    "data_bits": 8,
    "stop_bits": 1,
    "tcp_port": null
  },
  "addressing": {
    "convention": "hex 0-based",
    "note": "The data map prints each register in hex and decimal; the value is the address sent on the wire. The manual's read example asks for 0000H-0002H and gets back PV, event state and output, so 0000H is a real register (CH1 measured value)."
  },
  "default_word_order": null,
  "firmware": null,
  "source": {
    "title": "SRX Communication Instruction Manual (Module Type Controller)",
    "doc_number": "IMS01N01-E5",
    "revision_date": null,
    "url": "https://www.flw.com/rkc/pdf/ims01n01e5.pdf",
    "pages": "Settings pp. 15-16; Modbus frames pp. 70-73; decimal handling pp. 74-77; TIO data map pp. 78-89",
    "unofficial": true
  },
  "notes": [
    "RKC's own download center does not offer this manual publicly; the linked copy is the unaltered RKC manual hosted by a US distributor (a distributor stamp on the cover only).",
    "All registers are 16-bit; FFFFH is -1. Values are sent without a decimal point: PV/SV-type items follow the input range decimal point (0873H), integral/derivative time follows 085CH, others have the fixed decimals shown (scale).",
    "Items marked (module) exist once per module (channel 1 address only); all others repeat for channel 2 at +1000H.",
    "The decimal-handling list prints Manual output value twice and does not name the manipulated output (0002H); its scale 0.1 rests on its printed -5.0 to +105.0 % range.",
    "Level PID tables, program pattern/segment tables, digital input assignments and the DI/DO module maps are left out.",
    "Writing input range, scale, decimal point, unit or event type can take up to 200 ms to answer; stop control (0030H) before changing initial-setting items."
  ],
  "integration": {
    "summary": "Set DIP switch 6 ON (Modbus) and the rotary address, then read 0000H-0003H for CH1 PV, event state, output and SV monitor (1000H-1003H for CH2). Write the setpoint to 0010H/1010H and start control with 0030H = 1.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 0,
        "why": "CH1 measured value"
      },
      {
        "table": "holding_register",
        "address": 1,
        "why": "CH1 event state"
      },
      {
        "table": "holding_register",
        "address": 2,
        "why": "CH1 output"
      },
      {
        "table": "holding_register",
        "address": 16,
        "why": "CH1 set value"
      },
      {
        "table": "holding_register",
        "address": 48,
        "why": "Control RUN/STOP"
      },
      {
        "table": "holding_register",
        "address": 4096,
        "why": "CH2 measured value"
      },
      {
        "table": "holding_register",
        "address": 4112,
        "why": "CH2 set value"
      }
    ],
    "enable": "Modbus is chosen with DIP switch 6 (ON = Modbus; factory setting is RKC protocol). Speed is set by DIP switches 1-2, data/parity by 3-5. Power off before changing switches.",
    "watchdog": null,
    "quirks": [
      "The Modbus slave address is the rotary switch setting plus 1 (switch 00 = slave 1).",
      "Each module (slave address) carries at most two channels.",
      "Writes to undefined addresses are not allowed; with a data error part-way through a multi-write, the values before the error still take effect."
    ],
    "setup": [
      "Factory DIP settings: 9600 bps, 8 data bits, no parity, 1 stop bit (fixed). Speeds 2400-38400 bps.",
      "Give the basic TIO module the lowest address when extension modules share its bus; terminate the internal data bus at both ends (DIP 8)."
    ],
    "gotchas": [
      "Wait 30 bit times after a response before the next request; the response takes up to 5 ms (200 ms after initial-setting writes).",
      "Some items read 0 when the matching function is not fitted or not in use (no error is returned)."
    ]
  },
