 "integration": {
  "summary": "Wire RS485 to terminals 23 and 24, poll unit 1 at 9600 baud 8E1 with function 03 and decode each value as a high-word-first float. Live values sit at 5000h-502Bh, energy at 6000h-604Ah.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 20480,
    "why": "Voltage"
   },
   {
    "table": "holding_register",
    "address": 20490,
    "why": "Current"
   },
   {
    "table": "holding_register",
    "address": 20498,
    "why": "Total active power (kW)"
   },
   {
    "table": "holding_register",
    "address": 20522,
    "why": "Power factor"
   },
   {
    "table": "holding_register",
    "address": 20488,
    "why": "Grid frequency"
   },
   {
    "table": "holding_register",
    "address": 24588,
    "why": "Forward (import) active energy"
   },
   {
    "table": "holding_register",
    "address": 24600,
    "why": "Reverse (export) active energy"
   }
  ],
  "enable": "Modbus is on the -Mod version only. Set the ID in Program mode 2 and baud/parity in Program mode 3 (4-digit password, default 0000), or over Modbus at 4003h/4004h/4011h.",
  "watchdog": null,
  "quirks": [
   "Addresses are hex: 5012h is decimal 20498 on the wire.",
   "Floats are ABCD (high word first).",
   "Power is in kW/kvar/kVA, not W.",
   "Default parity is even (8E1), not 8N1."
  ],
  "setup": [
   "RS485 on terminals 23 and 24; defaults Modbus ID 1, 9600 baud, 8 data bits, even parity, 1 stop bit.",
   "Baud can be lowered to 4800, 2400 or 1200; parity can be none or odd; data and stop bits are fixed.",
   "Fit a 120 ohm / 0.25 W resistor across the RS485 terminals at the meter when testing through an RS485 converter."
  ],
  "gotchas": [
   "Program mode 3 settings (S0, combination code, baud, parity, power-down counter) need the display password (default 0000).",
   "Total active energy (6000h) follows the combination code; read forward (600Ch) and reverse (6018h) for import and export."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/inepro-metering/pro1-mod-v3",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
