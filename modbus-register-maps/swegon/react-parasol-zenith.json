 "integration": {
  "summary": "Write the setpoint in 0.01 % to address 0 (with Setpoint Source = Bus) and read relative position (address 4) and relative or absolute flow (addresses 6-7). Use Override Control (address 1) to force open/close and the bus watchdog (addresses 108-109) for a safe position on comms loss.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 0,
    "why": "Setpoint %"
   },
   {
    "table": "holding_register",
    "address": 1,
    "why": "Override control"
   },
   {
    "table": "holding_register",
    "address": 4,
    "why": "Relative position"
   },
   {
    "table": "holding_register",
    "address": 6,
    "why": "Relative flow"
   },
   {
    "table": "holding_register",
    "address": 7,
    "why": "Absolute flow m³/h"
   },
   {
    "table": "holding_register",
    "address": 104,
    "why": "Malfunction flags"
   },
   {
    "table": "holding_register",
    "address": 118,
    "why": "Setpoint source"
   }
  ],
  "enable": "Setpoint Source (address 118) must be Bus for Modbus setpoints. Bus termination is set with the actuator configuration tools.",
  "watchdog": "Bus Fail Position (address 108) and Timeout for Bus Watchdog (address 109, 0-3600 s; 0 = off). If neither setpoint nor override is rewritten within the timeout, the actuator goes to the fail position and sets bit 10 in address 104.",
  "quirks": [
   "Register numbers in the sheet start at 1; send Address = No. - 1.",
   "32-bit flows are low word first."
  ],
  "setup": [
   "External 120 ohm termination at the line ends; No. 100 shows whether the built-in terminator is active.",
   "Max 32 nodes without a repeater."
  ],
  "gotchas": [
   "Vmax must stay above 20 % and at or above Vmin."
  ]
 },
