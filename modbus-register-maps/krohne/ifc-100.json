{
 "manufacturer": "KROHNE",
 "manufacturer_slug": "krohne",
 "model": "IFC 100 electromagnetic flow converter (Modbus RTU)",
 "model_slug": "ifc-100",
 "short_model": "IFC 100",
 "aliases": [
  "IFC100",
  "IFC 100 Modbus",
  "KROHNE IFC 100"
 ],
 "equipment_type": "Sensor (electromagnetic flowmeter)",
 "applies_to": "IFC 100 signal converter with the Modbus option, supplementary instructions 4001410101 R01 (08/2014).",
 "summary": "The IFC 100 is a KROHNE signal converter for electromagnetic flowmeters. With the Modbus option it is an RS-485 Modbus RTU slave. This map covers flow, temperature, conductivity and diagnosis floats, the two double-float totalisers, counter and filter settings, calibration values, serial parameters and the control coils.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "The manual lists protocol addresses and says they go into the request unchanged: input register 30006 is requested as start address 30006 (0x7536). The same registers are mirrored lower for masters that cannot use high addresses (30000-38998 -> 0-8998, 20000-20998 -> 9000-9998, 40000-49998 -> 0-9998)."
 },
 "default_word_order": "ABCD",
 "firmware": "Electronic revision ER 3.0.xx, Modbus version 1.0.xx",
 "source": {
  "title": "IFC 100 Supplementary instructions - Description of Modbus interface",
  "doc_number": "4001410101 R01",
  "revision_date": "2014-08",
  "url": "https://cdn.krohne.com/archive/AD_IFC100_Modbus_en_140728_4001410101_R01.pdf",
  "pages": "Serial settings p. 6; addressing pp. 8-9; coils pp. 10-11; input registers p. 12; holding registers pp. 13-16; calibration pp. 17-19"
 },
 "notes": [
  "Data format is selectable (C5.8.4 or holding 50004): Big Endian, which the manual defines as MSB first for the data bytes, is the default, so 32-bit floats and 64-bit doubles are listed ABCD. With Little Endian (LSB first) selected the whole value is byte-reversed. The manual gives no worked byte example.",
  "Input registers 30000-30034 can also be read at 0-34, and holding registers 40000-49998 at 0-9998; only the primary addresses are listed.",
  "Left out: long status sensor/device (30032 / 30034, byte[4]) because the bit meanings are not given in this document; 'no function' and 'not used' registers.",
  "Factory serial settings: address 1, 19200 baud, even parity, 1 stop bit, Big Endian, 0 ms response delay.",
  "byte and word types in the holding tables each occupy one register and are listed as UINT16."
 ],
