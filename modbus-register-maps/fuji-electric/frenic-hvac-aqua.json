 "integration": {
  "summary": "Set y10 = 0 (Modbus RTU), y01 address and y04/y06 serial settings, and H30 = 3 so frequency and run commands come from RS-485. Write S05 (Hz) or S01 (p.u.) for speed and S06 bit 0/1 for run forward/reverse; poll M09, M11, M14 and M16.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 1797,
    "why": "S05 frequency command"
   },
   {
    "table": "holding_register",
    "address": 1798,
    "why": "S06 run command"
   },
   {
    "table": "holding_register",
    "address": 1806,
    "why": "S14 alarm reset"
   },
   {
    "table": "holding_register",
    "address": 2057,
    "why": "M09 output frequency"
   },
   {
    "table": "holding_register",
    "address": 2059,
    "why": "M11 output current"
   },
   {
    "table": "holding_register",
    "address": 2062,
    "why": "M14 status"
   },
   {
    "table": "holding_register",
    "address": 2064,
    "why": "M16 latest alarm"
   },
   {
    "table": "holding_register",
    "address": 1054,
    "why": "H30 link mode"
   }
  ],
  "enable": "Select Modbus RTU with y10 = 0 and set H30 (communications link function) so the frequency and/or run command come from RS-485 (3 = both from the RJ-45 port). If a digital input is assigned to LE (enable communications link), it must be ON.",
  "watchdog": "y08 sets a no-response detection time (0 = off, 1-60 s); y02/y03 choose whether the drive trips at once, after a timer, or keeps running.",
  "quirks": [
   "Addresses are function-code based: wire address = group code x 256 + number (for example H30 = 4 x 256 + 30 = 1054).",
   "Reads are limited to 50 words and do not cross a function code group; unused codes read as 0.",
   "Reading S codes returns the last value written over comms, not the live command; read the M codes for the live value.",
   "Alarm reset through S06 needs bit 15 set then cleared; S14 = 1 resets in one write.",
   "S14 = 1 resets an alarm even when H30, y98, y99 or the LE terminal block the link; S06 bit 15 only works when the link is enabled."
  ],
  "setup": [
   "y01 station address 1-247, y04 baud (0-4 = 2400-38400 bps), y06 parity (stop bits follow parity in Modbus RTU), data length fixed at 8 bits.",
   "y09 adds a response interval (0.00-1.00 s) for slow masters."
  ],
  "gotchas": [
   "If S01 is not 0 it overrides S05; write 0 to S01 when using S05.",
   "Writing an alarm reset while a run command is still set restarts the drive immediately."
  ]
 },
