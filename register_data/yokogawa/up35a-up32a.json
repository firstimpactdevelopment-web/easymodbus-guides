  "integration": {
    "summary": "Select a pattern with D2322 and start it with D2316 = 1 (PROG); stop with 0 (RESET). Poll D2003-D2008 for PV, SP, output and mode, D2015-D2017 for pattern, segment and remaining time, and D2040 for time events.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 2002,
        "why": "Loop-1 PV (D2003)"
      },
      {
        "table": "holding_register",
        "address": 2003,
        "why": "Loop-1 SP (D2004)"
      },
      {
        "table": "holding_register",
        "address": 2007,
        "why": "Operation mode status (D2008)"
      },
      {
        "table": "holding_register",
        "address": 2015,
        "why": "Current segment (D2016)"
      },
      {
        "table": "holding_register",
        "address": 2010,
        "why": "Alarm status (D2011)"
      },
      {
        "table": "holding_register",
        "address": 2315,
        "why": "Program MODE (D2316)"
      },
      {
        "table": "holding_register",
        "address": 2321,
        "why": "Pattern number (D2322)"
      }
    ],
    "enable": "Set the communication setup parameters (protocol MBRTU or MBASC, baud, parity, stop bits, data length, address) on the keypad. Ethernet models use Modbus/TCP on port 502 by default.",
    "watchdog": null,
    "quirks": [
      "Address D register n at wire address n-1.",
      "Write values without the decimal point (50.0 with one decimal place = 500)."
    ],
    "setup": [
      "Factory defaults: Modbus RTU, 19200 bps, even parity, 1 stop bit, 8 data bits, address 1."
    ],
    "gotchas": [
      "HOLD (D2317) and ADV (D2318) are program-operation items: write them while a program is running."
    ]
  },
  "verified": {
    "date": "2026-11-19",
    "method": "independent re-check of every register against the source PDF"
  }
}
