  "integration": {
    "summary": "Poll Nos. 20-24 (temperatures and delta T), 8 (flow), 28/34 (cooling/heating power) and 66/72 (energy) with FC03, decoding 32-bit values low word first. Check No. 105 for sensor and flow faults.",
    "minimum_registers": [
      {
        "table": "holding_register",
        "address": 7,
        "why": "Flow l/s"
      },
      {
        "table": "holding_register",
        "address": 19,
        "why": "Remote temperature"
      },
      {
        "table": "holding_register",
        "address": 21,
        "why": "Flow-body temperature"
      },
      {
        "table": "holding_register",
        "address": 23,
        "why": "Delta T"
      },
      {
        "table": "holding_register",
        "address": 27,
        "why": "Cooling power kW"
      },
      {
        "table": "holding_register",
        "address": 33,
        "why": "Heating power kW"
      },
      {
        "table": "holding_register",
        "address": 65,
        "why": "Cooling energy kWh"
      },
      {
        "table": "holding_register",
        "address": 71,
        "why": "Heating energy kWh"
      },
      {
        "table": "holding_register",
        "address": 104,
        "why": "Fault bitmask"
      }
    ],
    "enable": "Modbus is the native interface; set address, baud rate and frame format with Belimo Assistant 2 or the built-in web server.",
    "watchdog": null,
    "quirks": [
