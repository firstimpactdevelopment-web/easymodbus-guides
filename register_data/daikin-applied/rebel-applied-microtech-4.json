{
 "manufacturer": "Daikin Applied",
 "manufacturer_slug": "daikin-applied",
 "model": "Rebel / Rebel Applied rooftop (MicroTech 4 controller)",
 "model_slug": "rebel-applied-microtech-4",
 "short_model": "Rebel Applied Rooftop",
 "aliases": [
  "DPSA",
