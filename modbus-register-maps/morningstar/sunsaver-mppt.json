{
 "manufacturer": "Morningstar",
 "manufacturer_slug": "morningstar",
 "model": "SunSaver MPPT solar charge controller (Modbus RTU via MeterBus)",
 "model_slug": "sunsaver-mppt",
 "short_model": "SunSaver MPPT",
 "aliases": [
  "SunSaver MPPT",
  "SS-MPPT"
 ],
 "equipment_type": "Solar charge controller (MPPT, battery charger)",
 "applies_to": "Morningstar SunSaver MPPT through the MSC MeterBus-to-RS-232 adapter; Modbus specification v11.",
 "summary": "The SunSaver MPPT is a Morningstar MPPT solar charge controller with a load output. It speaks Modbus RTU on its RJ-11 meter port through Morningstar's MSC adapter (MeterBus to RS-232). RAM registers give battery, array and load readings, charge and load state and fault bitfields; EEPROM registers hold the charge setpoints and LO-first copies of the Ah and hour counters; coils force load/charge disconnect and clear counters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 9600,
  "parity": "None",
  "data_bits": 8,
  "stop_bits": 2,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Morningstar prints a PDU address (hex, goes on the wire as-is) and a logical address (PDU + 1). The manual states all listed addresses are request-PDU addresses; its scaling example reads battery voltage at 0x0008."
 },
 "default_word_order": "CDAB",
 "firmware": "Va_ref_fixed registers need firmware v08 or later.",
 "source": {
  "title": "SunSaver MPPT MODBUS Specification",
  "doc_number": "v11",
  "revision_date": "2017-04-03",
  "url": "https://www.morningstarcorp.com/wp-content/uploads/technical-doc-sunsaver-mppt-modbus-specification-en.pdf",
  "pages": "p. 3 (parameters), pp. 3-7 (RAM, EEPROM, coils), pp. 11-17 (definitions and enums), p. 27 (examples)"
 },
 "notes": [
  "Scaling: Morningstar gives formulas such as n x 100 x 2^-15; these are converted to a single multiplier (e.g. 100/32768 = 0.0030517578125 for voltages, 79.16/32768 for currents, 989.5/65536 for power, 96.667/32768 for Vb_ref). The manual's example: 0x0F96 = 3990 x 100 / 32768 = 12.18 V.",
  "Word order: the RAM table names each 32-bit pair HI word then LO word (e.g. hourmeter_HI 0x0021, hourmeter_LO 0x0022), but the spec's own two-word example reads the hourmeter LO word at the lower address. Because the document contradicts itself, the RAM 32-bit values (Ah counters 0x0015-0x0020, hourmeter 0x0021, alarm 0x0023 and daily alarm 0x0031) are left out. The EEPROM read-only copies are printed LO word first (Ehourmeter_LO 0xE040, Ehourmeter_HI 0xE041), which matches the example, so those are listed as CDAB.",
  "The two-word example uses addresses 0x0025/0x0026 for the hourmeter, which do not match the table (0x0021/0x0022).",
  "Both Read Holding (0x03) and Read Input (0x04) are supported; registers are listed as holding registers. EEPROM is written with Write Single Register (0x06) only.",
  "Alarm bitfield bits (32-bit value at 0x0023, not listed): 0 RTS open, 1 RTS shorted, 2 RTS disconnected, 3 Ths open, 4 Ths shorted, 5 SSMPPT hot, 6 current limit, 7 current offset, 10 uncalibrated, 11 RTS miswire, 14 miswire, 15 FET open, 16 P12, 17 high Va current limit.",
  "Not listed: bank-2 charge settings (0xE00D-0xE017), LED thresholds, the data logger (0x8000-0x81FF) and the remaining EEPROM timers.",
  "Voltages and currents are listed as unsigned raw values; temperatures are signed (-128 to +127)."
 ],
 "integration": {
  "summary": "Connect through the Morningstar MSC adapter at 9600 8N2, ID 1. Read 0x0008-0x0014 for live data; multiply raw voltages by 100/32768 and currents by 79.16/32768. Use coils 0x0001/0x0002 to switch the load or charger off remotely.",
  "minimum_registers": [
   {
    "table": "holding_register",
    "address": 8,
    "why": "Battery voltage"
   },
   {
    "table": "holding_register",
    "address": 9,
    "why": "Array voltage"
   },
   {
    "table": "holding_register",
    "address": 11,
    "why": "Charging current"
   },
   {
    "table": "holding_register",
    "address": 17,
    "why": "Charge state"
   },
   {
    "table": "holding_register",
    "address": 18,
    "why": "Array faults"
   },
   {
    "table": "holding_register",
    "address": 39,
    "why": "Charge output power"
   },
   {
    "table": "coil",
    "address": 1,
    "why": "Remote load disconnect"
   }
  ],
  "enable": "Set the comm DIP switch (switch 4, reported as bit 3 of register 0x0025) to MODBUS protocol instead of Meterbus, and connect via the MSC RS-232 adapter.",
  "watchdog": null,
  "quirks": [
   "Every analog value needs its own formula-derived multiplier; there are no floats.",
   "Any EEPROM write sets an 'EEPROM changed' fault; reset the controller (coil 0x00FF) to clear it. Writes are not verified."
  ],
  "setup": [
   "Serial: 9600 baud, 8 data bits, no parity, 2 stop bits, no flow control.",
   "Modbus ID is stored in EEPROM at 0xE034 (1-247)."
  ],
  "gotchas": [
   "The MeterBus port is not RS-485; a Morningstar adapter is required."
  ]
 },
