 "integration": {
  "summary": "Read input registers 200-264 for measurements and 101/103/107 for breaker state, alarms and trips. Open, close or reset by writing command type and parameter (registers 0-1) together with function 16.",
  "minimum_registers": [
   {
    "table": "input_register",
    "address": 101,
    "why": "CB open/closed, tripped, remote"
   },
   {
    "table": "input_register",
    "address": 107,
    "why": "Which protection tripped"
   },
   {
    "table": "input_register",
    "address": 203,
    "why": "L1 current"
   },
   {
    "table": "input_register",
    "address": 219,
    "why": "V12 voltage"
   },
   {
    "table": "input_register",
    "address": 228,
    "why": "Total active power"
   },
   {
    "table": "input_register",
    "address": 256,
    "why": "Total active energy"
   },
   {
    "table": "holding_register",
    "address": 0,
    "why": "Commands (open/close/reset)"
   }
  ],
  "enable": "Fit the PR120/D-M (or PR330/D-M) module and set address, baud and parity on the trip unit. The breaker must be in Remote mode (state 2 bit 9) for open/close commands.",
  "watchdog": null,
  "quirks": [
   "32-bit values are low word first.",
   "Measures are input registers (function 4), not holding registers.",
   "Commands need function 16 even when the parameter is 0."
  ],
  "setup": [
   "Defaults: address 247, 19200 baud, E,8,1; 9600 baud and O,8,1 / N,8,2 / N,8,1 also available."
  ],
  "gotchas": [
   "Factory address is 247, not 1.",
   "Glitch state bits in register 100 clear when read."
  ]
 },
 "page": "https://easymodbus.com/modbus-register-maps/abb/pr122-pr123-pr332-pr333-modbus",
 "address_note": "address = 0-based Modbus wire (PDU) address; documented = as printed in the source.",
 "note": "Re-typed from the manufacturer's public documentation (see source) and verified against it. Registers vary by firmware and options; verify against the live device before writing."
}
