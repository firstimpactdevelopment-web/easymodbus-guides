{
 "manufacturer": "INVT",
 "manufacturer_slug": "invt",
 "model": "Goodrive350 (GD350) high-performance multifunction VFD",
 "model_slug": "goodrive350-gd350",
 "short_model": "GD350",
 "aliases": [
  "GD350",
  "Goodrive350",
  "GD350 series"
 ],
 "equipment_type": "Variable frequency drive",
 "applies_to": "INVT Goodrive350 drives (not GD350A) using the built-in RS-485 Modbus RTU port, per the GD350 manual V1.1 (communication chapter).",
 "summary": "INVT's high-performance vector drive with option slots for fieldbuses, encoders and I/O. The built-in RS-485 port speaks Modbus RTU. Commands and setpoints go to the 2000H block, status and fault words sit at 2100H-2103H, monitors at 3000H onwards, and each function parameter has its own hex address. This map covers that block plus the run-source, P14 serial and fault parameters.",
 "transport": [
  "RTU"
 ],
 "defaults": {
  "unit_id": 1,
  "baud": 19200,
  "parity": "Even",
  "data_bits": 8,
  "stop_bits": 1,
  "tcp_port": null
 },
 "addressing": {
  "convention": "hex 0-based",
  "note": "Addresses are printed in hex and go on the wire unchanged. Parameter P00.00 sits at 0000H and the manual's example frames carry the address bytes directly (reading state word 2100H is sent as 01 03 21 00 00 01, and setting P01.20 as 01 06 01 14 00 32)."
 },
 "default_word_order": null,
 "firmware": null,
 "source": {
  "title": "Goodrive350 Series High-performance Multifunction VFD Operation Manual",
  "doc_number": "V1.1",
  "revision_date": null,
  "url": "https://www.invt.com/uploads/file1/20210729/GD350%20Series%20VFD%20Manual_V1.1.pdf",
  "pages": "P00 group, P07.27 fault list, pp. 200-202 (P14 group), pp. 275-279 (other function addresses, examples)"
 },
 "notes": [
  "Every register is a single 16-bit word; there are no 32-bit values in this map.",
  "Any function parameter can be read or written at (group << 8) | index; only the parameters an integrator needs most are listed here.",
  "3016H (identification code) and 5000H (fault code) are printed without range or unit, so they are left out; 2102H and 2103H carry the same information.",
  "300FH, 3010H (pulse input printed with a mixed kHz/0.01 Hz unit) and 3011H are left out.",
  "P00.02 values other than 0 select option cards; only 0 (Modbus) is listed.",
  "GD350A has its own map in this library; check the drive label.",
  "300DH/300EH (AI2/AI3) are left out: the address table prints AI2 as 0.00-10.00 V and AI3 as -10.00-10.00 V, but P17.20 prints AI2 as -10.00-10.00 V and AI3 is a 0-10 V option-card input, so signedness is unclear."
 ],
