  "integration": {
    "summary": "Read input registers (function 04) from 19000 for 27 floats: phase and line voltages, currents, P/Q/S per phase and total, CosPhi, frequency and phase order. Use function 03 on the same block if you want the averaged values.",
    "minimum_registers": [
      {
        "table": "input_register",
        "address": 19000,
        "why": "Voltage L1-N"
      },
      {
        "table": "input_register",
        "address": 19012,
        "why": "Current L1"
      },
      {
        "table": "input_register",
        "address": 19026,
        "why": "Total active power"
      },
      {
        "table": "input_register",
        "address": 19034,
        "why": "Total apparent power"
      },
      {
        "table": "input_register",
        "address": 19050,
