{
 "manufacturer": "SATEC",
 "manufacturer_slug": "satec",
 "model": "PM174 powermeter and power quality analyzer",
 "model_slug": "pm174",
 "short_model": "PM174",
 "aliases": [
  "PM174",
  "SATEC PM174",
  "PM 174"
 ],
 "equipment_type": "Power meter (power quality analyzer)",
 "applies_to": "SATEC PM174 from firmware 24.3.1, per Modbus reference guide BG0414 Rev. A7 (April 2013).",
 "summary": "The PM174 is a SATEC panel power meter and EN 50160 power quality analyzer with serial (RTU/ASCII) and optional Ethernet/GPRS Modbus ports. Its 32-bit register set carries 1-second phase and total values, demands and energy counters as integers with fixed units, low word first. This map covers volts, amps, power, PF, THD, frequency, unbalance, present demands, energy totals, digital I/O, basic wiring/CT/PT setup, COM port settings, password and clear commands.",
 "transport": [
  "RTU",
  "ASCII",
  "TCP"
 ],
 "defaults": {
  "unit_id": null,
  "baud": null,
  "parity": null,
  "data_bits": null,
  "stop_bits": null,
  "tcp_port": null
 },
 "addressing": {
  "convention": "0-based",
  "note": "The guide numbers registers 0-65535 and says to add 40001 (or 400001 above 9999) for Modicon holding-register numbers, so the printed address goes straight into the frame: 13952 is wire address 13952 (Modicon 413953)."
 },
 "default_word_order": "CDAB",
 "firmware": "24.3.1 or higher",
 "source": {
  "title": "PM174 Powermeter and Power Quality Analyzer - Modbus Communications Protocol Reference Guide",
  "doc_number": "BG0414 Rev. A7",
  "revision_date": "2013-04",
  "url": "https://www.satec-global.com/wp-content/uploads/2023/03/PM174-Modbus.pdf",
  "pages": "Addressing and data formats pp. 9-12; 32-bit registers pp. 36-41; control/status pp. 57-58; setup pp. 60-61; data units p. 85; F26 wiring codes p. 94"
 },
 "notes": [
  "Addressing: the guide says to add 40001 to a register address to get the Modicon holding-register number (400001 above 9999), so printed addresses are 0-based wire addresses.",
  "Word order: 32-bit values are sent with the low-order word in the first (even) register and the high-order word in the second, so they are CDAB here.",
  "Units U1 (voltage) and U3 (power) depend on the PT ratio: with PT ratio = 1 they are 0.1 V and 0.001 kW/kvar/kVA (the scales used here); with PT ratio > 1 they become 1 V and 1 kW/kvar/kVA. U2 (current) is always 0.01 A.",
  "Function 04 can be used the same way as function 03.",
  "Voltage rows marked V1/V12 read line-to-neutral in 4LN3, 3LN3 and 3BLN3 wiring and line-to-line otherwise.",
  "Energy counters are whole kWh/kvarh/kVAh and roll over at the energy roll value set in the device options.",
  "Left out: 16-bit scaled registers (need per-site HI/LO scale arithmetic), 1-cycle and 1/2-cycle values, harmonics, min/max logs, TOU registers, the total PF lag/lead rows (printed as UINT16 in a two-register slot), setpoint, log and file-transfer registers.",
  "When password protection is on, write the password to 2575 before any setup or clear command, otherwise writes fail with exception 01."
 ],
